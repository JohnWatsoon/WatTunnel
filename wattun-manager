    j=''; sc=''; for i in $AUTO_VAR_CDN; do j=$(plan_port "$(plan_part "$T_AUTO" d)" "$i"); [ -n "$j" ] && { sc=$i; break; }; done
    if [ -n "$j" ]; then
      [ "$AT_QUIET" = 1 ] || at_busy "Cloudflare edges"
      CS_QUIET=1; cdn_scan "$T_SNI" "$j" "${T_PATH:-/wat}" "$sc"
