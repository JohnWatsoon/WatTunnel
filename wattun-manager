  auto_test || { err "Could not prepare the test (is $AUTO_RUN writable?)."; return 1; }
  at_rank; auto_refine
  if [ "${#AT_RANK[@]}" -eq 0 ]; then echo; at_none; return 1; fi
  at_table
  at_choose || { warn "Cancelled."; return 1; }
