  case " $AT_SKIP " in *" $(av_key "$i") "*) AR_WHY[$i]='in use by this tunnel'; return 0 ;; esac
  if [ "${AV_KIND[$i]}" = r ] && is_rpool "${AV_CAR[$i]}"; then
    local rp; rp=$(rproto "${AV_CAR[$i]}")
    if listen_blocked "$rp" "${AV_PORT[$i]}"; then
      AR_WHY[$i]="port ${AV_PORT[$i]}/$rp busy ($(listen_conflict_desc "$rp" "${AV_PORT[$i]}"))"; return 0
    fi
    at_fw_open "${AV_PORT[$i]}/$rp"
  fi
  mp=$(at_free_port) || { AR_WHY[$i]='no free test port'; return 0; }
  AT_LIM=$((w + 55 + AT_MB * 4))
  at_start "$i" "$mp" || { AR_WHY[$i]='no free test port'; return 0; }
  if ! at_wait "$mp" "$w"; then
    AR_WHY[$i]="no link in $w s"
