  [ "${AT_MOVED_MB:-0}" -gt 0 ] && title="Results · ${#AT_RANK[@]} working · ${AT_MOVED_MB} MB · ${AT_SECS} s"
  box_top "$title"
  if [ "${#AT_RANK[@]}" -gt 0 ]; then
    if [ "$BOXW" -ge 66 ]; then
      printf -v hdr '%s %2s  %-22s %6s %6s %6s  %-10s%s' "$GRY" '#' 'Carrier' 'Down' 'Up' 'RTT' 'Speed' "$RST"
    else
