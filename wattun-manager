#!/usr/bin/env bash
# wattun-manager: set up and run WatTunnel tunnels.
#   Kharej = the outside server (runs the real service, the tunnel SERVER)  -> set it up FIRST, it makes the token
#   Iran   = the inside server users connect to (the tunnel CLIENT)          -> paste the token there
# Each tunnel is /etc/wattun/NAME.yml + NAME.key (+ NAME.token on Kharej), run by systemd as wattun@NAME.
# Run it without arguments for the dashboard. Commands:
#   wattun-manager [new [kharej|iran]|kharej|iran|status|list|monitor|ports NAME|test NAME|
#                   speedtest NAME [MB]|logs NAME|token NAME|heal|update|rollback|help]
#   Censor starts blocking the tunnel (whitelist regime): blackout NAME [SNI] turns the resilience kit
#                   (fake-SNI desync + defaults) on with one command; profiles save/apply combinations.
#   Auto carrier (one token, Iran tests every connection type): auto-test NAME | auto-ip NAME IP |
#                   auto-watch NAME | auto-retest NAME   (the last two are run by systemd, not by hand)
#   CDN carriers (ws, wss, h2, h2c, grpc via Cloudflare; wattun >= 2.2.0): cdn-tune NAME [full]
#   Unattended (no tty, for scripts and test rigs): kharej --carrier C --name N --yes | iran --token T --map L:T --yes |
#                   cdn-tune NAME --yes | auto-test NAME --yes | delete NAME --yes | uninstall --yes   (see: help)
# Environment: WAT_NO_ANIM=1 (no animations), NO_COLOR=1 (no colours), WAT_REPO, WAT_PROXY, WAT_PREFIX (sandbox, see below),
#   WAT_SIG_PUB (another release-signing key), WAT_ALLOW_UNSIGNED_UPDATE=1 (run install.sh from main unverified; not recommended).
set -uo pipefail
shopt -s extglob

# Sandbox: WAT_PREFIX=NAME (default wattun) moves every path and unit name this manager creates or controls:
#   $CONF=/etc/NAME  $RUN=/run/NAME  $AUTO_RUN=/run/NAME-auto  $BIN=/opt/NAME/wattun  units NAME@X, NAME-heal, NAME-autowatch-X.
# WAT_CONF / WAT_BIN / WAT_RUN / WAT_AUTO_RUN still override single paths. The manager itself is then THIS script file.
WAT_PREFIX=${WAT_PREFIX:-wattun}
case "$WAT_PREFIX" in ''|-*|*[!A-Za-z0-9_.]*|*-) printf 'WAT_PREFIX must be letters, digits, "_" or "." and may contain "-" inside (got "%s").\n' "$WAT_PREFIX" >&2; exit 1 ;; esac
SANDBOX=0; [ "$WAT_PREFIX" = wattun ] || SANDBOX=1
CONF=${WAT_CONF:-/etc/$WAT_PREFIX}
RUN=${WAT_RUN:-/run/$WAT_PREFIX}
if [ "$SANDBOX" = 1 ]; then
  BIN=${WAT_BIN:-/opt/$WAT_PREFIX/wattun}
  MGR=$(readlink -f "$0" 2>/dev/null || echo "$0")
  # a sandbox must never share a path with the production install
  if [ "$CONF" = /etc/wattun ] || [ "$BIN" = /usr/local/bin/wattun ] || [ "$RUN" = /run/wattun ]; then
    printf 'Sandbox %s refuses to use a production path (CONF=%s BIN=%s RUN=%s MGR=%s).\n' "$WAT_PREFIX" "$CONF" "$BIN" "$RUN" "$MGR" >&2; exit 1
  fi
  export WAT_PREFIX
else
  BIN=${WAT_BIN:-/usr/local/bin/wattun}
  MGR=/usr/local/bin/wattun-manager
fi
REPO=${WAT_REPO:-JohnWatsoon/WatTunnel}
# Release-signing public key. update() checks the installer it runs as root against the release's signed SHA256SUMS.
# This PEM must stay byte-identical to SIG_PUB in install.sh; regenerate the key in both scripts together.
SIG_PUB=$(cat <<'PEM'
-----BEGIN PUBLIC KEY-----
MIIBojANBgkqhkiG9w0BAQEFAAOCAY8AMIIBigKCAYEA0j+yK26CzKRD+am5rQZJ
v8zChkZ5HuwQ4uBtj2mKfFRG8mrj7XN3iW60QEj7Le/fAYtk4hHvqsxb6Xhxw303
+rFCBxKr+mwc3GOB/zVh/fzNqN2pXzKCT+mSKiaDfwUmCizKFNUUCCnhNVpEx9hl
A4B4n5iBgxW0G/ks4hOujx6teaKUN44+cZNgPshPSQ5KdiqQBi0rFCiSAKBCh1vL
j07u5S/mvU8L8u9M6sUzST0mXcGw9WKQmAiIOCqAwLiyV1RtDodgaCIxLPJ93Qo/
uK4DzYX3Ker8lW6MRKXgX3fAVXoyj/ZaE3oh1ZibVefAy6w7qB74JvQPv4nFvS/Y
VJXpxiHiqE/YMdHbS9eCQnqjHVKmGWvBVPo/IlUiJFbl8nIEFZVij32Cp8A4awO2
IORyD7iC8bA7AZHruzVfiUtrYA5XhBTRJplqws8kM0Ig4sLrws0HPOY4xOBRtSVh
vgY6Qw/EWglth/K24PEC8AiuJYIRRkn/Kq+SBIRu8qVrAgMBAAE=
-----END PUBLIC KEY-----
PEM
)
if [ -n "${WAT_SIG_PUB:-}" ]; then SIG_PUB=$(cat "$WAT_SIG_PUB"); fi
# Download helpers for update(): verify SHA256SUMS with the pinned key, then match one "<sha>  <name>" line.
sig_pub_file() { # write the pinned key to a private temp file and print its path
  local f
  f=$(mktemp /tmp/wattun-sigpub.XXXXXX) || return 1
  chmod 600 "$f" 2>/dev/null || { rm -f "$f"; return 1; }
  printf '%s\n' "$SIG_PUB" >"$f" || { rm -f "$f"; return 1; }
  printf '%s\n' "$f"
}
sums_verify() { # sums sig [pubfile]: the optional third argument lets the self-test use a throwaway key
  local pub rc
  command -v openssl >/dev/null 2>&1 || return 1
  if [ -n "${3:-}" ]; then pub=$3; else pub=$(sig_pub_file) || return 1; fi
  openssl dgst -sha256 -verify "$pub" -signature "$2" "$1" >/dev/null 2>&1; rc=$?
  [ -n "${3:-}" ] || rm -f "$pub"
  return "$rc"
}
sums_has() { grep -qx -- "$3  $2" "$1"; } # sums name sha
MGR_VERSION=2026112403   # YYYYMMDDNN; install.sh refuses to replace a newer manager with an older one
HEAL_UNIT=$WAT_PREFIX-heal
MCONF=$CONF/.manager.conf
self_cmd() { # the command to type to start this manager (user-facing hints)
  if [ "$SANDBOX" = 1 ]; then printf 'WAT_PREFIX=%s %s' "$WAT_PREFIX" "$MGR"; else printf wattun; fi
}
SELF=$(self_cmd)
# Environment for units that call this manager again (heal timer, watcher, retest): same sandbox, same paths.
unit_env_lines() { # Environment= lines for a service file
  [ "$SANDBOX" = 1 ] && printf 'Environment="WAT_PREFIX=%s"\n' "$WAT_PREFIX"
  [ -n "${WAT_CONF:-}" ] && printf 'Environment="WAT_CONF=%s"\n' "$WAT_CONF"
  [ -n "${WAT_BIN:-}" ] && printf 'Environment="WAT_BIN=%s"\n' "$WAT_BIN"
  [ -n "${WAT_RUN:-}" ] && printf 'Environment="WAT_RUN=%s"\n' "$WAT_RUN"
  [ -n "${WAT_AUTO_RUN:-}" ] && printf 'Environment="WAT_AUTO_RUN=%s"\n' "$WAT_AUTO_RUN"
  return 0
}
run_env_args() { # --setenv arguments for systemd-run, one per line (read with mapfile)
  printf '%s\n' "--setenv=WAT_CONF=$CONF" "--setenv=WAT_RUN=$RUN" "--setenv=WAT_PREFIX=$WAT_PREFIX"
  [ -n "${WAT_BIN:-}" ] || [ "$SANDBOX" = 1 ] && printf '%s\n' "--setenv=WAT_BIN=$BIN"
  [ -n "${WAT_AUTO_RUN:-}" ] && printf '%s\n' "--setenv=WAT_AUTO_RUN=$WAT_AUTO_RUN"
  return 0
}
# The systemd template unit NAME@.service. install.sh writes wattun@.service; in a sandbox the manager writes its own.
ensure_template() {
  [ "$SANDBOX" = 1 ] || return 0
  local f="/etc/systemd/system/$WAT_PREFIX@.service"
  [ -f "$f" ] && return 0
  cat >"$f" <<EOF
[Unit]
Description=WatTunnel %i (sandbox $WAT_PREFIX)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=$BIN -config $CONF/%i.yml
Restart=always
RestartSec=2
LimitNOFILE=1048576
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "$f" && systemctl daemon-reload && ok "Sandbox: created $f (ExecStart $BIN, configs in $CONF)"
}
LIB=${WAT_MANAGER_LIB:-0}

# Non-interactive mode: no tty, no stdin reads, no animation, no screen clearing, plain lines. Every prompt helper
# (ask, ask_ok, confirm, key_read, pick_carrier, port_editor, at_choose...) answers with its preset or default.
# On with --yes, or NONINTERACTIVE=1 in the environment, or when stdin is not a tty and a --flag is given.
NONINTERACTIVE=${NONINTERACTIVE:-0}
case "${1:-}" in kharej|iran|cdn-tune|auto-test|delete|uninstall|matrix|auto-retest|bond-retest|auto-prune|scepter)
  for _a in "$@"; do
    case "$_a" in --yes) NONINTERACTIVE=1 ;; --*) [ -t 0 ] || NONINTERACTIVE=1 ;; esac
  done ;;
esac
[ "$NONINTERACTIVE" = 1 ] || NONINTERACTIVE=0
# Answers set by flags (see ni_parse); empty = the wizard's own default
NI_CARRIER=''; NI_NAME=''; NI_LISTEN=''; NI_PATH=''; NI_ADDR=''; NI_SNI=''; NI_CDN=''; NI_PORTS=''; NI_MBPS=''; NI_FAKESNI=''; NI_FAKEMODE=''; NI_FAKETTL=''; NI_POOLROT=''; NI_POOLBYTES=''; NI_PRESET=''; NI_TEST=''; NI_ECH=''; NI_GOVERNOR=''; NI_DNSLISTEN=''; NI_SRCIP=''; NI_UDPDNS=''
NI_TOKEN=''; NI_MAP=''; NI_PICK=best; NI_SESSIONS=''; NI_YES=0; NI_POS=(); NI_EXTENDED=0
ERRN=0

case "$(locale charmap 2>/dev/null)" in UTF-8) ;; *) export LC_ALL=C.UTF-8 ;; esac

# ======================================================================================
#  Terminal UI core: colours, cursor, animations, prompts
# ======================================================================================
IS_TTY=0; [ -t 1 ] && IS_TTY=1
[ "$NONINTERACTIVE" = 1 ] && IS_TTY=0
USE_COLOR=0
if [ "${WAT_FORCE_COLOR:-0}" = 1 ] || { [ "$IS_TTY" = 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; }; then USE_COLOR=1; fi
[ "$NONINTERACTIVE" = 1 ] && USE_COLOR=0
NCOL=8
if [ "$USE_COLOR" = 1 ]; then
  NCOL=$(tput colors 2>/dev/null || echo 8)
  case "${TERM:-}" in *256color*) NCOL=256 ;; esac
  case "$NCOL" in ''|*[!0-9]*) NCOL=8 ;; esac
fi
if [ "$USE_COLOR" = 1 ]; then
  RST=$'\e[0m'; BOLD=$'\e[1m'; RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'
  if [ "$NCOL" -ge 256 ]; then CYN=$'\e[38;5;45m'; else CYN=$'\e[36m'; fi
  BLU=$'\e[34m'; GRY=$'\e[90m'
else
  RST=''; BOLD=''; RED=''; GRN=''; YEL=''; CYN=''; BLU=''; GRY=''
fi

conf_get() { local v; v=$(sed -n "s/^$1=//p" "$MCONF" 2>/dev/null | tail -1); echo "${v:-$2}"; }
conf_set() {
  mkdir -p "$CONF"; touch "$MCONF"; chmod 600 "$MCONF"
  sed -i "/^$1=/d" "$MCONF"; echo "$1=$2" >>"$MCONF"
}
ANIM=0
if [ "$IS_TTY" = 1 ] && [ "${WAT_NO_ANIM:-0}" != 1 ] && [ "$(conf_get anim 1)" = 1 ]; then ANIM=1; fi

SPIN_PID=''
LOGF=''
LINK_RTT=''
IN_FLOW=0
INTRO_DONE=0
KEY=''
KEY_NAV=0 # 1: key_read reports arrows as up|down|left|right instead of swallowing them (tunnel page deck)
REPLY_V=''

cur_hide() { [ "$IS_TTY" = 1 ] && printf '\e[?25l'; return 0; }
cur_show() { [ "$IS_TTY" = 1 ] && printf '\e[?25h'; return 0; }
kill_spin() {
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=''; fi
  return 0
}
UDIR_TMP=''
BDIR_TMP=''
cleanup() { kill_spin; cur_show; [ -n "$LOGF" ] && rm -f "$LOGF"; [ -n "$UDIR_TMP" ] && rm -rf "$UDIR_TMP"; [ -n "$BDIR_TMP" ] && rm -rf "$BDIR_TMP"; at_cleanup; return 0; }
on_int() { [ "$IN_FLOW" = 1 ] && return 0; cleanup; printf '\n'; exit 130; }
eof_exit() { cleanup; echo; exit 0; }

rep() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }
VLEN=0
vlen() { local s=${1//$'\e'\[*([0-9;?])[a-zA-Z]/}; VLEN=${#s}; }
strip_ansi() { printf '%s' "${1//$'\e'\[*([0-9;?])[a-zA-Z]/}"; }

# ---- responsive layout width ----
UI_W=74
BOXW=74
TM_CW=36
term_cols() {
  local c=${COLUMNS:-}
  if [[ ! "$c" =~ ^[0-9]+$ ]] || [ "$c" -lt 20 ]; then
    c=$(tput cols 2>/dev/null || echo 80)
  fi
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  echo "$c"
}
ui_init_width() {
  local cols; cols=$(term_cols)
  if [ "$cols" -lt 50 ]; then UI_W=44
  elif [ "$cols" -lt 78 ]; then UI_W=$((cols - 4))
  elif [ "$cols" -ge 84 ]; then UI_W=76
  else UI_W=74; fi
  BOXW=$UI_W
  TM_CW=$(( (UI_W - 2) / 2 ))
}

# ---- plain messages ----
say()  { printf '%b\n' "$*"; }
ok()   { printf '  %s✔%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '  %s!%s %s\n' "$YEL" "$RST" "$*"; }
err()  { ERRN=$((ERRN+1)); if [ "$NONINTERACTIVE" = 1 ]; then printf 'error: %s\n' "$*" >&2; else printf '  %s✘%s %s\n' "$RED" "$RST" "$*"; fi; }
hint() { printf '  %s%s%s\n' "$GRY" "$*" "$RST"; }
hr()   { [ "${UI_W:-0}" -gt 0 ] || ui_init_width; printf '  %s%s%s\n' "$GRY" "$(rep ─ "$UI_W")" "$RST"; }
key_label() { printf '%s[%s]%s' "$CYN" "$1" "$RST"; }
set_row() { # key label value [unit] [default] : one "[k] label  value" line of a settings page
  local v=$3
  if [ -n "$v" ]; then v="$v${4:+ $4}"
  else case "${5:-}" in off|'default route'|'') v="$GRY${5:-}$RST" ;; *) v="$5 ${GRY}(default)${RST}" ;; esac; fi
  printf '  %s %-16s %s\n' "$(key_label "$1")" "$2" "$v"
}
adv_group() { # title : a named section of the Advanced settings page (A1)
  printf '\n  %s%s%s\n' "$BOLD" "$1" "$RST"
}
menu_line() { # key label [key label...] : rows of "[k] label" items, wrapped at UI_W
  local out='' w=0 iw maxw=${UI_W:-74}
  while [ $# -ge 2 ]; do
    iw=$(( ${#1} + 3 + ${#2} ))
    if [ "$w" -gt 0 ] && [ $((w + 2 + iw)) -gt "$maxw" ]; then printf '  %s
' "$out"; out=''; w=0; fi
    [ "$w" -gt 0 ] && { out+='  '; w=$((w+2)); }
    out+="$(key_label "$1") $2"; w=$((w+iw)); shift 2
  done
  printf '  %s
' "$out"
}

# ---- signature kite + WATTUN mark & 0.45s packet-pulse reveal ----
WATTUN_KITE=(
  '   ╱╲  '
  '  ╱──╲ '
  ' ╱ ╲╱  '
)
WATTUN_BANNER=(
  '██   ██  ▄██▄  ██████ ██████ ██  ██ ██▄  ██'
  '██ █ ██ ██▄▄██   ██     ██   ██  ██ ██▀█▄██'
  ' ▀█▀█▀  ██  ██   ██     ██   ▀████▀ ██  ▀██'
)
META_TELEGRAM='@WatxDev'

_banner_draw_frame() { # kite0 kite1 kite2 word_col meta_col show_meta gap cols
  local k0=$1 k1=$2 k2=$3 wc=$4 mc=$5 show_meta=$6 gap=$7 cols=$8
  local -a side=("WatTunnel${VER:+ · v${VER}}" "github.com/JohnWatsoon" "t.me/${META_TELEGRAM#@}")
  local -a ks=("$k0" "$k1" "$k2")
  local i sp=''; [ "$gap" -eq 2 ] && sp=' '
  for i in 0 1 2; do
    if [ "$cols" -ge 78 ] && [ "$show_meta" = 1 ]; then
      printf '  %s%s%s  %s%s%s %s%s%s%s%s\n' \
        "$CYN" "${ks[$i]}" "$RST" "$wc" "${WATTUN_BANNER[$i]}" "$RST" "$sp" "$mc" "${side[$i]}" "$RST" "$EL"
    else
      printf '  %s%s%s  %s%s%s%s\n' "$CYN" "${ks[$i]}" "$RST" "$wc" "${WATTUN_BANNER[$i]}" "$RST" "$EL"
    fi
  done
}
banner() { # [1 = animated reveal] : geometric kite + WATTUN mark, responsive at <78 and <56 cols
  local anim=${1:-0} cols gap=2
  cols=$(term_cols)
  [ "$cols" -lt 80 ] && gap=1
  if [ "$cols" -lt 56 ]; then
    printf '  %s◈%s %sWatTunnel%s%s\n' "$CYN" "$RST" "$BOLD" "$RST" "${VER:+ ${GRY}v${VER}${RST}}"
    return 0
  fi
  if [ "$anim" = 1 ] && [ "$ANIM" = 1 ]; then
    cur_hide
    _banner_draw_frame "       ${GRY}┃" " ╺▸    ${GRY}┃" "╱      ${GRY}┃" "$GRY" "" 0 "$gap" "$cols"
    sleep 0.075
    printf '\r\e[3A'
    _banner_draw_frame "       ${GRY}┃" " ╺━▸   ${GRY}┃" "╱      ${GRY}┃" "$GRY" "" 0 "$gap" "$cols"
    sleep 0.075
    printf '\r\e[3A'
    _banner_draw_frame "       ${GRY}┃" "   ╺━━╋▸" "╱      ${GRY}┃" "$GRY" "" 0 "$gap" "$cols"
    sleep 0.075
    printf '\r\e[3A'
    _banner_draw_frame "${WATTUN_KITE[0]}" "${WATTUN_KITE[1]}" "${WATTUN_KITE[2]}" "$BOLD" "" 0 "$gap" "$cols"
    sleep 0.075
    printf '\r\e[3A'
    _banner_draw_frame "${WATTUN_KITE[0]}" "${WATTUN_KITE[1]}" "${WATTUN_KITE[2]}" "$BOLD" "$GRY" 1 "$gap" "$cols"
    cur_show
  else
    _banner_draw_frame "${WATTUN_KITE[0]}" "${WATTUN_KITE[1]}" "${WATTUN_KITE[2]}" "$BOLD" "$GRY" 1 "$gap" "$cols"
  fi
  if [ "$cols" -lt 78 ]; then
    printf '  %s%sgithub.com/JohnWatsoon · t.me/%s%s\n' "$GRY" "${VER:+v${VER} · }" "${META_TELEGRAM#@}" "$RST"
  fi
  return 0
}

VER=''

EL=''; [ "$IS_TTY" = 1 ] && EL=$'\e[K'
clear_screen() { [ "$IS_TTY" = 1 ] && printf '\e[H\e[2J'; return 0; }

render_header() { # title [subtitle] [animated=0]
  if [ "$NONINTERACTIVE" = 1 ]; then printf '== %s%s ==\n' "$1" "${2:+ ($2)}"; return 0; fi
  ui_init_width; clear_screen; echo
  banner "${3:-0}"
  hr
  local left="${BOLD}$1${RST}" right="${2:+${GRY}$2${RST}}"
  if [ -n "$right" ]; then
    local lw rw pad
    vlen "$left"; lw=$VLEN; vlen "$right"; rw=$VLEN
    pad=$((UI_W - lw - rw)); [ "$pad" -lt 2 ] && pad=2
    printf '  %s%*s%s\n' "$left" "$pad" '' "$right"
  else
    printf '  %s\n' "$left"
  fi
  echo
}

render_subpage_header() { # title [subtitle] : one line, "WatTunnel · title  subtitle"
  if [ "$NONINTERACTIVE" = 1 ]; then printf '== %s%s ==\n' "$1" "${2:+ ($2)}"; return 0; fi
  ui_init_width; clear_screen; echo
  printf '  %sWatTunnel%s ·%s %s%s%s%s\n' "$GRY" "${VER:+ v$VER}" "$RST" "$BOLD" "$1" "$RST" "${2:+  ${GRY}$2${RST}}"
  hr; echo
}

page_full() { # title [subtitle]
  local anim=0
  if [ "$ANIM" = 1 ] && [ "$INTRO_DONE" = 0 ]; then anim=1; fi
  INTRO_DONE=1
  render_header "$1" "${2:-}" "$anim"
}

page() { # title [subtitle]
  render_subpage_header "$1" "${2:-}"
}

# ---- boxes ----
box_top() { # [title]
  if [ -z "${1:-}" ]; then printf '  %s╭%s╮%s\n' "$GRY" "$(rep ─ "$BOXW")" "$RST"; return 0; fi
  vlen "$1"
  local rem=$((BOXW - VLEN - 3)); [ "$rem" -lt 1 ] && rem=1
  printf '  %s╭─ %s%s%s %s╮%s\n' "$GRY" "$RST" "$1" "$GRY" "$(rep ─ "$rem")" "$RST"
}
box_mid() { printf '  %s├%s┤%s\n' "$GRY" "$(rep ─ "$BOXW")" "$RST"; }
box_row() { # a row never pushes the right border out: a longer one is cut to the box
  local t=$1 pad; vlen "$t"
  if [ "$VLEN" -gt $((BOXW-2)) ]; then t=$(strip_ansi "$t"); t="${t:0:$((BOXW-3))}…"; VLEN=$((BOXW-2)); fi
  pad=$((BOXW-2-VLEN)); printf '  %s│%s %s%*s %s│%s\n' "$GRY" "$RST" "$t" "$pad" '' "$GRY" "$RST"
}
row_2col() {
  local left=$1 right=$2 w_left pad
  if [ "$BOXW" -lt 58 ]; then
    box_row "$left"
    [ -n "$(strip_ansi "$right")" ] && box_row "$right"
    return 0
  fi
  w_left=$(( (BOXW - 4) / 2 ))
  vlen "$left"
  pad=$((w_left - VLEN))
  [ "$pad" -lt 0 ] && pad=0
  box_row "${left}$(rep ' ' "$pad")  ${right}"
}
kv() { printf '%s%-11s%s %s' "$GRY" "$1" "$RST" "$2"; } # label value, for the tunnel card
box_bot() { printf '  %s╰%s╯%s\n' "$GRY" "$(rep ─ "$BOXW")" "$RST"; }

# ---- spinner / progress ----
SPIN_FR=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
spin_start() { # label : animate a spinner on the current line until spin_stop (foreground work continues)
  [ "$ANIM" = 1 ] || return 0
  cur_hide
  (
    local i=0 t0=$SECONDS el ts
    while :; do
      el=$((SECONDS-t0))
      if [ "$el" -ge 1 ]; then ts=" ${GRY}· ${el}s${RST}"; else ts=''; fi
      printf '\r\e[K  %s%s%s %s%s' "$CYN" "${SPIN_FR[$i]}" "$RST" "$1" "$ts"
      i=$(( (i+1) % 10 )); sleep 0.1
    done
  ) &
  SPIN_PID=$!
}
spin_stop() { kill_spin; [ "$ANIM" = 1 ] && { printf '\r\e[K'; cur_show; }; return 0; }
step() { # label cmd... : run silently under a spinner, print a done/failed line
  local label=$1 rc; shift
  [ -n "$LOGF" ] || LOGF=$(mktemp /tmp/wattun-manager.XXXXXX)
  : >"$LOGF"
  spin_start "$label"
  "$@" >>"$LOGF" 2>&1; rc=$?
  spin_stop
  if [ "$rc" -eq 0 ]; then ok "$label"; else err "$label"; tail -n 3 "$LOGF" 2>/dev/null | sed "s/^/      $GRY/; s/\$/$RST/"; fi
  return "$rc"
}
bar() { # cur max width -> ━━━━━━────
  local c=$1 m=$2 w=${3:-16} f ch_f='━' ch_e='─'
  [ "$m" -gt 0 ] || m=1; [ "$c" -gt "$m" ] && c=$m
  f=$(( c * w / m ))
  if [ "$USE_COLOR" = 1 ]; then
    printf '%s%s%s%s%s' "$CYN" "$(rep "$ch_f" "$f")" "$GRY" "$(rep "$ch_e" $((w-f)))" "$RST"
  else
    printf '%s%s' "$(rep '#' "$f")" "$(rep '-' $((w-f)))"
  fi
}

celebrate() { printf '  %s◆%s %s%s%s\n' "$GRN" "$RST" "$BOLD" "$1" "$RST"; }
sec_hdr() { # title [meta] : calm section divider clamped to UI_W
  [ "${UI_W:-0}" -gt 0 ] || ui_init_width
  if [ "$NONINTERACTIVE" = 1 ]; then printf '\n  -- %s%s --\n' "$1" "${2:+ ($2)}"; return 0; fi
  local m=${2:+ · $2} len rem
  len=$(( 3 + ${#1} + ${#m} + 1 ))
  rem=$(( UI_W - len )); [ "$rem" -lt 2 ] && rem=2
  printf '\n  %s── %s%s%s%s %s%s\n' "$GRY" "$RST$BOLD" "$1" "$RST" "${2:+ ${GRY}· ${2}}" "$GRY" "$(rep ─ "$rem")$RST"
}
tbar() { # val max [width=10] : proportional throughput bar (▰▰▱▱ / ##--)
  local v=${1:-0} m=${2:-10} w=${3:-10} f
  f=$(awk -v v="$v" -v m="$m" -v w="$w" 'BEGIN{if(m<=0)m=1; r=int((v*w/m)+0.5); if(r<0)r=0; if(r>w)r=w; print r}')
  if [ "$USE_COLOR" = 1 ]; then
    printf '%s%s%s%s%s' "$CYN" "$(rep ▰ "$f")" "$GRY" "$(rep ▱ $((w-f)))" "$RST"
  else
    printf '%s%s' "$(rep '#' "$f")" "$(rep '-' $((w-f)))"
  fi
}
conn_card() { # name carrier rtt maps... : connected summary card + diagram
  local name=$1 cr=$2 rtt=$3; shift 3
  [ "${UI_W:-0}" -gt 0 ] || ui_init_width
  if [ "$NONINTERACTIVE" = 1 ]; then
    celebrate "CONNECTED (RTT ${rtt} ms)"
    echo
    say "  Users connect here:"
    conn_diagram "$cr" "$@"
    return 0
  fi
  celebrate "CONNECTED${rtt:+ · ${rtt} ms}"
  echo
  conn_diagram "$cr" "$@"
  echo
  box_top "$name"
  if systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null; then
    box_row "$(kv 'Auto-heal' "${GRN}on${RST} · background monitor")"
  fi
  if is_pool_list "$cr" && [ "$(uname -s)" = Linux ] && [ -z "${T_FAKESNI:-}${T_POOLROT:-}${T_POOLBYTES:-}" ] \
     && ! grep -q '^fake-sni:' <<<"${AT_EXTRA:-}"; then
    if [ "${T_REV:-0}" = 1 ]; then
      box_row "$(kv 'Blocked?' "Set anti-censor on Kharej: tunnel page -> z")"
    else
      box_row "$(kv 'Blocked?' "Press [z] on tunnel page for anti-censor presets")"
    fi
  fi
  box_bot
}

# ---- input ----
# shellcheck disable=SC2120
key_read() { # [timeout] -> KEY ; rc 0 key, 2 timeout ; EOF exits
  local rc k2 c i; KEY=''
  [ "$NONINTERACTIVE" = 1 ] && { KEY=enter; return 0; }
  while :; do
    if [ -n "${1:-}" ]; then IFS= read -rsn1 -t "$1" KEY; rc=$?; else IFS= read -rsn1 KEY; rc=$?; fi
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -gt 128 ] && { KEY=''; return 2; }
      eof_exit
    fi
    if [ "$KEY" = $'\e' ]; then
      # ESC followed by more bytes is an escape sequence (arrows, Home, F-keys): swallowed and read again,
      # except arrows on a page that navigates a deck (KEY_NAV=1). A lone ESC stays "esc".
      if IFS= read -rsn1 -t 0.05 k2; then
        c=''
        if [ "$k2" = '[' ] || [ "$k2" = O ]; then
          for ((i=0; i<8; i++)); do
            IFS= read -rsn1 -t 0.05 c || break
            case "$c" in [A-Za-z~@]) break ;; esac
          done
          if [ "$KEY_NAV" = 1 ]; then
            case "$c" in
              A) KEY=up; return 0 ;;
              B) KEY=down; return 0 ;;
              C) KEY=right; return 0 ;;
              D) KEY=left; return 0 ;;
            esac
          fi
        fi
        KEY=''; continue
      fi
      KEY=esc
    fi
    break
  done
  [ -z "$KEY" ] && KEY=enter
  return 0
}
ask() { # prompt [default] -> REPLY_V (free text). Enter keeps the default.
  local d=${2:-} v
  if [ "$NONINTERACTIVE" = 1 ]; then REPLY_V=$d; return 0; fi
  printf '  %s?%s %s%s %s›%s ' "$CYN" "$RST" "$1" "${d:+ ${GRY}[$d]${RST}}" "$GRY" "$RST"
  IFS= read -r v || eof_exit
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  REPLY_V=${v:-$d}
}
ask_ok() { # prompt default validator : up to 3 tries, validator prints its own error
  local t
  if [ "$NONINTERACTIVE" = 1 ]; then # the preset/default is the only answer: validate once and say what is wrong
    ask "$1" "$2"; "$3" "$REPLY_V" && return 0
    err "'$1': '$REPLY_V' is not accepted (set it with the matching command-line flag)"; return 1
  fi
  for t in 1 2 3; do
    ask "$1" "$2"
    if "$3" "$REPLY_V"; then return 0; fi
  done
  err "Too many invalid answers, going back."; return 1
}
confirm() { # prompt [y|n default]
  local def=${2:-y} t lab='Y/n'
  [ "$def" = y ] || def=n # anything but y is "no"
  [ "$def" = n ] && lab='y/N'
  if [ "$NONINTERACTIVE" = 1 ]; then
    echo "  ? $1 -> $([ "$def" = y ] && echo yes || echo no)" # the answer actually used
    [ "$def" = y ]; return
  fi
  for t in 1 2 3; do
    printf '  %s?%s %s %s[%s]%s ' "$CYN" "$RST" "$1" "$GRY" "$lab" "$RST"
    key_read
    case "$KEY" in
      y|Y) echo yes; return 0 ;;
      n|N) echo no; return 1 ;;
      enter) echo; [ "$def" = y ]; return ;;
      esc) echo; return 1 ;;
    esac
    echo
  done
  return 1
}
pause() { printf '\n  %sPress any key to go back...%s' "$GRY" "$RST"; key_read; echo; }
PMSG=''
flash() { PMSG=$*; } # shown after the next prompt caret

run_flow() { # fn args... : run in a subshell; Ctrl+C cancels just this flow
  local rc
  IN_FLOW=1
  ( trap 'kill_spin; cur_show; exit 130' INT; trap 'kill_spin; cur_show; at_cleanup' EXIT; "$@" )
  rc=$?
  IN_FLOW=0
  [ "$rc" -eq 130 ] && { echo; warn "Cancelled."; [ "$IS_TTY" = 1 ] && sleep 0.8; }
  return "$rc"
}

# ======================================================================================
#  Pure helpers: config, tokens, port specs
# ======================================================================================
is_auto_helper() { # hidden internal helpers: per-shape auto listeners (-e-*) and auto reverse companions (-r)
  is_auto_ext "$1" || [ -n "$(companion_of "$1")" ]
}
is_probe_unit() { # hidden scepter machinery (3.5.0, plan D2/E4): the engine's test.open probe listeners live
  # as probe-<unix-ts>.yml in Kharej's conf dir for their ttl (probe-<unix-ts>-N.yml on a same-second
  # collision, the shape openProbe really produces). Discriminator = the name shape AND the provenance line
  # the engine stamps every probe yml with (cmd/wattun/scepter_ops.go probeProvenance, the same string its
  # orphan sweep matches) AND mode: server — so a user tunnel merely named probe-12345 predating Scepter,
  # which carries none of those, keeps listing (the .autoext sidecar's M1 rule, applied to probes).
  [[ "$1" =~ ^probe-[0-9]+(-[0-9]+)?$ ]] || return 1
  grep -qs 'probe tunnel created by scepter test.open' "$CONF/$1.yml" || return 1
  [ "$(cfg "$1" mode)" = server ] || return 1
  return 0
}
tunnels() { # every *visible* tunnel: hidden per-shape listeners (-e-*), reverse companions (-r) and the
  # transient scepter test.open probes stay invisible (cleanup paths use tunnels_all, which sees them all)
  local f b; for f in "$CONF"/*.yml; do [ -e "$f" ] || continue; b=${f##*/}; b=${b%.yml}; is_auto_helper "$b" && continue; is_probe_unit "$b" && continue; echo "$b"; done
}
listed_tunnels() { # what a status list shows: hidden auto helpers (-r and -e-*) never appear as separate tunnels
  local n; for n in $(tunnels); do
    is_auto_helper "$n" && continue
    echo "$n"
  done
}
tunnels_all() { # every config, hidden helpers included (uninstall/low-level cleanup)
  local f b; for f in "$CONF"/*.yml; do [ -e "$f" ] || continue; b=${f##*/}; echo "${b%.yml}"; done
}
auto_helpers() { # parent -> its hidden internal helper units ($parent-r and $parent-e-*), one per line
  local p=$1
  [ -f "$CONF/$p-r.yml" ] && [ "$(companion_of "$p-r")" = "$p" ] && echo "$p-r"
  auto_ext_names "$p"
}
auto_all_units() { # parent -> parent followed by its hidden internal helpers
  echo "$1"
  auto_helpers "$1"
}
cfg()     { sed -n "s/^$2:[[:space:]]*//p" "$CONF/$1.yml" 2>/dev/null | head -1 | tr -d "\"'"; }
role()    { [ "$(cfg "$1" mode)" = server ] && echo Kharej || echo Iran; }
stats()   { local m; m=$(cfg "$1" metrics); [ -n "$m" ] && curl -fs --noproxy '*' --max-time 2 "http://$m/stats"; }
stats_flat() { # name : /stats?flat=1 (3.3.6), one key=value line per top-level value, for readers of aggregates only;
  # an older binary answers it with the JSON, and an empty answer falls back to one plain /stats: jget reads both forms
  local m v; m=$(cfg "$1" metrics); [ -n "$m" ] || return 1
  v=$(curl -fs --noproxy '*' --max-time 2 "http://$m/stats?flat=1") && [ -n "$v" ] || v=$(stats "$1") || return 1
  printf '%s' "$v"
}
ms()      { printf "%.1f" "${1:-0}"; }
jget()    { # text key : a top-level value of a JSON object, or of stats_flat's key=value lines (text not starting with '{')
  case $1 in
    '{'*) grep -o "\"$2\": *[^,}]*" <<<"$1" | head -1 | sed 's/.*: *//; s/"//g' ;;
    *) sed -n "s/^$2=//p" <<<"$1" | head -1 ;;
  esac
}
jget_flat() { # json flat-key legacy-key: the flat aggregate first, fall back for older binaries
  local v; v=$(jget "$1" "$2"); [ -n "$v" ] || v=$(jget "$1" "$3"); printf '%s' "$v"
}
human()   { awk -v b="${1:-0}" 'BEGIN{s="B KB MB GB TB";split(s,u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}printf "%.1f %s",b,u[i]}'; }
ipv4_ok() { # is $1 a dotted IPv4 with every octet 0-255 ?
  local a b c d
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}; c=${BASH_REMATCH[3]}; d=${BASH_REMATCH[4]}
  [ "$((10#$a))" -le 255 ] && [ "$((10#$b))" -le 255 ] && [ "$((10#$c))" -le 255 ] && [ "$((10#$d))" -le 255 ]
}
ip_is_private() { # RFC1918, CGNAT 100.64/10, loopback, link-local
  local a b
  ipv4_ok "$1" || return 1
  a=${1%%.*}; b=${1#*.}; b=${b%%.*}; a=$((10#$a)); b=$((10#$b))
  case "$a" in 10|127) return 0 ;; esac
  [ "$a" = 172 ] && [ "$b" -ge 16 ] && [ "$b" -le 31 ] && return 0
  [ "$a" = 192 ] && [ "$b" = 168 ] && return 0
  [ "$a" = 169 ] && [ "$b" = 254 ] && return 0
  [ "$a" = 100 ] && [ "$b" -ge 64 ] && [ "$b" -le 127 ] && return 0
  return 1
}
public_ip() { # prints a valid IPv4 (or IPv6 when no IPv4 exists). A public address on an interface comes first (no
  # third-party lookup); NAT'd servers fall back to ipify/ifconfig.me, then hostname -I.
  local ip u
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\) .*/\1/p')
  if ipv4_ok "$ip" && ! ip_is_private "$ip"; then echo "$ip"; return 0; fi
  for u in https://api.ipify.org https://ifconfig.me; do
    ip=$(curl -fs4 --max-time 5 "$u" 2>/dev/null | tr -d '[:space:]')
    ipv4_ok "$ip" && { echo "$ip"; return 0; }
  done
  ip=$(hostname -I 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+$/){print $i; exit}}')
  ipv4_ok "$ip" && { echo "$ip"; return 0; }
  ip=$(ip -6 route get 2606:4700::1 2>/dev/null | sed -n 's/.* src \([0-9a-fA-F:]*\) .*/\1/p' | head -1)
  if ipv6_ok "$ip"; then
    case "${ip,,}" in ::1|fe80:*|fc*|fd*) ;; *) echo "$ip"; return 0 ;; esac
  fi
  for u in https://api64.ipify.org https://ifconfig.me; do
    ip=$(curl -fs6 --max-time 5 "$u" 2>/dev/null | tr -d '[:space:]')
    ipv6_ok "$ip" && { echo "$ip"; return 0; }
  done
  ip=$(hostname -I 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /:/ && $i !~ /^fe80:/){print $i; exit}}')
  ipv6_ok "$ip" && echo "$ip"
  return 0
}
new_key() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | head -c 40; }
rand_path() { echo "/api/$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"; } # a fresh URL path per tunnel: every install used /wat, a fixed string a filter can match (3.0.1)
uptime_of() { # name -> "3d 4h" / "2h 14m" / "5m", empty when unknown
  local t s; t=$(systemctl show "${WAT_PREFIX}@$1" -p ActiveEnterTimestamp --value 2>/dev/null)
  s=$(date -d "$t" +%s 2>/dev/null) || return 0; s=$(( $(date +%s) - s )); [ "$s" -ge 0 ] || return 0
  if [ "$s" -ge 86400 ]; then echo "$((s/86400))d $((s%86400/3600))h"
  elif [ "$s" -ge 3600 ]; then echo "$((s/3600))h $((s%3600/60))m"
  else echo "$((s/60))m"; fi
}
has_dgram() { local c; for c in ${1//+/ }; do is_pool "$c" || return 0; done; return 1; } # icmp/udp/gre/ipip in the list: the only carriers whose loss_pct is wire loss

# ---- engine state files (F8, 3.3.0): -state-dir moves the quota/totals pair, the names keep the config basename ----
# Mirrors cmd/wattun/state.go statePaths: <state-dir>/<config basename>.quota.json / .totals.json when the tunnel sets
# state-dir:, else next to the config (the 2.5.0-3.2.x location, so existing tunnels keep working). The manager only
# ever deletes these files (reset-traffic, delete, uninstall): live byte totals come from /stats, never from disk.
state_base_path() { # name state-dir -> the "<config basename>" the engine prefixes (pure; empty dir = next to the config)
  local n=$1 d=${2:-}
  if [ -n "$d" ]; then
    # the engine resolves a relative -state-dir from its working directory, which systemd sets to /; mirror that so a
    # hand-edited relative value does not make the manager delete files somewhere else
    case "$d" in /*) ;; *) d="/$d" ;; esac
    d=${d%/}
    printf '%s/%s.yml' "$d" "$n"
  else printf '%s/%s.yml' "$CONF" "$n"; fi
}
state_dir_of() { # name -> the tunnel's state-dir value (empty = engine default: next to the config)
  local d; d=$(cfg "$1" state-dir)
  printf '%s' "${d%/}"
}
state_dir_is_relative() { # name -> 0 when a hand-edited state-dir: is relative (engine CWD = / under the unit)
  local d; d=$(state_dir_of "$1")
  [ -n "$d" ] && [ "${d#/}" = "$d" ]
}
state_dir_relative_warn() { # name : M8 — say it out loud instead of silently assuming the unit's CWD (/)
  state_dir_is_relative "$1" || return 0
  warn "state-dir of '$1' is relative ($(cfg "$1" state-dir)); the service resolves it from / (the manager does the same)."
  hint "Use an absolute path (the shipped unit supports /run/wattun) so the manager and the service agree."
  return 0
}
state_base() { state_base_path "$1" "$(state_dir_of "$1")"; }
state_file() { # name totals|quota -> resolved path, exactly where the engine reads/writes it
  case "${2:-}" in totals|quota) ;; *) return 1 ;; esac
  printf '%s.%s.json' "$(state_base "$1")" "$2"
}
state_files() { # name -> every state file the engine can leave for it (delete/reset cleanup), one per line
  local b; b=$(state_base "$1")
  printf '%s\n' "$b.totals.json" "$b.totals.json.host" "$b.totals.json.tmp" "$b.quota.json" "$b.quota.json.tmp" "$b.pn" "$b.pn.tmp"
}

free_metrics_port() { # first free port from WAT_METRICS_BASE (default 19750, sandbox 19850); never 18990-18999 or 19700-19709 or 20400-20999
  local p=${WAT_METRICS_BASE:-} lim
  [[ "$p" =~ ^[0-9]{4,5}$ ]] || { p=19750; [ "$SANDBOX" = 1 ] && p=19850; }
  lim=$((p + 650))
  if [ "$p" -lt 20400 ] && [ "$lim" -gt 20400 ]; then lim=20400; fi
  [ "$lim" -le 65535 ] || lim=65535 # F25: the range follows the base; capped below the 20500-20999 test range
  while [ "$p" -lt "$lim" ]; do
    if { [ "$p" -ge 18990 ] && [ "$p" -le 18999 ]; } || { [ "$p" -ge 19700 ] && [ "$p" -le 19709 ]; } || { [ "$p" -ge 20400 ] && [ "$p" -le 20999 ]; }; then p=$((p+1)); continue; fi
    if ! port_busy "$p" tcp bind \
       && ! grep -qhE "^(metrics|dns-listen):.*:$p([\"'[:space:]]|#|\$)" "$CONF"/*.yml 2>/dev/null \
       && ! tunnel_using_listen "$p" >/dev/null \
       && ! tunnel_using_public "$p" tcp >/dev/null; then
      break
    fi
    p=$((p+1))
  done
  # F25: fail closed instead of returning a busy/out-of-range port. Callers then write no metrics: line.
  if [ "$p" -ge "$lim" ]; then
    printf '  ! No free metrics port below %s; this tunnel gets no /stats listener (auto-heal cannot read it).\n' "$lim" >&2
    return 1
  fi
  echo "$p"
}
valid_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] && [ ! -e "$CONF/$1.yml" ]; }
suggest_name() { # kharej|iran -> kharej, kharej-2, kharej-3 ...
  local base=$1 n=1 c=$1
  while [ -e "$CONF/$c.yml" ] && [ "$n" -lt 99 ]; do n=$((n+1)); c="$base-$n"; done
  echo "$c"
}

# ---- port busy / ownership ----
port_busy() { # port [tcp|udp|any] [listen|bind] : is something listening (or bound when $3=bind) on IPv4/IPv6?
  local port=${1:-} pr=${2:-any} mode=${3:-listen} f fl hex ss_out ss_rc files=()
  [[ "$port" =~ ^[0-9]+$ ]] && [ "$((10#$port))" -ge 1 ] && [ "$((10#$port))" -le 65535 ] || return 0
  port=$((10#$port))
  if command -v ss >/dev/null 2>&1; then
    if [ "$mode" = bind ]; then
      case "$pr" in tcp) fl=-Htan ;; udp) fl=-Haun ;; *) fl=-Htaun ;; esac
    else
      case "$pr" in tcp) fl=-Hltn ;; udp) fl=-Hlun ;; *) fl=-Hltnu ;; esac
    fi
    ss_out=$(ss "$fl" "( sport = :$port )" 2>/dev/null); ss_rc=$?
    if [ "$ss_rc" -eq 0 ]; then
      [ -n "$ss_out" ] && return 0
      return 1
    fi
  fi
  printf -v hex '%04X' "$port"   # ss missing or failed (e.g. restricted container): read /proc/net IPv4 + IPv6 directly
  case "$pr" in tcp) files=(tcp tcp6) ;; udp) files=(udp udp6) ;; *) files=(tcp tcp6 udp udp6) ;; esac
  for f in "${files[@]}"; do
    awk -v h=":$hex" -v u="${f:0:3}" -v m="$mode" \
      'NR>1 && toupper(substr($2, length($2)-4)) == h && (m=="bind" || u=="udp" || $4=="0A") {found=1} END{exit !found}' \
      "/proc/net/$f" 2>/dev/null && return 0
  done
  return 1
}
port_user() { # port proto -> process name and PID or empty
  local f=-Hltnp; [ "${2:-tcp}" = udp ] && f=-Hlunp
  local line u pid
  line=$(ss "$f" "( sport = :$1 )" 2>/dev/null | grep -o 'users:(("[^"]*",pid=[0-9]*' | head -1)
  if [ -n "$line" ]; then
    u=$(echo "$line" | cut -d'"' -f2)
    pid=$(echo "$line" | grep -o 'pid=[0-9]*' | cut -d= -f2)
    if [ -n "$pid" ] && [ -n "$u" ]; then echo "$u (PID $pid)"; return; fi
    [ -n "$u" ] && { echo "$u"; return; }
  fi
  ss "$f" "( sport = :$1 )" 2>/dev/null | grep -o 'users:(("[^"]*"' | head -1 | cut -d'"' -f2
}

# ---- port specs. Canonical form: LISTEN:TARGET/proto (proto = tcp|udp) ----
NS_OUT=(); NS_ERR=''
norm_spec() { # "8443->443/udp" "443" "53/both" -> NS_OUT=(canonical...) ; rc 1 + NS_ERR on bad input
  NS_OUT=(); NS_ERR=''
  local s=$1 body proto=tcp L T
  s=${s//->/:}; s=${s//→/:}; s=${s//=>/:}; s=${s//=/:}; s=${s//[[:space:]]/}
  [ -n "$s" ] || { NS_ERR='empty entry'; return 1; }
  body=$s
  if [[ $s == */* ]]; then body=${s%%/*}; proto=${s#*/}; fi
  proto=${proto,,}
  case $proto in
    tcp|udp|both) ;;
    tcp+udp|udp+tcp|tcpudp|udptcp) proto=both ;;
    *) NS_ERR="unknown protocol '$proto' (use tcp, udp or both)"; return 1 ;;
  esac
  if [[ $body == *:*:* ]]; then NS_ERR="'$1' has too many ':'"; return 1; fi
  if [[ $body == *:* ]]; then L=${body%%:*}; T=${body##*:}; else L=$body; T=$body; fi
  if ! [[ $L =~ ^[0-9]{1,5}$ && $T =~ ^[0-9]{1,5}$ ]]; then NS_ERR="'$1' is not a port"; return 1; fi
  L=$((10#$L)); T=$((10#$T))
  if [ "$L" -lt 1 ] || [ "$L" -gt 65535 ] || [ "$T" -lt 1 ] || [ "$T" -gt 65535 ]; then NS_ERR="'$1': ports must be 1-65535"; return 1; fi
  case $proto in both) NS_OUT=("$L:$T/tcp" "$L:$T/udp") ;; *) NS_OUT=("$L:$T/$proto") ;; esac
}
spec_L() { local x=${1%%/*}; echo "${x%%:*}"; }
spec_T() { local x=${1%%/*}; echo "${x##*:}"; }
spec_P() { echo "${1##*/}"; }
spec_yaml() { # canonical -> YAML list item text (L:T only when they differ)
  local L T P out
  L=$(spec_L "$1"); T=$(spec_T "$1"); P=$(spec_P "$1")
  if [ "$L" = "$T" ]; then out=$L; else out="$L:$T"; fi
  [ "$P" = udp ] && out="$out/udp"
  echo "$out"
}
spec_human() { # canonical -> "443" / "8443→443" / "53/udp"
  local L T P out
  L=$(spec_L "$1"); T=$(spec_T "$1"); P=$(spec_P "$1")
  if [ "$L" = "$T" ]; then out=$L; else out="$L→$T"; fi
  [ "$P" = udp ] && out="$out/udp"
  echo "$out"
}
maps_yaml_block() { # prints the ports: block for the array MAPS (nothing when empty)
  local i
  [ "${#MAPS[@]}" -gt 0 ] || return 0
  echo "ports:"
  for ((i=0; i<${#MAPS[@]}; i++)); do echo "  - $(spec_yaml "${MAPS[$i]}")"; done
}
maps_allow_str() { # MAPS -> "443,53/udp" (target ports only, as embedded in the token)
  local i out='' t p
  for ((i=0; i<${#MAPS[@]}; i++)); do
    t=$(spec_T "${MAPS[$i]}"); p=$(spec_P "${MAPS[$i]}")
    [ "$p" = udp ] && t="$t/udp"
    case ",$out," in *",$t,"*) continue ;; esac
    out="${out:+$out,}$t"
  done
  echo "$out"
}
allow_to_array() { # "443,53/udp" -> PE_ALLOW=(443:443/tcp 53:53/udp)
  local it; PE_ALLOW=()
  for it in ${1//,/ }; do norm_spec "$it" && PE_ALLOW+=("${NS_OUT[@]}"); done
  return 0
}
allowed_has() { # target proto : 0 if allowed or the allow list is unknown/empty
  local i
  [ "${#PE_ALLOW[@]}" -gt 0 ] || return 0
  for ((i=0; i<${#PE_ALLOW[@]}; i++)); do
    [ "$(spec_T "${PE_ALLOW[$i]}")" = "$1" ] && [ "$(spec_P "${PE_ALLOW[$i]}")" = "$2" ] && return 0
  done
  return 1
}
yml_ports_raw() { # name -> one raw ports: item per line
  sed -n '/^ports:/,/^[^ #\t-]/{/^[[:space:]]*-[[:space:]]/{s/^[[:space:]]*-[[:space:]]*//;s/[[:space:]]*#.*//;s/["'"'"']//g;p}}' "$CONF/$1.yml" 2>/dev/null
}
yml_maps() { # name -> canonical items, one per line
  local it
  while IFS= read -r it; do [ -n "$it" ] && norm_spec "$it" && printf '%s\n' "${NS_OUT[@]}"; done < <(yml_ports_raw "$1")
}
load_maps() { # name -> MAPS
  MAPS=()
  local it
  while IFS= read -r it; do [ -n "$it" ] && MAPS+=("$it"); done < <(yml_maps "$1")
}
cfg_ports() { # legacy one-line list: "443 8443→443 53/udp"
  local it out=''
  while IFS= read -r it; do [ -n "$it" ] && out="$out $(spec_human "$it")"; done < <(yml_maps "$1")
  echo "${out# }"
}
write_ports() { # name : replace the ports: block of NAME.yml with the array MAPS
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  awk '
    /^ports:/ {skip=1; next}
    skip && /^[[:space:]]+(-|#)/ {next}
    skip && /^[[:space:]]*$/ {next}
    {skip=0; print}' "$f" >"$tmp"
  maps_yaml_block >>"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
set_value() { # name key value : set or add a top-level key
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  # key and value through the environment: awk -v would expand backslash escapes in the value
  grep -v "^$2:" "$f" | K="$2" V="$3" awk '/^(metrics|ports):/ && !d {print ENVIRON["K"] ": " ENVIRON["V"]; d=1} {print} END{if(!d) print ENVIRON["K"] ": " ENVIRON["V"]}' >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
unset_value() { # same tmp+mv pattern as set_value: the 3 s hot-reloader must never see an interleaved rewrite
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  grep -v "^$2:" "$f" >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
set_port_limit() { # name port rate quota [period: day|week|month, 3.3.6; written only with a quota]
  local f="$CONF/$1.yml" lp=$2 lr=$3 lq=$4 lpd=${5:-} tmp
  [ -f "$f" ] || return 1
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  awk -v lp="$lp" -v lr="$lr" -v lq="$lq" -v lpd="$lpd" '
    BEGIN { in_lim=0; wrote=0 }
    /^limits:/ { in_lim=1; print; next }
    in_lim && /^[a-zA-Z0-9_-]+:/ {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        if (lpd != "" && lq != "" && lq != "0") s = s " period=" lpd
        print s
        wrote = 1
      }
      in_lim = 0
      print
      next
    }
    in_lim && $1 == "-" && $2 ~ ("^" lp "([[:space:]]|$)") {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        if (lpd != "" && lq != "" && lq != "0") s = s " period=" lpd
        print s
        wrote = 1
      }
      next
    }
    { print }
    END {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        if (!in_lim) print "limits:"
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        if (lpd != "" && lq != "" && lq != "0") s = s " period=" lpd
        print s
      }
    }
  ' "$f" >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}

# Connection token: wat1:BASE64("carrier|peer|key|path|sni|icmp-type|allowed-ports[|reverse]")
# Field 7 (allowed ports on Kharej, comma list, empty = any) was added in 1.9.0; 6-field tokens still parse.
# Field 8 ("1" = reverse ICMP, wattun >= 2.0.0) is written only when set, so every other token stays 7 fields.
# Field 9 (auto plan) is written only for carrier "auto" tokens; field 8 stays empty there. Format:
#   d=udp:4443,tcp:4443,...;r=tcp:24431,...   d = Kharej listen ports (direct), r = ports Iran listens on during the
#   reverse test. Only ; , : = are used, never '|'. 7/8-field tokens still parse.
# Field 10 (3.5.0, Scepter plan D5) is the pairing capability tier (tunnel|create|manage|full) of a token-bootstrap
# pairing: written only when set, exactly like fields 8/9, so an older parser stops at field 9 and ignores it.
# Owner directive (2026-11-22): the wizards' first mints write pair=full automatically — the engine derives the
# pairing from the token on both ends, Iran's wizard asks nothing extra; a pasted watp1: line stays for explicit/rotate.
make_token() {
  local f; f=$(printf '%s|%s|%s|%s|%s|%s|%s' "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}")
  if [ -n "${10:-}" ]; then f="$f|${8:-}|${9:-}|${10}"; elif [ -n "${9:-}" ]; then f="$f|${8:-}|$9"; elif [ "${8:-}" = 1 ]; then f="$f|1"; fi
  printf 'wat1:%s' "$(printf '%s' "$f" | base64 -w0)"
}
T_CARRIER=''; T_PEER=''; T_KEY=''; T_PATH=''; T_SNI=''; T_ICMP=''; T_PORTS=''; T_REV=''; T_AUTO=''; T_PAIR=''
T_LEG_C=(); T_LEG_P=() # a bond token's per-leg endpoints (parallel to the carrier list; see token_bond_legs)
read_token() { # token -> T_CARRIER T_PEER T_KEY T_PATH T_SNI T_ICMP T_PORTS T_REV T_AUTO T_PAIR
  local raw
  T_CARRIER=''; T_PEER=''; T_KEY=''; T_PATH=''; T_SNI=''; T_ICMP=''; T_PORTS=''; T_REV=''; T_AUTO=''; T_PAIR=''
  [[ "$1" == wat1:* ]] || return 1
  raw=$(printf '%s' "${1#wat1:}" | base64 -d 2>/dev/null) || return 1
  IFS='|' read -r T_CARRIER T_PEER T_KEY T_PATH T_SNI T_ICMP T_PORTS T_REV T_AUTO T_PAIR <<<"$raw"
  [ -n "$T_CARRIER" ] && [ -n "$T_PEER" ] && [ -n "$T_KEY" ]
}
is_reverse() { [ "$(cfg "$1" reverse)" = true ]; }

# The server that RECEIVES the tunnel's ICMP requests (Iran in reverse, Kharej in normal mode, echo/timestamp types):
# Linux answers every one with its own full-size copy, which doubles that server's ICMP upload (and, on Kharej, the
# ICMP volume the route sees, which has a ~30 MB/s reroute trigger). Rate-limiting the kernel's echo and timestamp
# replies (icmp_ratemask bits 0 and 14, 10 per second per sender) drops those copies and keeps ordinary pings
# answered. The tunnel's replies are raw-socket sends and are not limited. Measured on the real path: without it
# OutEchoReps = 2 x InEchos. The old values are kept and restored when the last such tunnel is gone (Kharej: 3.0.0).
KREPLY_CONF=/etc/sysctl.d/90-$WAT_PREFIX-reverse.conf
kreply_on() { [ -f "$KREPLY_CONF" ]; }
kreply_apply() {
  local mask lim
  mask=$(sysctl -n net.ipv4.icmp_ratemask 2>/dev/null) && lim=$(sysctl -n net.ipv4.icmp_ratelimit 2>/dev/null) || return 1
  [ -f "$CONF/.kreply.orig" ] || printf 'net.ipv4.icmp_ratemask = %s\nnet.ipv4.icmp_ratelimit = %s\n' "$mask" "$lim" >"$CONF/.kreply.orig"
  {
    echo "# wattun-manager: this server receives ICMP tunnel requests. The kernel's ping replies are rate-limited so it"
    echo "# stops sending a copy of every tunnel packet. Removed when no such tunnel is left."
    echo "net.ipv4.icmp_ratemask = $((mask | 1 | 16384))"
    echo "net.ipv4.icmp_ratelimit = 100"
  } >"$KREPLY_CONF"
  sysctl -q -p "$KREPLY_CONF" >/dev/null
}
kreply_restore() {
  [ -f "$KREPLY_CONF" ] || return 0
  rm -f "$KREPLY_CONF"
  [ -f "$CONF/.kreply.orig" ] && sysctl -q -p "$CONF/.kreply.orig" >/dev/null && rm -f "$CONF/.kreply.orig"
  ok "Restored the kernel's normal ping replies (no ICMP tunnel that needs it is left)."
}
kreply_wanted() { # name : this tunnel receives ICMP requests that the kernel would answer too
  case "+$(cfg "$1" carrier)+" in *+icmp+*) ;; *) return 1 ;; esac
  case "$(cfg "$1" icmp-type)" in ''|echo|timestamp) ;; *) return 1 ;; esac # info/mask: Linux does not answer
  if [ "$(role "$1")" = Iran ]; then is_reverse "$1"; else ! is_reverse "$1"; fi
}
kreply_users_left() {
  local n
  for n in $(tunnels); do kreply_wanted "$n" && return 0; done
  return 1
}
kreply_needed() { ! kreply_on && [ "$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null)" != 1 ]; }
kreply_offer() {
  kreply_needed || return 0
  hint "Linux here also answers every tunnel packet with a full-size copy, doubling this server's ICMP upload."
  [ "$SANDBOX" = 1 ] && warn "Sandbox: this changes GLOBAL kernel settings (net.ipv4.icmp_ratemask |= 16385, icmp_ratelimit = 100) via $KREPLY_CONF; original values saved in $CONF/.kreply.orig."
  step "Limiting the kernel's ping replies (normal pings keep working)" kreply_apply \
    && hint "Undo: remove $KREPLY_CONF and run: sysctl --system (it is also undone when the last reverse Iran tunnel is deleted)."
  return 0
}
refresh_token() { # name [fortress] : keep NAME.token in step with NAME.yml — the allowed ports always, and for a bonded
  # Kharej config (arm-blackout Fortress mode, M1 2026-11-18) also the finalized carrier list, one endpoint per
  # leg and the path, so the emergency token never carries the single-carrier tunnel that was armed over.
  local f="$CONF/$1.token" allow cr bp changed=0 tmp
  [ -f "$f" ] && read_token "$(cat "$f")" || return 0
  load_maps "$1"; allow=$(maps_allow_str)
  [ -f "$CONF/$1-r.yml" ] && is_auto_kharej "$1" && write_ports "$1-r" # the auto reverse companion allows the same ports
  cr=$T_CARRIER; bp=$T_PEER
  [ "$allow" = "$T_PORTS" ] || changed=1
  # an auto Kharej also lists every carrier (icmp+udp+...), but its token is the auto plan Iran tests: only
  # arm-blackout (second arg "fortress") turns it into a bond token (3.4.3; before, opening the token page did)
  if [ "$(role "$1")" = Kharej ] && [ "$T_REV" != 1 ] && { [ "$T_CARRIER" != auto ] || [ "${2:-}" = fortress ]; }; then
    local cc; cc=$(cfg "$1" carrier)
    if [[ "$cc" == *+* ]]; then
      cr=$cc
      split_hp "${T_PEER%%,*}" # the dial host is the old token's first endpoint, without its stale port
      bp=$(bond_peer_field "$1" "$HP_HOST")
      { [ "$cr" = "$T_CARRIER" ] && [ "$bp" = "$T_PEER" ]; } || changed=1
      # the bond finalized path/sni/icmp-type too (arm-blackout writes a fresh path); carry them, not pre-arming values
      [ "$(cfg "$1" path)" = "$T_PATH" ] || { T_PATH=$(cfg "$1" path); changed=1; }
      [ "$(cfg "$1" sni)" = "$T_SNI" ] || { T_SNI=$(cfg "$1" sni); changed=1; }
      [ "$(cfg "$1" icmp-type)" = "$T_ICMP" ] || { T_ICMP=$(cfg "$1" icmp-type); changed=1; }
      [ -z "$T_AUTO" ] || { T_AUTO=''; changed=1; } # a fortress token is not an auto plan
    fi
  fi
  [ "$changed" = 0 ] && return 0
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  ( umask 077; make_token "$cr" "$bp" "$T_KEY" "$T_PATH" "$T_SNI" "$T_ICMP" "$allow" "$T_REV" "$T_AUTO" "$T_PAIR" >"$tmp" )
  mv -f "$tmp" "$f"
}
# M1 (2026-11-18): a bonded Kharej config listens on one port per leg (listen-<carrier>:), so its token carries
# one endpoint per leg in field 2, comma separated in the carrier list's order; bare-carrier legs (icmp, gre,
# ipip, raw shapes) dial a bare address and stay port-less. read_token needs no change (no '|' is introduced);
# the Iran side splits the list back into per-leg peer-<carrier>: keys (token_bond_legs). A single-carrier
# token keeps the plain host:port form, so old tokens and old managers still interoperate.
bond_peer_field() { # name host -> comma-separated per-leg endpoints for a bonded config, in carrier order
  local c port entry out='' base
  base=$(cfg "$1" listen); base=${base##*:}; [[ "$base" =~ ^[0-9]+$ ]] || base='' # legs without their own key
  for c in $(cfg "$1" carrier | tr '+' ' '); do
    port=''; carrier_has_listen "$c" || { out="${out:+$out,}$(join_hp "$2" '')"; continue; }
    port=$(cfg "$1" "listen-$c"); port=${port##*:}; [[ "$port" =~ ^[0-9]+$ ]] || port=$base
    [[ "$port" =~ ^[0-9]+$ ]] || port=''
    out="${out:+$out,}$(join_hp "$2" "$port")"
  done
  printf '%s' "$out"
}
token_bond_legs() { # T_CARRIER (a bond) + T_PEER -> T_LEG_C/T_LEG_P arrays; T_PEER becomes the first leg's entry
  T_LEG_C=(); T_LEG_P=()
  { [[ "$T_CARRIER" == *+* ]] && [[ "$T_PEER" == *,* ]]; } || return 0 # an older manager's bond token has one endpoint for every leg
  local -a cs ps
  IFS='+' read -ra cs <<<"$T_CARRIER"
  IFS=',' read -ra ps <<<"$T_PEER"
  if [ "${#ps[@]}" -ne "${#cs[@]}" ]; then
    err "This token lists ${#ps[@]} endpoints for ${#cs[@]} carriers; it is damaged or hand-made."
    return 1
  fi
  local i
  for ((i=0; i<${#cs[@]}; i++)); do
    [ -n "${ps[$i]}" ] || { err "This token has an empty endpoint for carrier '${cs[$i]}'."; return 1; }
    T_LEG_C+=("${cs[$i]}"); T_LEG_P+=("${ps[$i]}")
  done
  T_PEER=${T_LEG_P[0]}
  return 0
}

# ======================================================================================
#  Scepter pairing (3.5.0, Phase A; plan D3/D4/D5/D6): the pairing credential is
#  {pairing UUID, 32-byte key, capability tier, version}. Iran consumes a watp1:
#  line (UNWRAPPED, plan D5 literal text, matching the engine parser and the Go
#  manager):
#     watp1:1|<36-char pairing UUID>|<base64 of exactly 32 bytes>|<capability>
#  The classic token's optional field 10 carries the same capability for a
#  token-bootstrap pairing (see make_token). Capability tiers (D4):
#     tunnel < create < manage < full
#  Store format (F1-B, 2026-11-22) — $CONF/.pairing, written 0600:
#     line 1 is the credential in the ENGINE's format above, because `wattun -pair`
#     (Kharej) and `wattun -pair-to` (Iran) read exactly that one line from the file;
#     the pre-2026112211 manager wrote a key=value file there that the engine cannot
#     parse, so a manager-paired Kharej never armed the channel. `# ` comment lines
#     after line 1 are this manager's bookkeeping (created=, oldkey=,
#     oldkey_expires=) and are ignored by the engine (the engine takes the first watp1:
#     line and skips blank/# lines; the pre-fix engine, which parses the whole file as
#     one line, was updated together with this manager). The old key=value store still
#     parses for READING; nothing writes that shape any more.
#     for READING; nothing writes that shape any more.
#  Hidden infrastructure: the store and the audit log are dotfiles, never *.yml
#  tunnels, so tunnels()/listed_tunnels()/dashboards can never list them (the
#  scepter latch follows the same rule on the engine side). Both ends need 3.5.0
#  for every Scepter feature; the manager here is Kharej's LOCAL console only
#  (Phase B.3 parity decision: cockpit features live in the Go manager/panel).
# ======================================================================================
PAIR_CAPS='tunnel create manage full'
# Token-bootstrap pairing is the default shape now (owner directive 2026-11-22:
# zero extra manual steps — the wizard's first mint embeds field 10 pair=full and
# the engine derives the pairing from it; a pasted watp1: line stays available for
# explicit/rotate flows on Kharej's console). The default tier rides T_PAIR:
# a first mint writes "full" unless an expert row/flag preset a tier.
SCEPTER_DEFAULT_TIER=full
# The scepter latch listener's default port (owner directive 2026-11-22: a
# manager-made Kharej tunnel carries latch-port without asking). 20443 sits in
# the manager's reserved 20400-20999 band — free_metrics_port and the probe
# ports never land there — so the latch cannot collide with either.
SCEPTER_LATCH_DEFAULT=20443
pick_latch_port() { # [exclude...] : latch-port for a new Kharej tunnel; 20443 unless this
  # tunnel's picked ports or another listener on this server holds it (scan up to 20499, then give up: the
  # engine's key-derived default applies when the yml carries no latch-port)
  local p=$SCEPTER_LATCH_DEFAULT e
  while [ "$p" -le 20499 ]; do
    for e in "$@"; do [ "$e" = "$p" ] && { p=$((p+1)); continue 2; }; done
    if ! listen_blocked tcp "$p"; then echo "$p"; return 0; fi
    p=$((p+1))
  done
  return 1
}
PAIR_STORE=$CONF/.pairing
PAIR_AUDIT=$CONF/.pairing.audit
pair_caps_ok() { case " $PAIR_CAPS " in *" ${1:-} "*) return 0 ;; esac; return 1; }
v_pair_caps() { pair_caps_ok "$1" && return 0; err "Use a capability tier: $PAIR_CAPS."; return 1; }
v_pair_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] && return 0
  err "Enter the pairing UUID exactly as printed (36 characters, dashes included)."; return 1
}
new_pair_uuid() {
  local u
  u=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null) || u=''
  if [ -z "$u" ]; then # no kernel uuidgen on this host: fold 16 random bytes into the same shape
    u=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' | sed 's/\(.\{8\}\)\(.\{4\}\)\(.\{4\}\)\(.\{4\}\)\(.\{12\}\)/\1-\2-\3-\4-\5/')
  fi
  printf '%s\n' "${u,,}"
}
new_pair_key() { head -c 32 /dev/urandom | base64 -w0; } # the D5 credential: base64 of exactly 32 bytes
P_VERSION=''; P_UUID=''; P_KEY=''; P_CAPS=''; P_CREATED=''; P_OLDKEY=''; P_OLDKEY_EXP=''
# The watp1: line is UNWRAPPED (plan D5 literal text; matches the engine parser committed in d354660 and the Go
# manager): watp1:<version>|<pairing UUID>|<base64 32-byte key>|<capability> — no outer base64 of the payload.
make_pairing() { # version uuid key caps -> watp1: line (pure; field order is the wire format, D5)
  printf 'watp1:%s|%s|%s|%s' "${1:-}" "${2:-}" "${3:-}" "${4:-}"
}
read_pairing() { # line -> P_VERSION P_UUID P_KEY P_CAPS ; rc 1 + its own error on a bad line
  P_VERSION=''; P_UUID=''; P_KEY=''; P_CAPS=''
  local klen
  [[ "$1" == watp1:* ]] || { err "A pairing line starts with watp1: (a tunnel token starts with wat1:)."; return 1; }
  IFS='|' read -r P_VERSION P_UUID P_KEY P_CAPS <<<"${1#watp1:}"
  [ "$P_VERSION" = 1 ] || { err "Pairing format version '${P_VERSION:-?}' is not known here (this manager speaks version 1)."; return 1; }
  v_pair_uuid "$P_UUID" || return 1
  if ! [[ "$P_KEY" =~ ^[A-Za-z0-9+/=]+$ ]] \
     || { klen=$(printf '%s' "$P_KEY" | base64 -d 2>/dev/null | wc -c | tr -d ' '); [ "$klen" != 32 ]; }; then
    err "The pairing key must be base64 decoding to exactly 32 bytes."; return 1
  fi
  v_pair_caps "$P_CAPS" || return 1
}
v_pairing() { read_pairing "$1"; }
pairing_load() { # $PAIR_STORE -> P_VERSION P_UUID P_KEY P_CAPS P_CREATED P_OLDKEY P_OLDKEY_EXP
  # rc 0 = parsed, 1 = the file exists but holds nothing parsable, 2 = no store. Lenient on purpose:
  # the engine owns the credential's shape, and refusing a store the engine accepts would lock this
  # console out of a future format; only a store with no uuid/key/caps at all counts as unreadable.
  P_VERSION=''; P_UUID=''; P_KEY=''; P_CAPS=''; P_CREATED=''; P_OLDKEY=''; P_OLDKEY_EXP=''
  [ -f "$PAIR_STORE" ] || return 2
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      watp1:*) # the engine's credential line (line 1; a stray further one is ignored)
        [ -n "$P_UUID" ] && continue
        line=${line%$'\r'} # a CRLF-edited store must not bake \r into the caps field (round-2)
        IFS='|' read -r P_VERSION P_UUID P_KEY P_CAPS <<<"${line#watp1:}" ;;
      \#*) # bookkeeping comments written by pairing_store_write: created=, oldkey=, oldkey_expires=
        k=${line#'#'}; k=${k# }; k=${k%%=*}; v=${line#*=}
        case "$k" in
          created) [ -n "$P_CREATED" ] || P_CREATED=$v ;;
          oldkey) [ -n "$P_OLDKEY" ] || P_OLDKEY=$v ;;
          oldkey_expires) [ -n "$P_OLDKEY_EXP" ] || P_OLDKEY_EXP=$v ;;
        esac ;;
      *) # the pre-2026112211 manager's key=value store: read-only compat, never written again
        k=${line%%=*}; v=${line#*=}
        case "$k" in
          version) P_VERSION=$v ;;
          uuid) [ -n "$P_UUID" ] || P_UUID=$v ;;
          key) [ -n "$P_KEY" ] || P_KEY=$v ;;
          caps) [ -n "$P_CAPS" ] || P_CAPS=$v ;;
          created) [ -n "$P_CREATED" ] || P_CREATED=$v ;;
          oldkey) [ -n "$P_OLDKEY" ] || P_OLDKEY=$v ;;
          oldkey_expires) [ -n "$P_OLDKEY_EXP" ] || P_OLDKEY_EXP=$v ;;
        esac ;;
    esac
  done <"$PAIR_STORE"
  { [ -n "$P_UUID" ] && [ -n "$P_KEY" ] && [ -n "$P_CAPS" ]; } || return 1
  return 0
}
pairing_get() { # field -> value ('' when absent, or there is no store, or it cannot be parsed)
  pairing_load
  case "$1" in
    version) printf '%s' "${P_VERSION:-}" ;;
    uuid) printf '%s' "$P_UUID" ;;
    key) printf '%s' "$P_KEY" ;;
    caps) printf '%s' "$P_CAPS" ;;
    created) printf '%s' "$P_CREATED" ;;
    oldkey) printf '%s' "$P_OLDKEY" ;;
    oldkey_expires) printf '%s' "$P_OLDKEY_EXP" ;;
  esac
  return 0
}
pairing_revoked() { # Handoff 4 R3: the store is a revoke tombstone (first non-comment line "revoked ...")
  [ -f "$PAIR_STORE" ] && grep -v '^#' "$PAIR_STORE" | grep -m1 . | grep -q '^revoked'
}
pairing_active() { [ -f "$PAIR_STORE" ] && ! pairing_revoked; }
pairing_check_readable() { # refuse to touch a store this manager cannot parse: it may be a newer engine's
  # format holding the only copy of the credential, and pair/rotate/revoke would destroy it (F1-B, 2026-11-22)
  [ -f "$PAIR_STORE" ] || return 0
  pairing_revoked && return 0
  pairing_load && return 0
  err "$PAIR_STORE exists but this manager cannot read it; nothing was changed."
  hint "Pair or rotate with the engine (wattun -pair) or delete the file by hand, then try again."
  return 1
}
pairing_store_write() { # uuid key caps [oldkey oldkey-expires-epoch] : the whole store, atomically (tmp+rename, 0600)
  # Line 1 is the credential in the ENGINE's format — `wattun -pair` reads exactly that line and cannot
  # parse anything else (F1-B); the `# ` lines carry this manager's bookkeeping and the engine skips them.
  local tmp old created
  mkdir -p "$CONF"
  created=$(pairing_get created); [ -n "$created" ] || created=$(date +%s) # a rotation keeps the original creation time
  old=$(umask); umask 077
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || { umask "$old"; return 1; }
  {
    make_pairing 1 "$1" "$2" "$3"; echo
    echo "# created=$created"
    if [ -n "${4:-}" ]; then echo "# oldkey=$4"; echo "# oldkey_expires=$5"; fi # the 24 h rotation window (plan D-rotation)
  } >"$tmp" || { rm -f "$tmp"; umask "$old"; return 1; }
  chmod 600 "$tmp"; mv -f "$tmp" "$PAIR_STORE"; umask "$old"
}
pairing_audit() { # event detail : append one line, never rewrite the file
  # Append-only for real (F5, 2026-11-22): the ENGINE appends audit records with open-append-close per
  # entry, so the old cat->tmp->mv rewrite dropped anything appended in the read->rename window (the
  # engine kept writing the renamed-away inode). One small O_APPEND write is atomic enough on a regular
  # file; a missing file is created 0600 via umask (>> never truncates an existing one). A failed append
  # returns 1 with its own error — an unaudited pairing change must not look like success (round-2).
  local f="$PAIR_AUDIT" old
  mkdir -p "$CONF"
  old=$(umask); umask 077
  if ! printf '%s %s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$2" >>"$f"; then
    umask "$old"
    err "Could not append to $PAIR_AUDIT — the audit line was NOT recorded."
    return 1
  fi
  umask "$old"
  return 0
}
pairing_audit_tail() { # [n=20]
  [ -f "$PAIR_AUDIT" ] || { hint "No pairing audit entries yet."; return 0; }
  tail -n "${1:-20}" "$PAIR_AUDIT"
}
pairing_status() {
  local caps created exp left
  if pairing_revoked; then
    say "  $(kv pairing "${RED}revoked${RST} ${GRY}(no Iran can manage this server; o = allow a new Iran)${RST}")"
    return 0
  fi
  if ! pairing_active; then
    say "  $(kv pairing "${GRY}waiting${RST} ${GRY}(the first Iran that connects with a pairing token pairs itself)${RST}")"
    return 0
  fi
  if ! pairing_load; then
    say "  $(kv pairing "${YEL}unreadable${RST} ${GRY}($PAIR_STORE is not a format this manager reads)${RST}")"
    return 0
  fi
  caps=$P_CAPS
  if grep -q '^# claimed' "$PAIR_STORE"; then say "  $(kv pairing "${GRN}paired with an Iran${RST}")"
  else say "  $(kv pairing "${GRN}on${RST}")"; fi
  say "  $(kv uuid "$P_UUID")"
  say "  $(kv caps "$caps")"
  created=$P_CREATED
  [ -n "$created" ] && say "  $(kv created "$(date -u -d "@$created" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$created")")"
  exp=$P_OLDKEY_EXP
  if [ -n "$P_OLDKEY" ] && [ -n "$exp" ]; then
    left=$(( exp - $(date +%s) ))
    # "the old key is accepted" was a lie: the engine takes only the current credential — the old
    # line sits in the store as reference for the rotation window (round-2, 2026-11-22).
    if [ "$left" -gt 0 ]; then say "  $(kv rotation "${YEL}the old line is kept for reference; attach the new line on Iran now — window ${left}s${RST}")"
    else say "  $(kv rotation "${GRY}old key expired${RST}")"; fi
  fi
  return 0
}
scepter_kharej_only() { # F1-C (2026-11-22): pair/rotate/revoke write Kharej's SERVER-side credential.
  # On Iran the same path ($CONF/.pairing) holds the CLIENT credential written by `wattun -pair-to`;
  # rewriting it here would desync the pair, so Iran only reads (status/audit) and pairs from the Go
  # cockpit. Refusing on an explicit Iran side only: side is saved at install/first tunnel, and an
  # undetermined side must not lock Kharej's first pairing out.
  [ "$(server_side)" = iran ] || return 0
  err "This is the Kharej-side action; Iran's pairing is managed by the Go cockpit (wattun -pair-to)."
  return 1
}
scepter_pair() { # generate (or adopt a pasted watp1: line) and store the pairing; prints the line for Iran
  local line uuid key caps
  scepter_kharej_only || return 1
  pairing_check_readable || return 1
  if pairing_active; then
    confirm "A pairing already exists ($(pairing_get uuid)). Replace it? Iran must be given the new line." n || return 0
  fi
  ask "Paste a watp1: line (Enter = generate a fresh pairing here)" ""
  line=$REPLY_V
  if [ -n "$line" ]; then
    read_pairing "$line" || return 1
    uuid=$P_UUID; key=$P_KEY; caps=$P_CAPS
  else
    uuid=$(new_pair_uuid); key=$(new_pair_key); caps=full
    ask_ok "Capability tier ($PAIR_CAPS)" "$caps" v_pair_caps || return 1; caps=$REPLY_V
  fi
  pairing_store_write "$uuid" "$key" "$caps" || { err "Could not write $PAIR_STORE."; return 1; }
  pairing_audit pair_created "$uuid caps=$caps"
  ok "Pairing stored ($uuid, caps $caps)."
  echo
  printf '  %s%s%s\n\n' "$BOLD$YEL" "$(make_pairing 1 "$uuid" "$key" "$caps")" "$RST"
  hint "Give this watp1: line to Iran (pairs the cockpit; wattun 3.5.0 on both ends)."
  return 0
}
scepter_rotate() { # [window_secs=86400] : new key; the window (default 24 h) is bookkeeping that reminds
  # you to re-attach the new watp1: line on Iran BEFORE rotating - the engine accepts only the current
  # credential and reloads within the poll interval once the store changes (TECHNICAL.md accepted limits)
  local win=${1:-86400} uuid caps key nk
  case "$win" in ''|*[!0-9]*) err "The rotation window is a number of seconds."; return 1 ;; esac
  scepter_kharej_only || return 1
  pairing_active || { err "No pairing to rotate (pair first)."; return 1; }
  pairing_check_readable || return 1
  pairing_load || return 1 # check_readable just proved the store parses; belt and braces
  uuid=$P_UUID; caps=$P_CAPS; key=$P_KEY
  nk=$(new_pair_key)
  pairing_store_write "$uuid" "$nk" "$caps" "$key" "$(( $(date +%s) + win ))" || { err "Could not write $PAIR_STORE."; return 1; }
  pairing_audit pair_rotated "$uuid window=${win}s"
  ok "Pairing key rotated; the engine switches to the new key within its poll interval."
  echo
  printf '  %s%s%s\n\n' "$BOLD$YEL" "$(make_pairing 1 "$uuid" "$nk" "$caps")" "$RST"
  hint "Attach this new watp1: line on Iran NOW (rotation takes effect at the next store poll)."
  return 0
}
scepter_revoke() { # revoke = a tombstone (Handoff 4 R3): a deleted store would let a token-paired unit
  # re-derive the pairing at its next start; the tombstone keeps every unit unpaired, token or not.
  # Tunnels keep running (plan D3).
  local id tmp old
  scepter_kharej_only || return 1
  pairing_revoked && { err "The pairing is already revoked (o = allow a new Iran)."; return 1; }
  pairing_check_readable || return 1
  id=$(pairing_get uuid); [ -n "$id" ] || id=token
  if [ "$NONINTERACTIVE" = 1 ]; then
    [ "${NI_YES:-0}" = 1 ] || { err "scepter revoke without a terminal needs --yes"; return 1; }
  else
    confirm "Revoke the pairing? No Iran can manage this server until you allow a new one; tunnels keep running." n || return 0
  fi
  pairing_audit pair_revoked "$id" || return 1
  mkdir -p "$CONF"
  old=$(umask); umask 077
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || { umask "$old"; return 1; }
  printf 'revoked %s %s\n' "$id" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$PAIR_STORE"
  umask "$old"
  ok "Pairing revoked. The audit log is kept in $PAIR_AUDIT."
  return 0
}
scepter_reopen() { # Handoff 4 R2: delete the store - the next Iran that connects with a pairing token pairs itself
  scepter_kharej_only || return 1
  [ -f "$PAIR_STORE" ] || { hint "Nothing to do: no Iran is paired yet, the next one to connect pairs itself."; return 0; }
  pairing_check_readable || return 1
  if [ "$NONINTERACTIVE" = 1 ]; then
    [ "${NI_YES:-0}" = 1 ] || { err "scepter reopen without a terminal needs --yes"; return 1; }
  else
    confirm "Allow a new Iran to pair? The current pairing ends; the next Iran that connects with a pairing token takes over." n || return 0
  fi
  pairing_audit pair_reopened "$(pairing_get uuid)" || return 1
  rm -f "$PAIR_STORE"
  ok "Pairing open: the next Iran that connects with this server's pairing token pairs itself."
  return 0
}
scepter_menu() { # Kharej's local Scepter console: status, pair, rotate, revoke, audit tail.
  # F1-C: on Iran the console is read-only (status/audit) — Iran's credential is the client side,
  # written by `wattun -pair-to`, and pair/rotate/revoke here would overwrite it.
  local sd; sd=$(server_side)
  if [ "$sd" = iran ]; then
    while :; do
      page "Pairing" "Iran · read-only"
      pairing_status
      echo
      hint "Pairing is managed on Kharej; this server pairs by itself when its tunnel connects."
      menu_line a 'audit tail' 0 back
      key_read
      case "$KEY" in
        a|A) echo; pairing_audit_tail 20; pause ;;
        b|0|q|enter|esc) return 0 ;;
      esac
    done
  fi
  while :; do
    page "Pairing" "which Iran manages this server"
    pairing_status
    echo
    menu_line o 'allow a new Iran' x 'revoke' r rotate p 'pair by hand' a 'audit tail' 0 back
    key_read
    case "$KEY" in
      p|P) echo; scepter_pair; pause ;;
      r|R) echo; scepter_rotate; pause ;;
      x|X) echo; scepter_revoke; pause ;;
      o|O) echo; scepter_reopen; pause ;;
      a|A) echo; pairing_audit_tail 20; pause ;;
      b|0|q|enter|esc) return 0 ;;
    esac
  done
}
scepter_cmd() { # status|pair|rotate [secs]|revoke|audit [n]
  case "${1:-status}" in
    status) pairing_status ;;
    pair) scepter_pair ;;
    rotate) scepter_rotate "${2:-86400}" ;;
    revoke|unpair) scepter_revoke ;;
    reopen|allow) scepter_reopen ;;
    audit) pairing_audit_tail "${2:-20}" ;;
    *) err "scepter: use status, pair, rotate, revoke, reopen or audit."; return 1 ;;
  esac
}

# ---- cross-tunnel conflict checks ----
tunnel_using_public() { # port proto [exclude] -> name of another Iran tunnel publishing it
  local n it
  for n in $(tunnels); do
    [ "$n" = "${3:-}" ] && continue
    [ "$(role "$n")" = Iran ] || continue
    while IFS= read -r it; do
      [ -n "$it" ] && [ "$(spec_L "$it")" = "$1" ] && [ "$(spec_P "$it")" = "$2" ] && { echo "$n"; return 0; }
    done < <(yml_maps "$n")
  done
  return 1
}
tunnel_using_listen() { # port [exclude] -> name of a tunnel (Kharej, or Iran in reverse) listening on it
  # every config counts, hidden auto children too, and every listen key: an auto tunnel keeps its ports as
  # listen-<carrier>: lines, and a stopped one still owns them (it starts again on reboot)
  local f n
  for f in "$CONF"/*.yml; do
    [ -e "$f" ] || continue
    n=${f##*/}; n=${n%.yml}
    [ "$n" = "${2:-}" ] && continue
    grep -qE "^listen(-[a-z0-9-]+)?:[[:space:]]*[\"']?[^\"'#]*:$1[\"']?([[:space:]]*(#.*)?)?\$" "$f" && { echo "$n"; return 0; }
  done
  return 1
}
tunnel_using_misc() { # port [exclude] -> name of a tunnel using port for metrics: or dns-listen:
  local f n
  for f in "$CONF"/*.yml; do
    [ -e "$f" ] || continue
    n=${f##*/}; n=${n%.yml}
    [ "$n" = "${2:-}" ] && continue
    grep -qE "^(metrics|dns-listen):[[:space:]]*[\"']?[^\"'#]*:$1[\"']?([[:space:]]*(#.*)?)?\$" "$f" && { echo "$n"; return 0; }
  done
  return 1
}
listen_blocked() { # proto port
  port_busy "$2" "$1" bind || tunnel_using_listen "$2" >/dev/null || tunnel_using_public "$2" "$1" >/dev/null || tunnel_using_misc "$2" >/dev/null
}
listen_conflict_desc() { # proto port -> explanation string
  # A probe unit is hidden machinery (its name is throw-away), so the message
  # names the machine, never the tunnel (round-2, 2026-11-22).
  local proto=${1:-tcp} port=$2
  local tun u
  tun=$(tunnel_using_listen "$port")
  if [ -n "$tun" ]; then
    if is_probe_unit "$tun"; then echo "a scepter probe test unit"; else echo "tunnel '$tun'"; fi
    return
  fi
  tun=$(tunnel_using_public "$port" "$proto")
  if [ -n "$tun" ]; then echo "tunnel '$tun' (public port)"; return; fi
  tun=$(tunnel_using_misc "$port")
  if [ -n "$tun" ]; then
    if is_probe_unit "$tun"; then echo "a scepter probe test unit"; else echo "tunnel '$tun' (local service)"; fi
    return
  fi
  u=$(port_user "$port" "$proto")
  if [ -n "$u" ]; then echo "$u"; return; fi
  echo "another process or tunnel"
}
_rand_u16() { # -> 0..65535
  local v=''
  if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
    v=$(od -An -tu2 -N2 /dev/urandom 2>/dev/null | tr -d '[:space:]')
  fi
  case "$v" in ''|*[!0-9]*) v=$(( (RANDOM << 1) ^ (RANDOM & 1) ^ ($$ & 65535) )) ;; esac
  echo "$v"
}
_port_reserved() { # port [space_sep_exclude] -> 0 when reserved or already chosen in the same plan
  local p=$1 ex=${2:-}
  if [ "$p" -ge 18990 ] && [ "$p" -le 18999 ]; then return 0; fi
  if [ "$p" -ge 19700 ] && [ "$p" -le 20999 ]; then return 0; fi
  case " $ex " in *" $p "*) return 0 ;; esac
  return 1
}
rand_open_port() { # [proto=tcp] [exclude_space_sep] -> prints one free random open port (10000..32767, fallback 40000..60000)
  local proto=${1:-tcp} excl=${2:-} i p start
  # Primary range 10000..32767 avoids well-known/panel ports and stays below Linux's default ephemeral range (32768..60999).
  for ((i=0; i<200; i++)); do
    p=$(( 10000 + ($(_rand_u16) % 22768) ))
    _port_reserved "$p" "$excl" && continue
    listen_blocked "$proto" "$p" && continue
    echo "$p"; return 0
  done
  for ((i=0; i<100; i++)); do
    p=$(( 40000 + ($(_rand_u16) % 20001) ))
    _port_reserved "$p" "$excl" && continue
    listen_blocked "$proto" "$p" && continue
    echo "$p"; return 0
  done
  start=$(( $(_rand_u16) % 22768 ))
  for ((i=0; i<256; i++)); do
    p=$(( 10000 + ((start + i * 103) % 22768) ))
    _port_reserved "$p" "$excl" && continue
    listen_blocked "$proto" "$p" && continue
    echo "$p"; return 0
  done
  return 1
}
CF_HTTPS_PORTS='2053 2083 2087 2096 8443' # Cloudflare-proxied HTTPS ports (never auto-grab 443)
CF_HTTP_PORTS='2052 2082 2086 2095 8880 8080' # Cloudflare-proxied HTTP ports (never auto-grab 80)
CF_ORIGIN_FALLBACK=0
cf_port_ok() { # carrier port -> 0 when port is Cloudflare-proxyable for this carrier
  local c=$1 p=${2:-}
  [ -n "$p" ] || return 1
  case "$c" in
    wss|grpc|h2|tls) case " 443 2053 2083 2087 2096 8443 " in *" $p "*) return 0 ;; esac ;;
    ws|h2c) case " 80 8080 8880 2052 2082 2086 2095 " in *" $p "*) return 0 ;; esac ;;
  esac
  return 1
}
pick_cf_cdn_port() { # carrier [exclude_space_sep] -> free CF port (never 443/80), else rand_open_port + CF_ORIGIN_FALLBACK=1
  local c=$1 excl=${2:-} list p off n i
  local -a pool=()
  CF_ORIGIN_FALLBACK=0
  case "$c" in
    wss|grpc|h2) list=$CF_HTTPS_PORTS ;;
    ws|h2c) list=$CF_HTTP_PORTS ;;
    *) rand_open_port "$(rproto "$c")" "$excl"; return $? ;;
  esac
  for p in $list; do pool+=("$p"); done
  n=${#pool[@]}
  off=$(( $(_rand_u16) % n ))
  for ((i=0; i<n; i++)); do
    p=${pool[$(((off + i) % n))]}
    _port_reserved "$p" "$excl" && continue
    listen_blocked tcp "$p" && continue
    echo "$p"; return 0
  done
  CF_ORIGIN_FALLBACK=1
  rand_open_port tcp "$excl"
}
default_listen() { # carrier [cdn_mode=0] [exclude_space_sep] -> free random open port (or non-443/80 CF port when cdn_mode=1)
  local cr=$1 cdn=${2:-0} excl=${3:-}
  if [ "$cdn" = 1 ] && is_cdn_carrier "$cr"; then
    pick_cf_cdn_port "$cr" "$excl"
    return $?
  fi
  rand_open_port "$(rproto "$cr")" "$excl"
}

# ---- validators (print their own error, rc 1 when bad) ----
# Engine limits, kept next to the validators: a bigger value is refused or silently clamped by the engine
# (maxSessions in cmd/wattun/tunnel.go, poolMaxConns in wat/carrier_tcp.go, MinPayload/MaxPayloadHi and
# poolMaxMTU in wat/session.go + wat/carrier_tcp.go), so the manager refuses it with the real limit instead.
ENG_MAX_SESSIONS=16   # maxSessions: -sessions 1..16 (a client of one pool carrier only)
ENG_MAX_CONNS=64      # poolMaxConns: -conns is clamped to 64 per pool
ENG_MTU_MIN=256       # MinPayload: the smallest datagram the engine accepts
ENG_MTU_MAX=1400      # MaxPayloadHi: icmp/udp/gre/ipip (and any bond with one) cap -mtu here
ENG_MTU_MAX_POOL=16384 # poolMaxMTU: a tcp/tls/ws/wss/h2/h2c/grpc carrier frames up to this
# A5 (2026-11-04): stable-but-rare engine keys that stay file-only on purpose (no UI: they are set once by an expert,
# or matter only to one debugging scenario). Listed in one place, shown in the Advanced page's help line, and checked by
# test-manager's coverage test, so a new engine flag cannot silently lack a manager path.
#   debug/ping-every/udp-idle/tcp-cc/slack-ms/hedge/lanes/mem-budget/plain: diagnostics and hand-tuned internals
#   port-offset: the "second slot" of a one-server handover, set by the installer docs
#   tls-cert/tls-key: a custom certificate pair for the tls carrier (self-signed is the default)
#   header: extra request headers for the ws/wss/h2/h2c/grpc carriers (repeatable; flag.Func, no UI row)
#   keep-slow/tls-small-ch/hdr-mask/tcp-mimic/tls-pin/fake-ip/fake-split: anti-censor/diagnostic file-only keys
#   legacy-mask-flip: joins a pre-3.0 plain-header peer (3.3.8; default off, the automatic flip was a downgrade)
#   udp-dns-edns: structurally complete udp-dns frames (3.3.8; both ends, opt-in)
#   probe-guard: demand a key-derived token on HTTP-family tunnel requests (3.3.8; both ends, opt-in)
#   mtu-adapt: sender-side payload clamp for size-selective loss (3.3.8; single-ended, no wire signal, opt-in)
#   max-sessions/max-conns: denial-of-service caps (server sessions, public connections); the defaults fit (3.3.5)
#   pairing: Scepter pairing attach, Iran side (3.5.0, both ends; the watp1: line or token field 10 carries the credential)
#   pair/pair-to: the one-shot bootstrap forms of the same (engine flags; the manager writes .pairing itself)
#   latch-port/latch-dial: the scepter latch listener and its one-shot contact/drill form (3.5.0, Kharej side; opt-in with a stored pairing)
#   scepter-call/scepter-args: the one-shot write-intent/RPC call form (3.5.0, Iran side; the Go manager shells out to it)
#   panel: runs the web panel from panel.conf (3.6.0), not a tunnel; `wattun panel on` writes its unit
CFG_FILE_ONLY='debug ping-every udp-idle tcp-cc slack-ms hedge lanes mem-budget plain port-offset tls-cert tls-key header keep-slow tls-small-ch hdr-mask legacy-mask-flip udp-dns-edns probe-guard mtu-adapt tcp-mimic tls-pin fake-ip fake-split max-sessions max-conns decoy repair fast-rtx burst-cap rate-tune ptcp-hop spray-hop pair pair-to pairing latch-port latch-dial scepter-call scepter-args update-job scepter-deny-ports panel'
# The server's target-port allowlist (-allow-min/-allow-max/-allow-ports/-allow-file) is reachable through the wizard's
# ports:/allowed-ports editor instead of separate rows: same data, one code path. The coverage test excludes these four.
CFG_PORTS_UI='allow-min allow-max allow-ports allow-file'
mtu_max_for() { # carrier list -> largest mtu the engine will not clamp for it (a bond merges to its smallest leg)
  local c hi leg
  [ -n "$1" ] || { echo "$ENG_MTU_MAX"; return 0; }
  hi=$ENG_MTU_MAX_POOL
  for c in ${1//+/ }; do
    case "$c" in tcp|tls|ws|wss|h2|h2c|grpc) leg=$ENG_MTU_MAX_POOL ;; *) leg=$ENG_MTU_MAX ;; esac
    leg=$(shaped_raw_mtu "$c" "$leg") # F19 raw shapes: 1400 minus their IP protocol header (M1/M15)
    leg=$(shaped_udp_mtu "$c" "$leg") # F19 UDP shapes carry a fixed header: their ceiling is below 1400
    [ "$leg" -lt "$hi" ] && hi=$leg
  done
  echo "$hi"
}
sessions_carrier_ok() { # carrier list -> 0 when the engine accepts -sessions > 1 (one udp/pool carrier, not a bond)
  case "${1:-}" in *+*) return 1 ;; esac
  case "${1:-}" in udp|tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac
  return 1
}
v_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$1))" -ge 1 ] && [ "$((10#$1))" -le 65535 ] && return 0; err "Enter a port between 1 and 65535."; return 1; }
v_name() {
  [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || { err "Use 1-32 letters, digits, - or _."; return 1; }
  [ ! -e "$CONF/$1.yml" ] || { err "A tunnel named '$1' already exists."; return 1; }
}
HP_HOST=''; HP_PORT=''
split_hp() { # addr -> HP_HOST (unbracketed) and HP_PORT (empty when bare host / bare IPv6 / [ipv6])
  local a=${1:-}
  HP_HOST=''; HP_PORT=''
  if [[ "$a" =~ ^\[([^\]]+)\]:([0-9]+)$ ]]; then HP_HOST=${BASH_REMATCH[1]}; HP_PORT=${BASH_REMATCH[2]}
  elif [[ "$a" =~ ^\[([^\]]+)\]$ ]]; then HP_HOST=${BASH_REMATCH[1]}
  elif ipv6_ok "$a"; then HP_HOST=$a
  elif [[ "$a" == *:* ]] && [[ "$a" != *:*:* ]]; then HP_HOST=${a%:*}; HP_PORT=${a##*:}
  else HP_HOST=$a; fi
}
join_hp() { # host [port] -> host:port or [ipv6]:port (bare host when port is empty)
  local h=${1:-} p=${2:-}
  h=${h#[}; h=${h%]}
  [ -n "$p" ] || { printf '%s' "$h"; return 0; }
  if [[ "$h" == *:* ]]; then printf '[%s]:%s' "$h" "$p"; else printf '%s:%s' "$h" "$p"; fi
}
v_ip() {
  local h=${1:-}; h=${h#[}; h=${h%]}
  if ipv4_ok "$h" || ipv6_ok "$h"; then return 0; fi
  err "Enter a valid IPv4 or IPv6 address."; return 1
}
v_host() {
  local a=${1:-}
  [ -n "$a" ] && [ "${#a}" -le 253 ] || { err "Enter an IP address or a domain name."; return 1; }
  split_hp "$a"
  if [[ "$a" != \[*\]:* ]] && [[ "$a" != \[*\] ]] && [[ "$a" == *:* ]] && [ -z "$HP_PORT" ]; then
    ipv6_ok "$HP_HOST" || { err "Enter an IP address or a domain name."; return 1; }
  fi
  if [ -n "$HP_PORT" ]; then v_port "$HP_PORT" >/dev/null 2>&1 || { err "Enter an IP address or a domain name."; return 1; }; fi
  if ipv4_ok "$HP_HOST" || ipv6_ok "$HP_HOST" || [[ "$HP_HOST" =~ ^[A-Za-z0-9._-]{1,253}$ ]]; then return 0; fi
  err "Enter an IP address or a domain name."; return 1
}
v_ipv4() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && return 0; err "Enter the server's IPv4 address, such as 198.51.100.20."; return 1; }
is_pool() { case "$1" in tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac; return 1; }
is_pool_list() { local c; for c in ${1//+/ }; do is_pool "$c" && return 0; done; return 1; }
has_ech_list() { local c; for c in ${1//+/ }; do case "$c" in tls|wss|h2|grpc) return 0 ;; esac; done; return 1; }
undisguised_legs() { local c out=''; for c in ${1//+/ }; do is_pool "$c" || out="${out:+$out }$c"; done; echo "$out"; }
carrier_ok() { # single carrier name, including the F19 shaped tier (3.3.0); a bond leg's :up/:down
               # direction suffix (3.3.9) is stripped and the base checked — the bond-level suffix
               # rules (udp-only :down, one leg per direction, bond-only, never shaped) live in v_carrier_list
  case "$1" in *:up|*:down) set -- "${1%:*}" ;; esac
  case "$1" in
    icmp|udp|tcp|tls|ws|wss|h2|h2c|grpc|gre|ipip|ptcp|spray) return 0 ;;
    sit|6to4|xfrm-ipsec|etherip|l2tpv3) return 0 ;;
    fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) return 0 ;;
  esac
  return 1
}
carrier_leg_base() { # bond leg -> carrier name without the :up/:down direction suffix (3.3.9; no suffix = carries both directions)
  case "$1" in *:up|*:down) echo "${1%:*}" ;; *) echo "$1" ;; esac
}
carrier_leg_dir() { # bond leg -> up|down|'' ('' = bidirectional)
  case "$1" in *:up) echo up ;; *:down) echo down ;; *) echo '' ;; esac
}
# B2 (2026-11-04): the oldest engine that can run a carrier at all. Auto itself needs 2.1.0; gre/ipip arrived in 3.2.0;
# the 13 shaped carriers are 3.3.0-only on both ends; a :up/:down directional leg signals itself with the frEndpoint
# frame (0x0e), so both ends need the release that speaks it (3.3.9, wat/version.go). Used by the Kharej plan writer
# and the Iran variant builder, so an old engine never receives a carrier it cannot start or test.
carrier_min_ver() {
  case "$1" in
    *:up|*:down) echo 3.3.9 ;;
    gre|ipip) echo 3.2.0 ;;
    ptcp|spray) echo 3.4.3 ;;
    sit|6to4|xfrm-ipsec|etherip|l2tpv3|fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) echo 3.3.0 ;;
    *) echo 2.1.0 ;;
  esac
}
carrier_ok_here() { [ -n "$(bin_ver_ok "$(carrier_min_ver "$1")")" ]; }
# F19 (3.3.0): wattun-internal wire shapes. Raw tier: bare-IP peer on a raw socket like icmp/gre, IP protocols
# 41/41/50/97/115, no -listen and no -reverse, one session, Linux + root/CAP_NET_RAW. UDP tier: the udp carrier with a
# fixed per-protocol header and conventional port (peer/listen, explicit port wins), no -reverse, one session. Both
# ends must run 3.3.0 with the same name; they do NOT talk to the real protocol. Kept in sync with cmd/wattun/main.go
# and wat/udpshape.go (port table).
SHAPED_RAW='sit 6to4 xfrm-ipsec etherip l2tpv3'
SHAPED_UDP='fou-gre gue-ipip vxlan geneve dnscrypt-udp ntp-direct openvpn-dco srtp-direct'
is_shaped_raw() { case " $SHAPED_RAW " in *" $1 "*) return 0 ;; esac; return 1; }
is_shaped_udp() { case " $SHAPED_UDP " in *" $1 "*) return 0 ;; esac; return 1; }
is_shaped_carrier() { is_shaped_raw "$1" || is_shaped_udp "$1"; }
is_shaped_list() { local c; for c in ${1//+/ }; do is_shaped_carrier "$c" && return 0; done; return 1; }
is_raw_carrier() { case "$1" in icmp|gre|ipip) return 0 ;; esac; is_shaped_raw "$1"; }
is_udp_carrier() { [ "$1" = udp ] || is_shaped_udp "$1"; }
carrier_has_listen() { ! is_raw_carrier "$1"; }
carrier_write_listen() { # carrier list -> 0 when the config needs a global listen: key (single raw shape: no listen)
  local c
  case "$1" in
    *+*) for c in ${1//+/ }; do case "$(carrier_leg_base "$c")" in udp|tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac; done; return 1 ;;
    *) carrier_has_listen "$1" ;;
  esac
}
shaped_udp_port() { # F19 UDP-shaped carrier -> its conventional UDP port (the engine's withDefaultPort default)
  case "$1" in
    fou-gre) echo 5555 ;; gue-ipip) echo 6080 ;; vxlan) echo 4789 ;; geneve) echo 6081 ;;
    dnscrypt-udp) echo 443 ;; ntp-direct) echo 123 ;; openvpn-dco) echo 1194 ;; srtp-direct) echo 5004 ;;
  esac
}
shaped_udp_mtu() { # carrier [default] -> the shape's datagram ceiling (wat/udpshape.go: 1400 minus its header/padding)
  local m
  case "$1" in
    dnscrypt-udp) m=1326 ;; ntp-direct) m=1336 ;; openvpn-dco) m=1396 ;; srtp-direct) m=1388 ;;
    fou-gre|gue-ipip|vxlan|geneve) m=1392 ;; *) echo "${2:-$ENG_MTU_MAX}"; return 0 ;;
  esac
  echo "$m"
}
shaped_raw_mtu() { # M1/M15: raw tier = 1400 minus the shape's fixed header (engine wat/mtuclamp_test.go pins these)
  local m
  case "$1" in
    sit|6to4) m=1360 ;; xfrm-ipsec) m=1392 ;; etherip) m=1384 ;; l2tpv3) m=1396 ;;
    *) echo "${2:-$ENG_MTU_MAX}"; return 0 ;;
  esac
  echo "$m"
}
shaped_real_name() { # F19 carrier -> the real protocol name the UI must say it is NOT
  case "$1" in
    sit) echo '6in4' ;; 6to4) echo '6to4' ;; xfrm-ipsec) echo 'IPsec/ESP' ;; etherip) echo 'EtherIP' ;;
    l2tpv3) echo 'L2TPv3' ;; fou-gre) echo 'FOu/GRE-in-UDP' ;; gue-ipip) echo 'GUE' ;; vxlan) echo 'VXLAN' ;;
    geneve) echo 'Geneve' ;; dnscrypt-udp) echo 'DNSCrypt' ;; ntp-direct) echo 'NTP' ;;
    openvpn-dco) echo 'OpenVPN DCO' ;; srtp-direct) echo 'SRTP' ;;
  esac
}
shaped_raw_proto() { # raw tier -> the IP protocol number it imitates
  case "$1" in sit|6to4) echo 41 ;; xfrm-ipsec) echo 50 ;; etherip) echo 97 ;; l2tpv3) echo 115 ;; esac
}
v_carrier_list() { # "icmp+udp" etc: every leg a known carrier, no duplicates; "auto" only alone; bond legs may
                   # carry a :up/:down direction suffix (3.3.9, both ends): :down is udp-only, the suffix is
                   # bond-only (a single carrier always carries both directions), a bond must keep at least
                   # one leg able to carry each direction, and a shaped carrier never takes a suffix (it
                   # cannot be a bond leg at all — D7, so the check runs on the stripped leg names)
  local v=${1:-} c base dir seen='' plain=0 saw_up=0 saw_down=0 bases=''
  [ -n "$v" ] || { err "Choose a carrier."; return 1; }
  if [ "$v" = auto ]; then return 0; fi
  case "$v" in *++*|+*|*+) err "Carrier list '$v' has an empty leg."; return 1 ;; esac
  case "$v" in
    *+*) # D7: the engine refuses shaped carriers in a bond in 3.3.0 (untested, per-protocol port defaults collide)
      for c in ${v//+/ }; do bases="${bases:+$bases+}$(carrier_leg_base "$c")"; done
      is_shaped_list "$bases" && { err "F19 shaped carriers are single-carrier only in 3.3.0; the engine refuses them in a '+'-bond ('$v')."; return 1; } ;;
    *) case "$v" in *:up|*:down) err "A :up/:down direction suffix only makes sense on a '+'-bond leg ('$v' alone would lose a direction)."; return 1 ;; esac ;;
  esac
  for c in ${v//+/ }; do
    base=$(carrier_leg_base "$c")
    carrier_ok "$base" || { err "Unknown carrier '$c' (use icmp, udp, tcp, tls, ws, wss, h2, h2c, grpc, gre, ipip, sit, 6to4, xfrm-ipsec, etherip, l2tpv3, fou-gre, gue-ipip, vxlan, geneve, dnscrypt-udp, ntp-direct, openvpn-dco, srtp-direct; join several with + to bond; a bond leg may end in :up or :down, 3.3.9 on both ends)."; return 1; }
    dir=$(carrier_leg_dir "$c")
    case "$dir" in
      down) [ "$base" = udp ] || { err "Carrier '$c': :down is udp-only in 3.3.9 (the engine refuses the rest)."; return 1; }
            saw_down=1 ;;
      up) saw_up=1 ;;
      *) plain=1 ;;
    esac
  done
  # a bond whose legs all point the same way has no leg left for the other direction (checked
  # before the duplicate pass so it names the real problem: :down is udp-only, so an all-:down
  # bond is also a duplicate-udp bond)
  if [ "$plain" = 0 ]; then
    [ "$saw_up" = 0 ] && { err "Carrier list '$v': every leg is :down, so nothing carries the uplink."; return 1; }
    [ "$saw_down" = 0 ] && { err "Carrier list '$v': every leg is :up, so nothing carries the downlink."; return 1; }
  fi
  for c in ${v//+/ }; do
    # dedupe on the BASE carrier like the engine does (cmd/wattun/main.go leg loop): udp:up+udp:down is two
    # different leg strings over one socket, and the engine exits 2 on it (docs/TECHNICAL.md "refused as a
    # duplicate udp") — the manager must refuse it too or it writes a config the tunnel cannot start with
    # (2026-11-20 review F1)
    local b
    b=$(carrier_leg_base "$c")
    case " $seen " in *" $b "*) err "Carrier '$b' appears twice in '$v' (a $c leg counts as its base)."; return 1 ;; esac
    seen="$seen $b"
  done
  return 0
}
shaped_supported_here() { # carrier list -> 0 when this host can run it, else prints why
  local c raw=0 shaped=0
  for c in ${1//+/ }; do
    is_shaped_carrier "$c" || continue
    shaped=1
    is_shaped_raw "$c" && raw=1
  done
  [ "$shaped" = 1 ] || return 0
  if [ "$raw" = 1 ] && [ "$(uname -s)" != Linux ]; then
    err "The raw-tier shaped carriers (sit, 6to4, xfrm-ipsec, etherip, l2tpv3) need Linux + root/CAP_NET_RAW on both ends (raw sockets); this server is not Linux."
    return 1
  fi
  if [ "$(bin_ver_ok 3.3.0)" != 1 ]; then
    err "F19 shaped carriers need wattun 3.3.0 or newer on BOTH ends; this server has ${VER:-an unknown version}. Run: $SELF update"
    return 1
  fi
  return 0
}
shaped_warn() { # carrier list : the wattun-internal warning (plus raw-tier and bond caveats) for the UI
  local c real='' raw=0 udp=0 bond=0 any=0 rawprotos='' udpports=''
  case "$1" in *+*) bond=1 ;; esac
  for c in ${1//+/ }; do
    is_shaped_carrier "$c" || continue
    any=1
    real="$real${real:+, }$(shaped_real_name "$c")"
    if is_shaped_raw "$c"; then raw=1; rawprotos="$rawprotos $(shaped_raw_proto "$c")"; else udp=1; udpports="$udpports${udpports:+, }$(shaped_udp_port "$c")"; fi
  done
  [ "$any" = 1 ] || return 0
  warn "F19 $([ "$bond" = 1 ] && echo 'leg(s)' || echo carrier) '$1': wattun-internal shape between two 3.3.0 peers, NOT real $real."
  hint "Both ends must run wattun 3.3.0+ and pick the SAME carrier name; it does not talk to the real $real protocol."
  [ "$raw" = 1 ] && hint "Raw tier: IP protocol ${rawprotos# } on a raw socket, Linux + root/CAP_NET_RAW on both ends, no listen port, no reverse, one session. Allow that protocol in the cloud firewalls."
  [ "$udp" = 1 ] && hint "UDP tier: Kharej listens on a random open UDP port (or --listen PORT; peer host:port). Open it in the Kharej cloud firewall."
  [ "$bond" = 1 ] && warn "3.3.0 refuses F19 shaped carriers in a '+'-bond; use a single shaped carrier instead."
  return 0
}
shaped_peer_for_client() { # carrier peer -> the peer form the engine wants (raw tier: bare host; UDP tier: host:port)
  local c=$1 p=$2 last
  if is_shaped_raw "$c"; then
    case "$p" in *:*) last=${p##*:}; v_port "$last" >/dev/null 2>&1 && p=${p%:*} ;; esac
    printf '%s' "$p"; return 0
  fi
  case "$p" in
    *:*) printf '%s' "$p" ;; # an explicit port wins (withDefaultPort)
    *) printf '%s:%s' "$p" "$(shaped_udp_port "$c")" ;;
  esac
}
# D7 (3.3.0): shaped carriers are single-carrier — the engine refuses them in a '+'-bond, so the manager has no
# per-leg listen-/peer- YAML writer any more (shaped_bond_yaml was removed with the 3.3.0 audit fix).
# Which address a connection to HOST leaves from, and the global IPv4 addresses this server holds (3.0.0). A server with
# two addresses sends the tunnel from the one the route picks, which can be the address the users connect to.
out_ip() {
  local ip
  ip=$(ip -4 route get "$1" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
  if [ -n "$ip" ]; then echo "$ip"; return 0; fi
  ip -6 route get "$1" 2>/dev/null | sed -n 's/.* src \([0-9a-fA-F:]*\).*/\1/p' | head -1
}
local_ips() { ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/,"",$4); print $4}'; }
# carriers whose reverse mode means: Iran listens on the carrier port and Kharej connects (tcp family) or punches (udp) to it
is_rpool() { is_pool "$1" || [ "$1" = udp ]; }
rproto() { # transport of the carrier port, for firewall and busy-port checks
  case "$1" in udp|fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) echo udp ;; *) echo tcp ;; esac
}
rev_capable() { [ "$1" = icmp ] || is_rpool "$1"; }
reverse_hint() { # [carrier]
  if [ "${1:-}" = udp ]; then
    hint "Reverse: Kharej sends first and Iran only answers. For filters that punish flows Iran starts."
    hint "Set it on both sides (wattun 3.0.0+)."
  elif is_pool "${1:-}"; then
    hint "Reverse: Kharej connects to Iran. For when Iran cannot reach Kharej's port, but Kharej can reach Iran."
    hint "Set it on both sides."
  else
    hint "Reverse: Kharej pings Iran. For a one-way block where Iran cannot ping Kharej."
    hint "Set it on both sides (wattun 2.0.0+)."
  fi
}
v_icmp() { case "$1" in echo|timestamp) return 0 ;; esac; err "Use echo or timestamp (Linux does not answer info/mask)."; return 1; }
v_mbps_adv() { case "$1" in -|0|default) return 0 ;; esac; v_mbps "$1"; }
v_mbps() { [ -z "$1" ] && return 0; [[ "$1" =~ ^[0-9]{1,4}$ ]] && [ "$1" -ge 1 ] && return 0; err "Enter a number of MB/s (1-9999)."; return 1; }
v_sessions() { # [count] [carrier] [reverse=1] : engine max 16, and >1 only one udp/pool carrier in forward mode
  local v=$1 car=${2:-} rev=${3:-0}
  [ -z "$v" ] && return 0
  case "$v" in -|0|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$v))" -ge 1 ] && [ "$((10#$v))" -le "$ENG_MAX_SESSIONS" ] || {
    err "Enter sessions count 1-$ENG_MAX_SESSIONS (or 0/default to unset)."; return 1; }
  [ "$((10#$v))" -gt 1 ] || return 0
  if [ "$rev" = 1 ]; then err "sessions > 1 does not work with reverse (the server dials one pool)."; return 1; fi
  if [ -n "$car" ] && ! sessions_carrier_ok "$car"; then
    err "sessions > 1 needs one udp/tcp/tls/ws/wss/h2/h2c/grpc carrier, not '$car' (bonds, icmp/gre/ipip and the F19 shapes run one session)."
    return 1
  fi
  return 0
}
v_conns() { [ -z "$1" ] && return 0; case "$1" in -|0|default) return 0 ;; esac; [[ "$1" =~ ^[0-9]{1,3}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le "$ENG_MAX_CONNS" ] && return 0; err "Enter conns count 1-$ENG_MAX_CONNS (the engine caps a pool at $ENG_MAX_CONNS; or 0/default to unset)."; return 1; }
v_mtu() { # [mtu] [carrier] : engine bound 256..1400, up to 16384 with a pool carrier (a bond uses its smallest leg)
  local hi=$ENG_MTU_MAX_POOL
  [ -n "${2:-}" ] && hi=$(mtu_max_for "$2")
  [ -z "$1" ] && return 0
  case "$1" in -|0|default) return 0 ;; esac
  [[ "$1" =~ ^[0-9]{3,5}$ ]] && [ "$((10#$1))" -ge "$ENG_MTU_MIN" ] && [ "$((10#$1))" -le "$hi" ] && return 0
  if [ -n "${2:-}" ]; then err "Enter MTU $ENG_MTU_MIN-$hi for carrier '$2' (or 0/default to unset)."
  else err "Enter MTU $ENG_MTU_MIN-$ENG_MTU_MAX_POOL (or 0/default to unset); without a pool carrier the engine caps it at $ENG_MTU_MAX."; fi
  return 1
}
v_num() { [[ "$1" =~ ^[0-9]+$ ]] && return 0; err "Enter a valid positive number."; return 1; }
v_bind() {
  local h=${1:-}; h=${h#[}; h=${h%]}
  if [ "$h" = "::" ] || ipv4_ok "$h" || ipv6_ok "$h"; then return 0; fi
  err "Enter an IPv4 or IPv6 address such as 0.0.0.0, :: (dual-stack) or 10.0.0.5."; return 1
}
v_fec() { case "$1" in off|auto) return 0 ;; esac; err "Use off or auto."; return 1; }
# A3: stable engine knobs as first-class rows. -win-max is an Int clamped by the engine to 4..64 MB (0 = auto-tuned
# from host RAM, 3.0.3); -loss-ceiling is a bool opt-in (3.0.0). A value the engine would clamp must not be written.
v_win_max() { # MB, 4..64; empty/-/0/default = unset (engine auto)
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|0|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$v))" -ge 4 ] && [ "$((10#$v))" -le 64 ] && return 0
  err "Enter the per-stream window cap in MB (4-64), or 0/- for the engine's auto value."
  return 1
}
v_loss_ceiling() { # on/off (also true/false/1/0); off is the engine default
  case "${1:-}" in off|false|0|default|'') return 0 ;; on|true|1) return 0 ;; esac
  err "Use on or off."
  return 1
}
# A2: the wizard's FEC prompt keeps off|auto and adds `a` = auto plus open the loss-band rows after creation. Parsed by a
# pure helper so the three answers and the old-engine fallback are table-testable. On an engine older than 3.3.0 the
# band keys do not exist (unknown key stops startup), so `a` falls back to plain auto with the update hint.
REPLY_FEC_BAND=0; REPLY_FEC_OLD=0
fec_choice() { # raw answer -> REPLY_V (off|auto), REPLY_FEC_BAND (1 = open the band rows), REPLY_FEC_OLD (1 = asked on old engine)
  local v=${1:-}
  REPLY_FEC_BAND=0; REPLY_FEC_OLD=0
  case "$v" in
    ''|off|default) REPLY_V=off ;;
    auto) REPLY_V=auto ;;
    a|A)
      if [ -n "$(bin_ver_ok 3.3.0)" ]; then REPLY_V=auto; REPLY_FEC_BAND=1
      else REPLY_V=auto; REPLY_FEC_OLD=1; fi ;;
    *) err "Use off, auto or a."; return 1 ;;
  esac
  return 0
}
ask_fec() { # [default] : wizard FEC prompt; interactive answer a also opens the band rows
  local def=${1:-off}
  if [ "$NONINTERACTIVE" = 1 ]; then fec_choice "$def" || return 1; return 0; fi
  hint "auto sends parity only while loss is above 2 %; a here lets you tune the band."
  ask "FEC: off, auto, or a (auto + open the loss-band rows)" "$def"
  fec_choice "$REPLY_V" || return 1
  [ "$REPLY_FEC_OLD" = 1 ] && hint "The FEC loss band needs wattun 3.3.0 on this server (run: $SELF update); using auto with engine defaults."
  return 0
}
# -fec-on-loss/-fec-off-loss (F11, 3.3.0): percentages. The engine (cmd/wattun/fecgate.go) requires 0 < on <= 50 and
# 0 <= off < on; an invalid band stops the tunnel at startup, so the same check runs here before the key is written.
v_fec_on() { # value [current-off] : 0 < value <= 50 and above the off threshold
  local v=${1:-} off=${2:-0.5}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}(\.[0-9]+)?$ ]] || { err "Enter a loss percentage above 0 and at most 50 (for example 2 or 0.5)."; return 1; }
  awk -v v="$v" -v o="$off" 'BEGIN{exit !(v > 0 && v <= 50 && v > o)}' \
    || { err "fec-on-loss must be above 0, at most 50 and above fec-off-loss ($off)."; return 1; }
  return 0
}
v_fec_off() { # value [current-on] : 0 <= value < on threshold
  local v=${1:-} on=${2:-2}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}(\.[0-9]+)?$ ]] || { err "Enter 0 or a loss percentage (for example 0.5 or 2)."; return 1; }
  awk -v v="$v" -v n="$on" 'BEGIN{exit !(v >= 0 && v < n)}' \
    || { err "fec-off-loss must be 0 or more and below fec-on-loss ($on)."; return 1; }
  return 0
}
# -state-dir/-state-save (F8, 3.3.0): the engine needs an existing-or-creatable directory (it creates 0700 and probes
# writability at startup) and a whole number of seconds >= 0.
v_state_dir() { # absolute directory, or empty/-/default for the engine default (next to the config)
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|default|0) return 0 ;; esac
  [[ "$v" =~ ^/[A-Za-z0-9._/-]*$ ]] || { err "Enter an absolute directory such as /run/wattun (no spaces), or - for the default next to the config."; return 1; }
  case "/${v#/}/" in */../*) err "The state directory cannot contain '..'."; return 1 ;; esac
  [ "${#v}" -le 200 ] || { err "That path is too long (200 characters at most)."; return 1; }
  case "$v" in # H1: the shipped unit only makes /run/wattun writable (RuntimeDirectory + ReadWritePaths)
    /run/wattun|/run/wattun/*|/etc/wattun|/etc/wattun/*) ;;
    *) warn "The shipped systemd unit only guarantees writes under /run/wattun; add '$v' to its ReadWritePaths or the engine stops at startup." ;;
  esac
  [ -e "$v" ] && [ ! -d "$v" ] && { err "$v exists and is not a directory."; return 1; }
  [ -d "$v" ] && [ ! -w "$v" ] && { err "$v is not writable; wattun would fail at startup (the shipped unit only makes /run/wattun writable via RuntimeDirectory)."; return 1; }
  return 0
}
v_state_save() { # whole seconds 0..2592000 (0 = only on shutdown); mirrors stateSaveInterval's cap
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,7}$ ]] && [ "$((10#$v))" -le 2592000 ] && return 0
