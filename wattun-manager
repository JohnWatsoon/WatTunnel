at_choose() { # rc 0 = chosen (T_* ready), 1 = cancelled
  local n=${#AT_RANK[@]} best=${AT_RANK[0]} bond=() rbond=() i num rest bd bu can_join=0 jd_n=0 jr_n=0
  for i in "${AT_RANK[@]}"; do
    case "${AV_CAR[$i]}" in *+*) continue ;; esac
    is_shaped_carrier "${AV_CAR[$i]}" && continue # B4: shaped carriers are single-carrier only
    if [ "${AV_KIND[$i]}" = d ] && ! av_anti "$i"; then bond+=("$i")
    elif [ "${AV_KIND[$i]}" = r ]; then rbond+=("$i"); fi
  done
  at_joinable_summary
  jd_n=$(wc -w <<<"$AT_JD"); jr_n=$(wc -w <<<"$AT_JR")
  { [ "$jd_n" -ge 2 ] || [ "$jr_n" -ge 2 ]; } && can_join=1
  if [ "$NONINTERACTIVE" = 1 ]; then # --pick best (default) | bond | rbond | N | N,N...
    local def_pick="best"
