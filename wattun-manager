TI_STATE=stopped; TI_RTT=0; TI_STREAMS=0; TI_SESS=0; TI_IN=0; TI_OUT=0; TI_RATE=0; TI_RAW=''
TI_CAR_COUNT=0; TI_CAR_ALIVE=0; TI_CAR_MUTED=0
CAR_COUNT=0; CAR_NAME=(); CAR_ALIVE=(); CAR_RTT=(); CAR_LOSS=(); CAR_SHARE=(); CAR_MUTED=()
parse_carriers() { # json
  local json=$1 carr_block item
  CAR_COUNT=0; CAR_NAME=(); CAR_ALIVE=(); CAR_RTT=(); CAR_LOSS=(); CAR_SHARE=(); CAR_MUTED=()
  carr_block=$(grep -o '"carriers": *\[[^]]*\]' <<<"$json" | head -1)
  [ -n "$carr_block" ] || return 0
  while read -r item; do
    [ -n "$item" ] || continue
    local nm al rtt ls sh mu
    nm=$(grep -o '"name": *"[^"]*"' <<<"$item" | head -1 | cut -d'"' -f4)
    al=$(grep -o '"alive": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    rtt=$(grep -o '"srtt_ms": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    ls=$(grep -o '"loss": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    sh=$(grep -o '"share": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    mu=$(grep -o '"muted": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    CAR_NAME+=("${nm:-unknown}")
    CAR_ALIVE+=("${al:-false}")
    CAR_RTT+=("${rtt:-0}")
    CAR_LOSS+=("${ls:-0}")
    CAR_SHARE+=("${sh:-0}")
    CAR_MUTED+=("${mu:-false}")
    CAR_COUNT=$((CAR_COUNT+1))
  done < <(grep -o '{[^{}]*}' <<<"$carr_block")
}
TI_MIN_RTT=0; TI_LOSS=0; TI_DGRAM_FLOWS=0; TI_LIVE_PICK=''
tinfo() { # name -> TI_*  (state: up | degraded | down | standby | unknown | stopped), TI_WHY says why when it is not obvious
  local par='' s='' on=0 miss=0
  TI_STATE=stopped; TI_RTT=0; TI_MIN_RTT=0; TI_LOSS=0; TI_STREAMS=0; TI_SESS=0; TI_DGRAM_FLOWS=0
  TI_IN=0; TI_OUT=0; TI_RATE=0; TI_RAW=''; TI_WHY=''; TI_LIVE_PICK=''
  TI_CAR_COUNT=0; TI_CAR_ALIVE=0; TI_CAR_MUTED=0; TI_LIVE=$(cfg "$1" carrier); TI_AUTO=0
  par=$(companion_of "$1")
  if [ -n "$par" ]; then
    TI_AUTO=1
    systemctl is-active -q "${WAT_PREFIX}@$1" 2>/dev/null && on=1
    [ "$on" = 1 ] || return 0
    TI_RAW=$(stats "$1") || TI_RAW=$(stats "$1") || TI_RAW=''
    if [ -z "$TI_RAW" ]; then TI_STATE=unknown; TI_WHY='stats did not answer, status not known'; return 0; fi
    if [ "$(jget "$TI_RAW" alive)" = true ]; then TI_STATE=up
    else
      s=$(stats "$par") || s=$(stats "$par") || true
      if [ "$(jget "$s" alive)" = true ]; then TI_STATE=standby; TI_WHY="not in use, Iran is connected through $par"
      else TI_STATE=down; fi
    fi
  elif is_auto_kharej "$1"; then
    TI_AUTO=1
    local u any_up=0 sum_in=0 sum_out=0 sum_rate=0 sum_sess=0 sum_str=0 sum_df=0
    local best_rtt='' best_mr=0 best_ls=0 primary_raw='' live_pick=''
    local u_in u_out u_rate u_sess u_str u_df u_al u_rtt u_mr u_ls ulive one c j
    local -a units=("$1") m_name=() m_alive=() m_rtt=() m_loss=() m_share=() m_muted=()
    while IFS= read -r u; do [ -n "$u" ] && units+=("$u"); done < <(auto_helpers "$1")
    for u in "${units[@]}"; do
      systemctl is-active -q "${WAT_PREFIX}@$u" 2>/dev/null || continue
      on=1
      if [ "$u" = "$1" ] || [ "$u" = "$1-r" ]; then
        s=$(stats "$u") || s=$(stats "$u") || { miss=$((miss+1)); continue; }
        [ -n "$s" ] || { miss=$((miss+1)); continue; } # silent stats port: treat as unknown, not down
      else
        s=$(stats_flat "$u") || s=$(stats_flat "$u") || { miss=$((miss+1)); continue; }
      fi
      [ -n "$primary_raw" ] || primary_raw=$s
      u_in=$(jget "$s" bytes_in_total); u_out=$(jget "$s" bytes_out_total)
      [ -n "$u_in" ] || { u_in=$(jget "$s" bytes_in); u_out=$(jget "$s" bytes_out); }
      u_rate=$(jget "$s" rate_bps); u_sess=$(jget "$s" sessions)
      u_str=$(jget_flat "$s" streams_total streams); u_df=$(jget "$s" dgram_flows)
      sum_in=$(awk -v a="$sum_in" -v b="${u_in:-0}" 'BEGIN{printf "%.0f", a+b}')
      sum_out=$(awk -v a="$sum_out" -v b="${u_out:-0}" 'BEGIN{printf "%.0f", a+b}')
      sum_rate=$(awk -v a="$sum_rate" -v b="${u_rate:-0}" 'BEGIN{printf "%.0f", a+b}')
      sum_sess=$(( sum_sess + ${u_sess:-0} ))
      sum_str=$(( sum_str + ${u_str:-0} ))
      sum_df=$(( sum_df + ${u_df:-0} ))
      u_al=$(jget "$s" alive)
      if [ "$u_al" = true ] || { [ "${u_sess:-0}" -gt 0 ] 2>/dev/null; }; then
        [ "$u_al" = true ] && { any_up=1; primary_raw=$s; }
        u_rtt=$(jget_flat "$s" rtt_ms srtt_ms); u_mr=$(jget "$s" min_rtt_ms); u_ls=$(jget "$s" loss_pct)
        awk -v r="${u_rtt:-0}" 'BEGIN{exit !(r < 0.5)}' && u_rtt=${u_mr:-0}
        if [ -z "$best_rtt" ] || awk -v a="${u_rtt:-0}" -v b="$best_rtt" 'BEGIN{exit !(a > 0 && (b <= 0 || a < b))}'; then
          best_rtt=${u_rtt:-0}; best_mr=${u_mr:-0}; best_ls=${u_ls:-0}
        fi
        if [ "$u" = "$1" ]; then
          ulive=$({ grep -o '"clients": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep -o '"carrier": *"[^"]*"' | cut -d'"' -f4
            grep -o '"carriers": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep '"alive": *true' | grep -o '"name": *"[^"]*"' | cut -d'"' -f4
          } | sed '/^$/d' | sort -u)
          if [ -z "$ulive" ]; then
            one=$(cfg "$u" carrier); case "$one" in *+*|'') ;; *) ulive=$one ;; esac
          fi
          for c in $ulive; do live_pick+="${live_pick:++}$c"; done
          parse_carriers "$s"
          for ((j=0; j<CAR_COUNT; j++)); do
            if [ "${CAR_ALIVE[$j]}" = true ] || [ "${CAR_MUTED[$j]}" = true ]; then
              m_name+=("${CAR_NAME[$j]}"); m_alive+=("${CAR_ALIVE[$j]}"); m_rtt+=("${CAR_RTT[$j]}")
              m_loss+=("${CAR_LOSS[$j]}"); m_share+=("${CAR_SHARE[$j]}"); m_muted+=("${CAR_MUTED[$j]}")
            fi
          done
        elif [ "$u" = "$1-r" ]; then
          ulive=$(grep -o '"carriers": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep '"alive": *true' | grep -o '"name": *"[^"]*"' | cut -d'"' -f4 | sort -u)
          if [ -z "$ulive" ]; then
            one=$(cfg "$u" carrier); case "$one" in *+*|'') ;; *) ulive=$one ;; esac
          fi
          for c in $ulive; do live_pick+="${live_pick:++}r:$c"; done
          parse_carriers "$s"
          for ((j=0; j<CAR_COUNT; j++)); do
            if [ "${CAR_ALIVE[$j]}" = true ] || [ "${CAR_MUTED[$j]}" = true ]; then
              m_name+=("r:${CAR_NAME[$j]}"); m_alive+=("${CAR_ALIVE[$j]}"); m_rtt+=("${CAR_RTT[$j]}")
              m_loss+=("${CAR_LOSS[$j]}"); m_share+=("${CAR_SHARE[$j]}"); m_muted+=("${CAR_MUTED[$j]}")
            fi
          done
        else
          c=${u#"$1"-e-}
          live_pick+="${live_pick:++}$c"
          m_name+=("$c"); m_alive+=(true); m_rtt+=("${u_rtt:-0}")
          m_loss+=("$(awk -v l="${u_ls:-0}" 'BEGIN{printf "%.4f", l/100}')")
          m_share+=(1); m_muted+=(false)
        fi
      fi
    done
    [ "$on" = 1 ] || return 0
    if [ "$any_up" = 1 ]; then TI_STATE=up; TI_WHY=''
    elif [ "$miss" -gt 0 ]; then TI_STATE=unknown; TI_WHY='stats did not answer, status not known'; return 0
    else TI_STATE=down; fi
    TI_RAW=$primary_raw
    TI_IN=$sum_in; TI_OUT=$sum_out; TI_RATE=$sum_rate; TI_SESS=$sum_sess; TI_STREAMS=$sum_str; TI_DGRAM_FLOWS=$sum_df
    TI_RTT=${best_rtt:-0}; TI_MIN_RTT=${best_mr:-0}; TI_LOSS=${best_ls:-0}
    TI_LIVE_PICK=$live_pick
    TI_LIVE=${live_pick:-$(cfg "$1" carrier)}
    CAR_NAME=("${m_name[@]+"${m_name[@]}"}"); CAR_ALIVE=("${m_alive[@]+"${m_alive[@]}"}")
    CAR_RTT=("${m_rtt[@]+"${m_rtt[@]}"}"); CAR_LOSS=("${m_loss[@]+"${m_loss[@]}"}")
    CAR_SHARE=("${m_share[@]+"${m_share[@]}"}"); CAR_MUTED=("${m_muted[@]+"${m_muted[@]}"}")
    CAR_COUNT=${#CAR_NAME[@]}; TI_CAR_COUNT=$CAR_COUNT
    return 0
  else
    local other=''
    [ "$(companion_of "$1-r")" = "$1" ] && other=$1-r
    systemctl is-active -q "${WAT_PREFIX}@$1" 2>/dev/null && on=1
    if [ -n "$other" ] && systemctl is-active -q "${WAT_PREFIX}@$other" 2>/dev/null; then
      s=$(stats "$other") || s=$(stats "$other") || miss=1
    fi
    if [ "$on" = 1 ]; then
      TI_RAW=$(stats "$1") || TI_RAW=$(stats "$1") || TI_RAW=''
      if [ -z "$TI_RAW" ]; then TI_STATE=unknown; TI_WHY='stats did not answer, status not known'; return 0; fi
    elif [ -z "$par" ] && [ -n "$s" ]; then TI_RAW=$s
    elif [ -z "$par" ] && [ "$miss" = 1 ]; then TI_STATE=unknown; TI_WHY="$other stats did not answer, status not known"; return 0
    else return 0; fi
    if [ "$on" = 1 ] && [ "$(jget "$TI_RAW" alive)" = true ]; then TI_STATE=up
    elif [ "$miss" = 1 ]; then TI_STATE=unknown; TI_WHY="$other stats did not answer, status not known"
    elif [ "$(jget "$s" alive)" != true ]; then TI_STATE=down
    elif [ -n "$par" ]; then TI_STATE=standby; TI_WHY="not in use, Iran is connected through $par"
    else TI_STATE=up; TI_RAW=$s; TI_WHY="Iran is connected through $other"; fi
  fi
  TI_RTT=$(jget_flat "$TI_RAW" rtt_ms srtt_ms); TI_MIN_RTT=$(jget "$TI_RAW" min_rtt_ms); TI_LOSS=$(jget "$TI_RAW" loss_pct)
  TI_STREAMS=$(jget_flat "$TI_RAW" streams_total streams); TI_SESS=$(jget "$TI_RAW" sessions); TI_DGRAM_FLOWS=$(jget "$TI_RAW" dgram_flows)
  TI_IN=$(jget "$TI_RAW" bytes_in_total); TI_OUT=$(jget "$TI_RAW" bytes_out_total); TI_RATE=$(jget "$TI_RAW" rate_bps)
  [ -n "$TI_IN" ] || { TI_IN=$(jget "$TI_RAW" bytes_in); TI_OUT=$(jget "$TI_RAW" bytes_out); } # before 2.4.19: since the last restart
  awk -v r="${TI_RTT:-0}" 'BEGIN{exit !(r < 0.5)}' && TI_RTT=${TI_MIN_RTT:-0} # a server between samples reports srtt 0
  : "${TI_RTT:=0}" "${TI_MIN_RTT:=0}" "${TI_LOSS:=0}" "${TI_STREAMS:=0}" "${TI_SESS:=0}" "${TI_DGRAM_FLOWS:=0}" "${TI_IN:=0}" "${TI_OUT:=0}" "${TI_RATE:=0}"
  parse_carriers "$TI_RAW"
  TI_CAR_COUNT=$CAR_COUNT
  if [ "$CAR_COUNT" -gt 0 ]; then
    local j; TI_LIVE=''
    for ((j=0; j<CAR_COUNT; j++)); do [ "${CAR_ALIVE[$j]}" = true ] && TI_LIVE+="${TI_LIVE:++}${CAR_NAME[$j]}"; done
  fi
  if [ "$TI_STATE" = up ] && [ "$CAR_COUNT" -gt 0 ] && [ "$TI_AUTO" = 0 ]; then
    local i unmuted_live=0 unmuted_total=0
    for ((i=0; i<CAR_COUNT; i++)); do
      if [ "${CAR_MUTED[$i]}" = true ]; then
        TI_CAR_MUTED=$((TI_CAR_MUTED+1))
      else
        unmuted_total=$((unmuted_total+1))
        [ "${CAR_ALIVE[$i]}" = true ] && unmuted_live=$((unmuted_live+1))
      fi
    done
    TI_CAR_ALIVE=$unmuted_live
    if [ "$unmuted_total" -gt 1 ] && [ "$unmuted_live" -lt "$unmuted_total" ]; then
      TI_STATE=degraded; TI_WHY="$((unmuted_total - unmuted_live)) of $unmuted_total carriers down"
    fi
  fi
}
SC_COL=''; SC_TXT=''; SC_DOT='●'
state_cell() { # role state
  case "$2" in
    up) SC_COL=$GRN; SC_DOT='●'; SC_TXT=up ;;
    degraded) SC_COL=$YEL; SC_DOT='◐'; SC_TXT=partial ;;
    standby) SC_COL=$GRY; SC_DOT='◌'; SC_TXT=standby ;;
    unknown) SC_COL=$YEL; SC_DOT='◐'; SC_TXT=unknown ;;
    down) SC_COL=$RED; SC_DOT='○'; if [ "$1" = Kharej ]; then SC_TXT=waiting; else SC_TXT=down; fi ;;
    *) SC_COL=$GRY; SC_DOT='◌'; SC_TXT=stopped ;;
  esac
}
ports_summary() { # name [maxlen] -> "443 · 8443→443 · 53/udp"
  local n=$1 max=${2:-50} out='' piece it cnt=0 total=0
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    total=$((total+1))
    piece=$(spec_human "$it")
    [ "$(role "$n")" = Kharej ] && { piece=$(spec_T "$it"); [ "$(spec_P "$it")" = udp ] && piece="$piece/udp"; }
    if [ $(( ${#out} + ${#piece} + 5 )) -gt "$max" ]; then continue; fi
    out="${out:+$out · }$piece"; cnt=$((cnt+1))
  done < <(yml_maps "$n")
  if [ "$total" -eq 0 ]; then [ "$(role "$n")" = Kharej ] && echo "any port" || echo "no ports yet"; return; fi
  [ "$cnt" -lt "$total" ] && out="$out +$((total-cnt))"
  echo "$out"
}

