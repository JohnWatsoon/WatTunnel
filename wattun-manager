# ======================================================================================
#  Bond auto-retest (F10): re-test the carriers of a bond on a schedule and add one back
#  when it works again (a censor can block one leg of a bond for hours and then clear it).
#  Settings live in the $CONF/NAME.bondretest sidecar, never in NAME.yml: the engine
#  rejects unknown YAML keys and only ports:/limits: hot-reload.
# ======================================================================================
BONDRETEST_BUDGET_MB=20 # traffic budget of one run, .manager.conf key bondretest-budget
bond_is_bond() { case "${1:-}" in *+*) return 0 ;; esac; return 1; }
bond_retest_visible() { # role carrier -> 0 when the setting belongs on this tunnel (a bonded Iran client)
  [ "${1:-}" = Iran ] && bond_is_bond "${2:-}"
}
bondretest_ok() { # value -> the stored form (off|30m|1h|6h|daily-offpeak) ; rc 1 on anything else
  case "${1,,}" in
    off|0|none|never) echo off ;;
    30m|30min|half-hour) echo 30m ;;
    1h|60m|hourly) echo 1h ;;
    6h|360m) echo 6h ;;
    daily-offpeak|daily|offpeak|off-peak) echo daily-offpeak ;;
    *) return 1 ;;
  esac
}
v_bondretest() { # validator for ask_ok: normalizes the value into REPLY_V
  local v
  v=$(bondretest_ok "$1") || { err "Use off, 30m, 1h, 6h or daily-offpeak."; return 1; }
  REPLY_V=$v; return 0
}
bondretest_get() { # name -> stored value (off when the sidecar is missing or unreadable)
  local v=''
  [ -f "$CONF/$1.bondretest" ] && v=$(head -1 "$CONF/$1.bondretest" 2>/dev/null | tr -d '[:space:]')
  bondretest_ok "${v:-off}" || echo off
}
bondretest_set_file() { # name value : write the sidecar atomically, like every other state file here
  local n=$1 v
  v=$(bondretest_ok "$2") || return 1
  ( umask 077; printf '%s\n' "$v" >"$CONF/$n.bondretest.tmp" ) && mv -f "$CONF/$n.bondretest.tmp" "$CONF/$n.bondretest"
}
bondretest_timer_lines() { # value -> the [Timer] lines (pure; the self-test pins every schedule)
  case "$1" in
    30m) printf 'OnBootSec=5min\nOnUnitActiveSec=30min\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    1h)  printf 'OnBootSec=5min\nOnUnitActiveSec=1h\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    6h)  printf 'OnBootSec=5min\nOnUnitActiveSec=6h\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    daily-offpeak) printf 'OnCalendar=*-*-* 04:15:00\nRandomizedDelaySec=300\nPersistent=true\n' ;;
  esac
}
bondretest_unit() { echo "${WAT_PREFIX}-bondretest-$1"; }
bond_retest_enable() { # name value : write the oneshot unit + timer and enable them
  local n=$1 v u mgr=/usr/local/bin/wattun-manager
  v=$(bondretest_ok "$2") || return 1
  [ "$SANDBOX" = 1 ] && mgr=$MGR
  u=$(bondretest_unit "$n")
  {
    printf '[Unit]\nDescription=WatTunnel bond carrier re-test for %s%s\n[Service]\nType=oneshot\n' "$n" "$([ "$SANDBOX" = 1 ] && echo " (sandbox $WAT_PREFIX)")"
    unit_env_lines
    printf 'ExecStart=%s bond-retest %s --yes\n' "$mgr" "$n"
  } >"/etc/systemd/system/$u.service"
  {
    printf '[Unit]\nDescription=WatTunnel bond carrier re-test for %s (%s)\n[Timer]\n' "$n" "$v"
    bondretest_timer_lines "$v"
    printf '[Install]\nWantedBy=timers.target\n'
  } >"/etc/systemd/system/$u.timer"
  chmod 644 "/etc/systemd/system/$u.service" "/etc/systemd/system/$u.timer"
  systemctl daemon-reload && systemctl enable --now "$u.timer" >/dev/null 2>&1
}
bond_retest_disable() { # name : stop and remove the timer (toggling the setting off or deleting the tunnel)
  local u; u=$(bondretest_unit "$1")
  systemctl disable --now "$u.timer" >/dev/null 2>&1
  rm -f "/etc/systemd/system/$u.service" "/etc/systemd/system/$u.timer"
  systemctl daemon-reload >/dev/null 2>&1
  return 0
}
bond_retest_set() { # name value : store the setting and install/remove its timer
  local n=$1 v
  v=$(bondretest_ok "$2") || { err "Use off, 30m, 1h, 6h or daily-offpeak."; return 1; }
  bond_retest_visible "$(role "$n")" "$(cfg "$n" carrier)" \
    || { err "Bond auto-retest applies to a bonded tunnel on Iran (carrier list with '+'), not '$n'."; return 1; }
  bondretest_set_file "$n" "$v" || { err "Could not write $CONF/$n.bondretest."; return 1; }
  if [ "$v" = off ]; then bond_retest_disable "$n"; ok "Bond auto-retest off for '$n'."
  elif bond_retest_enable "$n" "$v"; then ok "Bond auto-retest for '$n': $v."
  else err "Could not install the bond-retest timer."; return 1; fi
  return 0
}
bond_candidates_plan() { # bond-carriers plan-d token-peer -> "carrier peer" for every planned carrier the bond lacks
  # An auto tunnel's token lists what Kharej listens on, so a carrier that failed at auto-test time is known even
  # though the chosen bond never had a peer-<carrier> line for it. icmp has no listen port: it uses the bare peer.
  # H4 (2026-11-04): the engine refuses a shaped carrier inside a '+' bond (D7), and a bare raw plan entry has no
  # ':<port>' to probe. Both are skipped here rather than written into a bond the engine would reject.
  local cur=" ${1//+/ } " pd=$2 addr=$3 c p out=''
  case "$cur" in *" icmp "*) ;; *) out="icmp $addr" ;; esac
  for x in ${pd//,/ }; do
    c=${x%%:*}; p=${x##*:}
    case "$cur" in *" $c "*) continue ;; esac
    is_shaped_carrier "$c" && continue
    case "$p" in ''|*[!0-9]*) continue ;; esac
    [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || continue
    out="${out:+$out
}$c $addr:$p"
  done
  printf '%s' "$out"
}
bond_peer_for() { # name carrier -> address for a throw-away probe (config peer-<carrier>, the auto plan, else peer)
  local n=$1 c=$2 p='' addr pd
  p=$(cfg "$n" "peer-$c"); [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  addr=$(cfg "$n" peer)
  if [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ]; then
    pd=$(plan_part "$T_AUTO" d); p=$(plan_port "$pd" "$c")
    if [ -n "$p" ] && [ "$c" != icmp ]; then printf '%s' "$T_PEER:$p"; return 0; fi
    addr=$T_PEER
  fi
  printf '%s' "$addr"
}
bondfail_get() { # name -> stored failures, comma separated (empty when none)
  local v=''
  [ -f "$CONF/$1.bondfail" ] && v=$(head -1 "$CONF/$1.bondfail" 2>/dev/null | tr -d '[:space:]')
  [ "$v" = none ] && v=''
  printf '%s' "${v%,}"
}
bondfail_set() { # name list : store the carriers to retry next run
  local n=$1 v=${2:-}
  ( umask 077; printf '%s\n' "${v:-none}" >"$CONF/$n.bondfail.tmp" ) && mv -f "$CONF/$n.bondfail.tmp" "$CONF/$n.bondfail"
}
bondfail_next() { # prev-failures carrier tested failing -> the list the next run retries
  # Only carriers outside the bond are remembered: a leg that is in the bond is probed on every run anyway, so
  # remembering it would just duplicate work. prev/testing/failing accept spaces or commas; carrier is a+b.
  local old=$1 car=${2//+/ } tested=$3 failing=$4 out='' x
  for x in ${tested//,/ }; do
    case " $car " in *" $x "*) continue ;; esac
    case " $failing " in *" $x "*) out="${out:+$out,}$x" ;; esac
  done
  for x in ${old//,/ }; do
    case " $car " in *" $x "*) continue ;; esac
    case " $tested " in *" $x "*) continue ;; esac
    case ",$out," in *",$x,"*) continue ;; esac
    out="${out:+$out,}$x"
  done
  printf '%s' "$out"
}
bond_worth() { # candidate-score best-leg-score -> 0 when adding this carrier is measurable value
  # A working carrier is always worth adding when no leg of the bond works right now; otherwise it must reach 10 %
  # of the best working leg's throughput, so a barely-alive path does not enlarge the bond.
  awk -v c="${1:-0}" -v b="${2:-0}" 'BEGIN{ if (c <= 0) exit 1; if (b <= 0) exit 0; exit !(c >= b*0.1) }'
}
bond_budget_fit() { # candidates budget-mb -> how many fit (1 MB each way per candidate)
  local max=$((${2:-$BONDRETEST_BUDGET_MB} / 2))
  [ "$max" -lt 1 ] && max=1
  [ "$1" -gt "$max" ] && echo "$max" || echo "$1"
}
bond_retest_job() { # name : probe the bond's carriers + the last failures, add one that works now
  local n=$1 cur cur_sp prev pd='' auto=0 pair pairs=() budget nfit c peer path sni icmp fp ech frag fs fm
  local best=0 score added='' failed='' tested=' ' total=0 i=0 npairs
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  [ "$(role "$n")" = Iran ] || { err "Bond auto-retest runs on Iran (the side that dials the bond), not on Kharej."; return 1; }
  cur=$(cfg "$n" carrier)
  bond_retest_visible Iran "$cur" || { err "'$n' is not bonded (carrier '$cur' has no '+'); nothing to re-test."; return 1; }
  is_reverse "$n" && { err "Bond auto-retest does not support a reverse bond: Kharej is the dialing side there."; return 1; }
  cur_sp=${cur//+/ }
  prev=$(bondfail_get "$n")
  # Candidates: the bond's legs, every carrier the auto plan left out (known from Iran's NAME.auto token), then the
  # stored failures. A carrier that works again is only added, never swapped in: a bond leg is never removed here.
  if [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ]; then
    auto=1; pd=$(plan_part "$T_AUTO" d)
  fi
  for c in $cur_sp; do pairs+=("$c $(bond_peer_for "$n" "$c")"); done
  if [ "$auto" = 1 ]; then
    while IFS= read -r pair; do [ -n "$pair" ] && pairs+=("$pair"); done < <(bond_candidates_plan "$cur" "$pd" "$T_PEER")
  fi
  for c in ${prev//,/ }; do
    case " $cur_sp " in *" $c "*) continue ;; esac
    case " ${pairs[*]} " in *" $c "*) continue ;; esac
    pairs+=("$c $(bond_peer_for "$n" "$c")")
  done
  budget=$(conf_get bondretest-budget "$BONDRETEST_BUDGET_MB")
  [[ "$budget" =~ ^[0-9]+$ ]] && [ "$budget" -gt 0 ] || budget=$BONDRETEST_BUDGET_MB
  npairs=${#pairs[@]}
  nfit=$(bond_budget_fit "$npairs" "$budget")
  [ "$nfit" -lt "$npairs" ] && logger -t wattun-bondretest "$n: traffic budget ${budget} MB, probing $nfit of $npairs carriers"
  # Probes are throw-away clients (the at_* machinery) with this tunnel's key and settings: the live bond is untouched.
  path=$(cfg "$n" path); sni=$(cfg "$n" sni); icmp=$(cfg "$n" icmp-type)
  fp=$(cfg "$n" fp); ech=$(cfg "$n" ech); frag=$(cfg "$n" tls-frag)
  fs=$(cfg "$n" fake-sni); fm=$(cfg "$n" fake-mode)
  AT_DIR=$AUTO_RUN/bondretest.$$
  AT_QUIET=1; AT_KEYS=0; AT_MB=1; AT_STOP=0; AT_ACT=''; AT_SKIP=''
  mkdir -p "$AUTO_RUN" && chmod 700 "$AUTO_RUN" && rm -rf "$AT_DIR" && mkdir -p "$AT_DIR" \
    || { err "Could not prepare $AUTO_RUN."; return 1; }
  cp -f "$CONF/$n.key" "$AT_DIR/key" 2>/dev/null || { ( umask 077; cat "$CONF/$n.key" >"$AT_DIR/key" ); }
  chmod 600 "$AT_DIR/key" 2>/dev/null
  T_PATH=${path:-/wat}; T_SNI=$sni; T_ICMP=$icmp
  for pair in "${pairs[@]}"; do
    i=$((i+1)); [ "$i" -le "$nfit" ] || break
    c=${pair%% *}; peer=${pair#* }
    AV_LABEL=("$c"); AV_CAR=("$c"); AV_KIND=(d); AV_PEER=("$peer"); AV_PORT=('')
    AV_SNI=(''); AV_FP=(''); AV_ECH=(''); AV_FRAG=(''); AV_FS=(''); AV_FM=(''); AV_X=('')
    if is_pool "$c"; then AV_SNI=("$sni"); AV_FP=("$fp"); AV_ECH=("$ech"); AV_FRAG=("$frag"); AV_FS=("$fs"); AV_FM=("$fm"); fi
    at_probe 0 8
    tested+="$c "; total=$((total + 2 * AT_MB))
    case " $cur_sp " in *" $c "*) # a bond leg: never removed, only its speed sets the bar for a new path
      if [ "${AR_OK[0]}" = 1 ]; then
        score=$(at_score 0)
        best=$(awk -v a="$best" -v b="$score" 'BEGIN{print (b>a)?b:a}')
        logger -t wattun-bondretest "$n/$c (in the bond): $(printf '%.1f' "${AR_DOWN[0]:-0}") down / $(printf '%.1f' "${AR_UP[0]:-0}") up MB/s"
      else
        logger -t wattun-bondretest "$n/$c (in the bond): failed, ${AR_WHY[0]}; it stays in the bond"
      fi ;;
      *)
      if [ "${AR_OK[0]}" = 1 ]; then
        score=$(at_score 0)
        if bond_worth "$score" "$best"; then
          added+="$c "
          logger -t wattun-bondretest "$n/$c works now: $(printf '%.1f' "${AR_DOWN[0]:-0}") down / $(printf '%.1f' "${AR_UP[0]:-0}") up MB/s, adding it to the bond"
        else
          logger -t wattun-bondretest "$n/$c works but is too slow next to the bond; not adding it"
        fi
      else
        failed+="$c "; logger -t wattun-bondretest "$n/$c failed: ${AR_WHY[0]}"
      fi ;;
    esac
  done
  at_cleanup
  local new='' oknew=1
  if [ -n "$added" ]; then
    local a
    new="$cur"
    for a in $added; do new="$new+$a"; done
    v_carrier_list "$new" || oknew=0 # H4: never write/restart into a carrier list the engine refuses
    for a in $added; do carrier_ok_here "$a" || oknew=0; done
    if [ "$oknew" = 0 ]; then
      logger -t wattun-bondretest "$n: '$new' is not a carrier list this engine can run; keeping the bond unchanged"
      added=''
    fi
  fi
  if [ -n "$added" ]; then
    set_value "$n" carrier "$new"
    logger -t wattun-bondretest "$n: adding ${added% } to the bond ($cur -> $new), restarting the tunnel"
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1
    ok "Added ${added% } to '$n' (bond now $new). The tunnel restarted."
  else
    ok "No carrier to add: the bond keeps its legs${prev:+ (still failing:$prev)}."
  fi
  local nf; nf=$(bondfail_next "$prev" "$cur" "$tested" "$failed")
  bondfail_set "$n" "$nf"
  [ -n "$nf" ] && logger -t wattun-bondretest "$n: retrying next run: $nf"
  logger -t wattun-bondretest "$n: probed$tested($total MB of test traffic)"
  return 0
}

# ======================================================================================
#  Backup & Restore, Bulk Operations
# ======================================================================================
backup_cmd() { # [dest.tar.gz]
  local dest=${1:-wattun-backup-$(date +%Y%m%d%H%M%S).tar.gz}
  dest=$(readlink -f "$dest" 2>/dev/null || echo "$dest")
  say "  Backing up $CONF to $dest..."
  tar -czf "$dest" -C "${CONF%/*}" "${CONF##*/}" || { err "Backup failed"; return 1; }
  chmod 600 "$dest"
  ok "Backup saved: $dest ($(du -h "$dest" | cut -f1))"
}
restore_cmd() { # <archive.tar.gz>
  local src=${1:-}
  [ -f "$src" ] || { err "Backup archive '$src' not found."; return 1; }
  say "  Restoring $CONF from $src..."
  mkdir -p "$CONF"
  tar -xzf "$src" -C "${CONF%/*}" || { err "Restore extraction failed"; return 1; }
  chmod 700 "$CONF"
  chmod 600 "$CONF"/*.key 2>/dev/null || true
  chmod 600 "$CONF"/*.yml 2>/dev/null || true
  ok "Restored configuration to $CONF."
  systemctl daemon-reload 2>/dev/null || true
  ok "Ready. You can start or restart your tunnels now."
}
start_all() {
  local n c=0
  for n in $(tunnels_all); do # hidden extended listeners start with their parent
    if ! systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Starting ${WAT_PREFIX}@$n" systemctl start "${WAT_PREFIX}@$n"; c=$((c+1))
    fi
  done
  [ "$c" -gt 0 ] && ok "Started $c tunnel(s)." || warn "All tunnels are already active."
}
stop_all() {
  local n c=0
  for n in $(tunnels_all); do # hidden extended listeners stop with their parent
    if systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Stopping ${WAT_PREFIX}@$n" systemctl stop "${WAT_PREFIX}@$n"; c=$((c+1))
    fi
  done
  [ "$c" -gt 0 ] && ok "Stopped $c tunnel(s)." || warn "All tunnels are already stopped."
}
batch_actions_menu() {
  while :; do
    page "All tunnels"
    menu_line 1 start 2 stop 3 restart 4 status
    menu_line 5 'back up configs' 6 'restore configs'
    menu_line 0 back
    key_read
    case "$KEY" in
      1) start_all; pause ;;
      2) confirm "Stop all active tunnels?" n && stop_all; pause ;;
      3) confirm "Restart all tunnels? Open connections drop." n && restart_all; pause ;;
      4) status_all; pause ;;
      5) echo; ask "Backup destination file" "wattun-backup-$(date +%Y%m%d).tar.gz"; backup_cmd "$REPLY_V"; pause ;;
      6) echo; ask "Path to backup .tar.gz" ""; restore_cmd "$REPLY_V"; pause ;;
      b|0|q|enter|esc) return 0 ;;
    esac
  done
}

# ======================================================================================
#  Bonding Manager Submenu
# ======================================================================================
bonding_menu() { # name
  local n=$1 r cr isauto=0
  r=$(role "$n")
  [ "$r" = Iran ] && [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ] && isauto=1
  while :; do
    cr=$(cfg "$n" carrier)
    page "Bonding" "$n · $cr"
    tinfo "$n"
    local bmode=$(cfg "$n" bond-mode)
    set_row m mode "${bmode:-balanced}"
    local brv='' brvis=0
    if bond_retest_visible "$r" "$cr"; then brvis=1; brv=$(bondretest_get "$n"); set_row r 'auto-retest' "$brv" '' off; fi
    echo
    if [ "$TI_CAR_COUNT" -gt 0 ]; then
      printf '  %s%4s  %-10s %-8s %8s %8s %12s%s\n' "$GRY" '#' path state rtt loss share "$RST"
      local ci ccol cdot ctxt c_pct
      for ((ci=0; ci<TI_CAR_COUNT; ci++)); do
        if [ "${CAR_MUTED[$ci]}" = true ]; then
          ccol=$GRY; cdot='○'; ctxt="muted"
        elif [ "${CAR_ALIVE[$ci]}" = true ]; then
          ccol=$GRN; cdot='●'; ctxt="up"
        else
          ccol=$RED; cdot='○'; ctxt="down"
        fi
        c_pct=$(awk -v s="${CAR_SHARE[$ci]:-0}" 'BEGIN{printf "%.0f", s*100}')
        printf '  %s%4s%s  %-10s %s%s %-6s%s %6.0f ms %7.1f%% %11s%%\n' "$CYN" "$ci" "$RST" \
          "${CAR_NAME[$ci]}" "$ccol" "$cdot" "$ctxt" "$RST" "${CAR_RTT[$ci]}" "$(awk -v l="${CAR_LOSS[$ci]:-0}" 'BEGIN{printf "%.1f", l*100}')" "$c_pct"
      done
    else
      hint "No path data: the tunnel is stopped or has one carrier."
    fi
    echo
    menu_line t 'mute or unmute a path' a 'add carrier' d 'remove carrier'
    [ "$brvis" = 1 ] && menu_line r 're-test blocked paths (off/30m/1h/6h/daily-offpeak)'
    menu_line 0 back
    key_read
    case "$KEY" in
      r|R)
        [ "$brvis" = 1 ] || continue
        echo
        say "  ${BOLD}Bond auto-retest${RST} ${GRY}(re-tests every leg plus the last failures; never removes a working leg)${RST}"
        hint "A carrier that works again is added back only when it reaches 10 % of the best working leg."
        ask_ok "Re-test: off, 30m, 1h, 6h or daily-offpeak" "$brv" v_bondretest || continue
        bond_retest_set "$n" "$REPLY_V"
        pause ;;
      t)
        echo
        ask_ok "Path index to toggle mute" "0" v_num || continue
        local pidx=$REPLY_V m=$(cfg "$n" metrics)
        if [ -n "$m" ]; then
          local res
          res=$(curl -fs --noproxy '*' --max-time 3 "http://$m/carrier/toggle?path=$pidx" 2>/dev/null)
          if [ -n "$res" ]; then
            ok "Toggled mute on path $pidx (muted: $(jget "$res" muted))."
          else
            err "Failed to toggle path $pidx on metrics server http://$m."
          fi
        else
          warn "Tunnel '$n' has no metrics endpoint configured."
        fi
        pause ;;
      m)
        echo
        say "  Choose bond mode:"
        say "    ${CYN}1${RST} balanced       (smooth weighted round-robin based on path capacities)"
        say "    ${CYN}2${RST} active-backup  (100% on primary path, 50ms keepalives on secondary, fast cutover)"
        say "    ${CYN}3${RST} replicate      (replicate datagrams across all paths for zero loss)"
        ask_ok "Choice" "1" v_nonempty || continue
        case "$REPLY_V" in
          1|balanced) set_value "$n" bond-mode balanced ;;
          2|active-backup) set_value "$n" bond-mode active-backup ;;
          3|replicate) set_value "$n" bond-mode replicate ;;
          *) warn "Unknown bond mode '$REPLY_V'."; continue ;;
        esac
        ok "Set bond-mode: $(cfg "$n" bond-mode)"
        confirm "Restart '$n' to apply mode change?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
        pause ;;
      a)
        echo
        # Only auto Iran tunnels can gain a path safely: Kharej already listens on every type in
        # the plan, and the per-carrier port comes from it. A fixed/hand-made bond needs peer-<carrier>
        # and listen-<carrier> in Advanced YAML, so this menu must not guess them.
        if [ "$isauto" != 1 ]; then
          warn "Adding a carrier here is for auto tunnels on Iran: the plan already made Kharej listen on every type."
          hint "A hand-made bond needs peer-<carrier> and listen-<carrier> in Advanced YAML (tunnel page, o)."
          hint "To get a bond the easy way: make an auto tunnel on Kharej, then join the tested types on Iran (tunnel page, m)."
          pause; continue
        fi
        local pd=$(plan_part "$T_AUTO" d)
        ask_ok "Carrier name to add (in the plan: ${pd:-none})" "tls" v_nonempty || continue
        local ncar=$REPLY_V cur_car=$(cfg "$n" carrier) p
        if ! carrier_ok "$ncar"; then err "Unknown carrier '$ncar' (use icmp, udp, tcp, tls, ws, wss, h2, h2c, grpc, gre, ipip or an F19 shape)."; pause; continue; fi
        if is_shaped_carrier "$ncar"; then err "F19 shaped carriers are single-carrier only in 3.3.0 (the engine refuses a shaped leg in a '+'-bond)."; pause; continue; fi # D7
        if [[ "+$cur_car+" == *"+$ncar+"* ]]; then
          warn "Carrier '$ncar' is already in carrier list '$cur_car'."
        else
          p=$(plan_port "$pd" "$ncar")
          if [ -z "$p" ]; then
            err "Carrier '$ncar' is not in this tunnel's auto plan, so Kharej does not listen for it."
          else
            set_value "$n" "peer-$ncar" "$T_PEER:$p"
            set_value "$n" carrier "$cur_car+$ncar"
            ok "Updated carrier: $(cfg "$n" carrier)"
            if ! is_pool "$ncar" && [ -n "$(cfg "$n" fake-sni)$(cfg "$n" pool-rotate)$(cfg "$n" pool-rotate-bytes)" ]; then
              warn "The $ncar leg carries no fake-SNI or rotation: only tcp/tls/ws/wss/h2/h2c/grpc legs are disguised."
            fi
            confirm "Restart '$n' to apply new carrier bond?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
          fi
        fi
        pause ;;
      d)
        echo
        if [ "$isauto" != 1 ]; then
          warn "Removing a carrier here is for auto tunnels on Iran; for a hand-made bond edit the YAML (tunnel page, o)."
          pause; continue
        fi
        ask_ok "Carrier name to remove" "" v_nonempty || continue
        local rcar=$REPLY_V cur_car=$(cfg "$n" carrier)
        if ! carrier_ok "$rcar"; then err "Unknown carrier '$rcar'."; pause; continue; fi
        if [[ "+$cur_car+" != *"+$rcar+"* ]]; then
          warn "Carrier '$rcar' not found in '$cur_car'."
        else
          local new_car
          new_car=$(echo "$cur_car" | sed -E "s/(^|\+)$rcar(\+|$)/\1/g; s/^\+//; s/\+$//")
          if [ -z "$new_car" ]; then
            err "Cannot remove the only carrier."
          else
            set_value "$n" carrier "$new_car"
            sed -i -E "/^peer-$rcar:/d" "$CONF/$n.yml"
            ok "Updated carrier: $(cfg "$n" carrier)"
            confirm "Restart '$n' to apply?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
          fi
        fi
        pause ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Auto Mode Settings Submenu
# ======================================================================================
auto_menu() { # name
  local n=$1 cur pol sla_f isauto=0
  sla_f="$CONF/$n.sla"
  [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ] && isauto=1
  while :; do
    page "Auto mode" "$n"
    cur=$(auto_current_key "$n" 2>/dev/null || cfg "$n" carrier)
    pol=$(cat "$CONF/$n.policy" 2>/dev/null || echo speed)
    [ "$isauto" != 1 ] && { hint "Fixed-type token: policy and retest need a new token (tunnel page, t)."; echo; }
    printf '      %-13s %s\n' 'in use' "${cur:--}"
    set_row p policy "$pol"
    local sla_v=''
    if [ -f "$sla_f" ]; then
      local min_r=$(grep '^sla_min_rate_kbps=' "$sla_f" 2>/dev/null | cut -d= -f2)
      local max_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" 2>/dev/null | cut -d= -f2)
      local max_l=$(grep '^sla_max_loss_pct=' "$sla_f" 2>/dev/null | cut -d= -f2)
      sla_v="rate ≥ ${min_r:-0} kbps · rtt ≤ ${max_rtt:-0} ms · loss ≤ ${max_l:-0} %"
    fi
    set_row s 'heal when' "$sla_v" '' 'the link is down'
    local opt_timer_st=''
    systemctl is-active -q "$WAT_PREFIX-auto-optimize.timer" 2>/dev/null && opt_timer_st="${GRN}on${RST} ${GRY}(retests once a day off-peak)${RST}"
    set_row o 'daily retest' "$opt_timer_st" '' off
    echo
    menu_line r 'retest now' 0 back
    key_read
    case "$KEY" in
      p)
        echo
        if [ "$isauto" != 1 ]; then
          warn "The selection policy is read only by auto tunnels; this one was made with a fixed type."
          hint "For an auto tunnel: make one on Kharej, paste its token here (t), run auto-test."
          pause; continue
        fi
        say "  Choose carrier selection policy:"
        say "    ${CYN}1${RST} speed    (rank by Down+Up throughput, lowest RTT tiebreak)"
        say "    ${CYN}2${RST} latency  (rank by lowest round-trip latency)"
        say "    ${CYN}3${RST} direct   (prioritize direct unproxied paths over CDN)"
        say "    ${CYN}4${RST} bond     (automatically bond top direct performers)"
        ask_ok "Choice" "1" v_nonempty || continue
        case "$REPLY_V" in
          1|speed) echo speed >"$CONF/$n.policy" ;;
          2|latency) echo latency >"$CONF/$n.policy" ;;
          3|direct) echo direct >"$CONF/$n.policy" ;;
          4|bond) echo bond >"$CONF/$n.policy" ;;
          *) warn "Unknown policy '$REPLY_V'."; continue ;;
        esac
        ok "Policy saved: $(cat "$CONF/$n.policy")"
        pause ;;
      s)
        echo
        local cur_min=0 cur_rtt=0 cur_loss=0
        if [ -f "$sla_f" ]; then
          cur_min=$(grep '^sla_min_rate_kbps=' "$sla_f" | cut -d= -f2)
          cur_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" | cut -d= -f2)
          cur_loss=$(grep '^sla_max_loss_pct=' "$sla_f" | cut -d= -f2)
        fi
        ask_ok "Minimum required throughput in kbps (0 = none)" "${cur_min:-0}" v_num || continue
        cur_min=$REPLY_V
        ask_ok "Maximum tolerable RTT in ms (0 = none, e.g. 300)" "${cur_rtt:-0}" v_num || continue
        cur_rtt=$REPLY_V
        ask_ok "Maximum tolerable packet loss % (0 = none, e.g. 10)" "${cur_loss:-0}" v_num || continue
        cur_loss=$REPLY_V
        {
          echo "sla_min_rate_kbps=$cur_min"
          echo "sla_max_rtt_ms=$cur_rtt"
          echo "sla_max_loss_pct=$cur_loss"
        } >"$sla_f"
        chmod 600 "$sla_f"
        ok "SLA configured."
        pause ;;
      r)
        echo
        if [ "$isauto" = 1 ]; then
          say "  Running auto-test & policy re-evaluation..."
        elif cdn_tunnel_p "$n"; then
          say "  Refreshing the CDN edge list..."
        else
          hint "Nothing to re-rank: this tunnel was made with a fixed type. To switch types, make a new tunnel or use an auto token."
          pause; continue
        fi
        AUTO_OPTIMIZE=1 auto_retest "$n"
        pause ;;
      o)
        echo
        if systemctl is-active -q "$WAT_PREFIX-auto-optimize.timer" 2>/dev/null; then
          optimize_disable
        else
          optimize_enable
        fi
        sleep 1 ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Bandwidth Quotas & Limits Submenu
# ======================================================================================
limits_menu() { # name
  local n=$1 r cr
  r=$(role "$n"); cr=$(cfg "$n" carrier)
  while :; do
    page "Limits" "$n"
    set_row m 'speed limit' "$(cfg "$n" max-mbps)" 'MB/s' 'none'
    echo
    say "  ${GRY}per port${RST}"
    local -a p_limits=()
    mapfile -t p_limits < <(grep -E '^[[:space:]]*-[[:space:]]+[0-9]+' "$CONF/$n.yml" | grep -E 'rate=|quota=' || true)
    if [ "${#p_limits[@]}" -gt 0 ]; then
      local it
      for it in "${p_limits[@]}"; do
        say "    $it"
      done
    else
      say "    ${GRY}none${RST}"
    fi
    echo
    local m=$(cfg "$n" metrics)
    if [ -n "$m" ]; then
      local prt_json
      prt_json=$(curl -fs --noproxy '*' --max-time 2 "http://$m/ports" 2>/dev/null)
      if [ -n "$prt_json" ]; then
        say "  ${GRY}quota used${RST}"
        local pobj
        while read -r pobj; do
          [ -n "$pobj" ] || continue
          local lp qu ql qe
          lp=$(jget "$pobj" port)
          qu=$(jget "$pobj" quota_used)
          ql=$(jget "$pobj" quota_limit)
          qe=$(jget "$pobj" quota_exceeded)
          if [ "${ql:-0}" -gt 0 ]; then
            say "    $lp  $(human "$qu") of $(human "$ql")$([ "$qe" = true ] && printf '  %s✘ used up%s' "$RED" "$RST")"
          fi
        done < <(grep -o '{[^{}]*}' <<<"$prt_json")
      fi
    fi
    echo
    menu_line e 'set a port limit' r 'reset a port quota' 0 back
    key_read
    case "$KEY" in
      m)
        echo
        ask_ok "Global speed ceiling in MB/s (- or 0 or default = unset)" "$(cfg "$n" max-mbps)" v_mbps_adv || continue
        case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
        if [ -z "$REPLY_V" ]; then unset_value "$n" max-mbps; else set_value "$n" max-mbps "$REPLY_V"; fi
        ok "Saved. Restart '$n' to apply."
        pause ;;
      e)
        echo
        ask_ok "Port to limit" "" v_port || continue
        local lport=$REPLY_V
        ask_ok "Rate limit (e.g. 5MB, 300k, 0 = none)" "0" v_pool_bytes || continue
        local lrate=$REPLY_V
        ask_ok "Quota limit (e.g. 100GB, 500MB, 0 = none)" "0" v_pool_bytes || continue
        local lquota=$REPLY_V
        set_port_limit "$n" "$lport" "$lrate" "$lquota"
        ok "Saved limit for port $lport. Hot-reloaded automatically by engine."
        pause ;;
      r)
        echo
        ask_ok "Port to reset quota for" "" v_port || continue
        local rport=$REPLY_V
        if [ -n "$m" ]; then
          local rres
          rres=$(curl -fs --noproxy '*' --max-time 3 -X POST "http://$m/quota/reset?port=$rport" 2>/dev/null)
          if [ -n "$rres" ]; then
            ok "Quota for port $rport reset."
          else
            err "Failed to reset quota on metrics server http://$m."
          fi
        else
          warn "Tunnel '$n' has no metrics endpoint configured."
        fi
        pause ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Tunnel page: status header + two-column command deck
# ======================================================================================
# The deck has two columns of rows. A row is a section header or an action. Arrows and Tab move a
# visible cursor (">"); Enter runs the selected action, and every action keeps its hotkey so the
# page stays fast for people who know it. Each action carries a one-line description, so the page
# explains itself instead of asking the operator to memorize 16 cryptic labels.
TM_SELKEY=''; TM_FSIDE=L; TM_FIDX=0; TM_CW=36
TL_TYPE=(); TL_KEY=(); TL_LAB=(); TL_DESC=(); TL_HELP=()
TR_TYPE=(); TR_KEY=(); TR_LAB=(); TR_DESC=(); TR_HELP=()

tmenu_lhdr() { TL_TYPE+=(H); TL_KEY+=(''); TL_LAB+=("$1"); TL_DESC+=(''); TL_HELP+=(''); }
tmenu_rhdr() { TR_TYPE+=(H); TR_KEY+=(''); TR_LAB+=("$1"); TR_DESC+=(''); TR_HELP+=(''); }
tmenu_ladd() { TL_TYPE+=(I); TL_KEY+=("$1"); TL_LAB+=("$2"); TL_DESC+=("$3"); TL_HELP+=("$4"); }
tmenu_radd() { TR_TYPE+=(I); TR_KEY+=("$1"); TR_LAB+=("$2"); TR_DESC+=("$3"); TR_HELP+=("$4"); }

tunnel_menu_build() { # name role run boot carrier z_ok reverse auto_kharej has_companion
  local n=$1 r=$2 run=$3 boot=$4 car=$5 z_ok=${6:-0} rev=${7:-0} auto=${8:-0} comp=${9:-0}
  local stop_lab stop_desc boot_desc
  TL_TYPE=(); TL_KEY=(); TL_LAB=(); TL_DESC=(); TL_HELP=()
  TR_TYPE=(); TR_KEY=(); TR_LAB=(); TR_DESC=(); TR_HELP=()
  if [ "$run" = active ]; then stop_lab=Stop; stop_desc='running now'
  else stop_lab=Start; stop_desc='stopped now'; fi
  if [ "$boot" = on ]; then boot_desc='on · toggle'; else boot_desc='off · toggle'; fi

  tmenu_lhdr OBSERVE
  tmenu_ladd l Logs 'follow the log' "Follow ${WAT_PREFIX}@$n in the journal, Ctrl+C comes back here."
  tmenu_ladd d Diagnose 'find the fault' 'Check the key, carrier, route and MTU, then run a speed test.'
  tmenu_ladd v 'Speed test' 'measure speed' 'Move 10 MB down and up through the live tunnel.'
  tmenu_ladd m Monitor 'live rates' 'Full-screen live view; any key comes back here.'
  tmenu_lhdr ROUTE
  tmenu_ladd p Ports 'edit mappings' 'Edit the published ports; applied within 3 s, users stay connected.'
  tmenu_ladd c Carrier 'change type' 'Change how the two servers connect (icmp, tcp, wss, ...).'
  tmenu_ladd q Limits 'rate and quota' 'Set a per-port rate limit and traffic quota.'
  tmenu_ladd b Bonding 'if bonded' 'Join several carriers into one tunnel, or change the bonding mode.'
  [ "$z_ok" = 1 ] && tmenu_ladd z Anti-censor 'fake-SNI · ECH' 'fake-SNI, ECH, fragmentation, presets and the matrix.'

  tmenu_rhdr SERVICE
  tmenu_radd r Restart 'restart it' 'Restart the service; open connections drop for a moment.'
  tmenu_radd s "$stop_lab" "$stop_desc" 'Start or stop the service now; the boot setting is separate.'
  tmenu_radd e Boot "$boot_desc" 'Start this tunnel automatically when the server boots.'
  tmenu_radd o Advanced 'tuning knobs' 'MTU, FEC, batching, sessions, bind, ICMP type and direction.'
  tmenu_rhdr IDENTITY
  if [ "$r" = Kharej ]; then
    tmenu_radd t Token 'share to Iran' "Show ${WAT_PREFIX}@$n's token; paste it on the Iran server."
    tmenu_radd k 'New key' 'rotate the key' 'Make a new key and token; update the other side to match.'
    if [ "$auto" = 1 ]; then
      if [ "$(auto_carrier_status "$n" | cut -d'|' -f1)" = open ]; then tmenu_radd u 'Close carriers' 'free ports' 'Close the carrier ports Iran does not use.'
      else tmenu_radd u 'Open carriers' 'reopen all' 'Open every carrier again and keep them open until you close them.'; fi
    fi
    [ "$rev" = 1 ] && [ "$comp" = 0 ] && tmenu_radd h 'Iran IP' 'change peer' 'Change the Iran address Kharej dials (reverse tunnel).'
  else
    tmenu_radd t 'New token' 'from Kharej' 'Replace Kharej, key and carrier from a new token; ports stay.'
    if [ "$rev" = 1 ]; then
      [ "$car" != icmp ] && tmenu_radd h 'Listen port' 'change listen' 'Change the port Iran listens on for this reverse tunnel.'
    else
      tmenu_radd h 'Kharej IP' 'change peer' 'Change the Kharej address Iran connects to.'
    fi
    tmenu_radd a 'Auto mode' 'let Iran pick' 'Let Iran test every carrier and pick the fastest that works.'
  fi
  # keep the cursor on the same action across redraws; if it vanished, start from the first action
  tmenu_find "$TM_SELKEY" || tunnel_menu_first
}

tmenu_find() { # key -> TM_FSIDE=L|R, TM_FIDX=row ; rc 1 when the key is not an action on this page
  local k=$1 i
  for i in "${!TL_KEY[@]}"; do
    [ "${TL_TYPE[$i]}" = I ] && [ "${TL_KEY[$i]}" = "$k" ] && { TM_FSIDE=L; TM_FIDX=$i; return 0; }
  done
  for i in "${!TR_KEY[@]}"; do
    [ "${TR_TYPE[$i]}" = I ] && [ "${TR_KEY[$i]}" = "$k" ] && { TM_FSIDE=R; TM_FIDX=$i; return 0; }
  done
  return 1
}
tunnel_menu_first() {
  local i
  for i in "${!TL_KEY[@]}"; do [ "${TL_TYPE[$i]}" = I ] && { TM_SELKEY=${TL_KEY[$i]}; return 0; }; done
  for i in "${!TR_KEY[@]}"; do [ "${TR_TYPE[$i]}" = I ] && { TM_SELKEY=${TR_KEY[$i]}; return 0; }; done
}
tunnel_menu_select() { # key : follow a typed hotkey with the cursor (no-op for unknown keys)
  local k=${1,,}
  [ -n "$k" ] || return 0
  tmenu_find "$k" && TM_SELKEY=$k
  return 0
}
tmenu_closest_to() { # side row -> TM_CKEY: the action in that column nearest to row
  local side=$1 row=$2 i d bestd=999
  TM_CKEY=''
  if [ "$side" = L ]; then
    for i in "${!TL_KEY[@]}"; do
      [ "${TL_TYPE[$i]}" = I ] || continue
      d=$(( i > row ? i - row : row - i ))
      [ "$d" -lt "$bestd" ] && { bestd=$d; TM_CKEY=${TL_KEY[$i]}; }
    done
  else
    for i in "${!TR_KEY[@]}"; do
      [ "${TR_TYPE[$i]}" = I ] || continue
      d=$(( i > row ? i - row : row - i ))
      [ "$d" -lt "$bestd" ] && { bestd=$d; TM_CKEY=${TR_KEY[$i]}; }
    done
  fi
  [ -n "$TM_CKEY" ]
}
tunnel_menu_move() { # up|down|left|right : move the cursor, skipping section headers
  local dir=$1 side idx i n want
  if ! tmenu_find "$TM_SELKEY"; then tunnel_menu_first; return 0; fi
  side=$TM_FSIDE; idx=$TM_FIDX
  case "$dir" in
    up) n=-1 ;;
    down) n=1 ;;
    *)
      want=R; [ "$side" = R ] && want=L
      tmenu_closest_to "$want" "$idx" && TM_SELKEY=$TM_CKEY
      return 0 ;;
  esac
  i=$(( idx + n ))
  if [ "$side" = L ]; then
    while [ "$i" -ge 0 ] && [ "$i" -lt "${#TL_TYPE[@]}" ]; do
      [ "${TL_TYPE[$i]}" = I ] && { TM_SELKEY=${TL_KEY[$i]}; return 0; }
      i=$(( i + n ))
    done
  else
    while [ "$i" -ge 0 ] && [ "$i" -lt "${#TR_TYPE[@]}" ]; do
      [ "${TR_TYPE[$i]}" = I ] && { TM_SELKEY=${TR_KEY[$i]}; return 0; }
      i=$(( i + n ))
    done
  fi
  return 0
}
tmenu_cell() { # side row -> CELL : one deck cell with colours (empty past the column's last row)
  local side=$1 i=$2 t key lab desc
  local -a ty=("${TL_TYPE[@]}") ky=("${TL_KEY[@]}") la=("${TL_LAB[@]}") de=("${TL_DESC[@]}")
  if [ "$side" = R ]; then
    ty=("${TR_TYPE[@]}"); ky=("${TR_KEY[@]}"); la=("${TR_LAB[@]}"); de=("${TR_DESC[@]}")
  fi
  t=${ty[$i]:-}
  case "$t" in
    H) CELL="${BOLD}${CYN}${la[$i]}${RST}" ;;
    I) key=${ky[$i]}; lab=${la[$i]}; desc=${de[$i]}
       if [ "$key" = "$TM_SELKEY" ]; then
         CELL="$(printf '%s %s %s%-14s%s %s%s%s' '▸' "$(key_label "$key")" "$BOLD" "$lab" "$RST" "$GRY" "$desc" "$RST")"
       else
         CELL="$(printf '  %s %-14s %s%s%s' "$(key_label "$key")" "$lab" "$GRY" "$desc" "$RST")"
       fi ;;
    *) CELL='' ;;
  esac
}
tunnel_menu_render() {
  local rows i l r pad
  rows=${#TL_TYPE[@]}
  [ "${#TR_TYPE[@]}" -gt "$rows" ] && rows=${#TR_TYPE[@]}
  for ((i=0; i<rows; i++)); do
    tmenu_cell L "$i"; l=$CELL
    tmenu_cell R "$i"; r=$CELL
    if [ -z "$r" ]; then printf '  %s\n' "$l"; continue; fi
    vlen "$l"; pad=$(( TM_CW - VLEN )); [ "$pad" -lt 0 ] && pad=0
    printf '  %s%*s  %s\n' "$l" "$pad" '' "$r"
  done
}
tunnel_menu_help_line() {
  local lab help
  tmenu_find "$TM_SELKEY" || return 0
  if [ "$TM_FSIDE" = L ]; then lab=${TL_LAB[$TM_FIDX]}; help=${TL_HELP[$TM_FIDX]}
  else lab=${TR_LAB[$TM_FIDX]}; help=${TR_HELP[$TM_FIDX]}; fi
  printf '\n  %s▸%s %s%s%s  %s%s%s\n' "$CYN" "$RST" "$BOLD" "$lab" "$RST" "$GRY" "$help" "$RST"
}
tunnel_menu_footer() {
  local nav pad
  nav="${GRY}↑↓${RST} move   ${GRY}tab${RST} column   ${GRY}enter${RST} open   ${GRY}0${RST} back   ${GRY}?${RST} keys"
  vlen "$nav"; pad=$(( 74 - VLEN - 10 )); [ "$pad" -lt 1 ] && pad=1
  printf '  %s%*s%s[x] delete%s\n' "$nav" "$pad" '' "$RED" "$RST"
}
tunnel_menu_keys() { # name : the full key map, for "?" (any key returns to the deck)
  local n=$1 i
  local -a ty ky la he
  page "Keys" "$n"
  printf '  %sEvery action, what it does, and its hotkey. Descriptions are also shown under the deck.%s\n\n' "$GRY" "$RST"
  ty=("${TL_TYPE[@]}"); ky=("${TL_KEY[@]}"); la=("${TL_LAB[@]}"); he=("${TL_HELP[@]}")
  for i in "${!ty[@]}"; do
    case "${ty[$i]}" in
      H) printf '  %s%s%s\n' "$BOLD" "${la[$i]}" "$RST" ;;
      I) printf '  %s %-14s %s%s%s\n' "$(key_label "${ky[$i]}")" "${la[$i]}" "$GRY" "${he[$i]}" "$RST" ;;
    esac
  done
  ty=("${TR_TYPE[@]}"); ky=("${TR_KEY[@]}"); la=("${TR_LAB[@]}"); he=("${TR_HELP[@]}")
  for i in "${!ty[@]}"; do
    case "${ty[$i]}" in
      H) printf '  %s%s%s\n' "$BOLD" "${la[$i]}" "$RST" ;;
      I) printf '  %s %-14s %s%s%s\n' "$(key_label "${ky[$i]}")" "${la[$i]}" "$GRY" "${he[$i]}" "$RST" ;;
    esac
  done
  printf '  %s %-14s %s%s%s\n' "$(key_label x)" Delete 'remove this tunnel and its files (asks first)' "$GRY" "$RST"
  printf '  %s %-14s %s%s%s\n' "$(key_label s)" 'Spoofing & shaping' 'what each anti-censor option actually does' "$GRY" "$RST"
  printf '\n  %s move   %stabs%s or %s←→%s column   %senter%s open   %s0%s back\n' \
    "↑↓" "$GRY" "$RST" "$GRY" "$RST" "$GRY" "$RST" "$GRY" "$RST"
  while :; do
    key_read
    [ "$KEY" = s ] && { spoofhelp_page "$n"; continue; }
    return 0
  done
}
tunnel_header() { # name role
  local n=$1 r=$2 left right pad
  if [ "$NONINTERACTIVE" = 1 ]; then printf '== %s (%s) ==\n' "$n" "$r"; return 0; fi
  clear_screen; echo
  tinfo "$n"; state_cell "$r" "$TI_STATE"
  left="${GRY}WatTun${VER:+ $VER}${RST} ${GRY}·${RST} ${BOLD}${n}${RST}  ${GRY}${r}${RST}"
  right="${SC_COL}${SC_DOT} ${SC_TXT}${RST} ${GRY}·${RST} ${GRY}$(carrier_label "$n")${RST}"
  if [ "$TI_STATE" = up ] || [ "$TI_STATE" = degraded ]; then
    if awk -v r="${TI_RATE:-0}" 'BEGIN{exit !(r > 0)}'; then
      right+=" ${GRY}·${RST} ↓$(human "$TI_RATE")/s"
    else
      right+=" ${GRY}·${RST} ${GRY}idle${RST}"
    fi
  fi
  vlen "$left"; pad=$(( 74 - VLEN )); vlen "$right"; pad=$(( pad - VLEN ))
  [ "$pad" -lt 1 ] && pad=1
  printf '  %s%*s%s\n' "$left" "$pad" '' "$right"
  hr
  echo
}

tunnel_page() {
  local n=$1 r run boot car z_ok rev auto comp par first=1
  TM_SELKEY=''
  while :; do
    [ -f "$CONF/$n.yml" ] || return 0
    r=$(role "$n")
    run=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null)
    boot=off; systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null && boot=on
    car=$(cfg "$n" carrier)
    z_ok=0; [ "$(uname -s)" = Linux ] && { is_pool_list "$car" || [ "$car" = icmp ]; } && z_ok=1
    rev=0; is_reverse "$n" && rev=1
    auto=0; is_auto_kharej "$n" && auto=1
    comp=0; [ -n "$(companion_of "$n")" ] && comp=1
    tunnel_header "$n" "$r"
    # first render: put the cursor on the action that is useful right now
    if [ "$first" = 1 ]; then
      first=0
      case "$TI_STATE" in
        stopped) TM_SELKEY=s ;;
        down|degraded) TM_SELKEY=d ;;
        *) TM_SELKEY=l ;;
      esac
    fi
    tunnel_card "$n"
    echo
    tunnel_menu_build "$n" "$r" "$run" "$boot" "$car" "$z_ok" "$rev" "$auto" "$comp"
    tunnel_menu_render
    tunnel_menu_help_line
    echo
    tunnel_menu_footer
    KEY_NAV=1; key_read; KEY_NAV=0
    case "$KEY" in
      up|down|left|right) tunnel_menu_move "$KEY"; continue ;;
      tab|$'\t') tunnel_menu_move right; continue ;;
      enter|' ') [ -n "$TM_SELKEY" ] && KEY=$TM_SELKEY || continue ;;
    esac
    tunnel_menu_select "$KEY"
    case "$KEY" in
      d|D) page "Diagnose" "$n"; run_flow test_tunnel "$n"; pause ;;
      v|V) page "Speed test" "$n"; run_flow speed_test "$n"; pause ;;
      l|L) page "Logs" "$n"; run_flow logs_menu "$n"; pause ;;
      m|M) run_flow live_monitor ;;
      p|P) run_flow edit_ports "$n"; pause ;;
      q|Q) run_flow limits_menu "$n" ;;
      c|C) page "Connection type" "$n"; run_flow change_type "$n"; pause ;;
      b|B) run_flow bonding_menu "$n" ;;
      a|A) [ "$r" = Iran ] && run_flow auto_menu "$n" ;;
      h|H) if [ "$r" = Kharej ] && is_reverse "$n" && [ -z "$(companion_of "$n")" ]; then page "Iran address" "$n"; echo; run_flow change_peer "$n"; pause
           elif [ "$r" = Iran ]; then
             if is_reverse "$n"; then
               [ "$(cfg "$n" carrier)" != icmp ] && { page "Carrier listen port" "$n"; echo; run_flow change_peer "$n"; pause; }
             else page "Kharej address" "$n"; echo; run_flow change_peer "$n"; pause; fi
           fi ;;
      u|U) if [ "$r" = Kharej ] && is_auto_kharej "$n"; then run_flow auto_carriers_toggle "$n"; pause; fi ;;
      t|T) if [ "$r" = Kharej ]; then
           par=$(companion_of "$n")
           page "Token" "$n"; echo
           [ -n "$par" ] && hint "'$n' is the reverse side of '$par'; this is the token of '$par'."
           say "  Paste it on the Iran server: new tunnel (n), or t on an existing tunnel."
           echo; show_token "${par:-$n}"
         else page "New token" "$n"
               hint "Replaces the Kharej, key and connection type. The ports published here stay."
               echo; run_flow change_key "$n"; fi
         pause ;;
      k|K) if [ "$r" = Kharej ]; then
           par=$(companion_of "$n"); page "New key" "$n"
           [ -n "$par" ] && hint "'$n' is the reverse side of '$par'; its key and token are changed there."
           run_flow change_key "${par:-$n}"; pause
         else anticensor_menu "$n"; fi ;;
      o|O) run_flow adv_menu "$n" ;;
      z|Z) anticensor_menu "$n" ;;
      r|R) echo; if confirm "Restart '$n'? Open connections drop." n; then step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"; sleep 1; fi ;;
      s|S) echo
         if [ "$run" = active ]; then systemctl stop "${WAT_PREFIX}@$n" 2>/dev/null; ok "Stopped (it still starts at boot if enabled)."; sleep 1
         else start_unit "$n"; sleep 1; fi ;;
      e|E) echo
         if systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null; then systemctl disable "${WAT_PREFIX}@$n" >/dev/null 2>&1; ok "Will NOT start at boot."
         else systemctl enable "${WAT_PREFIX}@$n" >/dev/null 2>&1; ok "Will start at boot."; fi
         sleep 1 ;;
      x|X) page "Delete tunnel" "$n"; echo; run_flow delete_tunnel "$n"; pause ;;
      0|esc) return 0 ;;
      \?|\/|help) tunnel_menu_keys "$n"; continue ;;
      *) : ;;
    esac
  done
}

# ======================================================================================
#  Auto-heal, update, rollback, uninstall, settings
# ======================================================================================
# The heal timer also drives the automatic auto-tunnel cleanup (R3: prune, widen safety net), so a Kharej-only server
# with an auto tunnel needs it too (ensure_prune_timer below installs it). heal() itself is role-gated: the restart/
# retest/matrix work runs only for Iran tunnels, so on a server it can only prune/widen. WAT_UNIT_DIR is a self-test
# hook (write the unit files into a throwaway directory); production always uses /etc/systemd/system.
unit_dir() { printf '%s' "${WAT_UNIT_DIR:-/etc/systemd/system}"; }
heal_enable() {
  local mgr=/usr/local/bin/wattun-manager ud
  ud=$(unit_dir); mkdir -p "$ud" 2>/dev/null
  [ "$SANDBOX" = 1 ] && mgr=$MGR
  {
    printf '[Unit]\nDescription=WatTunnel auto-heal%s\n[Service]\nType=oneshot\n' "$([ "$SANDBOX" = 1 ] && echo " (sandbox $WAT_PREFIX)")"
    unit_env_lines
    printf 'ExecStart=%s heal\n' "$mgr"
  } >"$ud/$HEAL_UNIT.service"
  cat >"$ud/$HEAL_UNIT.timer" <<EOF
[Unit]
Description=WatTunnel auto-heal and auto-tunnel cleanup every minute
[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
[Install]
WantedBy=timers.target
EOF
  chmod 644 "$ud/$HEAL_UNIT.service" "$ud/$HEAL_UNIT.timer"
  systemctl daemon-reload && systemctl enable --now "$HEAL_UNIT.timer" >/dev/null 2>&1 && ok "Auto-heal and auto-tunnel cleanup enabled."
}
heal_disable() {
  local ud; ud=$(unit_dir)
  systemctl disable --now "$HEAL_UNIT.timer" >/dev/null 2>&1
  rm -f "$ud/$HEAL_UNIT.service" "$ud/$HEAL_UNIT.timer"
  ok "Auto-heal disabled."
}
prune_timer_needed() { # role is-auto(1|0) -> 0 when this host has an auto Kharej tunnel that needs the heal timer
  [ "${1:-}" = Kharej ] && [ "${2:-0}" = 1 ]
}
ensure_prune_timer() { # an auto Kharej tunnel is pruned by heal(), so its timer must exist even on a Kharej-only server
  local n any=0
  for n in $(tunnels); do
    prune_timer_needed "$(role "$n")" "$(is_auto_kharej "$n" && echo 1 || echo 0)" && { any=1; break; }
  done
  [ "$any" = 1 ] || return 0
  systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null && return 0
  heal_enable >/dev/null 2>&1 && logger -t wattun-auto "enabled the heal timer (auto-tunnel cleanup and safety net)"
  return 0
}
heal_ext_listeners() { # B3: restart enabled-but-down hidden extended listeners (disabled = pruned, leave closed)
  local n
  for n in $(tunnels_all); do
    is_auto_ext "$n" || continue
    systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null || continue
    systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null && continue
    logger -t wattun-heal "extended listener $n is down, restarting"
    step "Restarting extended listener ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  done
  return 0
}
mgr_lock() { # L10: one manager pass at a time; fd 9 holds the lock until this process exits (no explicit unlock)
  mkdir -p "$RUN" 2>/dev/null
  command -v flock >/dev/null 2>&1 || return 0 # no flock (a stripped test host): run unlocked, never refuse to work
  exec 9>"$RUN/manager.lock" || return 0
  flock -n 9 && return 0
  warn "Another wattun-manager pass is running; skipping this one."
  return 1
}
heal() { # restart Iran tunnels whose link is down or breaches SLA 3 checks in a row
  local n cnt f st cyc sla_f b_f
  mkdir -p "$RUN"
  for n in $(tunnels); do
    [ "$(role "$n")" = Iran ] && systemctl is-enabled -q "${WAT_PREFIX}@$n" || continue
    f="$RUN/$n.down"
    b_f="$RUN/$n.sla_breach"
    st=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null)
    if [ "$st" = inactive ]; then rm -f "$f" "$RUN/$n.cycles" "$b_f"; continue; fi # stopped on purpose: leave it alone
    local s_raw; s_raw=$(stats "$n")
    local rx_age; rx_age=$(jget "$s_raw" last_rx_age_ms 2>/dev/null || echo -1)
    if [ "$(jget "$s_raw" alive)" = true ] && [ "$rx_age" -ge 0 ] && [ "$rx_age" -lt 35000 ]; then
      rm -f "$f" "$RUN/$n.cycles"
      sla_f="$CONF/$n.sla"
      if [ -f "$sla_f" ]; then
        local min_r max_rtt max_loss rtt loss rate rate_kbps breached=0
        min_r=$(grep '^sla_min_rate_kbps=' "$sla_f" 2>/dev/null | cut -d= -f2)
        max_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" 2>/dev/null | cut -d= -f2)
        max_loss=$(grep '^sla_max_loss_pct=' "$sla_f" 2>/dev/null | cut -d= -f2)
        rtt=$(jget_flat "$s_raw" rtt_ms srtt_ms)
        loss=$(jget "$s_raw" loss_pct)
        rate=$(jget "$s_raw" rate_bps) # float64 in /stats: take the integer part, never do bash arithmetic on "1.2e+07"
        rate_kbps=$(awk -v r="${rate:-0}" 'BEGIN { printf "%d", r / 1000 }' 2>/dev/null)
        [ -n "$rate_kbps" ] || rate_kbps=0
        [ -n "$max_rtt" ] && [ "$max_rtt" -gt 0 ] && [ "${rtt%.*}" -gt "$max_rtt" ] 2>/dev/null && breached=1
        [ -n "$max_loss" ] && [ "$max_loss" -gt 0 ] && [ "${loss%.*}" -gt "$max_loss" ] 2>/dev/null && breached=1
        [ -n "$min_r" ] && [ "$min_r" -gt 0 ] && [ "$rate_kbps" -lt "$min_r" ] 2>/dev/null && breached=1
        if [ "$breached" = 1 ]; then
          local b_cnt=$(( $(cat "$b_f" 2>/dev/null || echo 0) + 1 ))
          echo "$b_cnt" >"$b_f"
          if [ "$b_cnt" -ge 3 ]; then
            logger -t wattun-heal "tunnel $n breached SLA for 3 consecutive checks (rtt=${rtt}ms, loss=${loss}%, rate=${rate_kbps}kbps), triggering re-evaluation"
            rm -f "$b_f"
            touch "$RUN/$n.sla_triggered"
            if [ -f "$CONF/$n.auto" ]; then
              heal_retest "$n"
            fi
          fi
        else
          rm -f "$b_f"
        fi
      fi
      continue
    fi
    cnt=$(( $(cat "$f" 2>/dev/null || echo 0) + 1 )); echo "$cnt" >"$f"
    if [ "$cnt" -ge 3 ]; then
      logger -t wattun-heal "tunnel $n down for $cnt checks, restarting"
      systemctl restart "${WAT_PREFIX}@$n"; rm -f "$f"
      cyc=$(( $(cat "$RUN/$n.cycles" 2>/dev/null || echo 0) + 1 )); echo "$cyc" >"$RUN/$n.cycles"
      # a direct Iran pool tunnel (single or bonded) that restarts do not fix: tell the operator the kit exists
      if [ "$cyc" -ge 2 ] && ! is_reverse "$n" && is_pool_list "$(cfg "$n" carrier)" \
         && [ "$(cfg "$n" fake-sni)" = '' ]; then
        logger -t wattun-heal "tunnel $n: restarts do not fix it and it runs with no anti-censor; if the route is being filtered, run: wattun blackout $n <allowlisted-name>"
      fi
      # still down after three restart cycles (9 checks) on a pool/icmp tunnel: try the full matrix unattended
      if [ "$cyc" -ge 3 ] && ! is_reverse "$n" && { is_pool "$(cfg "$n" carrier)" || [ "$(cfg "$n" carrier)" = icmp ]; }; then
        heal_matrix "$n"
      fi
      # auto tunnel still down after two restart cycles (6 checks): test the other connection types in the background
      # (a plain CDN tunnel gets a fresh Cloudflare edge scan instead: dead edge IPs are replaced)
      if [ "$cyc" -ge 2 ] && { [ -f "$CONF/$n.auto" ] || { cdn_ok && cdn_tunnel_p "$n"; }; }; then heal_retest "$n"; fi
    fi
  done
  # B3: hidden extended listeners are restarted by their own helper; pruned ones stay closed until a widen/reopen.
  heal_ext_listeners
  # R3: an auto Kharej tunnel closes what is provably unused once Iran's pick has been stable for the grace window:
  # reverse companion/watchers by default, the full carrier set only with autoprune-direct=1 (D1); autoprune in
  # .manager.conf, $CONF/NAME.keepopen opts one tunnel out. The widen pass below is the safety net: a narrowed tunnel
  # that lost every open carrier reopens the whole plan (bounded by autowiden minutes). Only the Kharej side runs these;
  # the client-only checks above are role-gated to Iran, so heal() is safe on a server host.
  for n in $(tunnels); do
    [ "$(role "$n")" = Kharej ] && is_auto_kharej "$n" || continue
    auto_prune_tick "$n"
    auto_widen_tick "$n"
  done
}
# A running tunnel keeps executing the binary it was started with. Once update/rollback replaces the file,
# /proc/PID/exe reads "... (deleted)": that tunnel still runs the OLD version until it is restarted.
bin_ver() { "${1:-$BIN}" -version 2>/dev/null | awk '{print $2; exit}'; }
is_stale() {
  local pid
  pid=$(systemctl show -p MainPID --value "${WAT_PREFIX}@$1" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" != 0 ] && [[ "$(readlink "/proc/$pid/exe" 2>/dev/null)" == *"(deleted)"* ]]
}
stale_tunnels() { local n; for n in $(tunnels_all); do systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null && is_stale "$n" && printf '%s ' "$n"; done; } # hidden extended listeners included
restart_stale() { # offer to restart tunnels that still run the old binary, then prove they switched
  local st n bad=''
  st=$(stale_tunnels)
  [ -n "$st" ] || { ok "All running tunnels use wattun $(bin_ver)."; return 0; }
  warn "Still running the OLD binary: ${BOLD}${st% }${RST}"
  hint "They switch to $(bin_ver) only after a restart. A restart drops open connections for a few seconds."
  confirm "Restart them now?" y || { hint "Later: open the tunnel and press [r], or Settings -> restart all."; return 0; }
  for n in $st; do step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"; done
  sleep 1
  for n in $st; do is_stale "$n" && bad="$bad $n"; done
  if [ -n "$bad" ]; then err "Still on the old binary:$bad (see: journalctl -u ${WAT_PREFIX}@NAME)"; return 1; fi
  ok "Tunnels now run wattun $(bin_ver)."
}
restart_all() {
  local n c=0
  for n in $(tunnels_all); do # hidden extended listeners restart with their parent
    if systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null || systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"; c=$((c+1))
    fi
  done
  [ "$c" -gt 0 ] || warn "No tunnels to restart."
}
update() { # [installer args...]
  local url="https://raw.githubusercontent.com/$REPO/main/install.sh" tmp before after mbefore imgr a
  local ienv=()
  if [ "$SANDBOX" = 1 ]; then
    for a in "$@"; do [ "$a" = --uninstall ] && { err "Sandbox: use the manager's uninstall (Settings), not the installer's --uninstall (it removes the production units)."; return 1; }; done
    imgr=$MGR; [ "$MGR" = /usr/local/bin/wattun-manager ] && imgr=${BIN%/*}/wattun-manager
    mkdir -p "${BIN%/*}" || { err "Cannot create ${BIN%/*}"; return 1; }
    say "  Sandbox $WAT_PREFIX: the update writes only $BIN, $imgr and $CONF (not /usr/local/bin, not wattun@.service)."
  fi
  before=$(bin_ver); mbefore=$(cksum <"${imgr:-$MGR}" 2>/dev/null)
  tmp=$(mktemp /tmp/wattun-install.XXXXXX)
  local sums=$tmp.SHA256SUMS sig=$tmp.SHA256SUMS.sig mkeep
  trap 'rm -f ${tmp:+"$tmp"} ${tmp:+"$tmp.unit"} ${sums:+"$sums"} ${sig:+"$sig"} ${mkeep:+"$mkeep"}' EXIT # a kill mid-update must not leave root-owned temp files
  [ "$SANDBOX" = 1 ] && ienv=(WAT_BIN="$BIN" WAT_MGR="$imgr" WAT_CONF="$CONF" WAT_UNIT="$tmp.unit" WAT_REQUIRE_SANDBOX=1) # the installer's unit file goes to a throwaway path
  # keep the current manager so a bad replacement can be undone
  mkeep=$(mktemp /tmp/wattun-mgr.XXXXXX); cp -f "${imgr:-$MGR}" "$mkeep" 2>/dev/null || { rm -f "$mkeep"; mkeep=""; }
  if [ "${WAT_ALLOW_UNSIGNED_UPDATE:-0}" = 1 ]; then
    warn "WAT_ALLOW_UNSIGNED_UPDATE=1: fetching the installer without a signature check (only if you trust the source)."
    # raw.githubusercontent.com caches main for minutes: resolve main to a commit sha and fetch everything by it
    local sha mref="" rc
    sha=$(curl -fsSL --max-time 10 "${WAT_PROXY:-}https://api.github.com/repos/$REPO/commits/main" 2>/dev/null | grep -m1 '"sha"' | sed -n 's/.*"sha"[^"]*"\([0-9a-f]\{40\}\)".*/\1/p')
    if [ -n "$sha" ]; then url="https://raw.githubusercontent.com/$REPO/$sha/install.sh"; mref=$sha; ienv+=(WAT_MGR_REF="$sha")
    else warn "Could not resolve the latest commit; using the main branch (GitHub's cache may be a few minutes old)."; fi
    spin_start "Downloading the installer"
    curl -fsSL --max-time 60 --retry 2 -o "$tmp" "${WAT_PROXY:-}$url"; rc=$?
    spin_stop
    if [ "$rc" -ne 0 ] || ! head -c 2 "$tmp" | grep -q '#!'; then
      rm -f "$tmp" "$mkeep"; err "Update failed (could not download the installer). If GitHub is blocked: WAT_PROXY=https://ghproxy.net/ $SELF update"; return 1
    fi
    ok "Installer downloaded UNSIGNED${mref:+ (${mref:0:7})}"
  else
    # Release assets are immutable: verify the installer against the release's RSA-signed SHA256SUMS, then run it.
    local base="${WAT_PROXY:-}https://github.com/$REPO/releases/latest/download" rc got verified=0
    local refusal="Cannot verify the installer against the signed release; refusing to run it unverified. Install manually from https://github.com/$REPO/releases or set WAT_ALLOW_UNSIGNED_UPDATE=1 to override."
    if command -v openssl >/dev/null 2>&1; then
      spin_start "Downloading the installer and its signature"
      curl -fsSL --max-time 60 --retry 2 -o "$tmp" "$base/install.sh" \
        && curl -fsSL --max-time 60 --retry 2 -o "$sums" "$base/SHA256SUMS" \
        && curl -fsSL --max-time 60 --retry 2 -o "$sig" "$base/SHA256SUMS.sig"
      rc=$?
      spin_stop
      if [ "$rc" -eq 0 ] && sums_verify "$sums" "$sig"; then
        got=$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')
        if [ -n "$got" ] && sums_has "$sums" install.sh "$got"; then verified=1; fi
      fi
    else
      warn "openssl is required to check the release signature."
    fi
    if [ "$verified" != 1 ]; then
      rm -f "$tmp" "$sums" "$sig" "$mkeep"
      hint "The latest release must ship install.sh with SHA256SUMS and SHA256SUMS.sig signed by the pinned key."
      err "$refusal"; return 1
    fi
    ok "Installer verified against the signed release"
  fi
  env ${ienv[@]+"${ienv[@]}"} WAT_FROM_MANAGER=1 bash "$tmp" "$@"; rc=$?
  rm -f "$tmp" "$tmp.unit" "$sums" "$sig"
  trap - EXIT
  [ "$rc" -eq 0 ] || { rm -f "$mkeep"; err "The installer reported an error. Nothing was changed: still wattun ${before:-?}."; return 1; }
  # self-check: in a sandbox the new manager must understand WAT_PREFIX, or it would drive the production paths
  if [ "$SANDBOX" = 1 ] && [ -n "$mkeep" ] && ! grep -q 'WAT_PREFIX' "${imgr:-$MGR}" 2>/dev/null; then
    install -m 755 "$mkeep" "${imgr:-$MGR}.new" && mv -f "${imgr:-$MGR}.new" "${imgr:-$MGR}"
    rm -f "$mkeep"; err "The new manager has no sandbox (WAT_PREFIX) support; the previous manager was restored."; return 1
  fi
  rm -f "$mkeep"
  after=$(bin_ver)
  echo
  if [ -z "$after" ]; then err "$BIN does not run after the update. Roll back from the dashboard ([r])."; return 1
  elif [ "$after" != "$before" ]; then ok "wattun updated: ${BOLD}${before:-none} -> $after${RST}"
  else ok "wattun is already the latest release (${BOLD}$after${RST})."; fi
  [ "$(cksum <"${imgr:-$MGR}" 2>/dev/null)" != "$mbefore" ] && ok "Manager updated."
  restart_stale
  return 0
}
rollback() {
  [ -x "$BIN.prev" ] || { warn "No previous version saved."; return 0; }
  say "  Current: ${BOLD}$($BIN -version 2>&1)${RST}    Previous: ${BOLD}$($BIN.prev -version 2>&1)${RST}"
  echo
  confirm "Roll back to the previous version?" n || return 0
  cp -f "$BIN" "$BIN.rb" && mv -f "$BIN.prev" "$BIN" && mv -f "$BIN.rb" "$BIN.prev"
  ok "Rolled back: wattun is now ${BOLD}$(bin_ver)${RST}."
  restart_stale
  return 0
}
uninstall_all() {
  local n list=() u units p
  for n in $(tunnels_all); do list+=("$n"); done # B3: hidden extended listeners are removed with their parent
  echo
  if [ "${#list[@]}" -gt 0 ]; then
    warn "These tunnels will be stopped:"
    for n in "${list[@]}"; do printf '      %s%-14s%s %s · %s\n' "$BOLD" "$n" "$RST" "$(role "$n")" "$(cfg "$n" carrier)"; done
  else hint "No tunnels are configured."; fi
  echo
  if [ "$NONINTERACTIVE" = 1 ]; then REPLY_V=uninstall # --yes is the confirmation
  else ask "Type 'uninstall' to remove WatTunnel (empty = cancel)" ""; fi
  [ "$REPLY_V" = uninstall ] || { warn "Cancelled."; return 1; }
  heal_disable >/dev/null 2>&1 # stops the timer and removes its unit files (heal_disable removes them)
  # loaded instances plus every configured name (enabled-but-unloaded ones are not in list-units)
  units=$(systemctl list-units --all --plain --no-legend "${WAT_PREFIX}@*" 2>/dev/null | awk '{print $1}')
  for n in "${list[@]}"; do units+=$'\n'"${WAT_PREFIX}@$n.service"; done
  for u in $(printf '%s\n' "$units" | sort -u); do
    systemctl disable --now "$u" >/dev/null 2>&1
  done
  # F17: the hidden extended listeners had a UDP rule opened per child; close them while their configs are readable
  for n in "${list[@]}"; do
    is_auto_ext "$n" || continue
    p=$(cfg "$n" listen); p=${p##*:}
    [ -n "$p" ] && is_shaped_udp "$(cfg "$n" carrier)" && fw_close "$p/udp"
  done
  kreply_restore
  # every timer/transient unit the manager created for a tunnel goes with it (bond-retest, watcher, retest, matrix)
  for u in /etc/systemd/system/"${WAT_PREFIX}-bondretest-"*.service /etc/systemd/system/"${WAT_PREFIX}-bondretest-"*.timer; do
    [ -e "$u" ] || continue
    systemctl disable --now "${u##*/}" >/dev/null 2>&1
    rm -f "$u"
  done
  for u in $(systemctl list-units --all --plain --no-legend "${WAT_PREFIX}-autowatch-*" "${WAT_PREFIX}-autoretest-*" "${WAT_PREFIX}-matrix-*" 2>/dev/null | awk '{print $1}'); do
    systemctl stop "$u" >/dev/null 2>&1; systemctl reset-failed "$u" >/dev/null 2>&1
  done
  # F8: a custom state-dir puts totals/quota outside $CONF; remove each tunnel's files before its config goes
  for n in "${list[@]}"; do
    while IFS= read -r u; do rm -f "$u"; done < <(state_files "$n")
  done
  rm -f "/etc/systemd/system/${WAT_PREFIX}@.service" "$BIN" "$BIN.prev"
  [ "$SANDBOX" = 1 ] && rm -rf "$RUN" "$AUTO_RUN"
  if [ "$SANDBOX" = 1 ] && [ "${BIN%/*}" = "/opt/$WAT_PREFIX" ]; then rm -rf "/opt/$WAT_PREFIX"; ok "Removed /opt/$WAT_PREFIX"; fi
  systemctl daemon-reload
  ok "Services and binaries removed."
  if [ -d "$CONF" ] && confirm "Also delete $CONF (tunnel configs, keys, tokens)?" "$([ "$SANDBOX" = 1 ] || [ "$NONINTERACTIVE" = 1 ] && echo y || echo n)"; then rm -rf "$CONF"; ok "Configuration deleted."; fi
  ok "WatTunnel removed."
  if [ "$SANDBOX" = 1 ]; then
    if [ "${MGR%/*}" = "/opt/$WAT_PREFIX" ]; then rm -rf "/opt/$WAT_PREFIX"; ok "Removed /opt/$WAT_PREFIX (including this script)"
    else hint "Sandbox: this script ($MGR) was left in place; delete it by hand if you copied it."; fi
  else rm -f "$MGR"; fi
  return 0
}
settings_menu() {
  local heal_on anim_on
  while :; do
    systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null && heal_on="${GRN}on${RST} " || heal_on="${GRY}off${RST}"
    [ "$(conf_get anim 1)" = 1 ] && anim_on="${GRN}on${RST} " || anim_on="${GRY}off${RST}"
    page "Settings"
    printf '  %s auto-heal   %s  %srestarts a down Iran tunnel; cleans up auto tunnels%s\n' "$(key_label h)" "$heal_on" "$GRY" "$RST"
    printf '  %s animations  %s  %sspinners and the intro%s\n' "$(key_label a)" "$anim_on" "$GRY" "$RST"
    printf '  %s kernel speed boost\n' "$(key_label b)"
    local sd; sd=$(server_side)
    printf '  %s this server %s%s%s\n' "$(key_label w)" "$BOLD" "${sd:-not set}" "$RST"
    echo
    menu_line r 'restart all tunnels' v 'roll back to the previous version'
    hr
    printf '  %s back%*s%s %suninstall WatTun%s\n' "$(key_label 0)" 47 '' "$(key_label x)" "$RED" "$RST"
    key_read
    case "$KEY" in
      v|V) page "Roll back"; echo; run_flow rollback; pause ;;
      x|X) page "Uninstall"; if run_flow uninstall_all; then exit 0; fi; pause ;;
      h|H) echo; if systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null; then heal_disable; else heal_enable; fi; sleep 1 ;;
      r|R) echo; if confirm "Restart all tunnels? Open connections drop." n; then restart_all; sleep 1; fi ;;
      a|A) if [ "$(conf_get anim 1)" = 1 ]; then conf_set anim 0; ANIM=0; else conf_set anim 1; [ "$IS_TTY" = 1 ] && [ "${WAT_NO_ANIM:-0}" != 1 ] && ANIM=1; fi ;;
      b|B) boost_menu ;;
      w|W) ask_side || true ;;
      0|q|enter|esc) return 0 ;;
      *) : ;;
    esac
  done
}

