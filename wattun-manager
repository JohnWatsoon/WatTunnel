      if [ "$r" = Kharej ]; then
        split_hp "$(cfg "$n" peer)"; pp=$HP_PORT
        v_port "$pp" >/dev/null 2>&1 || { err "Cannot read the carrier port from peer."; return 1; }
        set_value "$n" listen "\":$pp\""
        unset_value "$n" peer; unset_value "$n" sni; unset_value "$n" host
        fw_open "$pp/$pr"
      else
        unset_value "$n" listen
      fi
      unset_value "$n" reverse
    else
      confirm "Switch '$n' to reverse (Kharej connects out to Iran)?" n || return 1
      if [ "$r" = Kharej ]; then
        split_hp "$(cfg "$n" listen)"; pp=$HP_PORT
        v_port "$pp" >/dev/null 2>&1 || { err "Cannot read the carrier port from listen."; return 1; }
        ask_ok "Iran server IP address (IPv4 or IPv6)" "" v_ip || return 1; ip=$REPLY_V
        set_value "$n" peer "$(join_hp "$ip" "$pp")"
        [ "$cr" = udp ] || unset_value "$n" listen # reverse udp keeps it: the source port of the punches
        if [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")" && [ -n "$T_SNI" ]; then
          set_value "$n" sni "$T_SNI"; set_value "$n" host "$T_SNI"
        fi
      else
        split_hp "$(cfg "$n" peer)"; pp=$HP_PORT
        v_port "$pp" >/dev/null 2>&1 || { err "The peer has no carrier port, so reverse cannot be set up."; return 1; }
        pp=$((10#$pp))
        if listen_blocked "$pr" "$pp"; then err "Port $pp/$pr is already in use here by $(listen_conflict_desc "$pr" "$pp")."; return 1; fi
        set_value "$n" listen "\":$pp\""
        fw_open "$pp/$pr"
      fi
      set_value "$n" reverse true
      local ofm; ofm=$(cfg "$n" fake-mode)
      case "$ofm" in sum|seqsum)
        set_value "$n" fake-mode rst; warn "fake-mode $ofm changed to rst: checksum markers are refused on a reverse tunnel." ;;
      esac
    fi
  elif is_reverse "$n"; then
    confirm "Switch '$n' back to the normal direction (Iran sends the pings)?" n || return 1
    unset_value "$n" reverse
    [ "$r" = Kharej ] && unset_value "$n" peer
  else
    confirm "Switch '$n' to reverse (Kharej sends the pings)?" n || return 1
    if [ "$r" = Kharej ]; then
      ask_ok "Iran server IPv4 address" "" v_ipv4 || return 1; ip=$REPLY_V
      set_value "$n" peer "$ip"
    fi
    set_value "$n" reverse true
  fi
  if [ "$cr" = icmp ]; then
    if kreply_wanted "$n"; then kreply_offer; else kreply_users_left || kreply_restore; fi
  fi
  if [ "$r" = Kharej ] && [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")"; then
    T_REV=''; is_reverse "$n" && T_REV=1
    make_token "$T_CARRIER" "$T_PEER" "$T_KEY" "$T_PATH" "$T_SNI" "$T_ICMP" "$T_PORTS" "$T_REV" "$T_AUTO" "$T_PAIR" >"$CONF/$n.token"
  fi
  warn "Change it on the $([ "$r" = Kharej ] && echo Iran || echo Kharej) server too (Advanced, d), or the link stays down."
  return 0
}
# Validators that need context from adv_menu (its prompts are single-value, so the context travels in these globals):
# the carrier list for sessions/mtu, and the other FEC threshold when checking the loss band.
ADV_CR=''; ADV_REV=0; FEC_ON_CUR=2; FEC_OFF_CUR=0.5
v_sessions_adv() { v_sessions "$1" "$ADV_CR" "$ADV_REV"; }
v_mtu_adv() { v_mtu "$1" "$ADV_CR"; }
v_udp_hop() { # packets per source port, 0 = off, else 2..1000 (Wraith, 3.3.9)
  case "${1:-}" in ''|-|default|0) return 0 ;; *[!0-9]*) err "Enter a whole number."; return 1 ;; esac
  [ "$1" -ge 2 ] && [ "$1" -le 1000 ] || { err "Use 2 to 1000 (0 = off)."; return 1; }
}
hop_ok() { # name -> 0 when the tunnel can use -udp-hop: an Iran udp client (single carrier or a bond leg), not reverse
  [ "$(role "$1")" = Iran ] && ! is_reverse "$1" && case "+$(cfg "$1" carrier)+" in *+udp+*) return 0 ;; esac
  return 1
}
v_fec_on_adv() { v_fec_on "$1" "$FEC_OFF_CUR"; }
v_fec_off_adv() { v_fec_off "$1" "$FEC_ON_CUR"; }
adv_33() { # H4: the 3.3.0-only keys cannot go into a config an older engine reads (unknown key stops startup)
  [ -n "$(bin_ver_ok 3.3.0)" ] && return 0
  err "This setting needs wattun 3.3.0 or newer on this server (run: $SELF update); an older engine rejects the key at startup."
  return 1
}
adv_menu() { # name : max-mbps, fec, bind, icmp-type, direction, state files, FEC loss band, shaping, admission
  local n=$1 r changed=0 v cr fec_auto noise_m noisy noisw noiwin nm cb k33 wm_ok lc_ok lc
  r=$(role "$n"); cr=$(cfg "$n" carrier)
  while :; do
    # H4: the manager ships from main while the engine comes from releases/latest, so a 3.3.0-only key must never be
    # written into a config an older engine reads (it stops startup on an unknown key). Every 3.3.0-only row/case below
    # is hidden or refused unless this server's engine is >= 3.3.0.
    k33=0; [ -n "$(bin_ver_ok 3.3.0)" ] && k33=1
    wm_ok=0; [ -n "$(bin_ver_ok 3.0.3)" ] && wm_ok=1 # A3: -win-max exists since 3.0.3
    lc_ok=0; [ -n "$(bin_ver_ok 3.0.0)" ] && lc_ok=1 # A3: -loss-ceiling exists since 3.0.0
    # the direction can change inside this page, and sessions/mtu are validated against it
    ADV_CR=$cr; ADV_REV=0; is_reverse "$n" && ADV_REV=1
    FEC_ON_CUR=$(cfg "$n" fec-on-loss); FEC_ON_CUR=${FEC_ON_CUR:-2}
    FEC_OFF_CUR=$(cfg "$n" fec-off-loss); FEC_OFF_CUR=${FEC_OFF_CUR:-0.5}
    fec_auto=0; [ "$(cfg "$n" fec)" = auto ] && fec_auto=1
    noise_m=$(cfg "$n" noise); [ -n "$noise_m" ] || noise_m=off
    noisy=0; { [ "$noise_m" = custom ] || [ -n "$(cfg "$n" noise-bps)" ]; } && noisy=1
    noisw=0; { [ "$noise_m" != off ] || [ -n "$(cfg "$n" noise-window)" ]; } && noisw=1
    page "Advanced" "$n"
    # A1: four named groups, same letters and gates. Group order: Performance (what moves bytes), Shaping & DPI (what
    # changes bytes on the wire), Safety (who gets in / which way), State & data (3.3.0-only persistence).
    adv_group Performance
    set_row m 'speed limit' "$(cfg "$n" max-mbps)" 'MB/s' 'none'
    [ "$r" = Iran ] && set_row s sessions "$(cfg "$n" sessions)" '' auto # client-only in the engine
    set_row c conns "$(cfg "$n" conns)" '' auto
    set_row u mtu "$(cfg "$n" mtu)" '' auto
    [ "$cr" = icmp ] && set_row i 'icmp type' "$(cfg "$n" icmp-type)" '' echo
    case "$cr" in icmp|udp) set_row y batching "$(cfg "$n" batch)" '' "$([ "$cr" = icmp ] && echo on || echo off)" ;; esac
    hop_ok "$n" && set_row h 'udp hop' "$(cfg "$n" udp-hop)" 'pkts/port' off
    [ "$wm_ok" = 1 ] && set_row e 'win max' "$(cfg "$n" win-max)" 'MB' 'auto'
    if [ "$lc_ok" = 1 ]; then # bool key: display on/off, write true/false (Go flag Set rejects "on")
      lc=$(cfg "$n" loss-ceiling); v=''; [ "$lc" = true ] && v=on
      set_row r 'loss ceiling' "$v" '' off
    fi
    adv_group 'Shaping & DPI'
    set_row f fec "$(cfg "$n" fec)" '' off
    [ "$fec_auto" = 1 ] && [ "$k33" = 1 ] && set_row o 'fec on loss' "$(cfg "$n" fec-on-loss)" '%' 2
    [ "$fec_auto" = 1 ] && [ "$k33" = 1 ] && set_row x 'fec off loss' "$(cfg "$n" fec-off-loss)" '%' 0.5
    if [ "$k33" = 1 ]; then
      set_row p 'shape data' "$(cfg "$n" shape-data)" '%' off
      [ "$noise_m" = off ] && set_row n noise '' '' off || set_row n noise "$noise_m"
      [ "$noisy" = 1 ] && set_row g 'noise bps' "$(cfg "$n" noise-bps)" 'B/s' 'custom only'
      [ "$noisw" = 1 ] && set_row w 'noise window' "$(cfg "$n" noise-window)" '' 'all day'
    fi
    if ac_dialer "$n"; then
      v=off; [ -n "$(cfg "$n" fake-sni)$(cfg "$n" pool-rotate)$(cfg "$n" ech)" ] || [ "$(cfg "$n" governor)" = true ] && v=on
      set_row k anti-censor "$v"
    fi
    adv_group Safety
    if [ "$k33" = 1 ] && [ "$r" = Kharej ]; then # admission allowlist: server side only (the client cannot enforce it)
      if allow_clients_cdn_risk "$cr" "$(cfg "$n" sni)"; then
        hint "Admission allowlist is unavailable here: a CDN carrier or sni makes the source the CDN edge (engine refuses it)."
      else
        set_row j 'allow clients' "$(cfg "$n" allow-clients)" '' 'any source'
        set_row l 'allow clients file' "$(cfg "$n" allow-clients-file)" '' 'none'
      fi
    fi
    [ "$r" = Iran ] && set_row a bind "$(cfg "$n" bind)" '' 0.0.0.0
    if rev_capable "$cr"; then
      if is_reverse "$n"; then v="reverse ${GRY}($([ "$cr" = icmp ] && echo "Kharej sends the pings" || echo "Kharej connects to Iran"))${RST}"
      else v="normal ${GRY}($([ "$cr" = icmp ] && echo "Iran sends the pings" || echo "Iran connects to Kharej"))${RST}"; fi
      set_row d direction "$v"
    fi
    if [ "$k33" = 1 ]; then
      adv_group 'State & data'
      set_row t 'state dir' "$(cfg "$n" state-dir)" '' 'next to config'
      set_row v 'state save' "$(cfg "$n" state-save)" 's' 30
    fi
    echo
    hint "Applies on exit (restarts tunnel). File-only keys: docs/TECHNICAL.md"
    menu_line 0 back
    key_read
    case "$KEY" in
      m) echo; ask_ok "Speed ceiling in MB/s (- or 0 or default = unset)" "$(cfg "$n" max-mbps)" v_mbps_adv || continue
         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" max-mbps; else set_value "$n" max-mbps "$REPLY_V"; fi; changed=1 ;;
      s) [ "$r" = Iran ] || continue
         echo; ask_ok "Sessions count 1-$ENG_MAX_SESSIONS (- or 0 or default = unset)" "$(cfg "$n" sessions)" v_sessions_adv || continue
         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" sessions; else set_value "$n" sessions "$REPLY_V"; fi; changed=1 ;;
      c) echo; ask_ok "Conns count 1-$ENG_MAX_CONNS (- or 0 or default = unset)" "$(cfg "$n" conns)" v_conns || continue
         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" conns; else set_value "$n" conns "$REPLY_V"; fi; changed=1 ;;
      u) echo; ask_ok "MTU $ENG_MTU_MIN-$(mtu_max_for "$cr") for carrier '$cr' (- or 0 or default = unset)" "$(cfg "$n" mtu)" v_mtu_adv || continue
         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" mtu; else set_value "$n" mtu "$REPLY_V"; fi; changed=1 ;;
      k) ac_dialer "$n" || continue; anticensor_menu "$n" ;;
      f) echo; ask_ok "FEC: off or auto" "$(cfg "$n" fec | sed 's/^$/off/')" v_fec || continue
         if [ "$REPLY_V" = off ]; then unset_value "$n" fec; else set_value "$n" fec "$REPLY_V"; fi; changed=1 ;;
      o) [ "$fec_auto" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "Enables FEC parity above this loss % (0 < on <= 50)."
         ask_ok "FEC on-loss percent (above $FEC_OFF_CUR%)" "$(cfg "$n" fec-on-loss)" v_fec_on_adv || continue
         case "$REPLY_V" in
           ''|-|default)
             awk -v o="$FEC_OFF_CUR" 'BEGIN{exit !(2 > o)}' \
               || { err "fec-off-loss is $FEC_OFF_CUR %, so default 2 % is not above it; lower fec-off-loss first."; continue; }
             unset_value "$n" fec-on-loss ;;
           *) set_value "$n" fec-on-loss "$REPLY_V" ;;
         esac; changed=1 ;;
      x) [ "$fec_auto" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "Stops FEC parity below this loss % (must stay below fec-on-loss)."
         ask_ok "FEC off-loss percent (below $FEC_ON_CUR%)" "$(cfg "$n" fec-off-loss)" v_fec_off_adv || continue
         case "$REPLY_V" in
           ''|-|default)
             awk -v n="$FEC_ON_CUR" 'BEGIN{exit !(0.5 < n)}' \
               || { err "fec-on-loss is $FEC_ON_CUR %, so default 0.5 % is not below it; raise fec-on-loss first."; continue; }
             unset_value "$n" fec-off-loss ;;
           *) set_value "$n" fec-off-loss "$REPLY_V" ;;
         esac; changed=1 ;;
      t) adv_33 || { sleep 1; continue; }
         echo; hint "Use /run/wattun (tmpfs, cleared on reboot); custom paths require unit write access."
         ask_ok "State directory (absolute; 0 or - = next to config)" "$(cfg "$n" state-dir)" v_state_dir || continue
         case "$REPLY_V" in
           ''|-|default|0) unset_value "$n" state-dir; ok "State files stay next to config." ;;
           *) set_value "$n" state-dir "${REPLY_V%/}"; ok "State dir: ${REPLY_V%/}." ;;
         esac
         changed=1 ;;
      v) adv_33 || { sleep 1; continue; }
         echo; ask_ok "State save interval in seconds (0 = shutdown only)" "$(cfg "$n" state-save)" v_state_save || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" state-save; ok "Default: 30 s." ;;
           *) set_value "$n" state-save "$REPLY_V"; ok "State save: ${REPLY_V} s." ;;
         esac; changed=1 ;;
      p) adv_33 || { sleep 1; continue; }
         echo; hint "Pads stream packets up to N% (0 = off, max 25%). Spends bandwidth."
         ask_ok "shape-data percent (0..25)" "$(cfg "$n" shape-data)" v_shape_data || continue
         case "$REPLY_V" in
           ''|-|default|0|0.0) unset_value "$n" shape-data; ok "shape-data off." ;;
           *) set_value "$n" shape-data "$REPLY_V"; ok "shape-data: $REPLY_V%." ;;
         esac; changed=1 ;;
      n) adv_33 || { sleep 1; continue; }
         echo; hint "Idle filler per session: low ~11 MB/d, med ~88 MB/d (multiplied by -sessions)."
         ask "noise: off, low, med or custom" "$(cfg "$n" noise | sed 's/^$/off/')"
         v_noise_mode "$REPLY_V" || continue
         nm=$REPLY_V
         case "$nm" in
           ''|off) unset_value "$n" noise; unset_value "$n" noise-bps; ok "Idle noise off." ;;
           low|med) set_value "$n" noise "$nm"; unset_value "$n" noise-bps; ok "Idle noise: $nm." ;;
           custom)
             cb=$(cfg "$n" noise-bps); case "$cb" in ''|*[!0-9]*) cb=1024 ;; esac
             [ "$cb" -ge 64 ] && [ "$cb" -le 1000000 ] || cb=1024
             ask_ok "Noise filler bytes/second (64..1000000)" "$cb" v_noise_bps || continue
             set_value "$n" noise-bps "$REPLY_V"; set_value "$n" noise custom
             ok "Idle noise: $REPLY_V B/s." ;;
         esac; changed=1 ;;
      g) [ "$noise_m" = custom ] || continue; adv_33 || { sleep 1; continue; }
         echo; ask_ok "Noise filler bytes/second (64..1000000)" "$(cfg "$n" noise-bps)" v_noise_bps || continue
         set_value "$n" noise-bps "$REPLY_V"; ok "Idle noise: $REPLY_V B/s."; changed=1 ;;
      w) [ "$noisw" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; ask_ok "Noise window HH:MM-HH:MM (empty = all day)" "$(cfg "$n" noise-window)" v_noise_window || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" noise-window; ok "Noise window: all day." ;;
           *) set_value "$n" noise-window "$REPLY_V"; ok "Noise window: $REPLY_V." ;;
         esac; changed=1 ;;
      j) [ "$r" = Kharej ] || continue; adv_33 || { sleep 1; continue; }
         allow_clients_cdn_risk "$cr" "$(cfg "$n" sni)" && { err "Refused with CDN carrier or sni (source is CDN edge)."; sleep 1; continue; }
         echo; hint "Admits only these source IPs/CIDRs on restart (ignored in reverse mode)."
         ask_ok "Allowed client addresses/CIDRs (- = any)" "$(cfg "$n" allow-clients)" v_allow_clients || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" allow-clients; ok "Allowlist cleared (any source)." ;;
           *) set_value "$n" allow-clients "$REPLY_V"
              [ -n "$(cfg "$n" allow-clients-file)" ] && warn "allow-clients-file overrides this inline list."
              ok "Allowed clients: $REPLY_V" ;;
         esac; changed=1 ;;
      l) [ "$r" = Kharej ] || continue; adv_33 || { sleep 1; continue; }
         allow_clients_cdn_risk "$cr" "$(cfg "$n" sni)" && { err "Refused with CDN carrier or sni (source is CDN edge)."; sleep 1; continue; }
         echo; hint "One IP/CIDR per line under $(allow_clients_dir)/; an empty file stops startup."
         ask_ok "Allowlist file (under $(allow_clients_dir)/; - = none)" "$(cfg "$n" allow-clients-file)" v_allow_clients_file || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" allow-clients-file; ok "Allowlist file cleared." ;;
           *) set_value "$n" allow-clients-file "$REPLY_V"; ok "Allowlist file: $REPLY_V." ;;
         esac; changed=1 ;;
      a) [ "$r" = Iran ] || continue; echo; ask_ok "Bind address" "$(cfg "$n" bind | sed 's/^$/0.0.0.0/')" v_bind || continue
         if [ "$REPLY_V" = 0.0.0.0 ]; then unset_value "$n" bind; else set_value "$n" bind "$REPLY_V"; fi; changed=1 ;;
      i) [ "$cr" = icmp ] || continue; echo; hint "Must match Kharej."; ask_ok "ICMP type" "$(cfg "$n" icmp-type | sed 's/^$/echo/')" v_icmp || continue
         if [ "$REPLY_V" = echo ]; then unset_value "$n" icmp-type; else set_value "$n" icmp-type "$REPLY_V"; fi; changed=1 ;;
      h) hop_ok "$n" || continue
         [ -n "$(bin_ver_ok 3.3.9)" ] || { err "udp hop needs wattun 3.3.9+ on this server (run: $SELF update)."; sleep 1; continue; }
         echo; hint "Sends from a new UDP source port every N-1.5N packets: passes a filter that cuts each flow after ~30 packets. 12 = field setting. Any Kharej connects; Kharej 3.3.9+ downloads at full speed."
         ask_ok "Packets per source port (0 = off)" "$(cfg "$n" udp-hop)" v_udp_hop || continue
         case "$REPLY_V" in ''|-|default|0) unset_value "$n" udp-hop ;; *) set_value "$n" udp-hop "$REPLY_V" ;; esac; changed=1 ;;
      y) case "$cr" in icmp|udp) ;; *) continue ;; esac
         echo; ask "Batching (on, off, default; needs 3.0.0+)" "$(cfg "$n" batch | sed 's/^$/default/')"
         case "$REPLY_V" in
           on|off) [ "$(bin_ver_ok 3.0.0)" = 1 ] || { err "batch needs wattun 3.0.0+ (run: $SELF update)."; sleep 1; continue; }
              set_value "$n" batch "$REPLY_V"; changed=1 ;;
           default|-|'') unset_value "$n" batch; changed=1 ;;
           *) err "Use on, off or default."; sleep 1 ;;
         esac ;;
      e) [ "$wm_ok" = 1 ] || { err "win-max needs wattun 3.0.3+ (run: $SELF update)."; sleep 1; continue; }
         echo; ask_ok "Stream receive window cap in MB (4-64; 0/- = auto)" "$(cfg "$n" win-max | sed 's/^$/0/')" v_win_max || continue
         case "$REPLY_V" in ''|-|0|default) unset_value "$n" win-max; ok "win-max: auto." ;;
           *) set_value "$n" win-max "$REPLY_V"; ok "win-max: $REPLY_V MB." ;;
         esac; changed=1 ;;
      r) [ "$lc_ok" = 1 ] || { err "loss-ceiling needs wattun 3.0.0+ (run: $SELF update)."; sleep 1; continue; }
         echo; hint "Also cut rate on sudden loss spikes (default is delay-only CC)."
         ask "Loss ceiling: on or off" "$([ "$(cfg "$n" loss-ceiling)" = true ] && echo on || echo off)"
         v_loss_ceiling "$REPLY_V" || { sleep 1; continue; }
         case "$REPLY_V" in on|true|1) set_value "$n" loss-ceiling true; ok "loss-ceiling on." ;;
           *) unset_value "$n" loss-ceiling; ok "loss-ceiling off." ;;
         esac; changed=1 ;;
      d) rev_capable "$cr" || continue; echo
         # applied at once, so the direction never sits in the file without running
         set_direction "$n" && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
         pause ;;
      b|0|q|enter|esc) break ;;
      *) : ;;
    esac
  done
  # Every setting here needs a restart; apply it automatically (an unapplied change only logs "restart needed").
  if [ "$changed" = 1 ]; then
    if [ "$r" = Kharej ] && is_auto_kharej "$n"; then
      auto_sync_helper_settings "$n"
      step "Restarting ${WAT_PREFIX}@$n to apply" auto_for_each_unit "$n" restart
    else
      step "Restarting ${WAT_PREFIX}@$n to apply" systemctl restart "${WAT_PREFIX}@$n"
    fi
  fi
  return 0
}

# ======================================================================================
#  Automated Anti-Censorship Testing & Verification
# ======================================================================================
anticensor_test() {
  local n=$1 r cr peer s alive=false srtt pkts_in pkts_out fprof ech_st gov_st
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n"); cr=$(cfg "$n" carrier); peer=$(cfg "$n" peer)
  ac_dialer "$n" || { err "'$n' does not dial the carrier (anti-censorship verification runs on the dialing end)."; return 1; }
  echo
  say "  ${BOLD}Anti-censor test${RST}  ${GRY}$n · $r · $cr${RST}"
  echo

  if ! systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
    warn "$n is stopped. Starting it."
    systemctl start "${WAT_PREFIX}@$n" 2>/dev/null
    sleep 1
  fi

  # Active profile report
  local fks=$(cfg "$n" fake-sni) fkm=$(cfg "$n" fake-mode) fkt=$(cfg "$n" fake-ttl)
  local rot=$(cfg "$n" pool-rotate) rbytes=$(cfg "$n" pool-rotate-bytes)
  local ech=$(cfg "$n" ech) gov=$(cfg "$n" governor)
  local dl=$(cfg "$n" dns-listen) sip=$(cfg "$n" src-ip)

  if [ -n "$fks" ]; then
    say "  $(kv 'fake sni' "$fks · ${fkm:-seq}${fkt:+ · ttl $fkt}")"
  else
    say "  $(kv 'fake sni' "${GRY}off${RST}")"
  fi
  [ -n "$rot" ] && say "  $(kv rotate "$rot${rbytes:+ / $rbytes}")"
  [ -n "$ech" ] && say "  $(kv ech "$ech")"
  [ "$gov" = true ] && say "  $(kv governor on)"
  [ -n "$dl" ] && say "  $(kv 'dns relay' "$dl")"
  [ -n "$sip" ] && say "  $(kv 'source ip' "$sip")"
  echo

  spin_start "Waiting for the link"
  local wait_sec=${ANTICENSOR_TEST_WAIT:-6}
  for ((i=0; i<wait_sec; i++)); do
    s=$(stats "$n" 2>/dev/null) # JSON: filter_profile below is an object, which the flat form leaves out
    if [ "$(jget "$s" alive)" = true ]; then
      alive=true; break
    fi
    sleep 1
  done
  spin_stop

  if [ "$alive" = true ]; then
    srtt=$(jget_flat "$s" rtt_ms srtt_ms)
    pkts_in=$(jget "$s" pkts_in)
    pkts_out=$(jget "$s" pkts_out)
    fprof=$(jget "$s" filter_profile)
    ech_st=$(jget "$s" ech)

    sec_hdr "Result"
    ok "Connected · RTT $(ms "$srtt") ms · ${pkts_in:-0} in / ${pkts_out:-0} out"
    [ -n "$fprof" ] && say "  $(kv filter "$fprof")"
    [ -n "$ech_st" ] && say "  $(kv ech "$ech_st")"

    # Forwarded port check
    load_maps "$n"
    if [ "${#MAPS[@]}" -gt 0 ]; then
      local first_map="${MAPS[0]}"
      local lport=$(spec_L "$first_map")
      local proto=$(spec_P "$first_map")
      if [ -n "$lport" ] && [[ "$lport" =~ ^[0-9]+$ ]]; then
        if [ "$proto" = tcp ]; then
          if timeout 2 bash -c "</dev/tcp/127.0.0.1/$lport" 2>/dev/null; then
            ok "Port :$lport/$proto answers"
          fi
        elif port_busy "$lport" "$proto"; then
          ok "Port :$lport/$proto open"
        fi
      fi
    fi
    return 0
  else
    err "No link within ${wait_sec} s"
    if [ -n "$fks" ]; then
      hint " · Try blackout:  $SELF blackout $n blackout"
      hint " · Try mode rst/synrst (tunnel page -> z -> 3) or another SNI (irancell.ir, divar.ir)"
    else
      hint " · Enable fake-SNI:  $SELF blackout $n mci"
    fi
    [ "$cr" = icmp ] && hint " · ICMP filtered? Turn governor on (tunnel page -> z -> 2)"
    return 1
  fi
}

# ======================================================================================
#  Interactive Anti-Censorship Menu Hub
# ======================================================================================
AC_KEYS="fake-sni fake-mode fake-ttl fake-ip fake-split fp tls-small-ch ech ech-cache tls-frag pool-rotate pool-rotate-bytes governor dns-listen src-ip conns loss-ceiling keep-slow"
anticensor_menu() {
  local n=$1 cr r
  cr=$(cfg "$n" carrier); r=$(role "$n")
  [ "$(uname -s)" = Linux ] || return 0
  if ! ac_dialer "$n"; then # the listening end has nothing to configure
    page "Anti-censor" "$n · $cr"
    say "  The $([ "$r" = Iran ] && echo Kharej || echo Iran) server dials this $(is_reverse "$n" && echo reverse || echo normal) tunnel, so anti-censor is set there."
    hint "To change who dials: Advanced, d, on both servers."
    menu_line h 'what spoofing and shaping mean'
    key_read
    [ "$KEY" = h ] && spoofhelp_page "$n"
    return 0
  fi
  local changed=0 k v
  while :; do
    page "Anti-censor" "$n · $cr"
    local fs fm ft pr pb ech gov dl sip
    fs=$(cfg "$n" fake-sni)
    fm=$(cfg "$n" fake-mode); [ -n "$fm" ] || fm=seq
    ft=$(cfg "$n" fake-ttl)
    pr=$(cfg "$n" pool-rotate)
    pb=$(cfg "$n" pool-rotate-bytes)
    ech=$(cfg "$n" ech)
    gov=$(cfg "$n" governor)
    dl=$(cfg "$n" dns-listen)
    sip=$(cfg "$n" src-ip)

    if [ -n "$fs" ] || [ "$gov" = true ] || [ -n "$pr" ]; then set_row 1 anti-censor "${GRN}on${RST} · $(detect_preset "$n")"
    else set_row 1 anti-censor "off ${GRY}(plain tunnel, full speed)${RST}"; fi
    set_row r direction "$(is_reverse "$n" && echo "reverse ${GRY}(Kharej dials Iran)${RST}" || echo "normal ${GRY}(Iran dials Kharej)${RST}")"
    echo
    if is_pool_list "$cr"; then
      set_row 2 'fake sni' "$fs" '' off
      [ -n "$fs" ] && set_row 3 'desync mode' "$fm"
      [ -n "$fs" ] && [ "$fm" = ttl ] && set_row 4 'fake ttl' "$ft" '' auto
      set_row 5 'rotate every' "$pr" '' off
      set_row 6 'rotate after' "$pb" '' off
    elif [ "$cr" = icmp ]; then
      set_row 2 governor "$([ "$gov" = true ] && echo on)" '' off
    fi
    has_ech_list "$cr" && set_row 7 ech "$ech" '' off
    set_row 8 'dns forwarder' "$dl" '' off
    set_row 9 'source ip' "$sip" '' 'default route'
    echo
    menu_line w presets t 'test now' m 'test all modes' h 'what these do'
    menu_line p 'save as profile' e 'edit any key'
    menu_line 0 back
    key_read
    case "$KEY" in
      h|H) spoofhelp_page "$n"; continue ;;
      1) # Toggle: on -> plain tunnel, off -> preset (apply_preset restarts the tunnel itself)
         echo
         if [ -n "$fs" ] || [ "$gov" = true ] || [ -n "$pr" ]; then
           confirm "Turn anti-censor OFF (plain tunnel, open connections drop)?" y && apply_preset "$n" off
         elif pick_preset "cloudflare"; then
           apply_preset "$n" "$REPLY_V"
         fi
         sleep 1 ;;
      w|W) echo
         if pick_preset "cloudflare"; then
           apply_preset "$n" "$REPLY_V"
         fi
         sleep 1 ;;
      r|R) rev_capable "$cr" || continue; echo
         if set_direction "$n"; then
           step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
           hint "Anti-censor now belongs to the dialing end: open this screen on the other server and press 1 there."
           pause; return 0
         fi
         pause ;;
      e|E) echo
         hint "Keys: $AC_KEYS"
         ask "Key to set" ""; k=$REPLY_V
         [ -n "$k" ] || continue
         case " $AC_KEYS " in *" $k "*) ;; *) err "Unknown key '$k'."; sleep 1; continue ;; esac
         ask "Value for $k (- = remove)" "$(cfg "$n" "$k")"; v=$REPLY_V
         if [ -z "$v" ] || [ "$v" = - ]; then unset_value "$n" "$k"; ok "$k removed."; changed=1
         elif [[ "$v" =~ ^[A-Za-z0-9._:/@+-]+$ ]]; then set_value "$n" "$k" "$v"; ok "$k set to $v."; changed=1
         else err "Value may only hold letters, digits and . _ : / @ + -"; fi
         sleep 1 ;;
      2) # Pick SNI (pool) or Toggle Governor (icmp)
         if [ "$cr" = icmp ]; then
           echo
           if [ "$(cfg "$n" governor)" = true ]; then
             unset_value "$n" governor; ok "Volume governor turned OFF."
           else
             set_value "$n" governor true; ok "Volume governor turned ON."
           fi
           changed=1; sleep 1; continue
         fi
         is_pool_list "$cr" || continue
         echo
         if pick_sni_preset "${fs:-mci.ir}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             sed -i -E '/^fake-(sni|mode|ttl):/d' "$CONF/$n.yml"
             ok "Fake-SNI turned OFF."; changed=1
           else
             set_value "$n" fake-sni "$REPLY_V"
             [ -n "$(cfg "$n" fake-mode)" ] || set_value "$n" fake-mode rst
             ok "Fake-SNI set to $REPLY_V"; changed=1
           fi
         fi
         sleep 1 ;;
      3) # Pick Fake Mode
         is_pool_list "$cr" || continue
         [ -n "$(cfg "$n" fake-sni)" ] || { warn "Turn on Fake-SNI first (option 2)."; sleep 1; continue; }
         echo
         if pick_fake_mode "$fm" && ! rev_sum_refused "$n" "$REPLY_V"; then
           set_value "$n" fake-mode "$REPLY_V"
           [ "$REPLY_V" != ttl ] && unset_value "$n" fake-ttl
           ok "Fake mode set to $REPLY_V"; changed=1
         fi
         sleep 1 ;;
      4) # Fake TTL
         is_pool_list "$cr" || continue
         [ "$(cfg "$n" fake-mode)" = ttl ] || { warn "Fake TTL is only used in ttl mode."; sleep 1; continue; }
         echo
         ask "Fake TTL (hop count, empty = auto-calibrate)" "$ft"
         if [ -z "$REPLY_V" ]; then
           unset_value "$n" fake-ttl; ok "Fake TTL set to auto-calibrate."; changed=1
         elif v_fake_ttl "$REPLY_V"; then
           set_value "$n" fake-ttl "$REPLY_V"; ok "Fake TTL set to $REPLY_V."; changed=1
         fi
         sleep 1 ;;
      5) # Pool Rotate (Time)
         is_pool_list "$cr" || continue
         echo
         if pick_pool_rotate "${pr:-30m}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" pool-rotate; ok "Pool rotate by time turned OFF."; changed=1
           else
             set_value "$n" pool-rotate "$REPLY_V"; ok "Pool rotate set to $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      6) # Pool Rotate (Bytes)
         is_pool_list "$cr" || continue
         echo
         if pick_pool_rotate_bytes "${pb:-500MB}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" pool-rotate-bytes; ok "Pool rotate by bytes turned OFF."; changed=1
           else
             set_value "$n" pool-rotate-bytes "$REPLY_V"; ok "Pool rotate bytes set to $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      7) # ECH Mode
         case "$cr" in
           tls|wss|h2|grpc)
             echo
             if pick_ech "${ech:-ladder}"; then
               if [ "$REPLY_V" = off ]; then
                 unset_value "$n" ech; ok "ECH turned OFF."; changed=1
               else
                 set_value "$n" ech "$REPLY_V"; ok "ECH set to $REPLY_V."; changed=1
               fi
             fi
             sleep 1 ;;
         esac ;;
      8) # DNS Forwarder Listener
         echo
         if pick_dns_listen "${dl:-off}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" dns-listen; ok "DNS forwarder listener turned OFF."; changed=1
           else
             set_value "$n" dns-listen "$REPLY_V"; ok "DNS forwarder listening on $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      9) # Carrier Source IP Binding
         echo
         if pick_src_ip "${sip:-off}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" src-ip; ok "Carrier source IP binding turned OFF."; changed=1
           else
             set_value "$n" src-ip "$REPLY_V"; ok "Carrier bound to source IP $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      t|T)
         anticensor_test "$n"
         pause ;;
      m|M)
         ac_matrix_cmd "$n"
         pause ;;
      p|P)
         echo
         ask "Profile name to save" ""
         if [ -n "$REPLY_V" ]; then
           profile_cmd save "$REPLY_V" "$n"
           sleep 1
         fi ;;
      b|0|q|enter|esc) break ;;
      *) : ;;
    esac
  done
  if [ "$changed" = 1 ]; then
    hint "Applying changes: restarting '$n'..."
    step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  fi
}

# ---- spoofing vs shaping: what each anti-censor option actually does (matches docs/TECHNICAL.md) ----
# One page, no network calls. The classification is the docs' one: fake-sni is the only true spoof, everything that
# changes our own packet bytes/sizes/timing is shape, FEC/governor are neither, and tunnel-level spoofing is not shipped.
spoofhelp_page() { # [name]
  page "Spoofing & shaping" "${1:-}"
  printf '  %sSpoof%s    fake-sni          decoy TLS hello (peer drops it)\n' "$CYN" "$RST"
  printf '  %sShape%s    tcp-mimic, tls-frag, ech, hdr-mask, udp-dns, pool-rotate, shape-data, noise\n' "$CYN" "$RST"
  printf '  %sOther%s    fec (loss parity) · governor (ICMP pacing)\n\n' "$CYN" "$RST"
  hint "Auto mode can also test the 13 F19 shaped carriers: --extended on Kharej (both ends 3.3.0)."
  hint "Does not hide server IPs, traffic volume/timing, or Iran↔user plaintext (no VLESS/Trojan handshake mimicry)."
  echo
  printf '  %s%-30s %s%s\n' "$BOLD" "Symptom" "Use" "$RST"
  printf '  %-30s %s\n' "SNI allowlist cuts flow" "rst/synrst mode"
  printf '  %-30s %s\n' "SNI black-holed after hello" "ech (wss/grpc via Cloudflare)"
  printf '  %-30s %s\n' "Non-TLS first bytes cut" "tcp-mimic + hdr-mask"
  printf '  %-30s %s\n' "UDP cut, DNS/53 passes" "udp-dns on both ends"
  printf '  %-30s %s\n' "Flow time/byte cap" "pool-rotate / pool-rotate-bytes"
  printf '  %-30s %s\n' "ICMP throttled at volume" "governor + max-mbps"
  echo
  hint "Full table: docs/TECHNICAL.md"
  pause
}

# ---- resilience profiles: save one tunnel's working fake-sni/pool-rotate combination, re-apply it later ----
prof_names() { local f; for f in "$CONF/profiles"/*.env; do [ -e "$f" ] || continue; basename "$f" .env; done; }
prof_path() { echo "$CONF/profiles/$1.env"; }
v_prof_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || { err "Profile name: 1-32 letters, digits, - or _."; return 1; }; return 0; }
prof_read() { # file -> the KEY=VALUE lines this manager wrote (comments and anything else are ignored)
  local l
  [ -f "$1" ] || return 0
  while IFS= read -r l; do
    case "$l" in FAKESNI=*|FAKEMODE=*|FAKETTL=*|POOLROT=*|POOLBYTES=*|ECH=*|GOVERNOR=*|DNSLISTEN=*|SRCIP=*) echo "$l" ;; esac
  done <"$1"
}
prof_pick_defaults() { # fill the wizard's resilience defaults from a saved profile (interactive only)
  local names pick l k v
  names=$(prof_names)
  [ -n "$names" ] || return 0
  echo
  hint "Saved resilience profiles: $(echo "$names" | tr '\n' ' ')"
  ask "Start from a saved profile (name, empty = skip)" ""; pick=$REPLY_V
  [ -n "$pick" ] || return 0
  [ -f "$(prof_path "$pick")" ] || { err "No profile named '$pick'."; return 0; }
  while IFS= read -r l; do
    k=${l%%=*}; v=${l#*=}
    case "$k" in
      FAKESNI) T_FAKESNI=$v ;; FAKEMODE) T_FAKEMODE=$v ;; FAKETTL) T_FAKETTL=$v ;;
      POOLROT) T_POOLROT=$v ;; POOLBYTES) T_POOLBYTES=$v ;;
      ECH) T_ECH=$v ;; GOVERNOR) T_GOVERNOR=$v ;;
      DNSLISTEN) T_DNSLISTEN=$v ;; SRCIP) T_SRCIP=$v ;;
    esac
  done < <(prof_read "$(prof_path "$pick")")
  hint "Profile '$pick' loaded as the defaults below; press Enter to keep each."
}
prof_only_tunnel() { # the single Iran pool tunnel, when there is exactly one
  local n count=0 pick=''
  for n in $(tunnels); do
    [ "$(role "$n")" = Iran ] && is_pool_list "$(cfg "$n" carrier)" || continue
    count=$((count+1)); pick=$n
  done
  [ "$count" = 1 ] && echo "$pick"
  return 0
}

blackout_cmd() { # name [sni_or_preset] : turn the resilience kit on when a censor starts blocking the tunnel.
  local n=$1 sni=${2:-}
  [ "$(uname -s)" = Linux ] || { err "The resilience kit is a Linux feature (fake-SNI needs CAP_NET_RAW, like the icmp carrier)."; return 1; }
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  ac_dialer "$n" || {
    err "'$n' does not dial the carrier, so anti-censorship runs on its other end (Iran normally, Kharej when reverse)."; return 1; }

  if [ -z "$sni" ] && [ "$NONINTERACTIVE" != 1 ]; then
    echo
    say "  ${BOLD}Blackout Resilience Activation for '$n'${RST}"
    say "  Under an SNI allowlist or blackout, choose an operator preset or allowlisted domain."
    echo
    pick_preset "mci" || return 1; sni=$REPLY_V
  fi
  [ -n "$sni" ] || { err "An allowlisted name or preset is required (blackout $n mci.ir or blackout $n mci)."; return 1; }

  if is_builtin_preset "$sni"; then
    apply_preset "$n" "$sni" || return 1
    if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
      anticensor_test "$n"
    fi
    return 0
  fi

  # Custom SNI domain
  [ "$(role "$n")" = Iran ] && is_pool "$(cfg "$n" carrier)" && ! is_reverse "$n" || {
    err "'$n' is not a direct Iran tunnel on a pool carrier (tcp, tls, ws, wss, h2, h2c, grpc); the kit is client-only and only attaches there."; return 1; }
  v_sni_name "$sni" || return 1
  [ "$(bin_ver_ok 2.7.0)" = 1 ] || { err "fake-sni needs wattun 2.7.0 or newer on this server (run: $SELF update)."; return 1; }
  set_value "$n" fake-sni "$sni"
  set_value "$n" fake-mode rst
  unset_value "$n" fake-ttl
  ok "Resilience kit on: fake-sni $sni (rst mode). pool-rotate stays off; tune later: tunnel page -> o -> k."
  if step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"; then
    ok "Restart applied. Watch whether the link comes back: $SELF test $n"
    if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
      anticensor_test "$n"
    fi
  else
    err "Restart failed: run  systemctl restart ${WAT_PREFIX}@$n"; return 1
  fi
  return 0
}

arm_blackout_cmd() { # name
  local n=$1 r
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n")
  if [ "$r" = Kharej ]; then
    say "  ${BOLD}Arming Kharej '$n' in Fortress Mode for Blackout Resilience${RST}"
    if [ "$(uname -s)" = Linux ]; then
      sysctl -w net.ipv4.icmp_echo_ignore_all=0 >/dev/null 2>&1 || true
      sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || true
      sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || true
      sysctl -w net.core.rmem_max=67108864 >/dev/null 2>&1 || true
      sysctl -w net.core.wmem_max=67108864 >/dev/null 2>&1 || true
    fi
    local ptcp ptls pwss pudp used_b=''
    ptcp=$(rand_open_port tcp "$used_b") || { err "No free TCP port for blackout tcp listener."; return 1; }
    used_b+=" $ptcp"
    ptls=$(rand_open_port tcp "$used_b") || { err "No free TCP port for blackout tls listener."; return 1; }
    used_b+=" $ptls"
    pwss=$(rand_open_port tcp "$used_b") || { err "No free TCP port for blackout wss listener."; return 1; }
    used_b+=" $pwss"
    pudp=$(rand_open_port udp "$used_b") || { err "No free UDP port for blackout udp listener."; return 1; }
    sed -i -E '/^(listen|listen-[a-z0-9-]+):/d' "$CONF/$n.yml"
    set_value "$n" carrier 'icmp+tcp+tls+wss+udp'
    set_value "$n" listen-tcp "\":$ptcp\""
    set_value "$n" listen-tls "\":$ptls\""
    set_value "$n" listen-wss "\":$pwss\""
    set_value "$n" listen-udp "\":$pudp\""
    [ -n "$(cfg "$n" path)" ] || set_value "$n" path "$(rand_path)"
    [ -n "$(cfg "$n" dns-relay-upstream)" ] || set_value "$n" dns-relay-upstream "1.1.1.1:53"
    fw_open "$ptcp/tcp $ptls/tcp $pwss/tcp $pudp/udp" >/dev/null 2>&1 || true
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1 || true
    ok "Kharej '$n' armed in Fortress Mode (ICMP, TCP:$ptcp, TLS:$ptls, WSS:$pwss, UDP:$pudp)."
    say "  Emergency blackout token for Iran distribution:"
    refresh_token "$n" fortress
    show_token "$n"
  else
    say "  ${BOLD}Arming Iran '$n' for Autonomous Blackout Failover${RST}"
    set_value "$n" path-probe-max "6s"
    set_value "$n" governor true
    heal_enable >/dev/null 2>&1 || true
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1 || true
    ok "Iran '$n' armed for Autonomous Failover (fast silence detection, auto-heal timer active)."
  fi
  return 0
}

audit_blackout_cmd() { # name
  local n=$1 r pid pass_cnt=0 fail_cnt=0
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n")
  echo
  say "  ${BOLD}Blackout Preparedness Audit for '$n' ($r)${RST}"
  echo
  pid=$(systemctl show -p MainPID --value "${WAT_PREFIX}@$n" 2>/dev/null || echo 0)
  if [ -n "$pid" ] && [ "$pid" -gt 0 ] && [ -r "/proc/$pid/status" ]; then
    local cap_eff; cap_eff=$(grep -i CapEff "/proc/$pid/status" 2>/dev/null | awk '{print $2}')
    if [ -n "$cap_eff" ]; then
      ok "Process capabilities active (PID $pid, CapEff $cap_eff)"
      pass_cnt=$((pass_cnt+1))
    else
      warn "Unable to read process capabilities"
      fail_cnt=$((fail_cnt+1))
    fi
  else
    warn "Tunnel process is not currently running"
    fail_cnt=$((fail_cnt+1))
  fi

  if [ "$(uname -s)" = Linux ]; then
    local icmp_ign; icmp_ign=$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null || echo 1)
    if [ "$icmp_ign" = 0 ]; then
      ok "Sysctl: net.ipv4.icmp_echo_ignore_all == 0 (ICMP replies enabled)"
      pass_cnt=$((pass_cnt+1))
    else
      ok "Sysctl: net.ipv4.icmp_echo_ignore_all == 1 (plain ping is off; the ICMP tunnel still receives its packets)"
      pass_cnt=$((pass_cnt+1))
    fi
    local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo cubic)
    if [ "$cc" = bbr ]; then
      ok "Sysctl: congestion control is BBR"
      pass_cnt=$((pass_cnt+1))
    else
      hint "Sysctl: congestion control is $cc (BBR recommended for anti-policing)"
    fi
  fi

  if [ "$r" = Kharej ]; then
    local lline lp lcar lpr lchk
    while IFS= read -r lline; do
      [ -n "$lline" ] || continue
      lcar=${lline%%:*}; [ "$lcar" = listen ] && lcar=$(cfg "$n" carrier) || lcar=${lcar#listen-}
      lp=${lline#*:}; lp=${lp//\"/}; lp=${lp//\'/}; lp=${lp##*:}; lp=${lp//[[:space:]]/}
      [[ "$lp" =~ ^[0-9]+$ ]] || continue
      lpr=$(rproto "$lcar")
      lchk=$(port_user "$lp" "$lpr" 2>/dev/null || true)
      if [ -n "$lchk" ] && [[ "$lchk" != *"wattun"* ]]; then
        warn "Port $lp/$lpr bound by another process: $lchk"
        fail_cnt=$((fail_cnt+1))
      else
        ok "Port $lp/$lpr available or bound by wattun"
        pass_cnt=$((pass_cnt+1))
      fi
    done < <(grep -E '^listen(-[a-z0-9-]+)?:' "$CONF/$n.yml" 2>/dev/null)
  fi

  local dns_up; dns_up=$(cfg "$n" dns-relay-upstream)
  if [ -n "$dns_up" ]; then
    ok "DNS in-band relay configured ($dns_up)"
    pass_cnt=$((pass_cnt+1))
  else
    hint "DNS in-band relay not configured (default upstreams active)"
  fi

  local st; st=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null || echo inactive)
  if [ "$st" = active ]; then
    ok "Service ${WAT_PREFIX}@$n is active"
    pass_cnt=$((pass_cnt+1))
  else
    warn "Service ${WAT_PREFIX}@$n is $st"
    fail_cnt=$((fail_cnt+1))
  fi

  echo
  if [ "$fail_cnt" -eq 0 ]; then
    say "  ${GRN}${BOLD}OVERALL STATUS: ARMED & READY FOR BLACKOUT${RST} (${pass_cnt} checks passed)"
  else
    say "  ${YEL}${BOLD}OVERALL STATUS: PARTIALLY ARMED${RST} (${pass_cnt} passed, ${fail_cnt} warnings)"
  fi
  echo
  return 0
}

preset_cmd() { # name [preset]
  local n=$1 p=${2:-}
  [ "$(uname -s)" = Linux ] || { err "Anti-censorship presets are a Linux feature."; return 1; }
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  ac_dialer "$n" || { err "'$n' does not dial the carrier, so presets run on its other end (Iran normally, Kharej when reverse)."; return 1; }
  if [ -z "$p" ] && [ "$NONINTERACTIVE" != 1 ]; then
    pick_preset "cloudflare" || return 1; p=$REPLY_V
  fi
  [ -n "$p" ] || { err "A preset name is required (preset $n mci). Available: cloudflare, rst-fast, mci, irancell, blackout, conservative"; return 1; }
  v_preset "$p" || return 1
  apply_preset "$n" "$p" || return 1
  if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
    anticensor_test "$n"
  fi
  return 0
}

profile_cmd() { # profile save|list|show|del|apply NAME [tunnel]
  local sub name tun f names x tmp
  sub=${1:-}; name=${2:-}; tun=${3:-}
  case "$sub" in
    save)
      if is_builtin_preset "$name"; then
        err "'$name' is a built-in preset name. Choose another name for your custom profile."
        return 1
      fi
      v_prof_name "$name" || return 1
      [ -n "$tun" ] || tun=$(prof_only_tunnel)
      [ -n "$tun" ] || { err "Name the tunnel explicitly (profile save $name TUNNEL)."; return 1; }
      [ -f "$CONF/$tun.yml" ] || { err "No tunnel named '$tun'."; return 1; }
      [ "$(uname -s)" = Linux ] || { err "Resilience profiles are a Linux feature (fake-SNI needs CAP_NET_RAW, like the icmp carrier)."; return 1; }
      mkdir -p "$CONF/profiles"
      f=$(prof_path "$name"); tmp="$f.tmp.$$"
      if { echo "# WatTunnel resilience profile: $name"
           echo "# From tunnel $tun, saved $(date -u '+%Y-%m-%d %H:%M UTC'). Apply: $SELF profile apply $name TUNNEL"
           echo "# FAKESNI   allowlisted server name (e.g. mci.ir); empty = fake-SNI off"
           echo "# FAKEMODE  seq | ttl | sum | seqsum | auto | rst | synrst"
           echo "# FAKETTL   hop count for fake-mode ttl; empty = auto-calibrate"
           echo "# POOLROT   recycle each healthy pool connection after this long (90s, 30m, 4h); empty = off"
           echo "# POOLBYTES recycle after this much traffic (500MB, 4G); empty = off"
           echo "# ECH       ECH mode: ladder | auto | off"
           echo "# GOVERNOR  ICMP volume pacer: true | false"
           echo "FAKESNI=$(cfg "$tun" fake-sni)"
           echo "FAKEMODE=$(cfg "$tun" fake-mode)"
           echo "FAKETTL=$(cfg "$tun" fake-ttl)"
           echo "POOLROT=$(cfg "$tun" pool-rotate)"
           echo "POOLBYTES=$(cfg "$tun" pool-rotate-bytes)"
           echo "ECH=$(cfg "$tun" ech)"
           echo "GOVERNOR=$(cfg "$tun" governor)"
           echo "DNSLISTEN=$(cfg "$tun" dns-listen)"
           echo "SRCIP=$(cfg "$tun" src-ip)"
         } >"$tmp"; then
        mv -f "$tmp" "$f"
        ok "Profile '$name' saved (from $tun). Re-apply later: $SELF profile apply $name TUNNEL."
      else rm -f "$tmp"; err "Could not write $(prof_path "$name")."; return 1
      fi ;;
    list)
      say "  ${BOLD}Built-in Presets:${RST}"
      echo "  rst-fast     Fastest direct setup (www.cloudflare.com, rst, 4 sessions x 4 conns, 30m)"
      echo "  mci          Iran Whitelist - MCI (mci.ir, rst, 30m, 500MB, ECH ladder)"
      echo "  irancell     Iran Whitelist - Irancell/Mokhaberat (irancell.ir, seq, 20m, 300MB, ECH ladder)"
      echo "  blackout     Emergency Blackout Mode (mci.ir, rst, 90s, 100MB, ECH ladder)"
      echo "  conservative Conservative / Low-Churn (mci.ir, seq, 4h, 4GB, ECH auto)"
      echo
      say "  ${GRY}saved profiles${RST}"
      names=$(prof_names)
      if [ -n "$names" ]; then
        echo "$names" | while read -r x; do echo "  $x"; done
      else
        hint "No custom saved profiles."
      fi ;;
    show)
      if is_builtin_preset "$name"; then
        show_builtin_preset "$name"
      else
        v_prof_name "$name" || return 1
        if [ -f "$(prof_path "$name")" ]; then
          cat "$(prof_path "$name")"
        else
          err "No profile named '$name'."
          return 1
        fi
      fi ;;
    del|delete|rm)
      if is_builtin_preset "$name"; then
        err "Cannot delete built-in preset '$name'."
        return 1
      fi
      v_prof_name "$name" || return 1
      [ -f "$(prof_path "$name")" ] || { err "No profile named '$name'."; return 1; }
      rm -f "$(prof_path "$name")"; ok "Profile '$name' deleted." ;;
    apply)
      if is_builtin_preset "$name"; then
        [ -n "$tun" ] || tun=$(prof_only_tunnel)
        [ -n "$tun" ] || { err "Name the tunnel explicitly (profile apply $name TUNNEL)."; return 1; }
        [ -f "$CONF/$tun.yml" ] || { err "No tunnel named '$tun'."; return 1; }
        apply_preset "$tun" "$name" || return 1
      else
        v_prof_name "$name" || return 1
        [ -n "$tun" ] || tun=$(prof_only_tunnel)
        [ -n "$tun" ] || { err "Name the tunnel explicitly (profile apply $name TUNNEL)."; return 1; }
        [ -f "$CONF/$tun.yml" ] || { err "No tunnel named '$tun'."; return 1; }
        [ "$(role "$tun")" = Iran ] || { err "'$tun' is not an Iran tunnel; these keys are client-only."; return 1; }
        if [ -f "$(prof_path "$name")" ]; then
          [ "$(role "$tun")" = Iran ] && is_pool_list "$(cfg "$tun" carrier)" || { err "'$tun' is not an Iran tunnel on a pool carrier (tcp, tls, ws, wss, h2, h2c, grpc, alone or bonded); these keys are client-only."; return 1; }
          prof_apply "$name" "$tun" || return 1
        else
          err "No profile named '$name'."
          return 1
        fi
      fi ;;
    *) err "profile: use save, list, show, del or apply."; return 1 ;;
  esac
  return 0
}

prof_apply() { # profile tunnel : write the tunnel's resilience keys from a saved profile, then restart
  local name=$1 tun=$2 l k v changed=0
  local fs='' fm='' ft='' pr='' pb='' ech='' gov='' dl='' sip=''
  while IFS= read -r l; do
    k=${l%%=*}; v=${l#*=}
    case "$k" in
      FAKESNI) fs=$v ;; FAKEMODE) fm=$v ;; FAKETTL) ft=$v ;; POOLROT) pr=$v ;; POOLBYTES) pb=$v ;;
      ECH) ech=$v ;; GOVERNOR) gov=$v ;; DNSLISTEN) dl=$v ;; SRCIP) sip=$v ;;
    esac
  done < <(prof_read "$(prof_path "$name")")
  if [ -n "$fs" ]; then
    [ "$(bin_ver_ok 2.7.0)" = 1 ] || { err "fake-sni needs wattun 2.7.0 or newer (run: $SELF update)."; return 1; }
    set_value "$tun" fake-sni "$fs"; changed=1
  elif [ -n "$(cfg "$tun" fake-sni)" ]; then
    unset_value "$tun" fake-sni; unset_value "$tun" fake-mode; unset_value "$tun" fake-ttl; changed=1
  fi
  if [ -n "$fs" ] && [ -n "$fm" ]; then
    v_fake_mode "$fm" || return 1
    rev_sum_refused "$tun" "$fm" && return 1
    case "$fm" in
      auto|rst) [ "$(bin_ver_ok 2.9.0)" = 1 ] || { err "fake-mode $fm needs wattun 2.9.0 or newer (run: $SELF update)."; return 1; } ;;
      synrst) [ "$(bin_ver_ok 2.10.5)" = 1 ] || { err "fake-mode synrst needs wattun 2.10.5 or newer (run: $SELF update)."; return 1; } ;;
      paws) [ "$(bin_ver_ok 3.0.2)" = 1 ] || { err "fake-mode paws needs wattun 3.0.2 or newer (run: $SELF update)."; return 1; } ;;
      seqsum) [ "$(bin_ver_ok 2.8.0)" = 1 ] || { err "fake-mode seqsum needs wattun 2.8.0 or newer (run: $SELF update)."; return 1; } ;;
      sum) [ "$(bin_ver_ok 2.7.1)" = 1 ] || { err "fake-mode sum needs wattun 2.7.1 or newer (run: $SELF update)."; return 1; } ;;
    esac
    set_value "$tun" fake-mode "$fm"; changed=1
    if [ "$fm" = ttl ] && [ -n "$ft" ]; then set_value "$tun" fake-ttl "$ft"; else unset_value "$tun" fake-ttl; fi
  fi
  if [ -n "$pr" ] && [ "$pr" != 0 ] && [ "$pr" != off ]; then
    [ "$(bin_ver_ok 2.8.0)" = 1 ] || { err "pool-rotate needs wattun 2.8.0 or newer (run: $SELF update)."; return 1; }
    set_value "$tun" pool-rotate "$pr"; changed=1
  elif [ -n "$(cfg "$tun" pool-rotate)" ]; then unset_value "$tun" pool-rotate; changed=1
  fi
  if [ -n "$pb" ] && [ "$pb" != 0 ] && [ "$pb" != off ]; then
    [ "$(bin_ver_ok 2.8.1)" = 1 ] || { err "pool-rotate-bytes needs wattun 2.8.1 or newer (run: $SELF update)."; return 1; }
    set_value "$tun" pool-rotate-bytes "$pb"; changed=1
  elif [ -n "$(cfg "$tun" pool-rotate-bytes)" ]; then unset_value "$tun" pool-rotate-bytes; changed=1
  fi
  if [ -n "$ech" ] && [ "$ech" != off ]; then
    [ "$(bin_ver_ok 2.9.0)" = 1 ] || { err "ech needs wattun 2.9.0 or newer (run: $SELF update)."; return 1; }
    set_value "$tun" ech "$ech"; changed=1
  elif [ -n "$(cfg "$tun" ech)" ]; then unset_value "$tun" ech; changed=1
  fi
  if [ "$gov" = true ] || [ "$gov" = on ]; then
    [ "$(bin_ver_ok 2.9.0)" = 1 ] || { err "governor needs wattun 2.9.0 or newer (run: $SELF update)."; return 1; }
    set_value "$tun" governor true; changed=1
  elif [ -n "$(cfg "$tun" governor)" ]; then unset_value "$tun" governor; changed=1
  fi
  if [ -n "$dl" ] && [ "$dl" != off ]; then
    set_value "$tun" dns-listen "$dl"; changed=1
  elif [ -n "$(cfg "$tun" dns-listen)" ]; then unset_value "$tun" dns-listen; changed=1
  fi
  if [ -n "$sip" ] && [ "$sip" != off ]; then
    set_value "$tun" src-ip "$sip"; changed=1
  elif [ -n "$(cfg "$tun" src-ip)" ]; then unset_value "$tun" src-ip; changed=1
  fi
  [ "$changed" = 1 ] || { hint "Nothing to change."; return 0; }
  ok "Profile '$name' applied to $tun."
  if step "Restarting ${WAT_PREFIX}@$tun" systemctl restart "${WAT_PREFIX}@$tun"; then ok "Restart applied."
  else err "Restart failed: run  systemctl restart ${WAT_PREFIX}@$tun"; return 1; fi
  return 0
}

change_type() { # name : one place to change how the two servers connect, whatever kind of tunnel this is
  local n=$1 c; c=$(cfg "$n" carrier)
  echo
  if is_shaped_list "$c"; then shaped_warn "$c"; fi # F19: repeat the wattun-internal note where the type is shown
  if [ "$(role "$n")" = Iran ]; then
    if [ -f "$CONF/$n.auto" ]; then
      auto_test_cmd "$n"; return
    fi
    say "  In use: $c. Kharej fixed this type when it made the token."
    hint "To choose freely: on Kharej press n, then paste the new token here with t."
    return 0
  fi
  if is_auto_kharej "$n"; then
    say "  In use: $(in_use "$n" | sed 's/^$/none yet/'). Iran chooses the type: on Iran, tunnel page, c."
    return 0
  fi
  say "  In use: $c, fixed when the tunnel was made."
  hint "To let Iran choose: press n here, paste the token on Iran with t, then delete this tunnel."
}
# ======================================================================================
#  Kernel Speed Boost (/boost)
# ======================================================================================
BOOST_SYSCTL=/etc/sysctl.d/99-$WAT_PREFIX-boost.conf
BOOST_OFF=$CONF/.boost-off # written by boost --undo: the installer's automatic boost leaves this server alone
is_container() {
  if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then return 0; fi
  if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt --container -q 2>/dev/null; then return 0; fi
  if [ -f /proc/user_beancounters ]; then return 0; fi
  if [ ! -w /proc/sys/net/ipv4/tcp_congestion_control ]; then return 0; fi
  return 1
}
boost_status() {
  local cc qdisc rmax wmax
  cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unknown)
  qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo unknown)
  rmax=$(sysctl -n net.core.rmem_max 2>/dev/null || cat /proc/sys/net/core/rmem_max 2>/dev/null || echo 0)
  wmax=$(sysctl -n net.core.wmem_max 2>/dev/null || cat /proc/sys/net/core/wmem_max 2>/dev/null || echo 0)
  if [ -f "$BOOST_SYSCTL" ]; then say "  $(kv boost "${GRN}on${RST}")"
  else say "  $(kv boost "${GRY}off${RST}")"; fi
  say "  $(kv congestion "$cc")"
  say "  $(kv qdisc "$qdisc")"
  say "  $(kv 'rmem max' "$(human "$rmax")")"
  say "  $(kv 'wmem max' "$(human "$wmax")")"
  is_container && warn "Container environment: sysctl writes may be restricted."
  boost_nic_hint
  return 0
}
default_dev() { ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i+1); exit }}'; }
boost_qdisc() { # put the default-route interface on fq now: default_qdisc alone only covers interfaces created later
  # Field 2026-11-08 (Iran VPS): boost had set default_qdisc=fq, eth0 stayed pfifo_fast until a reboot.
  local dev cur
  [ "$SANDBOX" = 1 ] && return 0
  command -v tc >/dev/null 2>&1 || return 0
  dev=$(default_dev); [ -n "$dev" ] || return 0
  cur=$(tc qdisc show dev "$dev" root 2>/dev/null | awk '{print $2; exit}')
  case "$cur" in
    mq) tc qdisc replace dev "$dev" root mq 2>/dev/null ;; # re-creates the per-queue children with default_qdisc
    pfifo_fast|pfifo|fq_codel) tc qdisc replace dev "$dev" root fq 2>/dev/null ;;
  esac # any other root (htb, cake, tbf ...) is someone's own shaping: left alone
  return 0
}
boost_nic_hint() { # an emulated NIC is the usual 1 Gbit/s limit on a cheap VPS, and no setting here fixes it
  local dev drv
  command -v ethtool >/dev/null 2>&1 || return 0
  dev=$(default_dev); [ -n "$dev" ] || return 0
  drv=$(ethtool -i "$dev" 2>/dev/null | sed -n 's/^driver: //p')
  case "$drv" in
    e1000|e1000e|8139cp|8139too|rtl8139|pcnet32|ne2k-pci)
      warn "Network card: $drv (emulated). One CPU core handles every packet, which usually caps the server below 1 Gbit/s."
      hint "Ask your provider to switch this VPS to a virtio network card." ;;
  esac
  return 0
}
boost_apply() {
  if is_container; then
    warn "Container environment detected. Sysctl writes may be restricted by the host."
  fi
  mkdir -p "${BOOST_SYSCTL%/*}"
  cat >"$BOOST_SYSCTL" <<EOF
# WatTunnel High-Speed Transport Engine Tunables (/boost)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.core.rmem_default = 33554432
net.core.wmem_default = 33554432
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.core.netdev_max_backlog = 100000
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_fastopen = 3
EOF
  chmod 644 "$BOOST_SYSCTL"
  modprobe tcp_bbr 2>/dev/null || true
  if command -v sysctl >/dev/null 2>&1; then
    sysctl -p "$BOOST_SYSCTL" >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1 || true
  fi
  boost_qdisc
  rm -f "$BOOST_OFF"
  ok "Boost parameters written to $BOOST_SYSCTL and applied."
  boost_status
}
boost_undo() {
  rm -f "$BOOST_SYSCTL"
  mkdir -p "$CONF" && : >"$BOOST_OFF"
  if command -v sysctl >/dev/null 2>&1; then
    sysctl --system >/dev/null 2>&1 || true
  fi
  ok "Removed $BOOST_SYSCTL and reloaded system defaults."
  boost_status
}
boost_cmd() {
  case "${1:-}" in
    --status|-s|status) boost_status ;;
    --undo|-u|undo) boost_undo ;;
    --yes|-y|apply|"") boost_apply ;;
    auto) # the installer and wattun update: on by default, except in a container or after boost --undo
      [ -f "$BOOST_OFF" ] || is_container || boost_apply >/dev/null 2>&1; return 0 ;;
    *) err "Usage: $SELF boost [--status|--undo|--yes]"; return 1 ;;
  esac
}
boost_menu() {
  while :; do
    page "Kernel speed boost"
    boost_status
    echo
    menu_line a 'enable (bbr, fq, 64 MiB)' u 'restore defaults' 0 back
    key_read
    case "$KEY" in
      a) boost_apply; pause ;;
      u) confirm "Restore default kernel sysctl values?" y && boost_undo; pause ;;
      b|0|q|enter|esc) return 0 ;;
    esac
  done
}

# ======================================================================================
#  Off-Peak Auto-Optimize (Timer)
# ======================================================================================
OPTIMIZE_UNIT=$WAT_PREFIX-auto-optimize
optimize_enable() {
  local mgr=/usr/local/bin/wattun-manager
  [ "$SANDBOX" = 1 ] && mgr=$MGR
  {
    printf '[Unit]\nDescription=WatTunnel off-peak auto-optimize%s\n[Service]\nType=oneshot\n' "$([ "$SANDBOX" = 1 ] && echo " (sandbox $WAT_PREFIX)")"
    unit_env_lines
    printf 'ExecStart=%s auto-optimize\n' "$mgr"
  } >"/etc/systemd/system/$OPTIMIZE_UNIT.service"
  cat >"/etc/systemd/system/$OPTIMIZE_UNIT.timer" <<EOF
[Unit]
Description=WatTunnel off-peak auto-optimize daily at 04:30
[Timer]
OnCalendar=*-*-* 04:30:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
  chmod 644 "/etc/systemd/system/$OPTIMIZE_UNIT.service" "/etc/systemd/system/$OPTIMIZE_UNIT.timer"
  systemctl daemon-reload && systemctl enable --now "$OPTIMIZE_UNIT.timer" >/dev/null 2>&1 && ok "Auto-optimize timer enabled (daily at 04:30)."
}
optimize_disable() {
  systemctl disable --now "$OPTIMIZE_UNIT.timer" >/dev/null 2>&1; ok "Auto-optimize timer disabled."
}
auto_optimize_all() {
  local n
  for n in $(tunnels); do
    if [ "$(role "$n")" = Iran ] && [ -f "$CONF/$n.auto" ]; then
      logger -t wattun-auto-optimize "running scheduled off-peak optimization for $n"
      AUTO_OPTIMIZE=1 auto_retest "$n"
    fi
  done
}

# ======================================================================================
#  Bond auto-retest (F10): re-test the carriers of a bond on a schedule and add one back
#  when it works again (a censor can block one leg of a bond for hours and then clear it).
#  Settings live in the $CONF/NAME.bondretest sidecar, never in NAME.yml: the engine
#  rejects unknown YAML keys and only ports:/limits: hot-reload.
# ======================================================================================
BONDRETEST_BUDGET_MB=20 # traffic budget of one run, .manager.conf key bondretest-budget
bond_is_bond() { case "${1:-}" in *+*) return 0 ;; esac; return 1; }
bond_retest_visible() { # role carrier -> 0 when the setting belongs on this tunnel (a bonded Iran client)
  [ "${1:-}" = Iran ] && bond_is_bond "${2:-}"
}
bondretest_ok() { # value -> the stored form (off|30m|1h|6h|daily-offpeak) ; rc 1 on anything else
  case "${1,,}" in
    off|0|none|never) echo off ;;
    30m|30min|half-hour) echo 30m ;;
    1h|60m|hourly) echo 1h ;;
    6h|360m) echo 6h ;;
    daily-offpeak|daily|offpeak|off-peak) echo daily-offpeak ;;
    *) return 1 ;;
  esac
}
v_bondretest() { # validator for ask_ok: normalizes the value into REPLY_V
  local v
  v=$(bondretest_ok "$1") || { err "Use off, 30m, 1h, 6h or daily-offpeak."; return 1; }
  REPLY_V=$v; return 0
}
bondretest_get() { # name -> stored value (off when the sidecar is missing or unreadable)
  local v=''
  [ -f "$CONF/$1.bondretest" ] && v=$(head -1 "$CONF/$1.bondretest" 2>/dev/null | tr -d '[:space:]')
  bondretest_ok "${v:-off}" || echo off
}
bondretest_set_file() { # name value : write the sidecar atomically, like every other state file here
  local n=$1 v
  v=$(bondretest_ok "$2") || return 1
  ( umask 077; printf '%s\n' "$v" >"$CONF/$n.bondretest.tmp" ) && mv -f "$CONF/$n.bondretest.tmp" "$CONF/$n.bondretest"
}
bondretest_timer_lines() { # value -> the [Timer] lines (pure; the self-test pins every schedule)
  case "$1" in
    30m) printf 'OnBootSec=5min\nOnUnitActiveSec=30min\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    1h)  printf 'OnBootSec=5min\nOnUnitActiveSec=1h\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    6h)  printf 'OnBootSec=5min\nOnUnitActiveSec=6h\nRandomizedDelaySec=60\nPersistent=true\n' ;;
    daily-offpeak) printf 'OnCalendar=*-*-* 04:15:00\nRandomizedDelaySec=300\nPersistent=true\n' ;;
  esac
}
bondretest_unit() { echo "${WAT_PREFIX}-bondretest-$1"; }
bond_retest_enable() { # name value : write the oneshot unit + timer and enable them
  local n=$1 v u mgr=/usr/local/bin/wattun-manager
  v=$(bondretest_ok "$2") || return 1
  [ "$SANDBOX" = 1 ] && mgr=$MGR
  u=$(bondretest_unit "$n")
  {
    printf '[Unit]\nDescription=WatTunnel bond carrier re-test for %s%s\n[Service]\nType=oneshot\n' "$n" "$([ "$SANDBOX" = 1 ] && echo " (sandbox $WAT_PREFIX)")"
    unit_env_lines
    printf 'ExecStart=%s bond-retest %s --yes\n' "$mgr" "$n"
  } >"/etc/systemd/system/$u.service"
  {
    printf '[Unit]\nDescription=WatTunnel bond carrier re-test for %s (%s)\n[Timer]\n' "$n" "$v"
    bondretest_timer_lines "$v"
    printf '[Install]\nWantedBy=timers.target\n'
  } >"/etc/systemd/system/$u.timer"
  chmod 644 "/etc/systemd/system/$u.service" "/etc/systemd/system/$u.timer"
  systemctl daemon-reload && systemctl enable --now "$u.timer" >/dev/null 2>&1
}
bond_retest_disable() { # name : stop and remove the timer (toggling the setting off or deleting the tunnel)
  local u; u=$(bondretest_unit "$1")
  systemctl disable --now "$u.timer" >/dev/null 2>&1
  rm -f "/etc/systemd/system/$u.service" "/etc/systemd/system/$u.timer"
  systemctl daemon-reload >/dev/null 2>&1
  return 0
}
bond_retest_set() { # name value : store the setting and install/remove its timer
  local n=$1 v
  v=$(bondretest_ok "$2") || { err "Use off, 30m, 1h, 6h or daily-offpeak."; return 1; }
  bond_retest_visible "$(role "$n")" "$(cfg "$n" carrier)" \
    || { err "Bond auto-retest applies to a bonded tunnel on Iran (carrier list with '+'), not '$n'."; return 1; }
  bondretest_set_file "$n" "$v" || { err "Could not write $CONF/$n.bondretest."; return 1; }
  if [ "$v" = off ]; then bond_retest_disable "$n"; ok "Bond auto-retest off for '$n'."
  elif bond_retest_enable "$n" "$v"; then ok "Bond auto-retest for '$n': $v."
  else err "Could not install the bond-retest timer."; return 1; fi
  return 0
}
bond_candidates_plan() { # bond-carriers plan-d token-peer [sni] -> "carrier peer" for every planned carrier the bond lacks
  # An auto tunnel's token lists what Kharej listens on, so a carrier that failed at auto-test time is known even
  # though the chosen bond never had a peer-<carrier> line for it. icmp has no listen port: it uses the bare peer.
  # H4 (2026-11-04): the engine refuses a shaped carrier inside a '+' bond (D7), and a bare raw plan entry has no
  # ':<port>' to probe. Both are skipped here rather than written into a bond the engine would reject.
  local cur=" ${1//+/ } " pd=$2 addr=$3 sni=${4:-} c p out='' h
  case "$cur" in *" icmp "*) ;; *) [[ "$addr" == *:* ]] || out="icmp $addr" ;; esac
  for x in ${pd//,/ }; do
    c=${x%%:*}; p=${x##*:}
    case "$cur" in *" $c "*) continue ;; esac
    is_shaped_carrier "$c" && continue
    case "$p" in ''|*[!0-9]*) continue ;; esac
    [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || continue
    h=$addr
    if [ -n "$sni" ]; then
      case "$c" in ws|wss|grpc) h=$sni ;; esac
    fi
    out="${out:+$out
}$c $(join_hp "$h" "$p")"
  done
  printf '%s' "$out"
}
bond_peer_for() { # name carrier -> address for a throw-away probe (config peer-<carrier>, the auto plan, else peer)
  local n=$1 c=$2 p='' addr pd
  p=$(cfg "$n" "peer-$c"); [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  addr=$(cfg "$n" peer)
  if [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ]; then
    pd=$(plan_part "$T_AUTO" d); p=$(plan_port "$pd" "$c")
    if [ -n "$p" ] && [ "$c" != icmp ]; then printf '%s' "$(join_hp "$T_PEER" "$p")"; return 0; fi
    addr=$T_PEER
  fi
  printf '%s' "$addr"
}
bondfail_get() { # name -> stored failures, comma separated (empty when none)
  local v=''
  [ -f "$CONF/$1.bondfail" ] && v=$(head -1 "$CONF/$1.bondfail" 2>/dev/null | tr -d '[:space:]')
  [ "$v" = none ] && v=''
  printf '%s' "${v%,}"
}
bondfail_set() { # name list : store the carriers to retry next run
  local n=$1 v=${2:-}
  ( umask 077; printf '%s\n' "${v:-none}" >"$CONF/$n.bondfail.tmp" ) && mv -f "$CONF/$n.bondfail.tmp" "$CONF/$n.bondfail"
}
bondfail_next() { # prev-failures carrier tested failing -> the list the next run retries
  # Only carriers outside the bond are remembered: a leg that is in the bond is probed on every run anyway, so
  # remembering it would just duplicate work. prev/testing/failing accept spaces or commas; carrier is a+b.
  local old=$1 car=${2//+/ } tested=$3 failing=$4 out='' x
  for x in ${tested//,/ }; do
    case " $car " in *" $x "*) continue ;; esac
    case " $failing " in *" $x "*) out="${out:+$out,}$x" ;; esac
  done
  for x in ${old//,/ }; do
    case " $car " in *" $x "*) continue ;; esac
    case " $tested " in *" $x "*) continue ;; esac
    case ",$out," in *",$x,"*) continue ;; esac
    out="${out:+$out,}$x"
  done
  printf '%s' "$out"
}
bond_worth() { # candidate-score best-leg-score -> 0 when adding this carrier is measurable value
  # A working carrier is always worth adding when no leg of the bond works right now; otherwise it must reach 10 %
  # of the best working leg's throughput, so a barely-alive path does not enlarge the bond.
  awk -v c="${1:-0}" -v b="${2:-0}" 'BEGIN{ if (c <= 0) exit 1; if (b <= 0) exit 0; exit !(c >= b*0.1) }'
}
bond_budget_fit() { # candidates budget-mb -> how many fit (1 MB each way per candidate)
  local max=$((${2:-$BONDRETEST_BUDGET_MB} / 2))
  [ "$max" -lt 1 ] && max=1
  [ "$1" -gt "$max" ] && echo "$max" || echo "$1"
}
bond_retest_job() { # name : probe the bond's carriers + the last failures, add one that works now
  local n=$1 cur cur_sp prev pd='' auto=0 pair pairs=() budget nfit c peer path sni icmp fp ech frag fs fm
  local best=0 score added='' failed='' tested=' ' total=0 i=0 npairs
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  [ "$(role "$n")" = Iran ] || { err "Bond auto-retest runs on Iran (the side that dials the bond), not on Kharej."; return 1; }
  cur=$(cfg "$n" carrier)
  bond_retest_visible Iran "$cur" || { err "'$n' is not bonded (carrier '$cur' has no '+'); nothing to re-test."; return 1; }
  is_reverse "$n" && { err "Bond auto-retest does not support a reverse bond: Kharej is the dialing side there."; return 1; }
  cur_sp=${cur//+/ }
  prev=$(bondfail_get "$n")
  sni=$(cfg "$n" sni)
  # Candidates: the bond's legs, every carrier the auto plan left out (known from Iran's NAME.auto token), then the
  # stored failures. A carrier that works again is only added, never swapped in: a bond leg is never removed here.
  if [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ]; then
    auto=1; pd=$(plan_part "$T_AUTO" d)
  fi
  local -a cur_pairs=() cand_pairs=()
  declare -A cand_peer=()
  for c in $cur_sp; do cur_pairs+=("$c $(bond_peer_for "$n" "$c")"); done
  if [ "$auto" = 1 ]; then
    while IFS= read -r pair; do [ -n "$pair" ] && cand_pairs+=("$pair"); done < <(bond_candidates_plan "$cur" "$pd" "$T_PEER" "$sni")
  fi
  for c in ${prev//,/ }; do
    case " $cur_sp " in *" $c "*) continue ;; esac
    case " ${cand_pairs[*]:-} " in *" $c "*) continue ;; esac
    cand_pairs+=("$c $(bond_peer_for "$n" "$c")")
  done
  pairs=("${cur_pairs[@]}" ${cand_pairs[@]+"${cand_pairs[@]}"})
  budget=$(conf_get bondretest-budget "$BONDRETEST_BUDGET_MB")
  [[ "$budget" =~ ^[0-9]+$ ]] && [ "$budget" -gt 0 ] || budget=$BONDRETEST_BUDGET_MB
  npairs=${#pairs[@]}
  nfit=$(bond_budget_fit "$npairs" "$budget")
  if [ "$nfit" -lt "$npairs" ] && [ "${#cur_pairs[@]}" -ge "$nfit" ] && [ "${#cand_pairs[@]}" -gt 0 ]; then
    if [ "$nfit" -ge 2 ]; then
      pairs=("${cur_pairs[0]}" "${cand_pairs[@]}" "${cur_pairs[@]:1}")
    else
      pairs=("${cand_pairs[@]}" "${cur_pairs[@]}")
    fi
  fi
  [ "$nfit" -lt "$npairs" ] && logger -t wattun-bondretest "$n: traffic budget ${budget} MB, probing $nfit of $npairs carriers"
  # Probes are throw-away clients (the at_* machinery) with this tunnel's key and settings: the live bond is untouched.
  path=$(cfg "$n" path); icmp=$(cfg "$n" icmp-type)
  fp=$(cfg "$n" fp); ech=$(cfg "$n" ech); frag=$(cfg "$n" tls-frag)
  fs=$(cfg "$n" fake-sni); fm=$(cfg "$n" fake-mode)
  AT_DIR=$AUTO_RUN/bondretest.$$
  AT_QUIET=1; AT_KEYS=0; AT_MB=1; AT_STOP=0; AT_ACT=''; AT_SKIP=''
  mkdir -p "$AUTO_RUN" && chmod 700 "$AUTO_RUN" && rm -rf "$AT_DIR" && mkdir -p "$AT_DIR" \
    || { err "Could not prepare $AUTO_RUN."; return 1; }
  cp -f "$CONF/$n.key" "$AT_DIR/key" 2>/dev/null || { ( umask 077; cat "$CONF/$n.key" >"$AT_DIR/key" ); }
  chmod 600 "$AT_DIR/key" 2>/dev/null
  T_PATH=${path:-/wat}; T_SNI=$sni; T_ICMP=$icmp
  for pair in "${pairs[@]}"; do
    i=$((i+1)); [ "$i" -le "$nfit" ] || break
    c=${pair%% *}; peer=${pair#* }
    cand_peer[$c]=$peer
    AV_LABEL=("$c"); AV_CAR=("$c"); AV_KIND=(d); AV_PEER=("$peer"); AV_PORT=('')
    AV_SNI=(''); AV_FP=(''); AV_ECH=(''); AV_FRAG=(''); AV_FS=(''); AV_FM=(''); AV_X=('')
    if is_pool "$c"; then AV_SNI=("$sni"); AV_FP=("$fp"); AV_ECH=("$ech"); AV_FRAG=("$frag"); AV_FS=("$fs"); AV_FM=("$fm"); fi
    at_probe 0 8
    tested+="$c "; total=$((total + 2 * AT_MB))
    case " $cur_sp " in *" $c "*) # a bond leg: never removed, only its speed sets the bar for a new path
      if [ "${AR_OK[0]}" = 1 ]; then
        score=$(at_score 0)
        best=$(awk -v a="$best" -v b="$score" 'BEGIN{print (b>a)?b:a}')
        logger -t wattun-bondretest "$n/$c (in the bond): $(printf '%.1f' "${AR_DOWN[0]:-0}") down / $(printf '%.1f' "${AR_UP[0]:-0}") up MB/s"
      else
        logger -t wattun-bondretest "$n/$c (in the bond): failed, ${AR_WHY[0]}; it stays in the bond"
      fi ;;
      *)
      if [ "${AR_OK[0]}" = 1 ]; then
        score=$(at_score 0)
        if bond_worth "$score" "$best"; then
          added+="$c "
          logger -t wattun-bondretest "$n/$c works now: $(printf '%.1f' "${AR_DOWN[0]:-0}") down / $(printf '%.1f' "${AR_UP[0]:-0}") up MB/s, adding it to the bond"
        else
          logger -t wattun-bondretest "$n/$c works but is too slow next to the bond; not adding it"
        fi
      else
        failed+="$c "; logger -t wattun-bondretest "$n/$c failed: ${AR_WHY[0]}"
      fi ;;
    esac
  done
  at_cleanup
  local new='' oknew=1
  if [ -n "$added" ]; then
    local a
    new="$cur"
    for a in $added; do new="$new+$a"; done
    v_carrier_list "$new" || oknew=0 # H4: never write/restart into a carrier list the engine refuses
    for a in $added; do carrier_ok_here "$a" || oknew=0; done
    if [ "$oknew" = 0 ]; then
      logger -t wattun-bondretest "$n: '$new' is not a carrier list this engine can run; keeping the bond unchanged"
      added=''
    fi
  fi
  if [ -n "$added" ]; then
    for a in $added; do
      [ -n "${cand_peer[$a]:-}" ] && set_value "$n" "peer-$a" "${cand_peer[$a]}"
    done
    set_value "$n" carrier "$new"
    logger -t wattun-bondretest "$n: adding ${added% } to the bond ($cur -> $new), restarting the tunnel"
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1
    ok "Added ${added% } to '$n' (bond now $new). The tunnel restarted."
  else
    ok "No carrier to add: the bond keeps its legs${prev:+ (still failing:$prev)}."
  fi
  local nf; nf=$(bondfail_next "$prev" "$cur" "$tested" "$failed")
  bondfail_set "$n" "$nf"
  [ -n "$nf" ] && logger -t wattun-bondretest "$n: retrying next run: $nf"
  logger -t wattun-bondretest "$n: probed$tested($total MB of test traffic)"
  return 0
}

# ======================================================================================
#  Backup & Restore, Bulk Operations
# ======================================================================================
backup_cmd() { # [dest.tar.gz]
  local dest=${1:-wattun-backup-$(date +%Y%m%d%H%M%S).tar.gz}
  dest=$(readlink -f "$dest" 2>/dev/null || echo "$dest")
  say "  Backing up $CONF to $dest..."
  tar -czf "$dest" -C "${CONF%/*}" "${CONF##*/}" || { err "Backup failed"; return 1; }
  chmod 600 "$dest"
  ok "Backup saved: $dest ($(du -h "$dest" | cut -f1))"
}
restore_cmd() { # <archive.tar.gz>
  local src=${1:-}
  [ -f "$src" ] || { err "Backup archive '$src' not found."; return 1; }
  say "  Restoring $CONF from $src..."
  mkdir -p "$CONF"
  tar -xzf "$src" -C "${CONF%/*}" || { err "Restore extraction failed"; return 1; }
  chmod 700 "$CONF"
  chmod 600 "$CONF"/*.key 2>/dev/null || true
  chmod 600 "$CONF"/*.yml 2>/dev/null || true
  ok "Restored configuration to $CONF."
  systemctl daemon-reload 2>/dev/null || true
  ok "Ready. You can start or restart your tunnels now."
}
start_all() {
  local n c=0
  for n in $(tunnels); do # hidden auto helpers start with their parent
    if ! systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Starting ${WAT_PREFIX}@$n" auto_for_each_unit "$n" start; c=$((c+1))
    elif is_auto_kharej "$n"; then
      auto_for_each_unit "$n" start >/dev/null 2>&1 || true
    fi
  done
  [ "$c" -gt 0 ] && ok "Started $c tunnel(s)." || warn "All tunnels are already active."
}
stop_all() {
  local n c=0
  for n in $(tunnels); do # hidden auto helpers stop with their parent
    if systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Stopping ${WAT_PREFIX}@$n" auto_for_each_unit "$n" stop; c=$((c+1))
    elif is_auto_kharej "$n"; then
      auto_for_each_unit "$n" stop >/dev/null 2>&1 || true
    fi
  done
  [ "$c" -gt 0 ] && ok "Stopped $c tunnel(s)." || warn "All tunnels are already stopped."
}
batch_actions_menu() {
  while :; do
    page "All tunnels"
    menu_line 1 'start all' 2 'stop all' 3 'restart all' 4 'status list'
    menu_line 5 'back up configs' 6 'restore configs' 0 back
    key_read
    case "$KEY" in
      1) start_all; pause ;;
      2) confirm "Stop all active tunnels?" n && stop_all; pause ;;
      3) confirm "Restart all tunnels? Open connections drop." n && restart_all; pause ;;
      4) status_all; pause ;;
      5) echo; ask "Backup file" "wattun-backup-$(date +%Y%m%d).tar.gz"; backup_cmd "$REPLY_V"; pause ;;
      6) echo; ask "Backup .tar.gz path" ""; restore_cmd "$REPLY_V"; pause ;;
      b|0|q|enter|esc) return 0 ;;
    esac
  done
}

# ======================================================================================
#  Bonding Manager Submenu
# ======================================================================================
bonding_menu() { # name
  local n=$1 r cr isauto=0
  r=$(role "$n")
  [ "$r" = Iran ] && [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ] && isauto=1
  while :; do
    cr=$(cfg "$n" carrier)
    page "Bonding" "$n · $cr"
    tinfo "$n"
    local bmode=$(cfg "$n" bond-mode)
    set_row m mode "${bmode:-balanced}"
    local brv='' brvis=0
    if bond_retest_visible "$r" "$cr"; then brvis=1; brv=$(bondretest_get "$n"); set_row r 'auto-retest' "$brv" '' off; fi
    echo
    if [ "$TI_CAR_COUNT" -gt 0 ]; then
      printf '  %s%4s  %-10s %-8s %8s %8s %12s%s\n' "$GRY" '#' path state rtt loss share "$RST"
      local ci ccol cdot ctxt c_pct
      for ((ci=0; ci<TI_CAR_COUNT; ci++)); do
        if [ "${CAR_MUTED[$ci]}" = true ]; then
          ccol=$GRY; cdot='○'; ctxt="muted"
        elif [ "${CAR_ALIVE[$ci]}" = true ]; then
          ccol=$GRN; cdot='●'; ctxt="up"
        else
          ccol=$RED; cdot='○'; ctxt="down"
        fi
        c_pct=$(awk -v s="${CAR_SHARE[$ci]:-0}" 'BEGIN{printf "%.0f", s*100}')
        printf '  %s%4s%s  %-10s %s%s %-6s%s %6.0f ms %7.1f%% %11s%%\n' "$CYN" "$ci" "$RST" \
          "${CAR_NAME[$ci]}" "$ccol" "$cdot" "$ctxt" "$RST" "${CAR_RTT[$ci]}" "$(awk -v l="${CAR_LOSS[$ci]:-0}" 'BEGIN{printf "%.1f", l*100}')" "$c_pct"
      done
    else
      hint "No path data: the tunnel is stopped or has one carrier."
    fi
    echo
    menu_line t 'mute or unmute a path' a 'add carrier' d 'remove carrier'
    [ "$brvis" = 1 ] && menu_line r 're-test blocked paths (off/30m/1h/6h/daily-offpeak)'
    menu_line 0 back
    key_read
    case "$KEY" in
      r|R)
        [ "$brvis" = 1 ] || continue
        echo
        say "  ${BOLD}Bond auto-retest${RST} ${GRY}(re-tests every leg plus the last failures; never removes a working leg)${RST}"
        hint "A carrier that works again is added back only when it reaches 10 % of the best working leg."
        ask_ok "Re-test: off, 30m, 1h, 6h or daily-offpeak" "$brv" v_bondretest || continue
        bond_retest_set "$n" "$REPLY_V"
        pause ;;
      t)
        echo
        ask_ok "Path index to mute or unmute" "0" v_num || continue
        local pidx=$REPLY_V act
        ask_ok "mute or unmute?" "mute" v_nonempty || continue
        act=$REPLY_V
        # routed through carrier_toggle_cmd (2026-11-20 review F3): it carries the auto dead-leg index
        # realignment, the range check and the engine-answer interpretation this raw POST lacked
        case "$act" in
          mute|unmute) carrier_toggle_cmd "$act" "$n" "$pidx" ;;
          *) err "Choose mute or unmute." ;;
        esac
        pause ;;
      m)
        echo
        say "  Choose bond mode:"
        say "    ${CYN}1${RST} balanced       (smooth weighted round-robin based on path capacities)"
        say "    ${CYN}2${RST} active-backup  (100% on primary path, 50ms keepalives on secondary, fast cutover)"
        say "    ${CYN}3${RST} replicate      (replicate datagrams across all paths for zero loss)"
        ask_ok "Choice" "1" v_nonempty || continue
        case "$REPLY_V" in
          1|balanced) set_value "$n" bond-mode balanced ;;
          2|active-backup) set_value "$n" bond-mode active-backup ;;
          3|replicate) set_value "$n" bond-mode replicate ;;
          *) warn "Unknown bond mode '$REPLY_V'."; continue ;;
        esac
        ok "Set bond-mode: $(cfg "$n" bond-mode)"
        confirm "Restart '$n' to apply mode change?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
        pause ;;
      a)
        echo
        # Only auto Iran tunnels can gain a path safely: Kharej already listens on every type in
        # the plan, and the per-carrier port comes from it. A fixed/hand-made bond needs peer-<carrier>
        # and listen-<carrier> in Advanced YAML, so this menu must not guess them.
        if [ "$isauto" != 1 ]; then
          warn "Adding a carrier here is for auto tunnels on Iran: the plan already made Kharej listen on every type."
          hint "A hand-made bond needs peer-<carrier> and listen-<carrier> in Advanced YAML (tunnel page, o)."
          hint "To get a bond the easy way: make an auto tunnel on Kharej, then join the tested types on Iran (tunnel page, m)."
          pause; continue
        fi
        local pd=$(plan_part "$T_AUTO" d)
        ask_ok "Carrier name to add (in the plan: ${pd:-none})" "tls" v_nonempty || continue
        local ncar=$REPLY_V cur_car=$(cfg "$n" carrier) p
        if ! carrier_ok "$ncar"; then err "Unknown carrier '$ncar' (use icmp, udp, tcp, tls, ws, wss, h2, h2c, grpc, gre, ipip or an F19 shape)."; pause; continue; fi
        if is_shaped_carrier "$ncar"; then err "F19 shaped carriers are single-carrier only in 3.3.0 (the engine refuses a shaped leg in a '+'-bond)."; pause; continue; fi # D7
        if [[ "+$cur_car+" == *"+$ncar+"* ]]; then
          warn "Carrier '$ncar' is already in carrier list '$cur_car'."
        elif [ "$ncar" = icmp ]; then
          if [[ "$T_PEER" == *:* ]] && ! ipv4_ok "$T_PEER"; then
            err "icmp requires an IPv4/hostname peer."
          else
            set_value "$n" peer-icmp "$T_PEER"
            set_value "$n" carrier "$cur_car+icmp"
            ok "Updated carrier: $(cfg "$n" carrier)"
            confirm "Restart '$n' to apply new carrier bond?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
          fi
        else
          p=$(plan_port "$pd" "$ncar")
          if [ -z "$p" ]; then
            err "Carrier '$ncar' is not in this tunnel's auto plan, so Kharej does not listen for it."
          else
            set_value "$n" "peer-$ncar" "$(join_hp "$T_PEER" "$p")"
            set_value "$n" carrier "$cur_car+$ncar"
            ok "Updated carrier: $(cfg "$n" carrier)"
            if ! is_pool "$ncar" && [ -n "$(cfg "$n" fake-sni)$(cfg "$n" pool-rotate)$(cfg "$n" pool-rotate-bytes)" ]; then
              warn "The $ncar leg carries no fake-SNI or rotation: only tcp/tls/ws/wss/h2/h2c/grpc legs are disguised."
            fi
            confirm "Restart '$n' to apply new carrier bond?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
          fi
        fi
        pause ;;
      d)
        echo
        if [ "$isauto" != 1 ]; then
          warn "Removing a carrier here is for auto tunnels on Iran; for a hand-made bond edit the YAML (tunnel page, o)."
          pause; continue
        fi
        ask_ok "Carrier name to remove" "" v_nonempty || continue
        local rcar=$REPLY_V cur_car=$(cfg "$n" carrier)
        if ! carrier_ok "$rcar"; then err "Unknown carrier '$rcar'."; pause; continue; fi
        if [[ "+$cur_car+" != *"+$rcar+"* ]]; then
          warn "Carrier '$rcar' not found in '$cur_car'."
        else
          local new_car
          new_car=$(echo "$cur_car" | sed -E "s/(^|\+)$rcar(\+|$)/\1/g; s/^\+//; s/\+$//")
          if [ -z "$new_car" ]; then
            err "Cannot remove the only carrier."
          else
            set_value "$n" carrier "$new_car"
            sed -i -E "/^peer-$rcar:/d" "$CONF/$n.yml"
            ok "Updated carrier: $(cfg "$n" carrier)"
            confirm "Restart '$n' to apply?" y && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
          fi
        fi
        pause ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Auto Mode Settings Submenu
# ======================================================================================
auto_menu() { # name
  local n=$1 cur pol sla_f isauto=0
  sla_f="$CONF/$n.sla"
  [ -f "$CONF/$n.auto" ] && read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ] && isauto=1
  while :; do
    page "Auto mode" "$n"
    cur=$(auto_current_key "$n" 2>/dev/null || cfg "$n" carrier)
    pol=$(cat "$CONF/$n.policy" 2>/dev/null || echo speed)
    [ "$isauto" != 1 ] && { hint "Fixed-type token: policy and retest need a new token (tunnel page, t)."; echo; }
    printf '      %-13s %s\n' 'in use' "${cur:--}"
    set_row p policy "$pol"
    local sla_v=''
    if [ -f "$sla_f" ]; then
      local min_r=$(grep '^sla_min_rate_kbps=' "$sla_f" 2>/dev/null | cut -d= -f2)
      local max_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" 2>/dev/null | cut -d= -f2)
      local max_l=$(grep '^sla_max_loss_pct=' "$sla_f" 2>/dev/null | cut -d= -f2)
      sla_v="rate ≥ ${min_r:-0} kbps · rtt ≤ ${max_rtt:-0} ms · loss ≤ ${max_l:-0} %"
    fi
    set_row s 'heal when' "$sla_v" '' 'the link is down'
    local opt_timer_st=''
    systemctl is-active -q "$WAT_PREFIX-auto-optimize.timer" 2>/dev/null && opt_timer_st="${GRN}on${RST} ${GRY}(retests once a day off-peak)${RST}"
    set_row o 'daily retest' "$opt_timer_st" '' off
    echo
    menu_line r 'retest now' 0 back
    key_read
    case "$KEY" in
      p)
        echo
        if [ "$isauto" != 1 ]; then
          warn "The selection policy is read only by auto tunnels; this one was made with a fixed type."
          hint "For an auto tunnel: make one on Kharej, paste its token here (t), run auto-test."
          pause; continue
        fi
        say "  Choose carrier selection policy:"
        say "    ${CYN}1${RST} speed    (rank by Down+Up throughput, lowest RTT tiebreak)"
        say "    ${CYN}2${RST} latency  (rank by lowest round-trip latency)"
        say "    ${CYN}3${RST} direct   (prioritize direct unproxied paths over CDN)"
        say "    ${CYN}4${RST} bond     (automatically bond top direct performers)"
        ask_ok "Choice" "1" v_nonempty || continue
        case "$REPLY_V" in
          1|speed) echo speed >"$CONF/$n.policy" ;;
          2|latency) echo latency >"$CONF/$n.policy" ;;
          3|direct) echo direct >"$CONF/$n.policy" ;;
          4|bond) echo bond >"$CONF/$n.policy" ;;
          *) warn "Unknown policy '$REPLY_V'."; continue ;;
        esac
        ok "Policy saved: $(cat "$CONF/$n.policy")"
        pause ;;
      s)
        echo
        local cur_min=0 cur_rtt=0 cur_loss=0
        if [ -f "$sla_f" ]; then
          cur_min=$(grep '^sla_min_rate_kbps=' "$sla_f" | cut -d= -f2)
          cur_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" | cut -d= -f2)
          cur_loss=$(grep '^sla_max_loss_pct=' "$sla_f" | cut -d= -f2)
        fi
        ask_ok "Minimum required throughput in kbps (0 = none)" "${cur_min:-0}" v_num || continue
        cur_min=$REPLY_V
        ask_ok "Maximum tolerable RTT in ms (0 = none, e.g. 300)" "${cur_rtt:-0}" v_num || continue
        cur_rtt=$REPLY_V
        ask_ok "Maximum tolerable packet loss % (0 = none, e.g. 10)" "${cur_loss:-0}" v_num || continue
        cur_loss=$REPLY_V
        {
          echo "sla_min_rate_kbps=$cur_min"
          echo "sla_max_rtt_ms=$cur_rtt"
          echo "sla_max_loss_pct=$cur_loss"
        } >"$sla_f"
        chmod 600 "$sla_f"
        ok "SLA configured."
        pause ;;
      r)
        echo
        if [ "$isauto" = 1 ]; then
          say "  Running auto-test & policy re-evaluation..."
        elif cdn_tunnel_p "$n"; then
          say "  Refreshing the CDN edge list..."
        else
          hint "Nothing to re-rank: this tunnel was made with a fixed type. To switch types, make a new tunnel or use an auto token."
          pause; continue
        fi
        AUTO_OPTIMIZE=1 auto_retest "$n"
        pause ;;
      o)
        echo
        if systemctl is-active -q "$WAT_PREFIX-auto-optimize.timer" 2>/dev/null; then
          optimize_disable
        else
          optimize_enable
        fi
        sleep 1 ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Bandwidth Quotas & Limits Submenu
# ======================================================================================
limits_menu() { # name
  local n=$1 r cr
  r=$(role "$n"); cr=$(cfg "$n" carrier)
  while :; do
    page "Limits" "$n"
    set_row m 'speed limit' "$(cfg "$n" max-mbps)" 'MB/s' 'none'
    echo
    say "  ${GRY}per port${RST}"
    local -a p_limits=()
    mapfile -t p_limits < <(grep -E '^[[:space:]]*-[[:space:]]+[0-9]+' "$CONF/$n.yml" | grep -E 'rate=|quota=' || true)
    if [ "${#p_limits[@]}" -gt 0 ]; then
      local it
      for it in "${p_limits[@]}"; do
        say "    $it"
      done
    else
      say "    ${GRY}none${RST}"
    fi
    echo
    local m=$(cfg "$n" metrics)
    if [ -n "$m" ]; then
      local prt_json
      prt_json=$(curl -fs --noproxy '*' --max-time 2 "http://$m/ports" 2>/dev/null)
      if [ -n "$prt_json" ]; then
        say "  ${GRY}quota used${RST}"
        local pobj
        while read -r pobj; do
          [ -n "$pobj" ] || continue
          local lp qu ql qe qp qr
          lp=$(jget "$pobj" port)
          qp=$(jget "$pobj" quota_period); qr=$(jget "$pobj" quota_resets_at)
          qu=$(jget "$pobj" quota_used)
          ql=$(jget "$pobj" quota_limit)
          qe=$(jget "$pobj" quota_exceeded)
          if [ "${ql:-0}" -gt 0 ]; then
            say "    $lp  $(human "$qu") of $(human "$ql")$([ "$qe" = true ] && printf '  %s✘ used up%s' "$RED" "$RST")$([ -n "$qp" ] && [ "${qr:-0}" -gt 0 ] 2>/dev/null && printf '  %sper %s, resets %s%s' "$GRY" "$qp" "$(date -d "@$qr" '+%Y-%m-%d %H:%M' 2>/dev/null)" "$RST")"
          fi
        done < <(grep -o '{[^{}]*}' <<<"$prt_json")
      fi
    fi
    echo
    menu_line e 'set a port limit' r 'reset a port quota' 0 back
    key_read
    case "$KEY" in
      m)
        echo
        ask_ok "Global speed ceiling in MB/s (- or 0 or default = unset)" "$(cfg "$n" max-mbps)" v_mbps_adv || continue
        case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
        if [ -z "$REPLY_V" ]; then unset_value "$n" max-mbps; else set_value "$n" max-mbps "$REPLY_V"; fi
        [ "$r" = Kharej ] && is_auto_kharej "$n" && auto_sync_helper_settings "$n"
        ok "Saved. Restart '$n' to apply."
        pause ;;
      e)
        echo
        ask_ok "Port to limit" "" v_port || continue
        local lport=$REPLY_V
        ask_ok "Rate limit (e.g. 5MB, 300k, 0 = none)" "0" v_pool_bytes || continue
        local lrate=$REPLY_V
        ask_ok "Quota limit (e.g. 100GB, 500MB, 0 = none)" "0" v_pool_bytes || continue
        local lquota=$REPLY_V lper=''
        if [ -n "$lquota" ] && [ "$lquota" != 0 ] && [ "$(bin_ver_ok 3.3.6)" = 1 ]; then # an older wattun refuses period=
          ask_ok "Reset the quota every day, week or month (- = never)" "-" v_quota_period || continue
          case "${REPLY_V,,}" in day|week|month) lper=${REPLY_V,,} ;; esac
        fi
        set_port_limit "$n" "$lport" "$lrate" "$lquota" "$lper"
        [ "$r" = Kharej ] && is_auto_kharej "$n" && auto_sync_helper_settings "$n"
        ok "Saved limit for port $lport. Hot-reloaded automatically by engine."
        pause ;;
      r)
        echo
        ask_ok "Port to reset quota for" "" v_port || continue
        local rport=$REPLY_V
        if [ -n "$m" ]; then
          local rres
          rres=$(curl -fs --noproxy '*' --max-time 3 -X POST "http://$m/quota/reset?port=$rport" 2>/dev/null)
          if [ -n "$rres" ]; then
            ok "Quota for port $rport reset."
          else
            err "Failed to reset quota on metrics server http://$m."
          fi
        else
          warn "Tunnel '$n' has no metrics endpoint configured."
        fi
        pause ;;
      b|0|q|enter|esc) break ;;
    esac
  done
}

# ======================================================================================
#  Tunnel page: status header + two-column command deck
# ======================================================================================
# The deck has two columns of rows. A row is a section header or an action. Arrows and Tab move a
# visible cursor (">"); Enter runs the selected action, and every action keeps its hotkey so the
# page stays fast for people who know it. Each action carries a one-line description, so the page
# explains itself instead of asking the operator to memorize 16 cryptic labels.
TM_SELKEY=''; TM_FSIDE=L; TM_FIDX=0; TM_CW=36
TL_TYPE=(); TL_KEY=(); TL_LAB=(); TL_DESC=(); TL_HELP=()
TR_TYPE=(); TR_KEY=(); TR_LAB=(); TR_DESC=(); TR_HELP=()

tmenu_lhdr() { TL_TYPE+=(H); TL_KEY+=(''); TL_LAB+=("$1"); TL_DESC+=(''); TL_HELP+=(''); }
tmenu_rhdr() { TR_TYPE+=(H); TR_KEY+=(''); TR_LAB+=("$1"); TR_DESC+=(''); TR_HELP+=(''); }
tmenu_ladd() { TL_TYPE+=(I); TL_KEY+=("$1"); TL_LAB+=("$2"); TL_DESC+=("$3"); TL_HELP+=("$4"); }
tmenu_radd() { TR_TYPE+=(I); TR_KEY+=("$1"); TR_LAB+=("$2"); TR_DESC+=("$3"); TR_HELP+=("$4"); }

tunnel_menu_build() { # name role run boot carrier z_ok reverse auto_kharej has_companion
  local n=$1 r=$2 run=$3 boot=$4 car=$5 z_ok=${6:-0} rev=${7:-0} auto=${8:-0} comp=${9:-0}
  local stop_lab stop_desc boot_desc pcnt bmode ac_st=''
  TL_TYPE=(); TL_KEY=(); TL_LAB=(); TL_DESC=(); TL_HELP=()
  TR_TYPE=(); TR_KEY=(); TR_LAB=(); TR_DESC=(); TR_HELP=()
  if [ "$run" = active ]; then stop_lab=Stop; stop_desc='active'
  else stop_lab=Start; stop_desc='stopped'; fi
  if [ "$boot" = on ]; then boot_desc='on · toggle'; else boot_desc='off · toggle'; fi
  pcnt=$(yml_maps "$n" 2>/dev/null | wc -l)
  [ "$pcnt" -gt 0 ] && pcnt="$pcnt rule$([ "$pcnt" = 1 ] || echo s)" || pcnt=$([ "$r" = Kharej ] && echo any || echo none)
  bmode=$(cfg "$n" bond-mode 2>/dev/null || true)
  if [ "$z_ok" = 1 ]; then
    ac_st=$(detect_preset "$n" 2>/dev/null || echo off)
    [ "$ac_st" = off ] && [ -z "$(cfg "$n" fake-sni)$(cfg "$n" pool-rotate)$(cfg "$n" ech)$(cfg "$n" governor)" ] && ac_st=off
  fi

  tmenu_lhdr Observe
  tmenu_ladd l Logs '' "Follow ${WAT_PREFIX}@$n in journalctl (Ctrl+C returns)"
  tmenu_ladd d Diagnose '' 'Check key, carrier, route, MTU and run speed test'
  tmenu_ladd v 'Speed test' '' 'Transfer 10 MB down/up through the live tunnel'
  tmenu_ladd m Monitor '' 'Live throughput & RTT view (any key returns)'
  tmenu_lhdr Route
  tmenu_ladd p Ports "$pcnt" 'Edit port mappings (reloads in 3 s, no drop)'
  tmenu_ladd c Carrier "${car:0:12}" 'Change transport carrier (icmp, tcp, tls, wss...)'
  tmenu_ladd q Limits '' 'Per-port bandwidth limits and traffic quotas'
  tmenu_ladd b Bonding "$bmode" 'Bond multiple carriers or set bonding policy'
  [ "$z_ok" = 1 ] && tmenu_ladd z Anti-censor "$ac_st" 'fake-SNI, ECH, rotation, presets and matrix'

  tmenu_rhdr Service
  tmenu_radd r Restart '' 'Restart service (drops active connections)'
  tmenu_radd s "$stop_lab" "$stop_desc" 'Start or stop this service now'
  tmenu_radd e Boot "$boot_desc" 'Toggle automatic start at boot'
  tmenu_radd o Advanced '' 'MTU, FEC, batching, sessions, bind, direction'
  tmenu_rhdr Identity
  if [ "$r" = Kharej ]; then
    tmenu_radd t Token '' "Show token for Iran setup"
    tmenu_radd k 'New key' '' 'Rotate PSK and regenerate token'
    [ "$rev" = 1 ] && [ "$comp" = 0 ] && tmenu_radd h 'Iran IP' '' 'Change Iran peer address (reverse tunnel)'
  else
    tmenu_radd t 'New token' '' 'Replace Kharej, key and carrier (ports stay)'
    if [ "$rev" = 1 ]; then
      [ "$car" != icmp ] && tmenu_radd h 'Listen port' '' 'Change reverse carrier listen port'
    else
      tmenu_radd h 'Kharej IP' '' 'Change Kharej peer address'
    fi
    tmenu_radd a 'Auto mode' '' 'Probe carriers and pick fastest route'
  fi
  # keep the cursor on the same action across redraws; if it vanished, start from the first action
  tmenu_find "$TM_SELKEY" || tunnel_menu_first
}

tmenu_find() { # key -> TM_FSIDE=L|R, TM_FIDX=row ; rc 1 when the key is not an action on this page
  local k=$1 i
  for i in "${!TL_KEY[@]}"; do
    [ "${TL_TYPE[$i]}" = I ] && [ "${TL_KEY[$i]}" = "$k" ] && { TM_FSIDE=L; TM_FIDX=$i; return 0; }
  done
  for i in "${!TR_KEY[@]}"; do
    [ "${TR_TYPE[$i]}" = I ] && [ "${TR_KEY[$i]}" = "$k" ] && { TM_FSIDE=R; TM_FIDX=$i; return 0; }
  done
  return 1
}
tunnel_menu_first() {
  local i
  for i in "${!TL_KEY[@]}"; do [ "${TL_TYPE[$i]}" = I ] && { TM_SELKEY=${TL_KEY[$i]}; return 0; }; done
  for i in "${!TR_KEY[@]}"; do [ "${TR_TYPE[$i]}" = I ] && { TM_SELKEY=${TR_KEY[$i]}; return 0; }; done
}
tunnel_menu_select() { # key : follow a typed hotkey with the cursor (no-op for unknown keys)
  local k=${1,,}
  [ -n "$k" ] || return 0
  tmenu_find "$k" && TM_SELKEY=$k
  return 0
}
tmenu_closest_to() { # side row -> TM_CKEY: the action in that column nearest to row
  local side=$1 row=$2 i d bestd=999
  TM_CKEY=''
  if [ "$side" = L ]; then
    for i in "${!TL_KEY[@]}"; do
      [ "${TL_TYPE[$i]}" = I ] || continue
      d=$(( i > row ? i - row : row - i ))
      [ "$d" -lt "$bestd" ] && { bestd=$d; TM_CKEY=${TL_KEY[$i]}; }
    done
  else
    for i in "${!TR_KEY[@]}"; do
      [ "${TR_TYPE[$i]}" = I ] || continue
      d=$(( i > row ? i - row : row - i ))
      [ "$d" -lt "$bestd" ] && { bestd=$d; TM_CKEY=${TR_KEY[$i]}; }
    done
  fi
  [ -n "$TM_CKEY" ]
}
tunnel_menu_move() { # up|down|left|right : move the cursor, skipping section headers
  local dir=$1 side idx i n want
  if ! tmenu_find "$TM_SELKEY"; then tunnel_menu_first; return 0; fi
  side=$TM_FSIDE; idx=$TM_FIDX
  case "$dir" in
    up) n=-1 ;;
    down) n=1 ;;
    *)
      want=R; [ "$side" = R ] && want=L
      tmenu_closest_to "$want" "$idx" && TM_SELKEY=$TM_CKEY
      return 0 ;;
  esac
  i=$(( idx + n ))
  if [ "$side" = L ]; then
    while [ "$i" -ge 0 ] && [ "$i" -lt "${#TL_TYPE[@]}" ]; do
      [ "${TL_TYPE[$i]}" = I ] && { TM_SELKEY=${TL_KEY[$i]}; return 0; }
      i=$(( i + n ))
    done
  else
    while [ "$i" -ge 0 ] && [ "$i" -lt "${#TR_TYPE[@]}" ]; do
      [ "${TR_TYPE[$i]}" = I ] && { TM_SELKEY=${TR_KEY[$i]}; return 0; }
      i=$(( i + n ))
    done
  fi
  return 0
}
tmenu_cell() { # side row -> CELL : one deck cell with colours (empty past the column's last row)
  local side=$1 i=$2 t key lab desc
  local -a ty=("${TL_TYPE[@]}") ky=("${TL_KEY[@]}") la=("${TL_LAB[@]}") de=("${TL_DESC[@]}")
  if [ "$side" = R ]; then
    ty=("${TR_TYPE[@]}"); ky=("${TR_KEY[@]}"); la=("${TR_LAB[@]}"); de=("${TR_DESC[@]}")
  fi
  t=${ty[$i]:-}
  case "$t" in
    H) CELL="${BOLD}${la[$i]}${RST}" ;;
    I) key=${ky[$i]}; lab=${la[$i]}; desc=${de[$i]}
       if [ "$key" = "$TM_SELKEY" ]; then
         CELL="$(printf '%s▸%s %s %s%-14s%s %s%s%s' "$CYN" "$RST" "$(key_label "$key")" "$BOLD" "$lab" "$RST" "$GRY" "$desc" "$RST")"
       else
         CELL="$(printf '  %s %-14s %s%s%s' "$(key_label "$key")" "$lab" "$GRY" "$desc" "$RST")"
       fi ;;
    *) CELL='' ;;
  esac
}
tunnel_menu_render() {
  local rows i l r pad cols
  cols=$(term_cols)
  if [ "$cols" -lt 74 ]; then
    for ((i=0; i<${#TL_TYPE[@]}; i++)); do tmenu_cell L "$i"; printf '  %s\n' "$CELL"; done
    echo
    for ((i=0; i<${#TR_TYPE[@]}; i++)); do tmenu_cell R "$i"; printf '  %s\n' "$CELL"; done
    return 0
  fi
  rows=${#TL_TYPE[@]}
  [ "${#TR_TYPE[@]}" -gt "$rows" ] && rows=${#TR_TYPE[@]}
  for ((i=0; i<rows; i++)); do
    tmenu_cell L "$i"; l=$CELL
    tmenu_cell R "$i"; r=$CELL
    if [ -z "$r" ]; then printf '  %s\n' "$l"; continue; fi
    vlen "$l"; pad=$(( TM_CW - VLEN )); [ "$pad" -lt 0 ] && pad=0
    printf '  %s%*s  %s\n' "$l" "$pad" '' "$r"
  done
}
tunnel_menu_help_line() {
  local lab help
  tmenu_find "$TM_SELKEY" || return 0
  if [ "$TM_FSIDE" = L ]; then lab=${TL_LAB[$TM_FIDX]}; help=${TL_HELP[$TM_FIDX]}
  else lab=${TR_LAB[$TM_FIDX]}; help=${TR_HELP[$TM_FIDX]}; fi
  printf '\n  %s▸%s %s%s%s  %s%s%s\n' "$CYN" "$RST" "$BOLD" "$lab" "$RST" "$GRY" "$help" "$RST"
}
tunnel_menu_footer() {
  local nav pad w=${UI_W:-74}
  nav="${GRY}↑↓${RST} move  ${GRY}tab${RST} col  ${GRY}enter${RST} open  ${GRY}0${RST} back  ${GRY}?${RST} keys"
  vlen "$nav"; pad=$(( w - VLEN - 10 )); [ "$pad" -lt 2 ] && pad=2
  printf '  %s%*s%s[x] delete%s\n' "$nav" "$pad" '' "$RED" "$RST"
}
tunnel_menu_keys() { # name : the full key map, for "?" (any key returns to the deck)
  local n=$1 i
  local -a ty ky la he
  page "Keys" "$n"
  ty=("${TL_TYPE[@]}"); ky=("${TL_KEY[@]}"); la=("${TL_LAB[@]}"); he=("${TL_HELP[@]}")
  for i in "${!ty[@]}"; do
    case "${ty[$i]}" in
      H) printf '  %s%s%s\n' "$BOLD" "${la[$i]}" "$RST" ;;
      I) printf '  %s %-14s %s%s%s\n' "$(key_label "${ky[$i]}")" "${la[$i]}" "$GRY" "${he[$i]}" "$RST" ;;
    esac
  done
  ty=("${TR_TYPE[@]}"); ky=("${TR_KEY[@]}"); la=("${TR_LAB[@]}"); he=("${TR_HELP[@]}")
  for i in "${!ty[@]}"; do
    case "${ty[$i]}" in
      H) printf '  %s%s%s\n' "$BOLD" "${la[$i]}" "$RST" ;;
      I) printf '  %s %-14s %s%s%s\n' "$(key_label "${ky[$i]}")" "${la[$i]}" "$GRY" "${he[$i]}" "$RST" ;;
    esac
  done
  printf '  %s %-14s %s%s%s\n' "$(key_label x)" Delete 'Remove tunnel and all files (confirms first)' "$GRY" "$RST"
  printf '  %s %-14s %s%s%s\n' "$(key_label s)" 'Spoofing & shaping' 'How each anti-censor option behaves' "$GRY" "$RST"
  echo
  hint "Press any key to go back"
  while :; do
    key_read
    [ "$KEY" = s ] && { spoofhelp_page "$n"; continue; }
    return 0
  done
}
tunnel_header() { # name role
  local n=$1 r=$2 left right pad
  if [ "$NONINTERACTIVE" = 1 ]; then printf '== %s (%s) ==\n' "$n" "$r"; return 0; fi
  ui_init_width; clear_screen; echo
  tinfo "$n"; state_cell "$r" "$TI_STATE"
  left="${GRY}WatTunnel${VER:+ v$VER} ·${RST} ${BOLD}${n}${RST}  ${GRY}${r}${RST}"
  right="${SC_COL}${SC_DOT} ${SC_TXT}${RST} ${GRY}· $(carrier_label "$n")${RST}"
  if [ "$TI_STATE" = up ] || [ "$TI_STATE" = degraded ]; then
    if awk -v r="${TI_RATE:-0}" 'BEGIN{exit !(r > 0)}'; then
      right+=" ${GRY}·${RST} ↓$(human "$TI_RATE")/s"
    else
      right+=" ${GRY}· idle${RST}"
    fi
  fi
  vlen "$left"; pad=$(( UI_W - VLEN )); vlen "$right"; pad=$(( pad - VLEN ))
  [ "$pad" -lt 2 ] && pad=2
  printf '  %s%*s%s\n' "$left" "$pad" '' "$right"
  hr
  echo
}

tunnel_page() {
  local n=$1 r run boot car z_ok rev auto comp par first=1
  TM_SELKEY=''
  while :; do
    [ -f "$CONF/$n.yml" ] || return 0
    r=$(role "$n")
    run=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null)
    boot=off; systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null && boot=on
    car=$(cfg "$n" carrier)
    z_ok=0; [ "$(uname -s)" = Linux ] && { is_pool_list "$car" || [ "$car" = icmp ]; } && z_ok=1
    rev=0; is_reverse "$n" && rev=1
    auto=0; is_auto_kharej "$n" && auto=1
    comp=0; [ -n "$(companion_of "$n")" ] && comp=1
    tunnel_header "$n" "$r"
    # first render: put the cursor on the action that is useful right now
    if [ "$first" = 1 ]; then
      first=0
      case "$TI_STATE" in
        stopped) TM_SELKEY=s ;;
        down|degraded) TM_SELKEY=d ;;
        *) TM_SELKEY=l ;;
      esac
    fi
    tunnel_card "$n"
    echo
    tunnel_menu_build "$n" "$r" "$run" "$boot" "$car" "$z_ok" "$rev" "$auto" "$comp"
    tunnel_menu_render
    tunnel_menu_help_line
    echo
    tunnel_menu_footer
    KEY_NAV=1; key_read; KEY_NAV=0
    case "$KEY" in
      up|down|left|right) tunnel_menu_move "$KEY"; continue ;;
      tab|$'\t') tunnel_menu_move right; continue ;;
      enter|' ') [ -n "$TM_SELKEY" ] && KEY=$TM_SELKEY || continue ;;
    esac
    tunnel_menu_select "$KEY"
    case "$KEY" in
      d|D) page "Diagnose" "$n"; run_flow test_tunnel "$n"; pause ;;
      v|V) page "Speed test" "$n"; run_flow speed_test "$n"; pause ;;
      l|L) page "Logs" "$n"; run_flow logs_menu "$n"; pause ;;
      m|M) run_flow live_monitor ;;
      p|P) run_flow edit_ports "$n"; pause ;;
      q|Q) run_flow limits_menu "$n" ;;
      c|C) page "Connection type" "$n"; run_flow change_type "$n"; pause ;;
      b|B) run_flow bonding_menu "$n" ;;
      a|A) [ "$r" = Iran ] && run_flow auto_menu "$n" ;;
      h|H) if [ "$r" = Kharej ] && is_reverse "$n" && [ -z "$(companion_of "$n")" ]; then page "Iran address" "$n"; echo; run_flow change_peer "$n"; pause
           elif [ "$r" = Iran ]; then
             if is_reverse "$n"; then
               [ "$(cfg "$n" carrier)" != icmp ] && { page "Carrier listen port" "$n"; echo; run_flow change_peer "$n"; pause; }
             else page "Kharej address" "$n"; echo; run_flow change_peer "$n"; pause; fi
           fi ;;
      t|T) if [ "$r" = Kharej ]; then
           par=$(companion_of "$n")
           page "Token" "$n"
           show_token "${par:-$n}"
         else page "New token" "$n"
               hint "Replaces Kharej, key and carrier; ports stay."
               echo; run_flow change_key "$n"; fi
         pause ;;
      k|K) if [ "$r" = Kharej ]; then
           par=$(companion_of "$n"); page "New key" "$n"
           run_flow change_key "${par:-$n}"; pause
         else anticensor_menu "$n"; fi ;;
      o|O) run_flow adv_menu "$n" ;;
      z|Z) anticensor_menu "$n" ;;
      r|R) echo; if confirm "Restart '$n'? Open connections drop." n; then step "Restarting ${WAT_PREFIX}@$n" auto_for_each_unit "$n" restart; sleep 1; fi ;;
      s|S) echo
         if [ "$run" = active ]; then auto_for_each_unit "$n" stop; ok "Stopped (it still starts at boot if enabled)."; sleep 1
         else start_unit "$n"; sleep 1; fi ;;
      e|E) echo
         if systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null; then auto_for_each_unit "$n" disable; ok "Will NOT start at boot."
         else auto_for_each_unit "$n" enable; ok "Will start at boot."; fi
         sleep 1 ;;
      x|X) page "Delete tunnel" "$n"; echo; run_flow delete_tunnel "$n"; pause ;;
      0|esc) return 0 ;;
      \?|\/|help) tunnel_menu_keys "$n"; continue ;;
      *) : ;;
    esac
  done
}

# ======================================================================================
#  Auto-heal, update, rollback, uninstall, settings
# ======================================================================================
# The heal timer also drives the automatic auto-tunnel cleanup (R3: prune, widen safety net), so a Kharej-only server
# with an auto tunnel needs it too (ensure_prune_timer below installs it). heal() itself is role-gated: the restart/
# retest/matrix work runs only for Iran tunnels, so on a server it can only prune/widen. WAT_UNIT_DIR is a self-test
# hook (write the unit files into a throwaway directory); production always uses /etc/systemd/system.
unit_dir() { printf '%s' "${WAT_UNIT_DIR:-/etc/systemd/system}"; }
heal_enable() {
  local mgr=/usr/local/bin/wattun-manager ud
  ud=$(unit_dir); mkdir -p "$ud" 2>/dev/null
  [ "$SANDBOX" = 1 ] && mgr=$MGR
  {
    printf '[Unit]\nDescription=WatTunnel auto-heal%s\n[Service]\nType=oneshot\n' "$([ "$SANDBOX" = 1 ] && echo " (sandbox $WAT_PREFIX)")"
    unit_env_lines
    printf 'ExecStart=%s heal\n' "$mgr"
  } >"$ud/$HEAL_UNIT.service"
  cat >"$ud/$HEAL_UNIT.timer" <<EOF
[Unit]
Description=WatTunnel auto-heal and auto-tunnel cleanup every minute
[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
[Install]
WantedBy=timers.target
EOF
  chmod 644 "$ud/$HEAL_UNIT.service" "$ud/$HEAL_UNIT.timer"
  systemctl daemon-reload && systemctl enable --now "$HEAL_UNIT.timer" >/dev/null 2>&1 && ok "Auto-heal and auto-tunnel cleanup enabled."
}
heal_disable() {
  local ud; ud=$(unit_dir)
  systemctl disable --now "$HEAL_UNIT.timer" >/dev/null 2>&1
  rm -f "$ud/$HEAL_UNIT.service" "$ud/$HEAL_UNIT.timer"
  ok "Auto-heal disabled."
}
prune_timer_needed() { # role is-auto(1|0) -> 0 when this host has an auto Kharej tunnel that needs the heal timer
  [ "${1:-}" = Kharej ] && [ "${2:-0}" = 1 ]
}
ensure_heal_timer() { # an auto Kharej tunnel is healed/maintained by heal(), so its timer must exist even on a Kharej-only server
  local n any=0
  for n in $(tunnels); do
    prune_timer_needed "$(role "$n")" "$(is_auto_kharej "$n" && echo 1 || echo 0)" && { any=1; break; }
  done
  [ "$any" = 1 ] || return 0
  systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null && return 0
  heal_enable >/dev/null 2>&1 && logger -t wattun-auto "enabled the heal timer (auto-tunnel maintenance)"
  return 0
}
ensure_prune_timer() { ensure_heal_timer "$@"; }
mgr_lock() { # L10: one manager pass at a time; fd 9 holds the lock until this process exits (no explicit unlock)
  mkdir -p "$RUN" 2>/dev/null
  command -v flock >/dev/null 2>&1 || return 0 # no flock (a stripped test host): run unlocked, never refuse to work
  exec 9>"$RUN/manager.lock" || return 0
  flock -n 9 && return 0
  warn "Another wattun-manager pass is running; skipping this one."
  return 1
}
heal() { # restart Iran tunnels whose link is down or breaches SLA 3 checks in a row
  local n cnt f st cyc sla_f b_f
  mkdir -p "$RUN"
  for n in $(tunnels); do
    [ "$(role "$n")" = Iran ] && systemctl is-enabled -q "${WAT_PREFIX}@$n" || continue
    f="$RUN/$n.down"
    b_f="$RUN/$n.sla_breach"
    # no metrics: line means no /stats to judge by: never count it as down (it would restart every 3 checks forever)
    if [ -z "$(cfg "$n" metrics)" ]; then rm -f "$f" "$RUN/$n.cycles" "$b_f" "$RUN/$n.sla_bytes"; continue; fi
    st=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null)
    if [ "$st" = inactive ]; then rm -f "$f" "$RUN/$n.cycles" "$b_f" "$RUN/$n.sla_bytes"; continue; fi # stopped on purpose: leave it alone
    local s_raw; s_raw=$(stats_flat "$n")
    local rx_age; rx_age=$(jget "$s_raw" last_rx_age_ms 2>/dev/null || echo -1)
    if [ "$(jget "$s_raw" alive)" = true ] && [ "$rx_age" -ge 0 ] && [ "$rx_age" -lt 35000 ]; then
      rm -f "$f" "$RUN/$n.cycles"
      sla_f="$CONF/$n.sla"
      if [ -f "$sla_f" ]; then
        local min_r max_rtt max_loss rtt loss tot now prev_tot prev_t act rate_kbps="" breached=0
        min_r=$(grep '^sla_min_rate_kbps=' "$sla_f" 2>/dev/null | cut -d= -f2)
        max_rtt=$(grep '^sla_max_rtt_ms=' "$sla_f" 2>/dev/null | cut -d= -f2)
        max_loss=$(grep '^sla_max_loss_pct=' "$sla_f" 2>/dev/null | cut -d= -f2)
        rtt=$(jget_flat "$s_raw" rtt_ms srtt_ms)
        loss=$(jget "$s_raw" loss_pct)
        # measured throughput in kbit/s from the byte counters since the last check (rate_bps is the pacer's allowed
        # rate in bytes/s, not traffic). awk does the math: the counters outgrow bash on 32-bit and may print as 1.2e+07.
        tot=$(awk -v a="$(jget "$s_raw" bytes_in_total)" -v b="$(jget "$s_raw" bytes_out_total)" 'BEGIN { printf "%.0f", a + b }')
        now=$(date +%s)
        if [ -f "$RUN/$n.sla_bytes" ] && read -r prev_tot prev_t <"$RUN/$n.sla_bytes"; then # first run or a restart (counter went back): no verdict
          rate_kbps=$(awk -v t="$tot" -v p="${prev_tot:-0}" -v n="$now" -v q="${prev_t:-0}" 'BEGIN { if (t >= p && n > q) printf "%d", (t - p) * 8 / 1000 / (n - q) }')
        fi
        echo "$tot $now" >"$RUN/$n.sla_bytes"
        act=$(jget_flat "$s_raw" streams_total streams) # an idle tunnel is not slow: judge the rate only while streams are open
        [ -n "$max_rtt" ] && [ "$max_rtt" -gt 0 ] && [ "${rtt%.*}" -gt "$max_rtt" ] 2>/dev/null && breached=1
        [ -n "$max_loss" ] && [ "$max_loss" -gt 0 ] && [ "${loss%.*}" -gt "$max_loss" ] 2>/dev/null && breached=1
        [ -n "$min_r" ] && [ "$min_r" -gt 0 ] && [ -n "$rate_kbps" ] && [ "${act:-0}" -gt 0 ] && [ "$rate_kbps" -lt "$min_r" ] 2>/dev/null && breached=1
        if [ "$breached" = 1 ]; then
          local b_cnt=$(( $(cat "$b_f" 2>/dev/null || echo 0) + 1 ))
          echo "$b_cnt" >"$b_f"
          if [ "$b_cnt" -ge 3 ]; then
            logger -t wattun-heal "tunnel $n breached SLA for 3 consecutive checks (rtt=${rtt}ms, loss=${loss}%, rate=${rate_kbps:-?}kbps), triggering re-evaluation"
            rm -f "$b_f"
            touch "$RUN/$n.sla_triggered"
            if [ -f "$CONF/$n.auto" ]; then
              heal_retest "$n"
            fi
          fi
        else
          rm -f "$b_f"
        fi
      fi
      continue
    fi
    cnt=$(( $(cat "$f" 2>/dev/null || echo 0) + 1 )); echo "$cnt" >"$f"
    if [ "$cnt" -ge 3 ]; then
      logger -t wattun-heal "tunnel $n down for $cnt checks, restarting"
      systemctl restart "${WAT_PREFIX}@$n"; rm -f "$f"
      cyc=$(( $(cat "$RUN/$n.cycles" 2>/dev/null || echo 0) + 1 )); echo "$cyc" >"$RUN/$n.cycles"
      # a direct Iran pool tunnel (single or bonded) that restarts do not fix: tell the operator the kit exists
      if [ "$cyc" -ge 2 ] && ! is_reverse "$n" && is_pool_list "$(cfg "$n" carrier)" \
         && [ "$(cfg "$n" fake-sni)" = '' ]; then
        logger -t wattun-heal "tunnel $n: restarts do not fix it and it runs with no anti-censor; if the route is being filtered, run: wattun blackout $n <allowlisted-name>"
      fi
      # still down after three restart cycles (9 checks) on a pool/icmp tunnel: try the full matrix unattended
      if [ "$cyc" -ge 3 ] && ! is_reverse "$n" && { is_pool "$(cfg "$n" carrier)" || [ "$(cfg "$n" carrier)" = icmp ]; }; then
        heal_matrix "$n"
      fi
      # auto tunnel still down after two restart cycles (6 checks): test the other connection types in the background
      # (a plain CDN tunnel gets a fresh Cloudflare edge scan instead: dead edge IPs are replaced)
      if [ "$cyc" -ge 2 ] && { [ -f "$CONF/$n.auto" ] || { cdn_ok && cdn_tunnel_p "$n"; }; }; then heal_retest "$n"; fi
    fi
  done
  # Migrate legacy finalized/narrowed auto Kharej tunnels and keep all auto test carriers + companions running.
  auto_migrate_all 0
  for n in $(tunnels); do
    [ "$(role "$n")" = Kharej ] && is_auto_kharej "$n" || continue
    auto_sync_companion "$n"
    heal_auto_helpers "$n"
  done
}
# A running tunnel keeps executing the binary it was started with. Once update/rollback replaces the file,
# /proc/PID/exe reads "... (deleted)": that tunnel still runs the OLD version until it is restarted.
bin_ver() { "${1:-$BIN}" -version 2>/dev/null | awk '{print $2; exit}'; }
is_stale() {
  local pid
  pid=$(systemctl show -p MainPID --value "${WAT_PREFIX}@$1" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" != 0 ] && [[ "$(readlink "/proc/$pid/exe" 2>/dev/null)" == *"(deleted)"* ]]
}
stale_tunnels() { # prints unique visible tunnel names whose service (or hidden auto helper) still runs an old binary
  local u p seen=' '
  for u in $(tunnels_all); do
    is_probe_unit "$u" && continue # a live probe is throw-away machinery: it dies at its ttl, never a restart prompt
    systemctl is-active -q "${WAT_PREFIX}@$u" 2>/dev/null || continue
    is_stale "$u" || continue
    p=$(companion_of "$u")
    [ -n "$p" ] || { [ -f "$CONF/$u.autoext" ] && p=$(head -1 "$CONF/$u.autoext" 2>/dev/null); }
    p=${p:-$u}
    case "$seen" in *" $p "*) ;; *) seen+="$p "; printf '%s ' "$p" ;; esac
  done
}
restart_stale() { # offer to restart tunnels that still run the old binary, then prove they switched
  local st n hu bad=''
  st=$(stale_tunnels)
  [ -n "$st" ] || { ok "All running tunnels use wattun $(bin_ver)."; return 0; }
  warn "Still running the OLD binary: ${BOLD}${st% }${RST}"
  hint "They switch to $(bin_ver) only after a restart. A restart drops open connections for a few seconds."
  confirm "Restart them now?" y || { hint "Later: open the tunnel and press [r], or Settings -> restart all."; return 0; }
  for n in $st; do step "Restarting ${WAT_PREFIX}@$n" auto_for_each_unit "$n" restart; done
  sleep 1
  for n in $st; do
    if is_stale "$n"; then bad="$bad $n"; continue; fi
    if is_auto_kharej "$n"; then
      for hu in $(auto_helpers "$n"); do
        systemctl is-active -q "${WAT_PREFIX}@$hu" 2>/dev/null && is_stale "$hu" && { bad="$bad $n"; break; }
      done
    fi
  done
  if [ -n "$bad" ]; then err "Still on the old binary:$bad (see: journalctl -u ${WAT_PREFIX}@NAME)"; return 1; fi
  ok "Tunnels now run wattun $(bin_ver)."
}
restart_all() {
  local n c=0
  for n in $(tunnels); do # hidden auto helpers restart with their parent
    if systemctl is-enabled -q "${WAT_PREFIX}@$n" 2>/dev/null || systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
      step "Restarting ${WAT_PREFIX}@$n" auto_for_each_unit "$n" restart; c=$((c+1))
    fi
  done
  [ "$c" -gt 0 ] || warn "No tunnels to restart."
}
U_URL_PREFIX=''; U_CURL_PROXY=''
apply_update_proxy() { # url -> U_URL_PREFIX (mirror prefix) or U_CURL_PROXY (curl -x proxy)
  local v=${1:-}
  U_URL_PREFIX=''; U_CURL_PROXY=''
  [ -n "$v" ] || return 0
  case "$v" in
    socks4://*|socks4a://*|socks5://*|socks5h://*) U_CURL_PROXY=$v ;;
    http://*)
      if [[ "$v" =~ ^http://([^/]*@)?(\[[0-9a-fA-F:]+\]|[^/:]+):[0-9]{1,5}/?$ ]]; then U_CURL_PROXY=${v%/}
      else U_URL_PREFIX="${v%/}/"; fi ;;
    https://*)
      if [[ "$v" =~ ^https://[^/]*@ ]] || [[ "$v" =~ ^https://(127\.|localhost|\[::1\])(:[0-9]{1,5})?/?$ ]]; then U_CURL_PROXY=${v%/}
      else U_URL_PREFIX="${v%/}/"; fi ;;
    *)
      if [[ "$v" =~ ^(\[[0-9a-fA-F:]+\]|[^/:]+):[0-9]{1,5}$ ]]; then U_CURL_PROXY=$v
      else U_URL_PREFIX="${v%/}/"; fi ;;
  esac
}
update_proxy_env() { # env WAT_PROXY / WAT_CURL_PROXY win; else .manager.conf update-proxy
  U_URL_PREFIX=${WAT_PROXY:-}; U_CURL_PROXY=${WAT_CURL_PROXY:-}
  [ -n "$U_URL_PREFIX" ] && U_URL_PREFIX="${U_URL_PREFIX%/}/"
  if [ -z "$U_URL_PREFIX" ] && [ -z "$U_CURL_PROXY" ]; then
    local saved; saved=$(conf_get update-proxy '')
    [ -n "$saved" ] && apply_update_proxy "$saved"
  fi
  return 0
}
u_curl() { # [curl args...] : curl with update proxy + retry-all-errors fallback for curl < 7.71
  local -a px=()
  [ -n "${U_CURL_PROXY:-}" ] && px=(-x "$U_CURL_PROXY")
  if curl --help all 2>&1 | grep -q -- '--retry-all-errors'; then
    curl -fsSL ${px[@]+"${px[@]}"} --connect-timeout 10 --max-time 90 --retry 4 --retry-all-errors "$@"
  else
    curl -fsSL ${px[@]+"${px[@]}"} --connect-timeout 10 --max-time 90 --retry 4 "$@"
  fi
}
OFFLINE_DIR=''
resolve_offline_bundle() { # path extract_dir -> OFFLINE_DIR (directory containing install.sh)
  local src=$1 dst=$2 d
  OFFLINE_DIR=''
  if [ -d "$src" ] && [ -f "$src/install.sh" ]; then
    OFFLINE_DIR=$(cd "$src" 2>/dev/null && pwd) || OFFLINE_DIR=$src
    return 0
  fi
  if [ -f "$src" ]; then
    mkdir -p "$dst" || return 1
    if tar -xzf "$src" -C "$dst" 2>/dev/null || tar -xf "$src" -C "$dst" 2>/dev/null; then
      if [ -f "$dst/install.sh" ]; then OFFLINE_DIR=$dst; return 0; fi
      for d in "$dst"/*; do
        [ -d "$d" ] && [ -f "$d/install.sh" ] && { OFFLINE_DIR=$d; return 0; }
      done
    fi
  fi
  err "No install.sh found in '$src' (pass a wattun-offline-<arch>.tar.gz archive or its extracted directory)."
  return 1
}
bundle_cmd() { # [amd64|arm64] [dest.tar.gz] : build a signed offline install/update bundle (e.g. on Kharej for Iran)
  local arch=${1:-} out=${2:-} bdir sub base f got
  if [ -z "$arch" ]; then
    case "$(uname -m)" in
      x86_64|amd64) arch=amd64 ;;
      aarch64|arm64) arch=arm64 ;;
      *) err "Specify architecture: $SELF bundle amd64  or  $SELF bundle arm64"; return 1 ;;
    esac
  fi
  case "$arch" in amd64|arm64) ;; *) err "Unsupported bundle architecture '$arch' (use amd64 or arm64)."; return 1 ;; esac
  [ -n "$out" ] || out="$PWD/wattun-offline-$arch.tar.gz"
  for f in curl tar sha256sum openssl; do
    command -v "$f" >/dev/null 2>&1 || { err "'$f' is required to build and verify an offline bundle."; return 1; }
  done
  update_proxy_env
  base="${U_URL_PREFIX}https://github.com/$REPO/releases/latest/download"
  bdir=$(mktemp -d /tmp/wattun-bundle.XXXXXX) || { err "Cannot create a temporary directory."; return 1; }
  BDIR_TMP=$bdir
  sub="$bdir/wattun-offline-$arch"
  mkdir -p "$sub" || { rm -rf "$bdir"; BDIR_TMP=''; return 1; }
  spin_start "Downloading release files for linux/$arch"
  u_curl -o "$sub/install.sh" "$base/install.sh" \
    && u_curl -o "$sub/wattun-linux-$arch" "$base/wattun-linux-$arch" \
    && u_curl -o "$sub/wattun-manager" "$base/wattun-manager" \
    && u_curl -o "$sub/SHA256SUMS" "$base/SHA256SUMS" \
    && u_curl -o "$sub/SHA256SUMS.sig" "$base/SHA256SUMS.sig"
  local rc=$?
  spin_stop
  if [ "$rc" -ne 0 ]; then
    rm -rf "$bdir"; BDIR_TMP=''
    err "Download failed from $base."
    return 1
  fi
  if ! sums_verify "$sub/SHA256SUMS" "$sub/SHA256SUMS.sig"; then
    rm -rf "$bdir"; BDIR_TMP=''
    err "Signature check on SHA256SUMS failed; refusing to create an unverified bundle."
    return 1
  fi
  for f in install.sh "wattun-linux-$arch" wattun-manager; do
    got=$(sha256sum "$sub/$f" 2>/dev/null | awk '{print $1}')
    if [ -z "$got" ] || ! sums_has "$sub/SHA256SUMS" "$f" "$got"; then
      rm -rf "$bdir"; BDIR_TMP=''
      err "Checksum mismatch for $f in SHA256SUMS; aborting."
      return 1
    fi
  done
  chmod 755 "$sub/install.sh" "$sub/wattun-linux-$arch" "$sub/wattun-manager"
  if ! tar -czf "$out" -C "$bdir" "wattun-offline-$arch"; then
    rm -rf "$bdir"; BDIR_TMP=''
    err "Failed to write archive '$out'."
    return 1
  fi
  rm -rf "$bdir"; BDIR_TMP=''
  ok "Verified offline bundle written: ${BOLD}$out${RST}"
  hint "1. Copy to Iran:   scp \"$out\" root@IRAN_IP:/root/"
  hint "2. Fresh install:  tar xzf /root/${out##*/} -C /root && bash /root/wattun-offline-$arch/install.sh"
  hint "3. Offline update: wattun update --from /root/${out##*/}"
  return 0
}
update() { # [--from <dir|tar.gz>] [installer args...]
  local url="https://raw.githubusercontent.com/$REPO/main/install.sh" tmp before after mbefore imgr a
  local from_src='' pass_args=() ienv=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || { err "--from needs a path to a .tar.gz bundle or directory"; return 1; }; from_src=$2; shift 2 ;;
      --from=*) from_src=${1#--from=}; shift ;;
      *)
        if [ -z "$from_src" ] && { [ -d "$1" ] && [ -f "$1/install.sh" ] || [[ "$1" == *.tar.gz || "$1" == *.tgz ]]; }; then
          from_src=$1; shift
        else
          pass_args+=("$1"); shift
        fi ;;
    esac
  done
  if [ "$SANDBOX" = 1 ]; then
    for a in ${pass_args[@]+"${pass_args[@]}"}; do [ "$a" = --uninstall ] && { err "Sandbox: use the manager's uninstall (Settings), not the installer's --uninstall (it removes the production units)."; return 1; }; done
    imgr=$MGR; [ "$MGR" = /usr/local/bin/wattun-manager ] && imgr=${BIN%/*}/wattun-manager
    mkdir -p "${BIN%/*}" || { err "Cannot create ${BIN%/*}"; return 1; }
    say "  Sandbox $WAT_PREFIX: the update writes only $BIN, $imgr and $CONF (not /usr/local/bin, not wattun@.service)."
  fi
  update_proxy_env
  before=$(bin_ver); mbefore=$(cksum <"${imgr:-$MGR}" 2>/dev/null)
  local udir; udir=$(mktemp -d /tmp/wattun-update.XXXXXX) || { err "Cannot create a temporary directory"; return 1; }
  UDIR_TMP=$udir
  tmp=$udir/install.sh # every temp file lives in one private (0700) directory: no guessable names in /tmp
  local sums=$udir/SHA256SUMS sig=$udir/SHA256SUMS.sig mkeep=$udir/manager.keep rc
  [ "$SANDBOX" = 1 ] && ienv=(WAT_BIN="$BIN" WAT_MGR="$imgr" WAT_CONF="$CONF" WAT_UNIT="$tmp.unit" WAT_REQUIRE_SANDBOX=1) # the installer's unit file goes to a throwaway path
  [ -n "$U_URL_PREFIX" ] && ienv+=(WAT_PROXY="$U_URL_PREFIX")
  [ -n "$U_CURL_PROXY" ] && ienv+=(WAT_CURL_PROXY="$U_CURL_PROXY")
  # keep the current manager so a bad replacement can be undone
  cp -f "${imgr:-$MGR}" "$mkeep" 2>/dev/null || { rm -f "$mkeep"; mkeep=""; }
  if [ -n "$from_src" ]; then
    resolve_offline_bundle "$from_src" "$udir/bundle" || { rm -rf "$udir"; UDIR_TMP=''; return 1; }
    tmp="$OFFLINE_DIR/install.sh"
    if [ "${WAT_ALLOW_UNSIGNED_UPDATE:-0}" != 1 ]; then
      local got bsums="$OFFLINE_DIR/SHA256SUMS" bsig="$OFFLINE_DIR/SHA256SUMS.sig"
      [ -f "$bsums" ] && [ -f "$bsig" ] || { rm -rf "$udir"; UDIR_TMP=''; err "Offline bundle '$from_src' is missing SHA256SUMS or SHA256SUMS.sig."; return 1; }
      sums_verify "$bsums" "$bsig" || { rm -rf "$udir"; UDIR_TMP=''; err "Signature verification failed on '$bsums'."; return 1; }
      got=$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')
      [ -n "$got" ] && sums_has "$bsums" install.sh "$got" || { rm -rf "$udir"; UDIR_TMP=''; err "install.sh checksum does not match signed SHA256SUMS."; return 1; }
      ok "Offline bundle verified against the pinned release key"
    else
      warn "WAT_ALLOW_UNSIGNED_UPDATE=1: running offline installer without checking SHA256SUMS.sig."
    fi
    ienv+=(WAT_OFFLINE_DIR="$OFFLINE_DIR")
  elif [ "${WAT_ALLOW_UNSIGNED_UPDATE:-0}" = 1 ]; then
    warn "WAT_ALLOW_UNSIGNED_UPDATE=1: fetching the installer without a signature check (only if you trust the source)."
    # raw.githubusercontent.com caches main for minutes: resolve main to a commit sha and fetch everything by it
    local sha mref=""
    sha=$(u_curl "${U_URL_PREFIX}https://api.github.com/repos/$REPO/commits/main" 2>/dev/null | grep -m1 '"sha"' | sed -n 's/.*"sha"[^"]*"\([0-9a-f]\{40\}\)".*/\1/p')
    if [ -n "$sha" ]; then url="https://raw.githubusercontent.com/$REPO/$sha/install.sh"; mref=$sha; ienv+=(WAT_MGR_REF="$sha")
    else warn "Could not resolve the latest commit; using the main branch (GitHub's cache may be a few minutes old)."; fi
    spin_start "Downloading the installer"
    u_curl -o "$tmp" "${U_URL_PREFIX}$url"; rc=$?
    spin_stop
    if [ "$rc" -ne 0 ] || ! head -c 2 "$tmp" | grep -q '#!'; then
      rm -rf "$udir"; UDIR_TMP=''; err "Update failed (could not download the installer). If GitHub is blocked: $SELF update --from <bundle.tar.gz> or set update proxy in Settings [p]."; return 1
    fi
    ok "Installer downloaded UNSIGNED${mref:+ (${mref:0:7})}"
  else
    # Release assets are immutable: verify the installer against the release's RSA-signed SHA256SUMS, then run it.
    local base="${U_URL_PREFIX}https://github.com/$REPO/releases/latest/download" got verified=0 dl_ok=0
    local refusal="Cannot verify the installer against the signed release; refusing to run it unverified. On filtered Iran hosts, build a signed bundle on Kharej ($SELF bundle) and run: $SELF update --from wattun-offline-amd64.tar.gz"
    if command -v openssl >/dev/null 2>&1; then
      spin_start "Downloading the installer and its signature"
      u_curl -o "$tmp" "$base/install.sh" \
        && u_curl -o "$sums" "$base/SHA256SUMS" \
        && u_curl -o "$sig" "$base/SHA256SUMS.sig"
      rc=$?
      spin_stop
      if [ "$rc" -eq 0 ]; then
        dl_ok=1
        if sums_verify "$sums" "$sig"; then
          got=$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')
          if [ -n "$got" ] && sums_has "$sums" install.sh "$got"; then verified=1; fi
        fi
      fi
    else
      warn "openssl is required to check the release signature."
    fi
    if [ "$verified" != 1 ]; then
      if [ "$dl_ok" = 0 ] && [ "$IS_TTY" = 1 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${U_RETRIED:-0}" = 0 ]; then
        warn "Could not reach GitHub from this server."
        hint "Tip: on Kharej run '$SELF bundle', scp wattun-offline-<arch>.tar.gz here, or enter an HTTP/SOCKS5 proxy / mirror."
        ask "Proxy/mirror URL or path to offline .tar.gz (Enter = cancel)" ""
        if [ -n "$REPLY_V" ]; then
          rm -rf "$udir"; UDIR_TMP=''
          if [ -e "$REPLY_V" ]; then
            U_RETRIED=1 update --from "$REPLY_V" ${pass_args[@]+"${pass_args[@]}"}
            return $?
          fi
          confirm "Save '$REPLY_V' in Settings for future updates?" y && conf_set update-proxy "$REPLY_V"
          apply_update_proxy "$REPLY_V"
          U_RETRIED=1 WAT_PROXY="$U_URL_PREFIX" WAT_CURL_PROXY="$U_CURL_PROXY" update ${pass_args[@]+"${pass_args[@]}"}
          return $?
        fi
      fi
      rm -rf "$udir"; UDIR_TMP=''
      hint "The latest release must ship install.sh with SHA256SUMS and SHA256SUMS.sig signed by the pinned key."
      err "$refusal"; return 1
    fi
    ok "Installer verified against the signed release"
  fi
  env ${ienv[@]+"${ienv[@]}"} WAT_FROM_MANAGER=1 bash "$tmp" ${pass_args[@]+"${pass_args[@]}"}; rc=$?
  rm -f "$udir/install.sh" "$tmp.unit" "$sums" "$sig"
  [ "$rc" -eq 0 ] || { rm -rf "$udir"; UDIR_TMP=''; err "The installer reported an error. Nothing was changed: still wattun ${before:-?}."; return 1; }
  # self-check: in a sandbox the new manager must understand WAT_PREFIX, or it would drive the production paths
  if [ "$SANDBOX" = 1 ] && [ -n "$mkeep" ] && ! grep -q 'WAT_PREFIX' "${imgr:-$MGR}" 2>/dev/null; then
    install -m 755 "$mkeep" "${imgr:-$MGR}.new" && mv -f "${imgr:-$MGR}.new" "${imgr:-$MGR}"
    rm -rf "$udir"; UDIR_TMP=''; err "The new manager has no sandbox (WAT_PREFIX) support; the previous manager was restored."; return 1
  fi
  rm -rf "$udir"; UDIR_TMP=''
  after=$(bin_ver)
  echo
  if [ -z "$after" ]; then err "$BIN does not run after the update. Roll back from the dashboard ([r])."; return 1
  elif [ "$after" != "$before" ]; then ok "wattun updated: ${BOLD}${before:-none} -> $after${RST}"
  else ok "wattun is already the latest release (${BOLD}$after${RST})."; fi
  [ "$(cksum <"${imgr:-$MGR}" 2>/dev/null)" != "$mbefore" ] && ok "Manager updated."
  restart_stale
  return 0
}
rollback() {
  [ -x "$BIN.prev" ] || { warn "No previous version saved."; return 0; }
  say "  Current: ${BOLD}$($BIN -version 2>&1)${RST}    Previous: ${BOLD}$($BIN.prev -version 2>&1)${RST}"
  echo
  confirm "Roll back to the previous version?" n || return 0
  cp -f "$BIN" "$BIN.rb" && mv -f "$BIN.prev" "$BIN" && mv -f "$BIN.rb" "$BIN.prev"
  ok "Rolled back: wattun is now ${BOLD}$(bin_ver)${RST}."
  restart_stale
  return 0
}
uninstall_all() {
  local n list=() u units p
  for n in $(tunnels_all); do list+=("$n"); done # B3: hidden extended listeners are removed with their parent
  echo
  if [ "${#list[@]}" -gt 0 ]; then
    warn "These tunnels will be stopped:"
    for n in "${list[@]}"; do printf '      %s%-14s%s %s · %s\n' "$BOLD" "$n" "$RST" "$(role "$n")" "$(cfg "$n" carrier)"; done
  else hint "No tunnels are configured."; fi
  echo
  if [ "$NONINTERACTIVE" = 1 ]; then REPLY_V=uninstall # --yes is the confirmation
  else ask "Type 'uninstall' to remove WatTunnel (empty = cancel)" ""; fi
  [ "$REPLY_V" = uninstall ] || { warn "Cancelled."; return 1; }
  heal_disable >/dev/null 2>&1 # stops the timer and removes its unit files (heal_disable removes them)
  # loaded instances plus every configured name (enabled-but-unloaded ones are not in list-units)
  units=$(systemctl list-units --all --plain --no-legend "${WAT_PREFIX}@*" 2>/dev/null | awk '{print $1}')
  for n in "${list[@]}"; do units+=$'\n'"${WAT_PREFIX}@$n.service"; done
  for u in $(printf '%s\n' "$units" | sort -u); do
    systemctl disable --now "$u" >/dev/null 2>&1
  done
  # F17: the hidden extended listeners had a UDP rule opened per child; close them while their configs are readable
  for n in "${list[@]}"; do
    is_auto_ext "$n" || continue
    p=$(cfg "$n" listen); p=${p##*:}
    [ -n "$p" ] && is_shaped_udp "$(cfg "$n" carrier)" && fw_close "$p/udp"
  done
  kreply_restore
  # every timer/transient unit the manager created for a tunnel goes with it (bond-retest, watcher, retest, matrix)
  for u in /etc/systemd/system/"${WAT_PREFIX}-bondretest-"*.service /etc/systemd/system/"${WAT_PREFIX}-bondretest-"*.timer; do
    [ -e "$u" ] || continue
    systemctl disable --now "${u##*/}" >/dev/null 2>&1
    rm -f "$u"
  done
  for u in $(systemctl list-units --all --plain --no-legend "${WAT_PREFIX}-autowatch-*" "${WAT_PREFIX}-autoretest-*" "${WAT_PREFIX}-matrix-*" 2>/dev/null | awk '{print $1}'); do
    systemctl stop "$u" >/dev/null 2>&1; systemctl reset-failed "$u" >/dev/null 2>&1
  done
  # F8: a custom state-dir puts totals/quota outside $CONF; remove each tunnel's files before its config goes
  for n in "${list[@]}"; do
    while IFS= read -r u; do rm -f "$u"; done < <(state_files "$n")
  done
  rm -f "/etc/systemd/system/${WAT_PREFIX}@.service" "$BIN" "$BIN.prev"
  [ "$SANDBOX" = 1 ] && rm -rf "$RUN" "$AUTO_RUN"
  if [ "$SANDBOX" = 1 ] && [ "${BIN%/*}" = "/opt/$WAT_PREFIX" ]; then rm -rf "/opt/$WAT_PREFIX"; ok "Removed /opt/$WAT_PREFIX"; fi
  systemctl daemon-reload
  ok "Services and binaries removed."
  if [ -d "$CONF" ] && confirm "Also delete $CONF (tunnel configs, keys, tokens)?" "$([ "$SANDBOX" = 1 ] || [ "$NONINTERACTIVE" = 1 ] && echo y || echo n)"; then rm -rf "$CONF"; ok "Configuration deleted."; fi
  ok "WatTunnel removed."
  if [ "$SANDBOX" = 1 ]; then
    if [ "${MGR%/*}" = "/opt/$WAT_PREFIX" ]; then rm -rf "/opt/$WAT_PREFIX"; ok "Removed /opt/$WAT_PREFIX (including this script)"
    else hint "Sandbox: this script ($MGR) was left in place; delete it by hand if you copied it."; fi
  else rm -f "$MGR"; fi
  return 0
}
