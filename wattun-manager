      if is_rpool "$T_CARRIER"; then summary_line "Direction" "reverse (Kharej connects to this server on port ${T_PEER##*:})"
      else summary_line "Direction" "reverse: Kharej sends the pings, this server answers"; fi
    fi
    cdn_wizard_tune # CDN carrier + domain: automatic edge / TLS tuning (wattun >= 2.2.0), silent otherwise
  fi
  rport=''
  if [ "$T_REV" = 1 ] && is_rpool "$T_CARRIER"; then
    rport=${T_PEER##*:}
    v_port "$rport" >/dev/null 2>&1 && [ "$rport" != "$T_PEER" ] || { err "The Kharej address has no valid carrier port, so reverse cannot be set up."; return 1; }
    rport=$((10#$rport))
  fi
  sleep 0.4

  # port mappings
  MAPS=(); PE_ROLE=Iran; PE_TUNNEL=$name; PE_OWNED=()
  allow_to_array "$T_PORTS"
  PE_MSG=''
  if [ "${#PE_ALLOW[@]}" -gt 0 ]; then
    local skipped=0
    PE_MSG="${GRN}✔${RST} Filled from the token. Enter keeps them; e # puts one on another port here."$'\n'
    # same checks as a hand-typed row: busy port, another tunnel publishing it
    for it in "${PE_ALLOW[@]}"; do pe_try_add "$(spec_T "$it"):$(spec_T "$it")/$(spec_P "$it")" || skipped=$((skipped+1)); done
    [ "$skipped" -gt 0 ] && pe_msg "${YEL}!${RST} $skipped port(s) from the token were skipped because they conflict (see above). Add each one on another Iran port (e.g. 8443:443)."
  fi
  port_editor || { warn "Cancelled."; return 1; }
  if [ -n "$rport" ]; then
    if listen_blocked "$(rproto "$T_CARRIER")" "$rport"; then
      err "Port $rport/$(rproto "$T_CARRIER") is already in use here by $(listen_conflict_desc "$(rproto "$T_CARRIER")" "$rport"). Reverse needs it free: pick another carrier port on Kharej and make a new token."
      return 1
    fi
    for ((i=0; i<${#MAPS[@]}; i++)); do
      if [ "$(spec_L "${MAPS[$i]}")" = "$rport" ] && [ "$(spec_P "${MAPS[$i]}")" = tcp ]; then
        err "Port $rport/tcp is also a port you publish here. The carrier port must differ: pick another one on Kharej and make a new token."
        return 1
      fi
    done
  fi

  # advanced
  echo
  [ "$NONINTERACTIVE" = 1 ] && hint "Defaults: name $name, all addresses, no speed limit, FEC off."
  if [ "$NONINTERACTIVE" = 1 ] && confirm "Change advanced settings?" "$advdef"; then
    ask_ok "Tunnel name" "$name" v_name && name=$REPLY_V || return 1
    ask_ok "Bind address for the public ports" 0.0.0.0 v_bind || return 1; bind=$REPLY_V
    ask_ok "Speed ceiling in MB/s (empty = no cap; icmp alone: 16)" "$mbps" v_mbps || return 1; mbps=$REPLY_V
    ask_fec off || return 1; fec=$REPLY_V; fecb=$REPLY_FEC_BAND
    if [ "$T_CARRIER" = icmp ]; then ask_ok "ICMP type (must match Kharej)" "${T_ICMP:-echo}" v_icmp || return 1; T_ICMP=$REPLY_V; fi
    case "$T_CARRIER" in wss|tls|grpc|h2) ask "Domain / SNI (empty = none)" "$T_SNI"; T_SNI=$REPLY_V ;; esac
    case "$T_CARRIER" in ws|wss|grpc|h2|h2c) ask_ok "URL path" "${T_PATH:-/wat}" v_path || return 1; T_PATH=$REPLY_V ;; esac
  fi
  # Which of this server's addresses the tunnel leaves from (3.0.0): the default is whatever the route picks, which on a
  # server with two addresses may be the one users connect to; a provider that restricts that address then sees the tunnel.
  if [ "$T_REV" != 1 ] && [ -z "$T_AUTO" ] && [ -z "$T_SRCIP" ] && [ "$NONINTERACTIVE" != 1 ] && [ "$(uname -s)" = Linux ]      && [ "$(local_ips | wc -l)" -gt 1 ]; then
    local oip; oip=$(out_ip "${T_PEER%%[:,]*}")
    echo
    hint "This server has several IPs; the tunnel leaves from ${oip:-the one the route picks}. Change it: tunnel page, z, 9."
  fi
  # Resilience options (2.6.0-2.8.1): fake-sni (name, mode, ttl) and pool-rotate churn — the
  # blackout/whitelisting survival kit (docs/TECHNICAL.md). Strictly for censored routes, so NOT part
  # of the plain-tunnel flow: one explicit ask, then the same prompts as before. Unattended flags or a
  # saved profile prefill it and skip the ask — a preset IS the ask.
  # Anti-censorship & resilience options (2.6.0-2.9.0): presets, fake-sni, pool-rotate, ech, governor
  if [ "$T_REV" != 1 ] && [ -z "$T_AUTO" ] && [ "$(uname -s)" = Linux ]; then
    prof_pick_defaults
    # Unattended preset or flags (the SNI/ECH/pool knobs apply to every pool leg of a bond)
    if [ -n "$NI_PRESET" ] && ! is_pool_list "$T_CARRIER"; then
      err "Preset '$NI_PRESET' needs a tcp/tls/ws/wss/h2/h2c/grpc tunnel: '$T_CARRIER' has no SNI to disguise."
      return 1
    fi
    if [ -n "$NI_FAKESNI$NI_FAKEMODE$NI_FAKETTL$NI_POOLROT$NI_POOLBYTES$NI_ECH" ] && ! is_pool_list "$T_CARRIER"; then
      err "--fake-sni, --pool-rotate and --ech need a tcp/tls/ws/wss/h2/h2c/grpc tunnel (got '$T_CARRIER')."
      return 1
    fi
    if [ -n "$NI_PRESET" ]; then
      case "$NI_PRESET" in
        rst-fast) T_FAKESNI="www.cloudflare.com"; T_FAKEMODE="rst"; T_POOLROT="30m"; NI_SESSIONS=${NI_SESSIONS:-4}; NI_CONNS=${NI_CONNS:-4} ;;
        mci) T_FAKESNI="mci.ir"; T_FAKEMODE="rst"; T_POOLROT="30m"; T_POOLBYTES="500MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
        irancell) T_FAKESNI="irancell.ir"; T_FAKEMODE="seq"; T_POOLROT="20m"; T_POOLBYTES="300MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
        blackout) T_FAKESNI="mci.ir"; T_FAKEMODE="rst"; T_POOLROT="90s"; T_POOLBYTES="100MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
        conservative) T_FAKESNI="mci.ir"; T_FAKEMODE="seq"; T_POOLROT="4h"; T_POOLBYTES="4GB"; T_ECH="auto"; T_GOVERNOR="true" ;;
      esac
    fi
    [ -n "$NI_ECH" ] && T_ECH=$NI_ECH
    [ -n "$NI_GOVERNOR" ] && T_GOVERNOR=$NI_GOVERNOR
    [ -n "$NI_DNSLISTEN" ] && T_DNSLISTEN=$NI_DNSLISTEN
    [ -n "$NI_SRCIP" ] && T_SRCIP=$NI_SRCIP

    askres=y
    if [ -z "$NI_FAKESNI$NI_FAKEMODE$NI_FAKETTL$NI_POOLROT$NI_POOLBYTES$NI_PRESET$NI_ECH$NI_GOVERNOR$NI_DNSLISTEN$NI_SRCIP$T_FAKESNI$T_FAKEMODE$T_FAKETTL$T_POOLROT$T_POOLBYTES$T_ECH$T_GOVERNOR$T_DNSLISTEN$T_SRCIP" ]; then
      if [ "$NONINTERACTIVE" = 1 ]; then
        confirm "Set up anti-censor (only for censored routes)?" n || askres=n
        [ "$askres" = n ] && hint "No disguise: a busy direct tunnel can be filtered within an hour. Turn it on later with z on the tunnel page."
      else askres=n; fi # by hand: tunnel page, z
    fi

    if [ "$askres" = y ] && [ -z "$NI_FAKESNI$NI_PRESET" ] && [ -z "$T_FAKESNI" ]; then
      if is_pool_list "$T_CARRIER"; then
        echo
        say "  Anti-censor profile            ${GRY}sni          mode  churn          ech${RST}"
        say "  $(key_label 1) MCI whitelist              ${GRY}mci.ir       rst   30m / 500MB    ladder${RST}"
        say "  $(key_label 2) Irancell whitelist         ${GRY}irancell.ir  seq   20m / 300MB    ladder${RST}"
        say "  $(key_label 3) Blackout                   ${GRY}mci.ir       rst   90s / 100MB    ladder${RST}"
        say "  $(key_label 4) Low churn                  ${GRY}mci.ir       seq   4h / 4GB       auto${RST}"
        say "  $(key_label 5) Custom                     ${GRY}pick each value${RST}"
        say "  $(key_label 6) Skip                       ${GRY}no disguise${RST}"
        hint "2 and 4 (seq mode) only help against SNI-allowlist filters."
        printf '  %s?%s Profile %s[1]%s ' "$CYN" "$RST" "$GRY" "$RST"
        key_read
        case "$KEY" in
          1|enter) T_FAKESNI="mci.ir"; T_FAKEMODE="rst"; T_POOLROT="30m"; T_POOLBYTES="500MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
          2) T_FAKESNI="irancell.ir"; T_FAKEMODE="seq"; T_POOLROT="20m"; T_POOLBYTES="300MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
          3) T_FAKESNI="mci.ir"; T_FAKEMODE="rst"; T_POOLROT="90s"; T_POOLBYTES="100MB"; T_ECH="ladder"; T_GOVERNOR="true" ;;
          4) T_FAKESNI="mci.ir"; T_FAKEMODE="seq"; T_POOLROT="4h"; T_POOLBYTES="4GB"; T_ECH="auto"; T_GOVERNOR="true" ;;
          5) # Custom step-by-step
             pick_sni_preset "${T_FAKESNI:-mci.ir}" || return 1; T_FAKESNI=$REPLY_V
             if [ "$T_FAKESNI" = off ] || [ "$T_FAKESNI" = 0 ]; then T_FAKESNI=''; fi
             if [ -n "$T_FAKESNI" ]; then
               pick_fake_mode "${T_FAKEMODE:-rst}" || return 1; T_FAKEMODE=$REPLY_V
               if [ "$T_FAKEMODE" = ttl ]; then
                 ask "Fake TTL (hop count, empty = auto-calibrate)" "${T_FAKETTL:-}"; T_FAKETTL=$REPLY_V
                 v_fake_ttl "$T_FAKETTL" || return 1
               fi
             fi
             pick_pool_rotate "${T_POOLROT:-30m}" || return 1; T_POOLROT=$REPLY_V
             if [ "$T_POOLROT" = off ] || [ "$T_POOLROT" = 0 ]; then T_POOLROT=''; fi
             pick_pool_rotate_bytes "${T_POOLBYTES:-500MB}" || return 1; T_POOLBYTES=$REPLY_V
             if [ "$T_POOLBYTES" = off ] || [ "$T_POOLBYTES" = 0 ]; then T_POOLBYTES=''; fi
             if has_ech_list "$T_CARRIER"; then
               pick_ech "${T_ECH:-ladder}" || return 1; T_ECH=$REPLY_V
               if [ "$T_ECH" = off ]; then T_ECH=''; fi
             fi
             ;;
          6|esc|q) T_FAKESNI=''; T_FAKEMODE=''; T_POOLROT=''; T_POOLBYTES=''; T_ECH=''; T_GOVERNOR='' ;;
        esac
      elif [ "$T_CARRIER" = icmp ]; then
        echo
        say "  ${BOLD}ICMP resilience${RST}: the volume governor, not an SNI profile."
        confirm "Enable the ICMP volume governor (prevents reroute blackouts)?" y && T_GOVERNOR=true || T_GOVERNOR=false
      else
        hint "Anti-censorship profiles apply to tcp/tls/ws/wss/h2/h2c/grpc; '$T_CARRIER' has no SNI to disguise. Skipping."
      fi
    fi

    # Fallback validation for any flags that were passed explicitly (e.g. --fake-sni mci.ir)
    if [ -n "$NI_FAKESNI" ] && [ -z "$T_FAKESNI" ]; then
      T_FAKESNI=$NI_FAKESNI
    fi
    if [ "$T_FAKESNI" = off ] || [ "$T_FAKESNI" = 0 ]; then T_FAKESNI=''; fi
    if [ -n "$T_FAKESNI" ]; then
      v_sni_name "$T_FAKESNI" || return 1
      [ "$(bin_ver_ok 2.7.0)" = 1 ] || err "fake-sni needs wattun 2.7.0 or newer on this server (run: $SELF update)."
      [ -n "${NI_FAKEMODE:-}" ] && T_FAKEMODE=$NI_FAKEMODE
      [ -n "$T_FAKEMODE" ] || T_FAKEMODE=rst
      v_fake_mode "$T_FAKEMODE" || return 1
      T_FAKETTL=${NI_FAKETTL:-${T_FAKETTL:-}}
      if [ "$T_FAKEMODE" = ttl ] && [ -n "$T_FAKETTL" ]; then v_fake_ttl "$T_FAKETTL" || return 1; fi
    fi
    if [ -n "$NI_POOLROT" ]; then T_POOLROT=$NI_POOLROT; fi
    if [ -n "$NI_POOLBYTES" ]; then T_POOLBYTES=$NI_POOLBYTES; fi
    if [ -n "$T_POOLROT" ] && [ "$T_POOLROT" != 0 ] && [ "$T_POOLROT" != off ]; then
      [ "$(bin_ver_ok 2.8.0)" = 1 ] || { err "pool-rotate needs wattun 2.8.0 or newer on this server (run: $SELF update)."; return 1; }
    fi
    if [ -n "$T_POOLBYTES" ] && [ "$T_POOLBYTES" != 0 ] && [ "$T_POOLBYTES" != off ]; then
      [ "$(bin_ver_ok 2.8.1)" = 1 ] || { err "pool-rotate-bytes needs wattun 2.8.1 or newer on this server (run: $SELF update)."; return 1; }
    fi
  fi
  valid_name "$name" || { err "The name '$name' is not available."; return 1; }

  # summary
  echo
  summary_line "Name" "$name"
  summary_line "Carrier" "$T_CARRIER${T_ICMP:+ ($T_ICMP)}"
  summary_line "Kharej" "$T_PEER"
  [ -n "$CT_DESC" ] && summary_line "CDN tuning" "$CT_DESC"
  if [ -n "$T_FAKESNI" ]; then
    local fsum="Fake SNI" fsv="$T_FAKESNI (${T_FAKEMODE:-seq} mode)"
    [ "$T_FAKEMODE" = ttl ] && [ -n "$T_FAKETTL" ] && fsv="$fsv, ttl $T_FAKETTL"
    summary_line "$fsum" "$fsv"
  fi
  local udl; udl=$(undisguised_legs "$T_CARRIER")
  [ -n "$T_FAKESNI$T_POOLROT$T_POOLBYTES" ] && [ -n "$udl" ] && warn "The '$udl' leg(s) of this bond stay undisguised: only tcp/tls/ws/wss/h2/h2c/grpc carry the fake-SNI and rotation."
  [ -n "$T_POOLROT" ] && [ "$T_POOLROT" != 0 ] && [ "$T_POOLROT" != off ] && summary_line "Pool rotate" "$T_POOLROT${T_POOLBYTES:+ / $T_POOLBYTES}"
  [ -n "$T_ECH" ] && [ "$T_ECH" != off ] && summary_line "ECH" "$T_ECH"
  [ "$T_GOVERNOR" = true ] && summary_line "Governor" "on"
  if [ "$T_REV" = 1 ]; then
    if [ -n "$rport" ]; then summary_line "Direction" "reverse (Kharej connects to this server on port $rport)"
    else summary_line "Direction" "reverse (Kharej sends the pings)"; fi
  fi
  allow_note=''; for ((i=0; i<${#MAPS[@]}; i++)); do allow_note="$allow_note $(spec_human "${MAPS[$i]}")"; done
  summary_line "Publishes" "${allow_note# }"
  [ -n "$bind" ] && [ "$bind" != 0.0.0.0 ] && summary_line "Bind" "$bind"
  [ -n "$mbps" ] && summary_line "Speed limit" "$mbps MB/s"
  [ "$fec" = auto ] && summary_line "FEC" "auto$([ "$fecb" = 1 ] && echo ' (+ tune the loss band after creation)')"
  # wss/grpc/h2 are the "through Cloudflare" carriers. If the peer is a raw IP and no CDN edges were tuned in, Iran
  # dials the origin directly (the domain is only an SNI/Host string), which works only where that IP is reachable
  # from the user's network - the usual cause of "runs on some servers, not others". Flag it before creating.
  case "$T_CARRIER" in
    wss|grpc|h2)
      if [ "$T_REV" != 1 ] && [ -z "$CT_DESC" ] && { ph=${T_PEER%%,*}; ipv4_ok "${ph%:*}"; }; then
        echo
        warn "peer is a direct IP (${ph%:*}) - this tunnel does NOT go through Cloudflare."
        hint "A direct IP works only where it is reachable from Iran, so it fails on some networks."
        hint "For Cloudflare: proxy a domain to this server (orange cloud) and enter that DOMAIN as the"
        hint "Kharej address, or run  wattun-manager cdn-tune $name  after creating it."
      fi ;;
  esac
  echo
  if [ "$NONINTERACTIVE" = 1 ]; then confirm "Create this tunnel?" y || { warn "Nothing was created."; return 1; }; fi

  m=$(free_metrics_port)
  write_client() {
    local old; old=$(umask); umask 077
    printf '%s\n' "$T_KEY" >"$CONF/$name.key" || return 1
    {
      echo "# WatTunnel - Iran (client). Created by wattun-manager."
      echo "mode: client"
      echo "key-file: $CONF/$name.key"
      echo "carrier: $T_CARRIER"
      echo "peer: $T_PEER"
      if [ "$T_CARRIER" = udp ] && [ "$T_PATH" = dns ]; then echo "udp-dns: true" # DNS-shaped udp: the token's path field carries "dns"
      elif [ -n "$T_PATH" ]; then echo "path: $T_PATH"; fi
      [ -n "$T_SNI" ] && { echo "sni: $T_SNI"; echo "host: $T_SNI"; }
      [ -n "$T_FAKESNI" ] && { echo "fake-sni: $T_FAKESNI"; [ -n "$T_FAKEMODE" ] && echo "fake-mode: $T_FAKEMODE"; [ "$T_FAKEMODE" = ttl ] && [ -n "$T_FAKETTL" ] && echo "fake-ttl: $T_FAKETTL"; }
      [ -n "$T_POOLROT" ] && [ "$T_POOLROT" != 0 ] && [ "$T_POOLROT" != off ] && echo "pool-rotate: $T_POOLROT"
      [ -n "$T_POOLBYTES" ] && [ "$T_POOLBYTES" != 0 ] && [ "$T_POOLBYTES" != off ] && echo "pool-rotate-bytes: $T_POOLBYTES"
      if [ -n "$T_ECH" ]; then
        [ "$T_ECH" != off ] && echo "ech: $T_ECH"
        [ -n "$AT_EXTRA" ] && AT_EXTRA=$(printf '%s\n' "$AT_EXTRA" | grep -v '^ech:' || true)
      fi
      [ "$T_GOVERNOR" = true ] && echo "governor: true"
      [ -n "$T_DNSLISTEN" ] && [ "$T_DNSLISTEN" != off ] && echo "dns-listen: $T_DNSLISTEN"
      [ -n "$T_SRCIP" ] && [ "$T_SRCIP" != off ] && echo "src-ip: $T_SRCIP"
      [ -n "$T_ICMP" ] && [ "$T_ICMP" != echo ] && echo "icmp-type: $T_ICMP"
      [ "$T_REV" = 1 ] && echo "reverse: true"
      [ -n "$rport" ] && echo "listen: \":$rport\""
      [ -n "$AT_EXTRA" ] && printf '%s\n' "$AT_EXTRA"
      ech_cache_line "$name"
      [ -n "$bind" ] && [ "$bind" != 0.0.0.0 ] && echo "bind: $bind"
      [ -n "$mbps" ] && echo "max-mbps: $mbps"
      [ "$fec" = auto ] && echo "fec: auto"
      sessions_line
      conns_line
      mtu_line
      [ -n "$m" ] && echo "metrics: 127.0.0.1:$m" # F25: free_metrics_port found no port; write no invalid line
      maps_yaml_block
    } >"$CONF/$name.yml"
    umask "$old"
  }
  mkdir -p "$CONF"; chmod 700 "$CONF"
  sessions_check
  step "Writing key and config" write_client || return 1
  if [ -n "$AUTO_TOKEN" ]; then # kept so auto-test / auto-heal can test again later
    ( umask 077; printf '%s\n' "$AUTO_TOKEN" >"$CONF/$name.auto" ); chmod 600 "$CONF/$name.auto"
  fi
  start_unit "$name" || return 1
  [ "$T_CARRIER" = icmp ] && [ "$T_REV" = 1 ] && kreply_offer
  [ -n "$rport" ] && fw_open "$rport/$(rproto "$T_CARRIER")" # before the link check: Kharej cannot connect until it is open
  for ((i=0; i<${#MAPS[@]}; i++)); do new_pub+=("$(spec_L "${MAPS[$i]}")/$(spec_P "${MAPS[$i]}")"); done
  echo
  if wait_link "$name" 25; then
    celebrate "CONNECTED (RTT ${LINK_RTT} ms)"
    echo
    say "  Users connect here:"
    conn_diagram "$T_CARRIER" "${MAPS[@]}"
  else
    linkok=0
    err "Not connected yet. Running a diagnosis..."
    test_tunnel "$name"
  fi
  echo
  fw_open "${new_pub[*]}"
  if ! systemctl is-enabled -q "$HEAL_UNIT.timer" 2>/dev/null; then
    heal_enable >/dev/null && ok "Auto-heal on (Settings, h)"
  fi
  if [ "$linkok" = 1 ] && is_pool_list "$T_CARRIER" && [ "$(uname -s)" = Linux ] && [ -z "$T_FAKESNI$T_POOLROT$T_POOLBYTES" ] \
     && ! grep -q '^fake-sni:' <<<"${AT_EXTRA:-}"; then
    if [ "$T_REV" = 1 ]; then hint "If a censor blocks it: anti-censor is set on Kharej (the side that dials), tunnel page, z."
    else hint "If a censor blocks it: tunnel page, z."; fi
  fi
  if [ "$fecb" = 1 ] && [ "$NONINTERACTIVE" != 1 ]; then
    echo; hint "FEC auto is on; opening the loss-band rows now."
    adv_menu "$name"
  fi
  if [ "$NONINTERACTIVE" = 1 ]; then
    printf 'LINK=%s\nTUNNEL=%s\n' "$([ "$linkok" = 1 ] && echo up || echo down)" "$name"
    [ "$linkok" = 1 ] || return 1
  fi
  return 0
}

SESS_USE=''
sessions_check() { # --sessions N: only when the installed wattun knows the key (>= 2.3.0; older engines reject unknown keys)
  SESS_USE=''
  [ -n "$NI_SESSIONS" ] || return 0
  if ver_ge "$(bin_ver || true)" 2.3.0 2>/dev/null; then SESS_USE=$NI_SESSIONS
  else warn "--sessions $NI_SESSIONS ignored: it needs wattun 2.3.0 or newer (this is ${VER:-unknown}); run: $SELF update"; fi
  return 0
}
sessions_line() { # the engine refuses sessions with icmp/gre/ipip, bonds, reverse, or more than 16
  # no default here: the engine's auto value fits the host (2 on 2 CPUs). Forcing 4 or 8 made sessions fight over
  # the same queue: direct tcp 2026-11-03, 2 sessions 248 MB/s, 8 sessions 68 MB/s.
  [ -n "$SESS_USE" ] || return 0
  if [ "$T_REV" = 1 ]; then warn "--sessions ignored: not supported in reverse mode" >&2; return 0; fi
  if ! sessions_carrier_ok "$T_CARRIER"; then
    warn "--sessions ignored: not supported with carrier '$T_CARRIER' (needs one udp/tcp/tls/ws/wss/h2/h2c/grpc carrier)" >&2
    return 0
  fi
  echo "sessions: $(( SESS_USE > ENG_MAX_SESSIONS ? ENG_MAX_SESSIONS : SESS_USE ))"; return 0
}
conns_line() {
  [ -n "${NI_CONNS:-}" ] && echo "conns: $NI_CONNS"
  return 0
}
mtu_line() { # a non-pool leg caps the engine's datagram size at 1400: warn instead of writing a value it clamps
  [ -n "${NI_MTU:-}" ] || return 0
  local hi; hi=$(mtu_max_for "${T_CARRIER:-}")
  if [ "${NI_MTU}" -gt "$hi" ]; then
    warn "--mtu $NI_MTU ignored: carrier '${T_CARRIER:-?}' caps the datagram at $hi (the engine would clamp it silently)." >&2
    return 0
  fi
  echo "mtu: $NI_MTU"
}

# ======================================================================================
#  Auto carrier: one token, Iran tests every connection type and keeps the best
#    Kharej: unit NAME (all carriers at once) + NAME-r (the reverse side, written by a watcher as soon as Iran's IP
#    is known). Iran: auto_test runs one throw-away client per variant and uses the built-in /speedtest.
#    Token field 9 (the plan): "d=udp:4443,tcp:4443,...;r=tcp:24431,..." (see make_token).
# ======================================================================================
AUTO_RUN=${WAT_AUTO_RUN:-/run/$WAT_PREFIX-auto}
AUTO_D=''; AUTO_NOTE=''; AUTO_ADDR=''; AUTO_EXT=0; AUTO_EXT_D=''
# Auto mode is data-driven: the token's plan (field 9) is the only source of direct/reverse variants (order = test
# order). AUTO_VAR_CDN needs a Cloudflare domain in the token, AUTO_VAR_REVERSE is the reverse set (icmp first, then
# pool legs), AUTO_VAR_ANTI is the direct pool subset that gets the fake-SNI/fingerprint variants of the anti-censor
# preset. AUTO_VAR_DIRECT is the default standard plan written by a new Kharej token; an old token's plan is honoured
# as-is, so a manager can never test a carrier Kharej does not listen on.
# B1/B2/B3 (2026-11-04): the plan grammar is `carrier[:port]`; a raw carrier (gre/ipip, and the F19 raw shapes) has no
# listen port and appears as a bare entry. gre/ipip need both ends >= 3.2.0 and are part of the normal plan; the 13
# shaped carriers are an explicit extended opt-in (both ends 3.3.0) and never mixed into a normal token.
AUTO_VAR_DIRECT='icmp udp tcp tls wss h2 grpc ws h2c gre ipip'
AUTO_VAR_EXT_UDP=$SHAPED_UDP # extended-only UDP-tier shapes (conventional/allocated port)
AUTO_VAR_EXT_RAW=$SHAPED_RAW # extended-only raw-tier shapes (bare plan entry, no listen/firewall)
AUTO_VAR_CDN='wss grpc'
AUTO_VAR_REVERSE='icmp tcp tls ws wss h2 h2c grpc'
AUTO_VAR_ANTI='tcp tls wss h2 grpc ws h2c'
# The reverse listen ports of a new auto token: one above the other for every reverse carrier except icmp. Built from
# AUTO_VAR_REVERSE, so adding a carrier to that list extends the token plan too (the plan format itself is unchanged).
auto_rplan_build() { # -> "tcp:24431,tls:24432,..." for the reverse carriers in AUTO_VAR_REVERSE (icmp has no port)
  local out='' c p=24431
  for c in $AUTO_VAR_REVERSE; do
    [ "$c" = icmp ] && continue
    out="${out:+$out,}$c:$p"; p=$((p+1))
  done
  printf '%s' "$out"
}
AUTO_RPLAN=$(auto_rplan_build)
plan_part() { # plan d|r -> "udp:4443,tcp:4443,..."
  local x
  for x in ${1//;/ }; do [ "${x%%=*}" = "$2" ] && { echo "${x#*=}"; return 0; }; done
  return 0
}
plan_has() { # list carrier -> 0 when the plan has that carrier (bare `gre` or `vxlan:4789`)
  local x
  for x in ${1//,/ }; do [ "${x%%:*}" = "$2" ] && return 0; done
  return 1
}
# A6 (2026-11-04): the Iran side shows what the token plan carries, split standard/extended, before testing. Extended
# entries are the F19 shaped carriers; an old engine skips them (auto_variants/AT_SKIPPED) so the budget counts only
# what is really measured.
auto_plan_standard() { # plan-d -> its non-shaped carrier names in plan order
  local c n out=''
  for c in ${1//,/ }; do n=${c%%:*}; is_shaped_carrier "$n" && continue; out="${out:+$out }$n"; done
  printf '%s' "$out"
}
auto_plan_extnames() { # plan-d -> its shaped carrier names in plan order (empty for a normal token)
  local c n out=''
  for c in ${1//,/ }; do n=${c%%:*}; is_shaped_carrier "$n" && out="${out:+$out }$n"; done
  printf '%s' "$out"
}
auto_plan_intro() { # plan-d -> human lines for the test screen ("standard carriers: …" / "extended carriers: …")
  local d=$1 std ext
  std=$(auto_plan_standard "$d"); ext=$(auto_plan_extnames "$d")
  printf 'standard carriers: %s\n' "${std:-none}"
  [ -n "$ext" ] && printf 'extended carriers: %s (both ends must run 3.3.0; shaped transports, not the real protocols)\n' "$ext"
  return 0
}

# B3 (2026-11-04): extended Auto opens ONE hidden single-carrier server unit per shaped carrier, because the 3.3.0
# engine refuses any '+' bond containing a shaped carrier (D7). The parent auto unit keeps the standard carriers +
# gre/ipip; a `.autoext` sidecar (holding the parent name) hides each child from tunnel lists/pickers while delete,
# uninstall, heal, prune and widen still manage them.
is_auto_ext() { [ -f "$CONF/$1.autoext" ]; }
auto_ext_names() { # parent -> its extended unit names ($parent-e-<shape>); only units whose .autoext names this parent
  local f b
  for f in "$CONF/$1-e-"*.yml; do
    [ -e "$f" ] || continue
    b=${f##*/}; b=${b%.yml}
    [ "$(cat "$CONF/$b.autoext" 2>/dev/null)" = "$1" ] || continue # M1: a user tunnel named NAME-e-* is not a child
    echo "$b"
  done
  return 0
}
auto_ext_space_taken() { # name : is any NAME-e-* config present (the hidden-child namespace stays reserved)
  local f; for f in "$CONF/$1-e-"*.yml; do [ -e "$f" ] && return 0; done; return 1
}
auto_ext_child() { printf '%s-e-%s' "$1" "$2"; }
auto_ext_plan_entries() { # -> "vxlan:4789,...,sit,..." for every shaped carrier (UDP: conventional or fallback port)
  local c p q used=' '
  for c in ${AUTO_D//,/ }; do p=$(plan_entry_port "$c"); [ -n "$p" ] && used+="$p "; done
  for c in ${AUTO_RPLAN//,/ }; do used+="${c##*:} "; done # the reverse plan's fixed 244xx ports
  local out=''
  for c in $AUTO_VAR_EXT_UDP; do
    q=''; p=$(shaped_udp_port "$c")
    case "$used" in *" $p "*) ;; *) listen_blocked udp "$p" || q=$p ;; esac
    if [ -z "$q" ]; then
      for p in $(seq 24540 24999); do
        case "$used" in *" $p "*) continue ;; esac
        listen_blocked udp "$p" && continue
        q=$p; break
      done
    fi
    [ -n "$q" ] || { AUTO_NOTE+="  $c: no free UDP port, skipped."$'\n'; continue; }
    used+="$q "; out="${out:+$out,}$c:$q"
  done
  for c in $AUTO_VAR_EXT_RAW; do out="${out:+$out,}$c"; done
  printf '%s' "$out"
}
auto_ext_write_units() { # name entries : write the hidden per-shape server configs + sidecars and open their UDP ports
  local name=$1 entries=$2 e c p u m fw='' keyf="$CONF/$1.key" bad=''
  mkdir -p "$CONF"
  for e in ${entries//,/ }; do # M1: never overwrite a .yml that is not already a child of this parent
    u=$(auto_ext_child "$name" "${e%%:*}")
    [ -e "$CONF/$u.yml" ] || continue
    [ "$(cat "$CONF/$u.autoext" 2>/dev/null)" = "$name" ] || bad=$u
  done
  [ -z "$bad" ] || { err "Refusing to overwrite $CONF/$bad.yml: it is not an extended listener of '$name'."; return 1; }
  for e in ${entries//,/ }; do
    c=${e%%:*}; p=$(plan_entry_port "$e"); u=$(auto_ext_child "$name" "$c"); m=$(free_metrics_port)
    {
      echo "# WatTunnel - Kharej extended test listener for auto tunnel '$name' ($c). Hidden; created by wattun-manager."
      echo "mode: server"
      echo "key-file: $keyf"
      echo "carrier: $c"
      [ -n "$p" ] && echo "listen: \":$p\""
      [ -n "$m" ] && echo "metrics: 127.0.0.1:$m" # F25: free_metrics_port found no port; write no invalid line
      maps_yaml_block # H2: without the parent's allowlist the engine falls back to its permissive 1-65535 default
      # H2: inherit the parent's per-port limits and source allowlist too (copied verbatim; ports come from MAPS above).
      if [ -f "$CONF/$name.yml" ]; then
        awk '/^(limits|allow-clients|allow-clients-file):/{f=1} f && /^[a-zA-Z0-9_-]+:/ && !/^(limits|allow-clients|allow-clients-file):/{f=0; next} f{print}' "$CONF/$name.yml" 2>/dev/null
      fi
    } >"$CONF/$u.yml" || return 1
    chmod 600 "$CONF/$u.yml"
    ( umask 077; printf '%s\n' "$name" >"$CONF/$u.autoext" )
    [ -n "$p" ] && fw="$fw $p/udp"
  done
  [ -n "$fw" ] && fw_open "${fw# }"
  return 0
}
auto_ext_start() { # parent : (re)enable+restart every extended listener of an auto tunnel (used by widen / prune --direct)
  local parent=$1 n
  for n in $(auto_ext_names "$parent"); do systemctl enable "${WAT_PREFIX}@$n" >/dev/null 2>&1; done
  for n in $(auto_ext_names "$parent"); do
    step "Restarting extended listener ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  done
  return 0
}
auto_ext_live() { # parent -> AE_LIVE = child units with a live client; rc 1 when a running child's /stats cannot be read
  # H1 (2026-11-04): each shaped listener is a single-carrier server with its own metrics port, and the parent's /stats
  # cannot show which shape Iran picked. A stopped unit has no metrics server (expected, not unknown); an unreadable
  # one is treated as unknown so the caller keeps every shape instead of guessing.
  local n s live='' any=0 bad=0
  for n in $(auto_ext_names "$1"); do
    any=1
    systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null || continue
    if s=$(stats "$n") && grep -q '"clients"' <<<"$s"; then
      grep -q '"ip"' <<<"$(grep -o '"clients": *\[[^]]*\]' <<<"$s")" && live="$live${live:+ }$n"
    else
      bad=1
    fi
  done
  AE_LIVE=$live
  [ "$any" = 1 ] || return 2
  [ "$bad" = 0 ]
}
auto_ext_sig() { # parent -> the live hidden pick ("e:vxlan"), empty when no child is provably in use
  local n out=''
  auto_ext_live "$1" || return 0
  for n in $AE_LIVE; do out="$out${out:+,}e:${n#"$1"-e-}"; done
  printf '%s' "$out"
}
auto_ext_prune() { # parent : stop+disable the hidden shaped listeners Iran is not using (keep the live ones)
  local parent=$1 n c keep=''
  auto_ext_live "$parent" || return 0 # no children, or a running child's stats is unreadable: keep every shape
  [ -n "$AE_LIVE" ] || return 0 # no child sees a client yet: that is not a pick, keep every shape
  for n in $AE_LIVE; do keep="$keep ${n#"$parent"-e-}"; done
  for n in $(auto_ext_names "$parent"); do
    c=${n#"$parent"-e-}
    case "$keep " in *" $c "*) ;; *)
      systemctl stop "${WAT_PREFIX}@$n" >/dev/null 2>&1
      systemctl disable "${WAT_PREFIX}@$n" >/dev/null 2>&1 ; ;; esac
  done
  return 0
}
plan_entry_port() { # one plan entry -> its port, or empty for a port-less raw entry (B1)
  case "${1:-}" in *:*) echo "${1##*:}" ;; *) echo '' ;; esac
  return 0
}
plan_port() { # list carrier -> port (empty for a bare raw entry)
  local x p
  for x in ${1//,/ }; do
    [ "${x%%:*}" = "$2" ] || continue
    p=$(plan_entry_port "$x"); echo "$p"; return 0
  done
  return 0
}
ver_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]; } # $1 >= $2
bin_ver_ok() { # min-version -> 1 when the installed wattun is new enough (empty output = not ok)
  ver_ge "$(bin_ver || true)" "$1" 2>/dev/null && echo 1
  return 0
}
is_auto_kharej() { # name : does NAME.token carry carrier "auto"?
  local raw
  [ -f "$CONF/$1.token" ] || return 1
  raw=$(sed 's/^wat1://' "$CONF/$1.token" | base64 -d 2>/dev/null) || return 1
  [ "${raw%%|*}" = auto ]
}
companion_of() { # name -> parent name when NAME is an auto reverse companion (NAME-r)
  local p=${1%-r}
  [ "$p" != "$1" ] && [ -f "$CONF/$p.yml" ] && is_auto_kharej "$p" && echo "$p"
  return 0
}
in_use() { # auto Kharej name -> the types Iran is connected through ("udp", "tcp+wss", "r:icmp"), empty before it connects
  local u
  auto_live "$1"
  u=$(echo $AN_D ${AN_R:+r:$AN_R}); echo "${u// /+}"
}
carrier_label() { # name -> short carrier text for lists
  if is_auto_kharej "$1"; then echo auto; elif [ -n "$(companion_of "$1")" ]; then echo auto-r; else cfg "$1" carrier; fi
}

# ---- Kharej side ----
auto_pick_ports() { # -> AUTO_D "udp:4443,tcp:4443,...,gre,ipip" and AUTO_NOTE ; rc 1 when no free port is left
  # The plan is built from AUTO_VAR_DIRECT (order = test order): carriers with a listen port get `name:port`, raw
  # carriers (gre/ipip) get a bare `name` because they have no port. A carrier this engine cannot run is skipped with a
  # warning (B2), so an old Kharej never writes a config that would fail at startup.
  local c want fb p proto pick used=' ' cdnok=' 443 2053 2083 2087 2096 8443 ' list=''
  AUTO_NOTE=''; AUTO_SKIP=''
  for c in $AUTO_VAR_DIRECT; do
    [ "$c" = icmp ] && continue
    if ! carrier_ok_here "$c"; then
      AUTO_SKIP+="${AUTO_SKIP:+, }$c"
      AUTO_NOTE+="  $c needs wattun $(carrier_min_ver "$c"); this server runs ${VER:-an old version} - skipped."$'\n'
      continue
    fi
    if ! carrier_has_listen "$c"; then # B1: raw carrier, no port/listen line
      list="${list:+$list,}$c"; continue
    fi
    case "$c" in
      wss) want=2053; fb="2096 8443 443 2083 2087" ;;
      grpc) want=2083; fb="2087 2096 8443 2053 443" ;;
      h2) want=2087; fb="2096 8443 2083 2053 443" ;;
      ws) want=2052; fb="2082 2086 2095 8080 8880" ;;
      h2c) want=2082; fb="2086 2095 8080 8880 2052" ;;
      tls) want=8443; fb="8444 8445 9443 2096" ;;
      *) want=4443; fb="4444 4445 9444 9445" ;;
    esac
    proto=tcp; [ "$c" = udp ] && proto=udp
    pick=''
    for p in $want $fb; do
      case "$used" in *" $proto$p "*) continue ;; esac
      listen_blocked "$proto" "$p" && continue
      pick=$p; break
    done
    if [ -z "$pick" ]; then # every usual port is taken (often by an x-ui/v2ray panel): any free high port will do
      for p in $(seq 24440 24999); do
        case "$used" in *" $proto$p "*) continue ;; esac
        listen_blocked "$proto" "$p" && continue
        pick=$p; break
      done
    fi
    [ -n "$pick" ] || { AUTO_FAIL="$c ($proto $want $fb)"; return 1; }
    used+="$proto$pick "
    list="${list:+$list,}$c:$pick"
    if [ "$pick" != "$want" ]; then
      AUTO_NOTE+="  $c: port $want is busy, using $pick."
      case "$c" in
        wss|grpc|h2) case "$cdnok" in *" $pick "*) ;; *) AUTO_NOTE+=" (not a Cloudflare port: the CDN test of $c may not work)" ;; esac ;;
        ws|h2c) case " 80 8080 8880 2052 2082 2086 2095 " in *" $pick "*) ;; *) AUTO_NOTE+=" (not a Cloudflare port: the CDN test of $c may not work)" ;; esac ;;
      esac
      AUTO_NOTE+=$'\n'
    fi
  done
  AUTO_D=$list
}
ask_public_addr() { # -> AUTO_ADDR ; rc 1 when cancelled
  local addr
  if [ -n "$NI_ADDR" ]; then addr=$NI_ADDR
  else spin_start "Detecting this server's public IP"; addr=$(public_ip); spin_stop; fi
  if [ -z "$NI_ADDR" ] && [ -n "$addr" ] && ip_is_private "$addr"; then
    warn "$addr looks like a private address; Iran cannot reach it."
    confirm "Use $addr anyway? (n = enter the public IP yourself)" n || addr=''
    [ -z "$addr" ] && hint "Behind NAT or a cloud 1:1 mapping? Enter the public IP shown in your provider's panel."
  elif [ -z "$addr" ]; then
    warn "Could not detect this server's public IP."
    [ "$NONINTERACTIVE" = 1 ] && hint "Give it with --addr HOST"
  fi
  if [ -z "$addr" ]; then
    ask_ok "Public IP or domain of this server" "" v_host || return 1; addr=$REPLY_V
  else
    ok "Public address: $addr"
  fi
  AUTO_ADDR=$addr
}
start_watcher() { # name : transient unit that waits for Iran's first connection, then writes NAME-r
  local u="${WAT_PREFIX}-autowatch-$1" m=$MGR renv
  mapfile -t renv < <(run_env_args)
  [ -x "$m" ] || m=$(readlink -f "$0")
  systemctl stop "$u.service" >/dev/null 2>&1; systemctl reset-failed "$u.service" >/dev/null 2>&1
  systemd-run --quiet --collect --unit "$u" --property=RuntimeMaxSec=3600 "${renv[@]}" \
    "$m" auto-watch "$1" >/dev/null 2>&1
}
wizard_kharej_auto() { # suggested-name : called from wizard_kharej when the carrier is "auto"
  local name=$1 n=1 cdn='' key m allow plan c p cars='' fwl='' ver line
  ver=$(bin_ver)
  if ! ver_ge "${ver:-0}" 2.1.0; then
    err "Auto needs wattun 2.1.0 or newer on this server (found ${ver:-none})."; hint "Update first: $SELF update"; return 1
  fi
  command -v systemd-run >/dev/null 2>&1 || { err "Auto needs systemd (systemd-run) on this server."; return 1; }
  if [ -n "$NI_NAME" ]; then
    { [ -e "$CONF/$name.yml" ] || [ -e "$CONF/$name-r.yml" ] || auto_ext_space_taken "$name"; } \
      && { err "A tunnel named '$name', '$name-r' or '$name-e-*' already exists."; return 1; }
  fi
  while { [ -e "$CONF/$name.yml" ] || [ -e "$CONF/$name-r.yml" ] || auto_ext_space_taken "$name"; } && [ "$n" -lt 99 ]; do n=$((n+1)); name="kharej-$n"; done
  cdn=$NI_CDN # by hand Iran adds the Cloudflare domain when it tests
  [ -n "$cdn" ] && { v_domain_opt "$cdn" || return 1; }
  auto_pick_ports || { err "Could not find a free port for $AUTO_FAIL on this server."; hint "Check what listens there: ss -ltnup"; return 1; }

  MAPS=(); PE_ROLE=Kharej; PE_TUNNEL=$name; PE_ALLOW=(); PE_OWNED=(); PE_MSG=''
  allow='' # all ports allowed (unless --ports); edit later from the tunnel menu
  if [ -n "$NI_PORTS" ]; then ni_kharej_ports || return 1; allow=$(maps_allow_str); fi

  ask_public_addr || return 1
  # B3: extended opt-in. The 13 shaped carriers cannot share the parent's '+' bond (engine D7), so each chosen one gets
  # its own hidden single-carrier server unit; the token plan lists them so Iran can test them. Offered only when this
  # Kharej engine can run them (3.3.0); otherwise --extended is refused with one clear message.
  if [ "${NI_EXTENDED:-0}" = 1 ] || { [ "$NONINTERACTIVE" != 1 ] && carrier_ok_here vxlan; }; then
    if ! carrier_ok_here vxlan; then
      err "--extended needs wattun 3.3.0 on this server (found ${ver:-none}); both ends must run 3.3.0. Run: $SELF update"
      return 1
    fi
    if [ "$NONINTERACTIVE" = 1 ]; then AUTO_EXT=1
    else
      echo
      warn "Extended carriers: the 13 F19 shaped transports are wattun-internal wire shapes, NOT the real protocols."
      hint "Each one gets its own hidden single-carrier listener here; both ends must run wattun 3.3.0."
      hint "Raw tier needs root/CAP_NET_RAW and the cloud firewall must pass IP protocols 41/50/97/115."
      confirm "Also test extended transports? (13 shaped carriers; both ends need 3.3.0)" n && AUTO_EXT=1
    fi
  fi
  AUTO_EXT_D=''
  if [ "$AUTO_EXT" = 1 ]; then
    AUTO_EXT_D=$(auto_ext_plan_entries)
    [ -n "$AUTO_EXT_D" ] || { warn "No extended carrier could be planned; continuing with the standard set."; AUTO_EXT=0; }
  fi
  plan="d=$AUTO_D${AUTO_EXT_D:+,$AUTO_EXT_D};r=$AUTO_RPLAN"
  [ "$AUTO_EXT" = 1 ] && plan="$plan;e=1"

  [ -n "$AUTO_NOTE" ] && printf '%s' "$AUTO_NOTE" | sed "s/^/  $GRY/; s/\$/$RST/"

  key=$(new_key); m=$(free_metrics_port); apath=$(rand_path)
  for c in ${AUTO_D//,/ }; do cars="$cars+${c%%:*}"; done
  write_auto_server() {
    local old; old=$(umask); umask 077
    printf '%s\n' "$key" >"$CONF/$name.key" || return 1
    {
      echo "# WatTunnel - Kharej (server), auto: every carrier at once. Created by wattun-manager."
      echo "mode: server"
      echo "key-file: $CONF/$name.key"
      echo "carrier: icmp$cars"
      for c in ${AUTO_D//,/ }; do p=$(plan_entry_port "$c"); [ -n "$p" ] && echo "listen-${c%%:*}: \":$p\""; done
      echo "path: $apath"
      [ -n "$m" ] && echo "metrics: 127.0.0.1:$m" # F25: free_metrics_port found no port; write no invalid line
      maps_yaml_block
    } >"$CONF/$name.yml"
    make_token auto "$AUTO_ADDR" "$key" "$apath" "$cdn" "" "$allow" "" "$plan" >"$CONF/$name.token"
    umask "$old"
  }
  mkdir -p "$CONF"; chmod 700 "$CONF"
  step "Writing key, config and token" write_auto_server || return 1
  start_unit "$name" || return 1
  for c in ${AUTO_D//,/ }; do
    p=$(plan_entry_port "$c"); [ -n "$p" ] || continue # B1: raw carriers have no listen port/firewall rule
    if [ "${c%%:*}" = udp ] || is_shaped_udp "${c%%:*}"; then fwl="$fwl $p/udp"; else fwl="$fwl $p/tcp"; fi
  done
  fw_open "${fwl# }"
  if [ "$AUTO_EXT" = 1 ]; then # B3: one hidden single-carrier listener per extended shape
    if ! step "Writing extended listeners" auto_ext_write_units "$name" "$AUTO_EXT_D"; then
      # F16: this tunnel is fresh, so a child-write failure rolls it back instead of leaving a running parent whose
      # token promises `;e=1` shapes with no (or only partial) listeners.
      systemctl disable --now "${WAT_PREFIX}@$name" >/dev/null 2>&1 # stop before the state files: the engine saves on SIGTERM
      while IFS= read -r line; do rm -f "$line"; done < <(state_files "$name")
      rm -f "$CONF/$name"-e-*.yml "$CONF/$name"-e-*.autoext
      fw_close "${fwl# }"
      rm -f "$CONF/$name".yml "$CONF/$name".key "$CONF/$name".token
      err "Could not write the extended listeners; the new tunnel was removed and nothing is running."
      return 1
    fi
    auto_ext_start "$name" >/dev/null 2>&1 || warn "Could not start the extended listeners; heal will retry."
  fi
  start_watcher "$name" || warn "Could not start the watcher. After Iran connects run: $SELF auto-ip $name IRAN_IP"
  ensure_prune_timer # R3: heal() does the automatic cleanup, so its timer must run on a Kharej-only server too
  line=''; for c in ${AUTO_D//,/ }; do p=$(plan_entry_port "$c"); if [ -n "$p" ]; then line="$line · ${c%%:*} $p"; else line="$line · ${c%%:*}"; fi; done
  ok "Tunnel '$name' is ready"
  hint "Open: icmp$line. Keep ICMP allowed in the cloud firewall."
  if [ "$AUTO_EXT" = 1 ]; then
    ok "Extended listeners (hidden): $(auto_plan_extnames "$AUTO_EXT_D")"
    hint "Both ends need wattun 3.3.0 for the extended carriers; raw tier needs root/CAP_NET_RAW and IP protocols 41/50/97/115 open in the cloud firewall."
    warn "An older Iran never uses the extended carriers: those hidden ports stay open until: $SELF auto-prune $name --direct (or stop the ${WAT_PREFIX}@$name-e-* units by hand)."
  fi
  hint "Automatic cleanup: once Iran's pick is stable the unused reverse side is closed by itself (direct carriers stay open)."
  hint "Keep every carrier open: $SELF auto-prune $name --keep-open. Opt into full narrowing: auto-prune $name --direct"
  echo
  say "  Token for the Iran server ${GRY}(copy the whole line)${RST}"
  echo
  printf '%s%s%s\n\n' "$BOLD$YEL" "$(cat "$CONF/$name.token")" "$RST"
  say "  On Iran: run ${CYN}${SELF}${RST}, press $(key_label n), paste it. Iran tests each type and picks one."
  hint "Show it again: $SELF token $name. It contains the key: share it only privately."
  [ "$NONINTERACTIVE" = 1 ] && printf 'TUNNEL=%s\nTOKEN=%s\n' "$name" "$(cat "$CONF/$name.token")"
  return 0
}

# Reverse companion: written once Iran's IP is known. Only the first Iran client matters; with a CDN domain the
# client list shows Cloudflare's IP for ws/wss/h2/h2c/grpc, so only icmp/udp/tcp/tls clients are trusted then.
companion_create() { # name ip
  local n=$1 ip=$2 r="$1-r" f="$CONF/$1-r.yml" m rp c p cars=icmp old tmp
  if [ -f "$f" ] && [ "$(cfg "$r" peer-icmp)" = "$ip" ]; then return 0; fi
  if ! { [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")" && [ -n "$T_AUTO" ]; }; then
    err "No auto token for '$n'."; return 1
  fi
  rp=$(plan_part "$T_AUTO" r)
  m=$(cfg "$r" metrics); m=${m##*:}; [ -n "$m" ] || m=$(free_metrics_port)
  for c in ${rp//,/ }; do cars="$cars+${c%%:*}"; done
  load_maps "$n"
  old=$(umask); umask 077
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || { umask "$old"; return 1; }
  {
    echo "# WatTunnel - Kharej reverse side of auto tunnel '$n' (Iran $ip). Written by wattun-manager."
    echo "mode: server"
    echo "key-file: $CONF/$n.key"
    echo "carrier: $cars"
    echo "reverse: true"
    echo "peer-icmp: $ip"
    for c in ${rp//,/ }; do echo "peer-${c%%:*}: $ip:${c##*:}"; done
    echo "path: ${T_PATH:-/wat}"
    echo "pool-rotate: 30m"
    [ -n "$m" ] && echo "metrics: 127.0.0.1:$m" # F25: write no invalid metrics: line when the range is exhausted
    maps_yaml_block
  } >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"; umask "$old"
  ensure_template >/dev/null
  systemctl enable "${WAT_PREFIX}@$r" >/dev/null 2>&1
  systemctl restart "${WAT_PREFIX}@$r" >/dev/null 2>&1
  logger -t wattun-auto "learned Iran IP $ip for $n; started ${WAT_PREFIX}@$r (reverse side)"
  return 0
}
auto_watch() { # name : run by systemd-run; poll /stats clients, write the companion on the first usable Iran client
  local n=$1 s cl ip='' cdn='' obj car
  [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")" && cdn=$T_SNI
  logger -t wattun-auto "watching $n for Iran's first connection"
  while [ -f "$CONF/$n.yml" ]; do
    s=$(stats "$n")
    cl=$(grep -o '"clients": *\[[^]]*\]' <<<"$s")
    ip=''
    while IFS= read -r obj; do
      [ -n "$obj" ] || continue
      car=$(grep -o '"carrier": *"[^"]*"' <<<"$obj" | head -1 | cut -d'"' -f4)
      if [ -n "$cdn" ]; then case "$car" in icmp|udp|tcp|tls) ;; *) continue ;; esac; fi
      ip=$(grep -o '"ip": *"[^"]*"' <<<"$obj" | head -1 | cut -d'"' -f4)
      ipv4_ok "$ip" && break
      ip=''
    done < <(sed 's/},[[:space:]]*{/}\n{/g' <<<"$cl")
    if [ -n "$ip" ]; then companion_create "$n" "$ip"; return $?; fi
    sleep 2
  done
  return 0
}
auto_ip() { # name ip : the manual fallback of auto_watch
  local n=$1 ip=${2:-}
  is_auto_kharej "$n" || { err "'$n' is not an auto Kharej tunnel."; return 1; }
  ipv4_ok "$ip" || { err "Usage: $SELF auto-ip $n IRAN_IPV4"; return 1; }
  companion_create "$n" "$ip" || return 1
  systemctl stop "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  ensure_prune_timer # R3: the automatic cleanup pass is driven by the heal timer (also on a Kharej-only server)
  ok "Reverse side ${n}-r is set for Iran $ip. Run the test again on Iran."
}

# Narrow an auto Kharej tunnel to what Iran really uses. The auto tunnel opens every carrier so Iran's test (and later
# auto-heal) can reach any of them; once Iran has picked, the rest are only open ports. Needs Iran to be connected.
auto_live() { # name -> AN_D (direct carriers with a live client on NAME) and AN_R (reverse carriers alive on NAME-r), space separated
  local n=$1 s
  AN_D=''; AN_R=''
  if s=$(stats "$n"); then
    # clients[] names one carrier per session (the last one heard); carriers[] has every leg of a bonded client
    AN_D=$({ grep -o '"clients": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep -o '"carrier": *"[^"]*"' | cut -d'"' -f4
      grep -o '"carriers": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep '"alive": *true' | grep -o '"name": *"[^"]*"' | cut -d'"' -f4
    } | sed '/^$/d' | sort -u | tr '\n' ' ')
  fi
  if [ -f "$CONF/$n-r.yml" ] && s=$(stats "$n-r"); then
    AN_R=$(grep -o '"carriers": *\[[^]]*\]' <<<"$s" | sed 's/},[[:space:]]*{/}\n{/g' | grep '"alive": *true' | grep -o '"name": *"[^"]*"' | cut -d'"' -f4 | tr '\n' ' ')
    # a narrowed side has one carrier and /stats lists no carriers[] for it: alive means that carrier is in use
    if [ -z "$AN_R" ] && [ "$(jget "$s" alive)" = true ]; then
      local one; one=$(cfg "$n-r" carrier); case "$one" in *+*|'') ;; *) AN_R="$one " ;; esac
    fi
  fi
}
auto_set_carriers() { # name "direct carriers" "reverse carriers" : rewrite the carrier lists of NAME and NAME-r from the token's plan
  local n=$1 dl=$2 rl=$3 c p cars blk d r ip tmp old
  { [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")" && [ -n "$T_AUTO" ]; } || { err "No auto token for '$n'."; return 1; }
  d=$(plan_part "$T_AUTO" d); r=$(plan_part "$T_AUTO" r)
  old=$(umask); umask 077
  if [ -n "$dl" ]; then
    cars=''; blk=''
    for c in $dl; do
      cars="$cars+$c"
      p=$(plan_port "$d" "$c"); [ -n "$p" ] && blk="$blk"$'\n'"listen-$c: \":$p\""
    done
    tmp=$(mktemp "$CONF/.tmp.XXXXXX") || { umask "$old"; return 1; }
    awk -v blk="carrier: ${cars#+}$blk" '/^carrier:/ { if (!done) { print blk; done = 1 } next } /^listen-[a-z0-9]+:/ { next } { print }' "$CONF/$n.yml" >"$tmp" \
      && chmod 600 "$tmp" && mv -f "$tmp" "$CONF/$n.yml"
  fi
  if [ -n "$rl" ] && [ -f "$CONF/$n-r.yml" ]; then
    ip=$(cfg "$n-r" peer-icmp); cars=''; blk=''
    for c in $rl; do
      cars="$cars+$c"
      p=$(plan_port "$r" "$c"); [ -n "$p" ] && blk="$blk"$'\n'"peer-$c: $ip:$p"
    done
    tmp=$(mktemp "$CONF/.tmp.XXXXXX") || { umask "$old"; return 1; }
    awk -v blk="carrier: ${cars#+}$blk" '/^carrier:/ { if (!done) { print blk; done = 1 } next } /^peer-icmp:/ { print; next } /^peer-[a-z0-9]+:/ { next } { print }' "$CONF/$n-r.yml" >"$tmp" \
      && chmod 600 "$tmp" && mv -f "$tmp" "$CONF/$n-r.yml"
  fi
  umask "$old"
}
fw_port_list() { # "carrier ..." plan-d -> "4443/udp 4443/tcp ..." (the firewall rules the direct carriers need)
  local c p out=''
  for c in $1; do
    p=$(plan_port "$2" "$c"); [ -n "$p" ] || continue
    out="$out $p/$([ "$c" = udp ] && echo udp || echo tcp)"
  done
  echo "$out"
}
auto_narrow() { # name : close every carrier port Iran does not use
  local n=$1 cur_d cur_r keep_d keep_r c gone_d='' gone_r='' d fwa fwb x
  is_auto_kharej "$n" || { err "'$n' is not an auto Kharej tunnel."; return 1; }
  read_token "$(cat "$CONF/$n.token")" && [ -n "$T_AUTO" ] || { err "No auto token for '$n'."; return 1; }
  auto_live "$n"
  if [ -z "$AN_D$AN_R" ]; then
    err "Iran is not connected to '$n' yet, so I cannot tell which carrier it uses."
    hint "Finish the Iran side first (paste the token, pick a connection type), give it a minute, then run this again."
    return 1
  fi
  d=$(plan_part "$T_AUTO" d)
  cur_d=$(cfg "$n" carrier); cur_d=${cur_d//+/ }
  keep_d=$AN_D; keep_r=$AN_R
  for c in $cur_d; do case " $keep_d " in *" $c "*) ;; *) gone_d="$gone_d $c" ;; esac; done
  if [ -f "$CONF/$n-r.yml" ]; then
    cur_r=$(cfg "$n-r" carrier); cur_r=${cur_r//+/ }
    for c in $cur_r; do case " $keep_r " in *" $c "*) ;; *) gone_r="$gone_r $c" ;; esac; done
  fi
  if [ -z "$gone_d$gone_r" ]; then ok "Nothing to close: '$n' only has the carriers Iran uses."; prune_done_mark "$n"; return 0; fi
  say "  Iran is connected through:  ${BOLD}${keep_d:+direct $keep_d}${keep_r:+reverse $keep_r}${RST}"
  [ -n "$gone_d" ] && say "  Closing direct:             $gone_d"
  [ -n "$gone_r" ] && say "  Closing reverse:            $gone_r"
  hint "The tunnel restarts for a moment. Auto-heal on Iran can then only use the carriers that stay open."
  hint "To open them all again: press c on the main menu, or run $SELF auto-widen $n"
  confirm "Close the unused carriers?" y || { warn "Nothing changed."; return 1; }
  fwa=$(fw_port_list "$gone_d" "$d"); fwb=$(fw_port_list "$keep_d" "$d")
  if [ -n "$gone_d" ]; then
    if [ -n "$keep_d" ]; then
      auto_set_carriers "$n" "$keep_d" '' || return 1
      step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
    else
      systemctl stop "${WAT_PREFIX}@$n" >/dev/null 2>&1; systemctl disable "${WAT_PREFIX}@$n" >/dev/null 2>&1
      ok "No direct carrier is in use: '$n' is stopped (its token and config stay)."
    fi
    for x in $fwa; do case " $fwb " in *" $x "*) ;; *) fw_close "$x" ;; esac; done
  fi
  if [ -n "$gone_r" ]; then
    if [ -n "$keep_r" ]; then
      auto_set_carriers "$n" '' "$keep_r" || return 1
      step "Restarting ${WAT_PREFIX}@$n-r" systemctl restart "${WAT_PREFIX}@$n-r"
    else
      systemctl stop "${WAT_PREFIX}@$n-r" >/dev/null 2>&1; systemctl disable "${WAT_PREFIX}@$n-r" >/dev/null 2>&1
      ok "No reverse carrier is in use: '$n-r' is stopped."
    fi
  fi
  ok "Done. Only the carriers Iran uses are open."
  prune_done_mark "$n"
}
auto_plan_lists() { # plan -> AP_D, AP_R: the carriers of the token's plan; shaped entries are hidden units, not bond legs (B3)
  local c
  AP_D='icmp'; AP_R='icmp'
  for c in $(plan_part "$1" d | tr ',' ' '); do
    is_shaped_carrier "${c%%:*}" && continue
    case "${c%%:*}" in icmp) ;; *) AP_D="$AP_D ${c%%:*}" ;; esac
  done
  for c in $(plan_part "$1" r | tr ',' ' '); do case "${c%%:*}" in icmp) ;; *) AP_R="$AP_R ${c%%:*}" ;; esac; done
}
auto_widen() { # name : open every carrier of the token's plan again
  local n=$1 d dl rl
  is_auto_kharej "$n" || { err "'$n' is not an auto Kharej tunnel."; return 1; }
  read_token "$(cat "$CONF/$n.token")" && [ -n "$T_AUTO" ] || { err "No auto token for '$n'."; return 1; }
  rm -f "$RUN/$n.autoprune" "$RUN/$n.autoprune.done" # a widen starts a fresh stable-selection window
  d=$(plan_part "$T_AUTO" d); auto_plan_lists "$T_AUTO"; dl=$AP_D; rl=$AP_R
  auto_set_carriers "$n" "$dl" "$rl" || return 1
  fw_open "$(fw_port_list "$dl" "$d")"
  systemctl enable "${WAT_PREFIX}@$n" >/dev/null 2>&1
  step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  if [ -f "$CONF/$n-r.yml" ]; then
    systemctl enable "${WAT_PREFIX}@$n-r" >/dev/null 2>&1
    step "Restarting ${WAT_PREFIX}@$n-r" systemctl restart "${WAT_PREFIX}@$n-r"
  fi
  [ -n "$(auto_ext_names "$n")" ] && auto_ext_start "$n" # B3: reopen the extended listeners for a retest
  ok "Every carrier of '$n' is open again."
}
unit_on() { systemctl is-active -q "${WAT_PREFIX}@$1" 2>/dev/null || systemctl is-enabled -q "${WAT_PREFIX}@$1" 2>/dev/null; }
auto_carrier_status() { # name -> "open|detail" or "closed|detail": how many carriers are open and what happens next
  local n=$1 u total open=0 cur st sig since left mins AP_D AP_R plan
  plan=$(read_token "$(cat "$CONF/$n.token")" >/dev/null 2>&1 && [ -n "$T_AUTO" ] && auto_plan_lists "$T_AUTO" && echo "$AP_D|$AP_R")
  IFS='|' read -r AP_D AP_R <<<"$plan"
  [ -n "$AP_D" ] || { echo "open|plan unknown"; return 0; }
  set -- $AP_D; total=$#
  cur=$(cfg "$n" carrier); set -- ${cur//+/ }
  unit_on "$n" && open=$#
  if [ -f "$CONF/$n-r.yml" ]; then
    set -- $AP_R; total=$((total + $#))
    cur=$(cfg "$n-r" carrier); set -- ${cur//+/ }
    unit_on "$n-r" && open=$((open + $#))
  fi
  for u in $(auto_ext_names "$n"); do
    total=$((total + 1))
    unit_on "$u" && open=$((open + 1))
  done
  [ "$open" -lt "$total" ] && { echo "closed|$open of $total open"; return 0; }
  st="all $total open"
  mins=$(autoprune_grace)
  if [ -f "$CONF/$n.keepopen" ]; then st="$st · stays open until you close it"
  elif [ "$mins" -le 0 ] || [ -f "$RUN/$n.autoprune.done" ]; then :
  else
    read -r sig since <<<"$(prune_stamp_get "$n")"
    case "$since" in
      ''|*[!0-9]*) st="$st · closes $mins min after Iran connects" ;;
      *) left=$(( (mins * 60 - ($(date +%s) - since) + 59) / 60 )); [ "$left" -ge 1 ] || left=1
         st="$st · closes in about $left min" ;;
    esac
  fi
  echo "open|$st"
}
auto_carriers_toggle() { # name : open every carrier and hold them open, or close the unused ones and hand back to the automatic pass
  local n=$1
  mgr_lock || return 1
  if [ "$(auto_carrier_status "$n" | cut -d'|' -f1)" = open ]; then
    page "Close carriers" "$n"; echo
    auto_narrow "$n" || return 1
    rm -f "$CONF/$n.keepopen"
  else
    page "Open carriers" "$n"; echo
    hint "Every carrier opens and stays open until you close it here. The tunnel restarts, so its connections drop once."
    confirm "Open every carrier of '$n'?" y || { warn "Nothing changed."; return 1; }
    auto_widen "$n" || return 1
    ( umask 077; : >"$CONF/$n.keepopen" )
  fi
}

# ---- R3: automatic lifecycle cleanup of an auto Kharej tunnel ----
# The auto tunnel listens on every carrier so Iran's test (and later auto-heal) can reach any of them. Running every
# carrier open for weeks is pure attack surface once Iran has picked, so after Iran's selection has been stable for a
# grace window the manager closes everything Iran does not use, on both sides (auto_narrow). All configs are kept so
# auto-widen works, nothing is ever deleted. The window is .manager.conf key autoprune (minutes, default 5; 0 turns the
# automatic pass off), per tunnel $CONF/NAME.keepopen turns it off, and autoprune-direct=0 limits it to the reverse side.
AUTOPRUNE_DEFAULT_MIN=5
autoprune_direct_setting() { # .manager.conf autoprune-direct (0 = reverse-side cleanup only; anything else = both sides)
  local v; v=$(conf_get autoprune-direct 1)
  [ "$v" = 0 ] && { echo 0; return 0; }
  echo 1
}
prune_targets() { # direct-on sig-direct sig-reverse has-companion -> "both" | "reverse" | "none" (pure)
  local on=${1:-0} d=$2 r=$3 comp=${4:-0}
  if [ "$on" = 1 ]; then
    [ -n "$d$r" ] || [ "$comp" = 1 ] && { echo both; return 0; }
    echo none; return 0
  fi
  [ "$comp" = 1 ] && { echo reverse; return 0; }
  echo none
}
prune_signature() { # direct-on sig-direct sig-reverse has-companion -> the stable-pick signature the window watches (pure)
  local on=${1:-0} d=$2 r=$3 comp=${4:-0}
  if [ "$on" = 1 ]; then
    [ -n "$d" ] && printf '%s' "$d"
    [ -n "$r" ] && { [ -n "$d" ] && printf '+'; printf 'r:%s' "$r"; }
    return 0
  fi
  [ "$comp" = 1 ] && { printf 'r:%s' "${r:--}"; return 0; } # "-" = companion present, nothing live on it
  printf ''
}
prune_decision() { # in-use prev-sig prev-since now grace-seconds -> "idle - -" | "reset SIG NOW" | "wait SIG SINCE" | "prune SIG SINCE"
  # Pure: the self-test pins every branch. The signature is the carrier set Iran is using ("tcp+wss", "r:icmp",
  # "tcp+r:tcp"); a changed signature restarts the window, so a flapping selection is never pruned.
  local in_use=$1 sig=$2 since=$3 now=$4 grace=$5
  [ -n "$in_use" ] || { echo "idle - -"; return 0; }
  case "$since" in ''|*[!0-9]*) echo "reset $in_use $now"; return 0 ;; esac
  [ "$in_use" = "$sig" ] || { echo "reset $in_use $now"; return 0; }
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  if [ "$grace" -le 0 ] || [ $((now - since)) -lt "$grace" ]; then echo "wait $sig $since"; return 0; fi
  echo "prune $sig $since"
}
autoprune_grace() { # -> minutes from .manager.conf (0 = automatic cleanup off); junk falls back to the default
  local v; v=$(conf_get autoprune "$AUTOPRUNE_DEFAULT_MIN")
  [[ "$v" =~ ^[0-9]+$ ]] || v=$AUTOPRUNE_DEFAULT_MIN
  echo "$v"
}
prune_stamp_get() { [ -f "$RUN/$1.autoprune" ] && head -1 "$RUN/$1.autoprune" 2>/dev/null; return 0; }
prune_stamp_set() { # name sig since : the observation the next pass compares against
  mkdir -p "$RUN"; printf '%s %s\n' "$2" "$3" >"$RUN/$1.autoprune"; return 0
}
prune_done_mark() { mkdir -p "$RUN"; : >"$RUN/$1.autoprune.done"; rm -f "$RUN/$1.autoprune"; return 0; }
auto_prune_reverse_only() { # name : close the unused reverse companion / stale watcher; the direct carrier list is untouched
  local n=$1 c cur_r keep_r gone_r=''
  is_auto_kharej "$n" || return 1
  systemctl stop "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  systemctl reset-failed "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  [ -f "$CONF/$n-r.yml" ] || { prune_done_mark "$n"; return 0; }
  keep_r=$AN_R
  if [ -z "$keep_r" ]; then
    systemctl stop "${WAT_PREFIX}@$n-r" >/dev/null 2>&1
    systemctl disable "${WAT_PREFIX}@$n-r" >/dev/null 2>&1
    ok "Reverse side '$n-r' is not in use: stopped (config and token stay)."
    prune_done_mark "$n"; return 0
  fi
  cur_r=$(cfg "$n-r" carrier); cur_r=${cur_r//+/ }
  for c in $cur_r; do case " $keep_r " in *" $c "*) ;; *) gone_r="$gone_r $c" ;; esac; done
  if [ -z "$gone_r" ]; then return 2; fi # every reverse leg is in use: nothing to close, keep watching
  auto_set_carriers "$n" '' "$keep_r" || return 1
  step "Restarting ${WAT_PREFIX}@$n-r" systemctl restart "${WAT_PREFIX}@$n-r"
  prune_done_mark "$n"
}
auto_prune_tick() { # name : one heal pass for an auto Kharej tunnel; reverse-side only unless autoprune-direct=1
  local n=$1 mins grace in_use_d in_use_r sig targets direct_on comp act seen now psig psince rc ext
  is_auto_kharej "$n" || return 0
  [ -f "$CONF/$n.keepopen" ] && return 0
  [ -f "$RUN/$n.autoprune.done" ] && return 0
  mins=$(autoprune_grace); [ "$mins" -gt 0 ] || return 0
  grace=$((mins * 60))
  direct_on=$(autoprune_direct_setting)
  comp=0; [ -f "$CONF/$n-r.yml" ] && comp=1
  auto_live "$n"
  in_use_d=$(echo $AN_D | tr ' ' '+'); in_use_r=$(echo $AN_R | tr ' ' '+')
  targets=$(prune_targets "$direct_on" "$in_use_d" "$in_use_r" "$comp")
  ext=$(auto_ext_names "$n")
  sig=$(prune_signature "$direct_on" "$in_use_d" "$in_use_r" "$comp")
  if [ "$targets" = none ]; then
    # H1 (2026-11-04): with no reverse companion and no parent traffic, the only pick visible on Kharej is a hidden
    # child's own /stats. auto_ext_sig is empty when no child reports a client or a running child cannot be read; then
    # every shape stays open (never guess).
    sig=''; [ -n "$ext" ] && sig=$(auto_ext_sig "$n")
  fi
  [ -n "$sig" ] || { rm -f "$RUN/$n.autoprune"; return 0; }
  psig=''; psince=''; read -r psig psince <<<"$(prune_stamp_get "$n")"
  now=$(date +%s)
  read -r act seen <<<"$(prune_decision "$sig" "$psig" "$psince" "$now" "$grace" | awk '{print $1, $3}')"
  case "$act" in
    idle) rm -f "$RUN/$n.autoprune" ;;
    reset|wait) prune_stamp_set "$n" "$sig" "$seen" ;;
    prune)
      if [ "$targets" = none ]; then
        logger -t wattun-auto "auto tunnel $n: extended pick '$sig' stable for ${mins} min, closing the other shapes"
      else
        logger -t wattun-auto "auto tunnel $n: Iran's pick '$sig' stable for ${mins} min, closing the unused side (${targets})"
      fi
      # B3/H1: close the shapes Iran did not pick, independent of the reverse/direct narrowing below (an unknown pick
      # keeps them all; auto_ext_prune is fail-safe). The reverse-only pass can return 2 when every leg is in use, and
      # that must not leave the hidden listeners open forever.
      [ -n "$ext" ] && auto_ext_prune "$n"
      if [ "$targets" = both ]; then
        systemctl stop "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
        systemctl reset-failed "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
        if ( NONINTERACTIVE=1; auto_narrow "$n" ) >/dev/null 2>&1; then
          prune_done_mark "$n"
          logger -t wattun-auto "auto tunnel $n: narrowed to the carriers Iran uses (configs kept; auto-widen $n reopens)"
        else
          logger -t wattun-auto "auto tunnel $n: narrowing failed, retrying after another ${mins} min"
          prune_stamp_set "$n" "$sig" "$now"
        fi
      elif [ "$targets" = reverse ]; then
        if ( NONINTERACTIVE=1; auto_prune_reverse_only "$n" ) >/dev/null 2>&1; then
          prune_done_mark "$n"
          logger -t wattun-auto "auto tunnel $n: unused reverse side closed (default scope; autoprune-direct=1 also narrows direct)"
        else
          rc=$?
          if [ "$rc" = 2 ]; then
            prune_stamp_set "$n" "$sig" "$now" # reverse side fully in use: nothing to close, check again next window
          else
            logger -t wattun-auto "auto tunnel $n: reverse-side cleanup failed, retrying after another ${mins} min"
            prune_stamp_set "$n" "$sig" "$now"
          fi
        fi
      else
        prune_done_mark "$n" # a shaped-only pick: the hidden children are the whole scope
      fi
      ;;
  esac
  return 0
}
auto_prune_cmd() { # name [--keep-open|--auto|--direct|--reverse-only] : automatic lifecycle cleanup of an auto Kharej tunnel
  local n=$1 mode=${2:-} mins before_done=0 st direct_on
  [ -n "$n" ] && [ -f "$CONF/$n.yml" ] || { err "Usage: $SELF auto-prune NAME [--keep-open|--auto|--direct|--reverse-only]"; return 1; }
  is_auto_kharej "$n" || { err "'$n' is not an auto Kharej tunnel."; return 1; }
  case "$mode" in
    --keep-open)
      ( umask 077; : >"$CONF/$n.keepopen" )
      rm -f "$RUN/$n.autoprune" "$RUN/$n.autoprune.done"
      logger -t wattun-auto "auto tunnel $n: keep-open set, automatic cleanup off"
      ok "Automatic cleanup off for '$n' (every carrier stays open)."
      hint "Manual cleanup at any time: $SELF auto-narrow $n. Back to automatic: $SELF auto-prune $n --auto"
      return 0 ;;
    --direct)
      conf_set autoprune-direct 1
      rm -f "$RUN/$n.autoprune" "$RUN/$n.autoprune.done"
      [ -n "$(auto_ext_names "$n")" ] && auto_ext_start "$n" # B3: reopen the hidden listeners for a retest
      ok "Direct-carrier narrowing is ON for every auto tunnel (autoprune-direct=1 in $MCONF)."
      hint "Default stays reverse-side only; turning this on can narrow a bonded Iran client to one leg."
      return 0 ;;
    --reverse-only)
      conf_set autoprune-direct 0
      rm -f "$RUN/$n.autoprune" "$RUN/$n.autoprune.done"
      ok "Automatic cleanup is back to the safe default: unused reverse side/watchers only (autoprune-direct=0)."
      return 0 ;;
    --auto|'') rm -f "$CONF/$n.keepopen" ;;
    *) err "Usage: $SELF auto-prune $n [--keep-open|--auto|--direct|--reverse-only]"; return 1 ;;
  esac
  mins=$(autoprune_grace); direct_on=$(autoprune_direct_setting)
  if [ "$mins" -le 0 ]; then
    ok "Automatic cleanup is off for every tunnel (autoprune=0 in $MCONF)."
    hint "The manual path still works: $SELF auto-narrow $n"
    return 0
  fi
  [ -f "$RUN/$n.autoprune.done" ] && before_done=1
  auto_prune_tick "$n"
  if [ "$before_done" = 0 ] && [ -f "$RUN/$n.autoprune.done" ]; then
    ok "Iran's pick was stable; the unused side is closed. auto-widen $n opens it again."
    return 0
  fi
  [ -f "$RUN/$n.autoprune.done" ] && { ok "'$n' is already narrowed to the carriers Iran uses."; return 0; }
  st=$(prune_stamp_get "$n")
  if [ -n "$st" ]; then
    if [ "$direct_on" = 1 ]; then
      ok "Waiting: Iran's pick ($st) must stay stable for $mins min; heal then closes the unused carrier legs."
    else
      ok "Waiting: Iran's pick ($st) must stay stable for $mins min; heal then closes only the unused reverse side."
      hint "Direct-carrier narrowing is opt-in: $SELF auto-prune $n --direct (it can narrow a bonded Iran client)."
    fi
    hint "Close the direct side now: $SELF auto-narrow $n. Keep every carrier open: $SELF auto-prune $n --keep-open"
  else
    ok "Iran is not connected to '$n' yet; nothing to close."
  fi
  return 0
}

# R3 safety net: automatic widening. A pruned auto tunnel keeps only the carriers Iran used, so if that carrier is
# blocked there is nothing left to fail over to. When heal (on Kharej) sees a pruned tunnel with no working open
# carrier, it reopens the token plan by itself, bounded to once per autowiden minutes (.manager.conf; D1 default 10,
# 0 turns the automatic widen off — short enough that the default reverse-only cleanup cannot hide failover for long).
AUTOWIDEN_DEFAULT_MIN=10
autowiden_grace() { # -> minutes of cooldown between two automatic widens (0 = automatic widen off)
  local v; v=$(conf_get autowiden "$AUTOWIDEN_DEFAULT_MIN")
  [[ "$v" =~ ^[0-9]+$ ]] || v=$AUTOWIDEN_DEFAULT_MIN
  echo "$v"
}
autowiden_decision() { # up downs-before age-seconds min-checks min-minutes -> "reset" | "wait N" | "widen"
  # Pure: the self-test pins every branch. A working open carrier resets the counter. Otherwise the tunnel must fail
  # MIN_CHECKS consecutive checks AND the last widen must be at least MIN_MINUTES old, so a flapping or freshly
  # widened tunnel is not reopened on every heal pass. Prints the new consecutive-down count with "wait".
  local up=$1 downs=${2:-0} age=${3:-999999} minchecks=${4:-3} minint=${5:-$AUTOWIDEN_DEFAULT_MIN}
  [ "$up" = 1 ] && { echo "reset"; return 0; }
  case "$downs" in ''|*[!0-9]*) downs=0 ;; esac
  case "$age" in ''|*[!0-9]*) age=999999 ;; esac
  case "$minchecks" in ''|*[!0-9]*) minchecks=3 ;; esac
  case "$minint" in ''|*[!0-9]*) minint=$AUTOWIDEN_DEFAULT_MIN ;; esac
  downs=$((downs+1))
  if [ "$minint" -gt 0 ] && [ "$age" -lt $((minint*60)) ]; then echo "wait $downs"; return 0; fi
  [ "$downs" -ge "$minchecks" ] && { echo "widen"; return 0; }
  echo "wait $downs"
}
auto_widen_tick() { # name : reopen the plan when a pruned auto tunnel lost every open carrier
  local n=$1 up=0 downs=0 age=999999 mins act cnt stamp
  is_auto_kharej "$n" || return 0
  [ -f "$RUN/$n.autoprune.done" ] || return 0 # everything is still open unless the tunnel was narrowed
  [ -f "$CONF/$n.keepopen" ] && return 0
  read_token "$(cat "$CONF/$n.token")" && [ -n "$T_AUTO" ] || return 0 # only when the plan is known
  mins=$(autowiden_grace); [ "$mins" -gt 0 ] || return 0
  auto_live "$n"
  [ -n "$AN_D$AN_R" ] && up=1
  auto_ext_live "$n"; [ -n "$AE_LIVE" ] && up=1 # H1: a shaped-only pick never shows up in the parent's /stats
  downs=$(cat "$RUN/$n.autowiden.down" 2>/dev/null || echo 0)
  stamp="$RUN/$n.autowiden"
  if [ -f "$stamp" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
    [ "$age" -ge 0 ] || age=999999
  fi
  read -r act cnt <<<"$(autowiden_decision "$up" "$downs" "$age" 3 "$mins")"
  case "$act" in
    reset) rm -f "$RUN/$n.autowiden.down" ;;
    widen)
      logger -t wattun-auto "auto tunnel $n: no open carrier has worked for $((downs+1)) checks; reopening the whole plan (autowiden ${mins} min)"
      if ( NONINTERACTIVE=1; auto_widen "$n" ) >/dev/null 2>&1; then
        : >"$stamp"; rm -f "$RUN/$n.autowiden.down"
        logger -t wattun-auto "auto tunnel $n: reopened every carrier; it narrows again after a stable Iran pick"
      else
        echo "$cnt" >"$RUN/$n.autowiden.down"
        logger -t wattun-auto "auto tunnel $n: automatic widen failed; run by hand: $SELF auto-widen $n"
      fi ;;
    wait) echo "$cnt" >"$RUN/$n.autowiden.down" ;;
  esac
  return 0
}

# ---- Iran side: test runner ----
AV_LABEL=(); AV_CAR=(); AV_KIND=(); AV_PEER=(); AV_PORT=(); AV_SNI=(); AV_FP=(); AV_ECH=(); AV_FRAG=()
AV_FS=(); AV_FM=(); AV_X=() # fake-sni / fake-mode per variant (anti-censor matrix, 2.10.2)
AR_OK=(); AR_DOWN=(); AR_UP=(); AR_RTT=(); AR_WHY=()
AT_QUIET=0; AT_MB=2; AT_DIR=''; AT_PID=''; AT_FW=''; AT_ADDR=''; AT_SKIP=''; AT_DLINK=0; AT_SECS=0; AT_APPLIED=0
AT_PRESET=normal; AT_STTY=''; AT_KEYS=0; AT_ACT=''; AT_STOP=0; AT_GSKIP=''
AT_RANK=(); AT_SEL=(); AT_SEL_LABEL=''; AT_SEL_KEY=''; AT_EXTRA=''; AUTO_TOKEN=''
# /speedtest streams per session (2.4.18+; an older engine ignores the query value and uses its own default). The
# screening asks for 8 streams, the finalists for 16 to show what a busy tunnel does (methodology 2026-11-03).
AT_STREAMS=8; AT_PLAN=''; AT_TUNE_MB=0; AT_SKIPPED=''
# H2/H3/D8 (3.3.0 audit): measurement sizes are duration-based, not fixed. Screening starts at 8 MB each way and may
# grow x4 up to 16 MB once the first measured rate says 8 MB is under the 1.5 s floor (a traffic guard; the finalists
# carry the sustained measurement). Finalists need >=1.5 s at the measured rate, clamped to 20-40 MB. Tuning probes are
# fixed at 20 MB each way and only test sessions/conns (the reduced D8 grid). at_budget prints all three phases.
AT_SCREEN_MB_START=8; AT_SCREEN_CAP_MB=16
AT_FINAL_MB_MIN=20; AT_FINAL_MB_MAX=40
AT_TUNE_PROBE_MB=20
at_probe_mb() { # rate-MB/s [min-secs] [cap-MB] -> MB per direction: start 8, x4 until >= min-secs at that rate, capped
  local rate=${1:-0} min=${2:-1.5} cap=${3:-200} mb=$AT_SCREEN_MB_START
  case "$cap" in ''|*[!0-9]*) cap=200 ;; esac
  [ "$cap" -lt "$AT_SCREEN_MB_START" ] && cap=$AT_SCREEN_MB_START
  case "$rate" in ''|*[!0-9.]*|0|0.0|.) echo "$AT_SCREEN_MB_START"; return 0 ;; esac
  while [ "$mb" -lt "$cap" ] && awk -v m="$mb" -v r="$rate" -v s="$min" 'BEGIN{exit !(m/r < s)}'; do mb=$((mb*4)); done
  [ "$mb" -gt "$cap" ] && mb=$cap
  echo "$mb"
}
at_skipped_hint() { # B2: one clear sentence for carriers the Iran engine cannot run; empty when nothing was skipped
  [ -n "$AT_SKIPPED" ] || return 0
  printf 'Token includes %s; this server runs %s and cannot test them (both ends need newer wattun for these transports).' \
    "$AT_SKIPPED" "${VER:-an older wattun}"
}
at_budget() { # screening-variants screen-MB finalist-MB tuning-probes tuning-MB -> true worst case, MB + rough minutes
  # True worst case = in all 3 phases (H2): every variant gets both directions, so N variants = N*2*MB. The minutes
  # assume a conservative 8 MB/s aggregate (480 MB/min); a fast link finishes sooner, a slow one later, but the MB
  # figure (the part that costs money) is exact for the caps used.
  awk -v n="${1:-0}" -v s="${2:-8}" -v f="${3:-40}" -v p="${4:-0}" -v t="${5:-20}" \
    'BEGIN{mb=n*2*s+3*2*f+p*2*t; m=int((mb+479)/480); if(m<1)m=1; printf "up to %d MB, about %d min", mb, m}'
}
at_tune_probe_count() { # "sessions:1,2 conns:4,8" -> 1 baseline + one probe per value (pure, used by at_budget)
  local kv v out=1
  for kv in $1; do for v in $(tr ',' ' ' <<<"${kv#*:}"); do [ -n "$v" ] && out=$((out+1)); done; done
  echo "$out"
}
at_best_rate() { # current-best index... -> the fastest measured direction so far (MB/s; used to size the next probe)
  local best=${1:-0} i v
  shift || true
  for i in "$@"; do
    [ "${AR_OK[$i]:-0}" = 1 ] || continue
    v=$(awk -v a="${AR_DOWN[$i]:-0}" -v b="${AR_UP[$i]:-0}" 'BEGIN{m=(a>b)?a:b; printf "%g", m}')
    awk -v v="$v" -v b="$best" 'BEGIN{exit !(v > b)}' && best=$v
  done
  echo "$best"
}
av_add() { # label carrier kind(d|c|r) peer port sni [fp ech tls-frag [fake-sni fake-mode [extra flags]]] (fp..frag: CDN variants, wattun >= 2.2.0; fake-*: matrix; extra: auto tuning)
  AV_LABEL+=("$1"); AV_CAR+=("$2"); AV_KIND+=("$3"); AV_PEER+=("$4"); AV_PORT+=("$5"); AV_SNI+=("$6")
  AV_FP+=("${7:-}"); AV_ECH+=("${8:-}"); AV_FRAG+=("${9:-}")
  AV_FS+=("${10:-}"); AV_FM+=("${11:-}"); AV_X+=("${12:-}")
}
av_key() { local k="${AV_CAR[$1]}/${AV_KIND[$1]}"; av_anti "$1" && k+="/${AV_FS[$1]}-${AV_FM[$1]}-${AV_FP[$1]}-${AV_ECH[$1]}-${AV_FRAG[$1]}"; echo "$k"; }
av_anti() { [ "${AV_KIND[$1]}" = d ] && [ -n "${AV_FS[$1]}${AV_FP[$1]}${AV_ECH[$1]}${AV_FRAG[$1]}" ]; } # a direct variant that carries desync / fingerprint / fragmentation (anti-censor preset)
# Anti-censor preset: every direct pool carrier of the plan with every desync mode (first curated SNI), the three modes that
# cleared a filter in the field (rst, synrst, paws) against the other curated SNIs and the Cloudflare edge name, the TLS
# ClientHello split and fingerprint variants, ECH. Reverse tunnels are not covered: the desync runs on the dialing side,
# which for a reverse tunnel is Kharej, and this test only controls this server. The mode list itself is AC_ALLMODES
# (defined once, near v_fake_mode, H6): the matrix and the validator cannot drift apart.
auto_variants_anti() { # direct plan part
  local d=$1 c p fs fm first=${AC_SNIS%%,*} others tls
  others="${AC_SNIS#*,},www.cloudflare.com"
  for c in $AUTO_VAR_ANTI; do
    p=$(plan_port "$d" "$c"); [ -n "$p" ] || continue
    for fm in $AC_ALLMODES; do
      av_add "$c $fm $first" "$c" d "$AT_ADDR:$p" '' '' '' '' '' "$first" "$fm"
    done
    for fs in ${others//,/ }; do
      for fm in rst synrst paws; do av_add "$c $fm ${fs#www.}" "$c" d "$AT_ADDR:$p" '' '' '' '' '' "$fs" "$fm"; done
    done
    case "$c" in tls|wss|h2|grpc)
      av_add "$c tls-frag mid-SNI" "$c" d "$AT_ADDR:$p" '' '' '' '' -1
      av_add "$c tls-frag 40" "$c" d "$AT_ADDR:$p" '' '' '' '' 40
      for fm in chrome firefox safari; do av_add "$c fp $fm" "$c" d "$AT_ADDR:$p" '' '' "$fm"; done
      [ -n "$T_SNI" ] && av_add "$c chrome+ech" "$c" d "$AT_ADDR:$p" '' "$T_SNI" chrome auto ;;
    esac
  done
  return 0
}
auto_variants() { # T_* from the auto token -> AV_* (the token's plan is the source; B1/B2/B4)
  local d r c p name
  AV_LABEL=(); AV_CAR=(); AV_KIND=(); AV_PEER=(); AV_PORT=(); AV_SNI=(); AV_FP=(); AV_ECH=(); AV_FRAG=()
  AV_FS=(); AV_FM=(); AV_X=()
  AT_ADDR=$T_PEER; AT_PATH=${T_PATH:-/wat}; AT_SKIPPED=''
  d=$(plan_part "$T_AUTO" d); r=$(plan_part "$T_AUTO" r)
  av_add icmp icmp d "$AT_ADDR" '' ''
  for c in ${d//,/ }; do # plan order = test order; a bare entry is a port-less raw carrier (gre/ipip/shaped raw)
    name=${c%%:*}; p=$(plan_entry_port "$c")
    [ "$name" = icmp ] && continue # the bare-IP icmp variant is the first row, added above
    if ! carrier_ok_here "$name"; then AT_SKIPPED+="${AT_SKIPPED:+, }$name"; continue; fi # B2: Iran skips what it cannot run
    if is_shaped_raw "$name"; then av_add "$name (shape only)" "$name" d "$AT_ADDR" '' ''
    elif is_shaped_udp "$name"; then av_add "$name (shape only)" "$name" d "$AT_ADDR:$p" '' ''
    elif [ -n "$p" ]; then av_add "$name" "$name" d "$AT_ADDR:$p" '' ''
    else av_add "$name" "$name" d "$AT_ADDR" '' ''; fi
  done
  [ "$AT_PRESET" = anti ] && auto_variants_anti "$d"
  if [ -n "$T_SNI" ]; then
    for c in $AUTO_VAR_CDN; do # h2 never connects through Cloudflare
      p=$(plan_port "$d" "$c"); [ -n "$p" ] || continue
      if cdn_ok; then # variant (a): chrome+ech on the best Cloudflare edges (CS_EDGES, filled by auto_test); b-d: cdn_auto_extras
        if [ "${#CS_EDGES[@]}" -gt 0 ]; then av_add "$c · chrome+ech · ${#CS_EDGES[@]} edges" "$c" c "$(cdn_peer_list "$p")" '' "$T_SNI" chrome auto
        else av_add "$c · chrome+ech" "$c" c "$T_SNI:$p" '' "$T_SNI" chrome auto; fi
      else av_add "$c via CDN" "$c" c "$T_SNI:$p" '' "$T_SNI"; fi
    done
  fi
  av_add "icmp reverse" icmp r "$AT_ADDR" '' ''
  for c in ${r//,/ }; do # reverse plan: icmp first, then pool legs (raw carriers have no reverse mode)
    name=${c%%:*}; p=$(plan_entry_port "$c")
    [ "$name" = icmp ] && continue # added above, like the direct icmp row
    [ -n "$p" ] || continue
    carrier_ok_here "$name" || { AT_SKIPPED+="${AT_SKIPPED:+, }$name"; continue; }
    av_add "$name reverse" "$name" r "$AT_ADDR:$p" "$p" ''
  done
  return 0
}
at_free_port() { local p=${1:-20500}; while [ "$p" -lt 20700 ] && port_busy "$p" tcp; do p=$((p+1)); done; echo "$p"; }
at_alive() { [ "$(jget "$(curl -fs --noproxy '*' --max-time 2 "http://127.0.0.1:$1/stats" 2>/dev/null)" alive)" = true ]; }
at_key() { # non-blocking key poll during a test: s skip this variant, g skip this carrier's anti-censor variants, q stop. rc 0 = a key was taken (AT_ACT)
  [ "$AT_KEYS" = 1 ] || return 1
  local k=''
  IFS= read -rsn1 -t 0.05 k 2>/dev/null || return 1
  case "$k" in s|S) AT_ACT=skip ;; g|G) AT_ACT=group ;; q|Q) AT_ACT=stop ;; *) return 1 ;; esac
  return 0
}
at_wait() { # metrics-port seconds : wait for the link
  local end=$((SECONDS + $2))
  while :; do
    at_alive "$1" && return 0
    at_key && return 1
    [ "$SECONDS" -ge "$end" ] && return 1
    kill -0 "$AT_PID" 2>/dev/null || return 1
    sleep 0.5
  done
}
AT_PIDS=(); AT_MPS=()
at_kill() { # the single probe client and every client of the reverse batch
  local p
  if [ -n "$AT_PID" ]; then kill "$AT_PID" 2>/dev/null; { wait "$AT_PID"; } 2>/dev/null; AT_PID=''; fi
  for p in "${AT_PIDS[@]}"; do [ -n "$p" ] && kill "$p" 2>/dev/null; done
  for p in "${AT_PIDS[@]}"; do [ -n "$p" ] && { wait "$p"; } 2>/dev/null; done
  AT_PIDS=(); AT_MPS=()
  return 0
}
at_fw_open() { # port/tcp : temporary rule for a reverse test port (firewalld: runtime only)
  local fw p=$1; fw=$(fw_kind); [ -n "$fw" ] || return 0
  [ "$SANDBOX" = 1 ] && hint "Sandbox: test port $p is opened in $fw if not already allowed, and closed when the test ends."
  if [ "$fw" = ufw ]; then
    ufw status 2>/dev/null | grep -q "^$p[[:space:]]" && return 0
    ufw allow "$p" >/dev/null 2>&1 && AT_FW="$AT_FW $p"
  else
    firewall-cmd -q --query-port="$p" 2>/dev/null && return 0
    firewall-cmd -q --add-port="$p" 2>/dev/null && AT_FW="$AT_FW $p"
  fi
  return 0
}
at_fw_close() {
  local fw p; fw=$(fw_kind); [ -n "$AT_FW" ] && [ -n "$fw" ] || { AT_FW=''; return 0; }
  for p in $AT_FW; do
    if [ "$fw" = ufw ]; then ufw delete allow "$p" >/dev/null 2>&1; else firewall-cmd -q --remove-port="$p" 2>/dev/null; fi
  done
  AT_FW=''; return 0
}
at_cleanup() {
  local p
  [ -n "$AT_STTY" ] && { stty "$AT_STTY" 2>/dev/null; AT_STTY=''; }
  at_kill; at_fw_close
  for p in ${CS_PIDS[@]+"${CS_PIDS[@]}"}; do kill "$p" 2>/dev/null; done
  CS_PIDS=(); [ -n "${CS_DIR:-}" ] && rm -rf "$CS_DIR"; CS_DIR=''
  [ -n "$AT_DIR" ] && rm -rf "$AT_DIR"
  AT_DIR=''; return 0
}
at_start() { # i metrics-port : start a throw-away client for variant i (no -map: nothing is published)
  local i=$1 mp=$2 car=${AV_CAR[$1]} a x c hasws=0 hasicmp=0
  a=(-mode client -carrier "$car" -key-file "$AT_DIR/key" -peer "${AV_PEER[$i]}" -metrics "127.0.0.1:$mp")
  # a bond (auto tuning) needs the per-leg overrides of its carrier list too: path and icmp-type apply when any leg does
  for c in ${car//+/ }; do
    case "$c" in ws|wss|h2|h2c|grpc) hasws=1 ;; icmp) hasicmp=1 ;; esac
  done
  [ "$hasws" = 1 ] && a+=(-path "${T_PATH:-/wat}")
  [ "$hasicmp" = 1 ] && [ -n "$T_ICMP" ] && a+=(-icmp-type "$T_ICMP")
  if [ -n "${AV_SNI[$i]}" ]; then a+=(-sni "${AV_SNI[$i]}" -host "${AV_SNI[$i]}"); fi
  if [ -n "${AV_FP[$i]:-}" ]; then a+=(-fp "${AV_FP[$i]}"); fi
  if [ -n "${AV_ECH[$i]:-}" ]; then a+=(-ech "${AV_ECH[$i]}"); fi
  if [ -n "${AV_FRAG[$i]:-}" ] && [ "${AV_FRAG[$i]}" != 0 ]; then a+=(-tls-frag "${AV_FRAG[$i]}"); fi
  if [ -n "${AV_FS[$i]:-}" ]; then # anti-censor matrix variant (2.10.2): desync on the throwaway client
    a+=(-fake-sni "${AV_FS[$i]}")
    [ -n "${AV_FM[$i]:-}" ] && a+=(-fake-mode "${AV_FM[$i]}")
  fi
  if [ -n "${AV_X[$i]:-}" ]; then read -ra x <<<"${AV_X[$i]}"; a+=("${x[@]}"); fi # auto tuning: -key=value words
  # the engine refuses a client without any -map: a loopback-only dummy mapping publishes nothing
  a+=(-map "$(at_free_port $((mp + 1))):1@127.0.0.1")
  if [ "${AV_KIND[$i]}" = r ]; then
    a+=(-reverse)
    if is_pool "$car"; then a+=(-listen ":${AV_PORT[$i]}"); fi
  fi
  timeout -k 2 "$AT_LIM" "$BIN" "${a[@]}" >"$AT_DIR/client.$i.log" 2>&1 &
  AT_PID=$!
}
at_curl() { # metrics-port dir -> AT_R (no subshell: AT_ACT must survive) ; a skip/stop key kills the transfer (rc 1)
  local cp f=${AT_DIR:-/tmp}/curl.$$
  AT_R=
  curl -fs --noproxy '*' --max-time $((AT_MB * 2 > 20 ? AT_MB * 2 : 20)) "http://127.0.0.1:$1/speedtest?dir=$2&mb=$AT_MB&streams=${AT_STREAMS:-8}" >"$f" 2>/dev/null &
  cp=$!
  if [ "$AT_KEYS" = 1 ]; then
    while kill -0 "$cp" 2>/dev/null; do
      if at_key; then kill "$cp" 2>/dev/null; { wait "$cp"; } 2>/dev/null; rm -f "$f"; return 1; fi
    done
  fi
  { wait "$cp"; } 2>/dev/null; AT_R=$(cat "$f" 2>/dev/null); rm -f "$f"
}
at_probe() { # i wait-seconds : fills AR_*[i]
  local i=$1 w=${2:-8} mp r
  AR_OK[$i]=0; AR_DOWN[$i]=0; AR_UP[$i]=0; AR_RTT[$i]=0; AR_WHY[$i]=''
  [ "$AT_ACT" = stop ] && AT_STOP=1
  AT_ACT=''
  [ "$AT_STOP" = 1 ] && { AR_WHY[$i]=skipped; return 0; }
  case " $AT_SKIP " in *" $(av_key "$i") "*) AR_WHY[$i]='in use by this tunnel'; return 0 ;; esac
  if [ "${AV_KIND[$i]}" = r ] && is_pool "${AV_CAR[$i]}"; then
    if listen_blocked tcp "${AV_PORT[$i]}"; then AR_WHY[$i]="port ${AV_PORT[$i]}/tcp is busy here"; return 0; fi
    at_fw_open "${AV_PORT[$i]}/tcp"
  fi
  mp=$(at_free_port)
  AT_LIM=$((w + 55 + AT_MB * 4))
  at_start "$i" "$mp"
  if ! at_wait "$mp" "$w"; then
    AR_WHY[$i]="no link in $w s"
    [ -n "$AT_ACT" ] && AR_WHY[$i]=skipped
  else
    [ "${AV_KIND[$i]}" = r ] || AT_DLINK=$((AT_DLINK+1))
    at_measure "$i" "$mp"
  fi
  at_kill; at_fw_close
  return 0
}
at_measure() { # i metrics-port : speed test on a running client, fills AR_*[i]
  local i=$1 mp=$2 r
  at_curl "$mp" down; r=$AT_R
  if [ "$(jget "$r" ok)" = true ]; then
    AR_DOWN[$i]=$(jget "$r" mb_per_s)
    at_curl "$mp" up; r=$AT_R
    if [ "$(jget "$r" ok)" = true ]; then
      AR_UP[$i]=$(jget "$r" mb_per_s)
      AR_RTT[$i]=$(jget_flat "$(curl -fs --noproxy '*' --max-time 2 "http://127.0.0.1:$mp/stats" 2>/dev/null)" rtt_ms srtt_ms)
      : "${AR_DOWN[$i]:=0}" "${AR_UP[$i]:=0}" "${AR_RTT[$i]:=0}"
      AR_OK[$i]=1
    fi
  fi
  [ "${AR_OK[$i]}" = 1 ] || AR_WHY[$i]='speed test failed/stalled'
  [ -n "$AT_ACT" ] && { AR_OK[$i]=0; AR_WHY[$i]=skipped; }
  return 0
}
# Reverse pool carriers: Kharej's NAME-r companion starts dialing Iran's r-ports as soon as it knows Iran's IP, and its
# redial backoff grows while nothing listens. So all reverse clients (and their temporary firewall rules) are started at
# once, we wait for all of them together, then the speed tests run one at a time on the already-running clients.
at_pool_batch() { # indices... : probe every reverse pool variant given
  local i mp base=20500 end pend ks=0 started=() up=()
  for i in "$@"; do
    AR_OK[$i]=0; AR_DOWN[$i]=0; AR_UP[$i]=0; AR_RTT[$i]=0; AR_WHY[$i]=''
    case " $AT_SKIP " in *" $(av_key "$i") "*) AR_WHY[$i]='in use by this tunnel'; continue ;; esac
    if listen_blocked tcp "${AV_PORT[$i]}"; then AR_WHY[$i]="port ${AV_PORT[$i]}/tcp is busy here"; continue; fi
    at_fw_open "${AV_PORT[$i]}/tcp"
  done
  AT_LIM=$((45 + $# * (50 + AT_MB * 4) + 30))
  for i in "$@"; do
    [ -z "${AR_WHY[$i]}" ] || continue
    mp=$(at_free_port "$base"); base=$((mp + 3))
    at_start "$i" "$mp"
    AT_PIDS[$i]=$AT_PID; AT_PID=''; AT_MPS[$i]=$mp
    started+=("$i")
  done
  if [ "${#started[@]}" -gt 0 ]; then
    [ "$AT_QUIET" = 1 ] || at_busy "reverse links (all at once, up to 45 s)"
    end=$((SECONDS + 45)); ks=0
    while :; do
      if at_key; then [ "$AT_ACT" = stop ] && AT_STOP=1; AT_ACT=''; ks=1; break; fi
      pend=0
      for i in "${started[@]}"; do
        [ "${up[$i]:-0}" = 1 ] && continue
        if at_alive "${AT_MPS[$i]}"; then up[$i]=1
        elif kill -0 "${AT_PIDS[$i]}" 2>/dev/null; then pend=1; fi
      done
      [ "$pend" = 0 ] && break
      [ "$SECONDS" -ge "$end" ] && break
      sleep 0.5
    done
    [ "$AT_QUIET" = 1 ] || at_idle
  fi
  for i in "$@"; do
    if [ -z "${AR_WHY[$i]}" ]; then
      if [ "$AT_STOP" = 1 ]; then AR_WHY[$i]=skipped
      elif [ "${up[$i]:-0}" = 1 ]; then
        [ "$AT_QUIET" = 1 ] || at_busy "${AV_LABEL[$i]}"
        at_measure "$i" "${AT_MPS[$i]}"
        [ "$AT_QUIET" = 1 ] || at_idle
        [ "$AT_ACT" = stop ] && AT_STOP=1
        AT_ACT=''
      elif [ "$ks" = 1 ]; then AR_WHY[$i]=skipped
      else AR_WHY[$i]='no link in 45 s'; fi
    fi
    [ "$AT_QUIET" = 1 ] || at_print "$i"
  done
  at_kill; at_fw_close
  return 0
}
at_busy() { if [ "$ANIM" = 1 ]; then spin_start "Testing $1"; elif [ "$NONINTERACTIVE" = 1 ]; then printf '  testing %s ...\n' "$1"; elif [ "$IS_TTY" = 1 ]; then printf '  testing %s ...' "$1"; fi; return 0; }
at_idle() { if [ "$ANIM" = 1 ]; then spin_stop; elif [ "$IS_TTY" = 1 ]; then printf '\r\e[K'; fi; return 0; }
at_print() {
  local i=$1
  if [ "${AR_OK[$i]}" = 1 ]; then
    printf '  %s✔%s %-28s %s%6.1f%s MB/s down  %6.1f MB/s up  %4.0f ms\n' "$GRN" "$RST" "${AV_LABEL[$i]}" "$BOLD" "${AR_DOWN[$i]:-0}" "$RST" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}"
  else
    printf '  %s✘%s %-28s %s%s%s\n' "$RED" "$RST" "${AV_LABEL[$i]}" "$GRY" "${AR_WHY[$i]}" "$RST"
  fi
}
AT_NOTE=''
auto_refine() { # AT_RANK from the screening -> re-measure the top 3 with 16 streams and a sustained run, re-rank
  # H3: slow start dominates a short transfer, so a finalist is sized by the duration floor, not a fixed MB: >=1.5 s
  # each way at its screening rate, clamped to 20-40 MB (the 40 MB cap keeps the worst case inside at_budget's number;
  # a variant that fails keeps its screening numbers).
  local i k=0 top=() pool=() save=$AT_MB save_streams=$AT_STREAMS w ok d u r t0=$SECONDS mb mb_pool=0 refined=0 rate
  local -A sv=()
  [ "${#AT_RANK[@]}" -gt 0 ] || return 0
  for i in "${AT_RANK[@]}"; do [ "$k" -ge 3 ] && break; top+=("$i"); k=$((k+1)); sv[$i]="${AR_OK[$i]}|${AR_DOWN[$i]}|${AR_UP[$i]}|${AR_RTT[$i]}"; done
  at_prep || return 0
  AT_STREAMS=16
  [ "$AT_QUIET" = 1 ] || { echo; say "  ${BOLD}Confirming the top ${#top[@]} with 16 streams and a sustained run${RST}"; }
  for i in "${top[@]}"; do
    IFS='|' read -r ok d u r <<<"${sv[$i]}"
    rate=$(awk -v a="${d:-0}" -v b="${u:-0}" 'BEGIN{print (a>b)?a:b}')
    mb=$(at_probe_mb "$rate" 1.5 "$AT_FINAL_MB_MAX")
    [ "$mb" -lt "$AT_FINAL_MB_MIN" ] && mb=$AT_FINAL_MB_MIN
    [ "${AV_KIND[$i]}" = r ] && is_pool "${AV_CAR[$i]}" && { pool+=("$i"); [ "$mb" -gt "$mb_pool" ] && mb_pool=$mb; continue; }
    w=8; [ "${AV_KIND[$i]}" = r ] && [ "${AV_CAR[$i]}" = icmp ] && w=30
    AT_MB=$mb; refined=$((refined + 2 * mb))
    [ "$AT_QUIET" = 1 ] || at_busy "${AV_LABEL[$i]}"
    at_probe "$i" "$w"
    [ "$AT_QUIET" = 1 ] || { at_idle; at_print "$i"; }
  done
  if [ "${#pool[@]}" -gt 0 ]; then
    [ "$mb_pool" -lt 20 ] && mb_pool=20
    AT_MB=$mb_pool; refined=$((refined + ${#pool[@]} * 2 * mb_pool))
    at_pool_batch "${pool[@]}"
  fi
  at_cleanup
  AT_MB=$save; AT_STREAMS=$save_streams
  for i in "${top[@]}"; do # a variant that fails the longer test keeps its screening numbers
    [ "${AR_OK[$i]}" = 1 ] && continue
    IFS='|' read -r ok d u r <<<"${sv[$i]}"; AR_OK[$i]=$ok; AR_DOWN[$i]=$d; AR_UP[$i]=$u; AR_RTT[$i]=$r
  done
  AT_SECS=$((AT_SECS + SECONDS - t0))
  AT_NOTE="Screened with duration-based $AT_SCREEN_MB_START-$AT_SCREEN_CAP_MB MB probes (8 streams); the top ${#top[@]} sized to the 1.5 s floor (20-40 MB) with 16 streams ($refined MB moved)."
  [ -n "$AT_PLAN" ] && AT_PLAN=$(at_budget "${#AV_LABEL[@]}" "$AT_SCREEN_CAP_MB" "$AT_FINAL_MB_MAX" "$AT_TUNE_PROBES_MAX" "$AT_TUNE_PROBE_MB")
  at_rank
  return 0
}
# Auto tuning: once the type is chosen, try the settings that actually moved speed in the field, one setting at a time,
# each value against the best so far. A value is kept only when it beats that by 10 % (one run is noisy), so a setting
# stays at the engine's auto value unless another value is clearly faster on this route. Measured on one 2 vCPU pair
# (2026-11-03): tcp sessions 1/2/4/8 gave 176/261/147/68 MB/s down, so no one value fits every route.
# D8 (3.3.0 audit): probes are fixed at AT_TUNE_PROBE_MB each way and the grid is sessions+conns only. mtu/win-max/batch/
# loss-ceiling were removed from tuning because their effect was inside the run-to-run noise; max-mbps and fec stay
# untuned (icmp keeps its 16 MB/s reroute guard; -fec auto needs the same setting on Kharej). A bond tests conns only:
# the engine refuses -sessions on any bond.
AUTO_TUNE_ICMP=''                       # no sessions/conns to tune on a raw-IP carrier
AUTO_TUNE_UDP='sessions:1,2,4'
AUTO_TUNE_POOL='sessions:1,2,4,8,16 conns:4,8,32,64'
AUTO_TUNE_REVERSE='conns:4,8,32'        # -sessions is refused in reverse mode
AUTO_TUNE_BOND_DGRAM='conns:4,8,32,64'
AUTO_TUNE_BOND_POOL='conns:4,8,32,64'
at_tune_knobs() { # carrier|bond|reverse -> "key:value,value ..." in test order (the data above)
  case "$1" in
    icmp) echo "$AUTO_TUNE_ICMP" ;;
    udp) echo "$AUTO_TUNE_UDP" ;;
    bond) if has_dgram "${T_CARRIER:-}"; then echo "$AUTO_TUNE_BOND_DGRAM"; else echo "$AUTO_TUNE_BOND_POOL"; fi ;;
    reverse) echo "$AUTO_TUNE_REVERSE" ;;
    tcp|tls|ws|wss|h2|h2c|grpc) echo "$AUTO_TUNE_POOL" ;;
  esac
}
AT_TUNE_PROBES_MAX=$(at_tune_probe_count "$AUTO_TUNE_POOL") # the widest reduced grid, used by at_budget (H2)
at_tune_knobs_avail() { printf '%s' "$(at_tune_knobs "$1")"; } # every remaining knob (sessions/conns) exists on every supported engine
AT_TUNE=''; AT_TUNE_KEYS=''
at_tune_bond_variant() { # AT_SEL (2+ direct variants) -> one AV entry that probes the whole selected bond; sets AT_TUNE_BASE
  # A CDN row may be one of the joined rows (at_rows allows it): fp/ech/tls-frag are global flags, so the bond probe
  # reuses them from the first CDN row and the global T_SNI, exactly as at_to_t writes them into the real config.
  local i c peers='' first='' sni='' fp='' ech='' frag=''
  for i in "${AT_SEL[@]}"; do
    c=${AV_CAR[$i]}
    if [ "$c" = icmp ]; then peers="${peers:+$peers }-peer-icmp ${AV_PEER[$i]}"
    else peers="${peers:+$peers }-peer-$c ${AV_PEER[$i]}"; fi
    [ -n "$first" ] || first=${AV_PEER[$i]}
    if [ "${AV_KIND[$i]}" = c ]; then
      [ -n "$sni" ] || sni=${AV_SNI[$i]}; [ -n "$fp" ] || fp=${AV_FP[$i]}
      [ -n "$ech" ] || ech=${AV_ECH[$i]}; [ -n "$frag" ] || frag=${AV_FRAG[$i]}
    fi
  done
  [ -n "$sni" ] || sni=$T_SNI
  av_add "bond ${T_CARRIER:-}" "${T_CARRIER:-}" d "$first" '' "$sni" "$fp" "$ech" "$frag" '' '' "$peers"
  AT_TUNE_BASE=$((${#AV_LABEL[@]} - 1))
}
at_tune() { # AT_SEL -> AT_TUNE (config lines) and AT_TUNE_KEYS (the settings it tested). One direct/CDN variant, one
  # reverse variant, or a bond of direct variants (at_choose only ever joins direct, non-anti-censor rows).
  local target kind knobs kv k v best bs s i x='' save=$AT_MB w=8
  AT_TUNE=''; AT_TUNE_KEYS=''; AT_TUNE_MB=0
  [ "${#AT_SEL[@]}" -ge 1 ] || return 0
  if [ "${#AT_SEL[@]}" -eq 1 ]; then
    target=${AT_SEL[0]}
    if [ "${AV_KIND[$target]}" = r ]; then kind=reverse; else kind=${AV_CAR[$target]}; fi
  else
    kind=bond; target=''
  fi
  knobs=$(at_tune_knobs_avail "$kind"); [ -n "$knobs" ] || return 0
  at_prep || return 0
  # AT_SKIP only skips the live variant during the screening; tuning must measure that very variant as its baseline
  AT_SKIP=''
  [ "$kind" = bond ] && at_tune_bond_variant
  [ -z "$target" ] && target=$AT_TUNE_BASE
  # D8: a fixed 20 MB each way per probe (the budget's number), not a size derived from the screening rate: the tuning
  # grid is short and its values are compared against each other, so every probe must cost the same.
  AT_MB=$AT_TUNE_PROBE_MB
  AT_STOP=0; AT_ACT=''
  [ "$kind" = reverse ] && w=45 # Kharej reverse dialer backoff is up to 30 s; match at_pool_batch
  [ "$AT_QUIET" = 1 ] || { echo; say "  ${BOLD}Tuning ${AV_LABEL[$target]}${RST} (one setting at a time, $AT_MB MB each way)"; }
  at_tune_try() { # flags label -> i (the new variant) ; prints its row
    local extra="${AV_X[$target]:+${AV_X[$target]}}"
    [ -n "$1" ] && extra="${extra:+$extra }$1"
    av_add "$2" "${AV_CAR[$target]}" "${AV_KIND[$target]}" "${AV_PEER[$target]}" "${AV_PORT[$target]}" "${AV_SNI[$target]}" \
      "${AV_FP[$target]}" "${AV_ECH[$target]}" "${AV_FRAG[$target]}" "${AV_FS[$target]}" "${AV_FM[$target]}" "$extra"
    i=$((${#AV_LABEL[@]} - 1))
    [ "$AT_QUIET" = 1 ] || at_busy "$2"
    at_probe "$i" "$w"
    [ "$AT_QUIET" = 1 ] || { at_idle; at_print "$i"; }
  }
  at_tune_try '' 'as chosen (engine auto)'
  AT_TUNE_MB=$((AT_TUNE_MB + 2 * AT_MB))
  bs=0; [ "${AR_OK[$i]}" = 1 ] && bs=$(at_score "$i")
  if [ "$bs" = 0 ]; then # no baseline, no comparison: do not apply a value that was never measured against it
    [ "$AT_QUIET" = 1 ] || warn "The chosen setting did not come up during tuning; keeping the engine's auto values."
    at_cleanup; AT_MB=$save; return 0
  fi
  for kv in $knobs; do
    k=${kv%%:*}
    case "$k" in # a value given on the command line (--sessions, --conns) wins
      sessions) [ -n "$NI_SESSIONS" ] && continue ;;
      conns) [ -n "${NI_CONNS:-}" ] && continue ;;
    esac
    AT_TUNE_KEYS+=" $k"; best=''
    for v in $(tr ',' ' ' <<<"${kv#*:}"); do
      at_tune_try "${x:+$x }-$k=$v" "$k $v"
      AT_TUNE_MB=$((AT_TUNE_MB + 2 * AT_MB))
      [ "${AR_OK[$i]}" = 1 ] || continue
      s=$(at_score "$i")
      if awk -v s="$s" -v b="$bs" 'BEGIN{exit !(s > b * 1.1)}'; then bs=$s; best=$v; fi
    done
    if [ -n "$best" ]; then x="${x:+$x }-$k=$best"; AT_TUNE+="$k: $best"$'\n'; fi
  done
  at_cleanup
  AT_MB=$save
  AT_TUNE=${AT_TUNE%$'\n'}
  if [ "$AT_QUIET" != 1 ]; then
    if [ -n "$AT_TUNE" ]; then ok "Keeping: $(tr '\n' ',' <<<"$AT_TUNE" | sed 's/,$//; s/,/, /g')"
    else ok "The engine's auto values were the fastest."; fi
    [ "$AT_TUNE_MB" -gt 0 ] && hint "Tuning moved $AT_TUNE_MB MB of test traffic."
  fi
  return 0
}
at_tune_extra() { [ -n "$AT_TUNE" ] && AT_EXTRA+="${AT_EXTRA:+$'\n'}$AT_TUNE"; return 0; } # after at_to_t: the tuned lines go into the config with the rest
auto_test() { # needs read_token of an auto token (T_*); sets AT_QUIET, AT_MB, AT_SKIP; fills AR_*, AT_SECS, AT_PLAN
  local i n t0=$SECONDS kind last='' w pool=() j sc best_rate
  at_prep || return 1
  AR_OK=(); AR_DOWN=(); AR_UP=(); AR_RTT=(); AR_WHY=()
  CS_EDGES=(); CS_TOTAL=0; CS_RAN=0; AT_TUNE=''; AT_TUNE_KEYS=''
