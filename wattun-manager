      ''|*[!0-9]*) err "--pick must be best, bond, a row number of the table, or several joined with commas or + (1,3)"; return 1 ;;
      *) if [ "$NI_PICK" -ge 1 ] && [ "$NI_PICK" -le "$n" ]; then AT_SEL=("${AT_RANK[$((NI_PICK-1))]}")
         else err "--pick $NI_PICK: the table has $n working row(s)"; return 1; fi ;;
    esac
    at_to_t; return 0
  fi
  printf -v bd '%.1f' "${AR_DOWN[$best]:-0}"
  printf -v bu '%.1f' "${AR_UP[$best]:-0}"
  echo
  printf '  %s  Use #1 %s(%s · %s / %s MB/s)%s\n' "$(key_label Enter)" "$GRY" "${AV_LABEL[$best]}" "$bd" "$bu" "$RST"
  if [ "${#bond[@]}" -ge 2 ]; then
    printf '  %s      Bond all %d direct carriers %s(failover + aggregate)%s\n' "$(key_label b)" "${#bond[@]}" "$GRY" "$RST"
  elif [ "${#rbond[@]}" -ge 2 ]; then
    printf '  %s      Bond all %d reverse carriers %s(failover + aggregate)%s\n' "$(key_label b)" "${#rbond[@]}" "$GRY" "$RST"
  fi
  local opts=()
  [ "$n" -gt 1 ] && opts+=("1-$n" "pick row")
  [ "$n" -gt 1 ] && [ "$can_join" = 1 ] && opts+=("c" "custom join")
  at_failed >/dev/null && opts+=("f" "force failed")
  opts+=("q" "cancel")
  menu_line "${opts[@]}"
  while :; do
    printf '  %s?%s Choice %s[Enter]%s %s›%s ' "$CYN" "$RST" "$GRY" "$RST" "$GRY" "$RST"
    key_read
    case "$KEY" in
      enter) AT_SEL=("$best") ;;
      b|B)
        if [ "${#bond[@]}" -ge 2 ]; then AT_SEL=("${bond[@]}")
        elif [ "${#rbond[@]}" -ge 2 ]; then AT_SEL=("${rbond[@]}")
        else echo; warn "Bonding needs two or more working direct or reverse carriers."; continue; fi ;;
      c|C)
        if [ "$can_join" != 1 ]; then
          echo; warn "Joining needs at least two compatible direct rows or two reverse rows."; continue
        fi
        echo; at_custom || continue ;;
      f|F) echo; at_force || continue ;;
      [1-9]) num=$KEY
         if [ "$n" -gt 9 ]; then printf '%s' "$KEY"; IFS= read -r -t 5 rest || true; num="$KEY$rest"; fi
         if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "$n" ]; then AT_SEL=("${AT_RANK[$((num-1))]}")
         else echo; warn "No row $num."; continue; fi ;;
      q|Q|esc) echo; return 1 ;;
      *) echo; warn "Press Enter, b, c, f, a row number or q."; continue ;;
    esac
    case "$KEY" in c|C|f|F) ;; *) echo ;; esac
    at_to_t || continue
    return 0
  done
