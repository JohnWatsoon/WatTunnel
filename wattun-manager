  [ "${#AT_SEL[@]}" -ge 1 ] || { err "Enter at least one row number."; return 1; }
  [ "${#AT_SEL[@]}" -eq 1 ] && return 0
  for i in "${AT_SEL[@]}"; do
    case "${AV_CAR[$i]}" in *+*) err "${AV_LABEL[$i]} is already a joined bond; pick individual rows to join."; return 1 ;; esac
    if av_anti "$i"; then err "${AV_LABEL[$i]} is an anti-censor variant; it cannot be joined with others. Pick it alone."; return 1; fi
    if [ "${AV_KIND[$i]}" = r ]; then has_r=1; else has_d=1; fi
    c=${AV_CAR[$i]}
    case "$cars" in *" $c "*) err "Two rows use $c; a joined tunnel can use each type once."; return 1 ;; esac
    cars+="$c "
  done
  if [ "$has_r" = 1 ] && [ "$has_d" = 1 ]; then
    at_joinable_summary
    err "Cannot mix direct and reverse rows in one tunnel.${AT_JD:+ Direct rows: $AT_JD.}${AT_JR:+ Reverse rows: $AT_JR.}"
    return 1
  fi
  v_carrier_list "$(printf '%s' "${cars# }" | tr ' ' '+')" || return 1 # B4: a shaped row cannot be joined
}
at_custom() { # interactive: choose rows to join -> AT_SEL
