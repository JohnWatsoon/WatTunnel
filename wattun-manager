status_all() { # plain, scriptable list
  local n any=0
  for n in $(listed_tunnels); do any=1; status_row "$n"; done
  [ "$any" = 1 ] || { warn "No tunnels yet. Start with Kharej: run $SELF and press n."; return 1; }
}
status_row() {
  local n=$1 r cr load
  r=$(role "$n"); cr=$(carrier_label "$n"); tinfo "$n"; state_cell "$r" "$TI_STATE"
  load=''; [ "$TI_STATE" != stopped ] && { [ "$r" = Kharej ] && load="clients $TI_SESS" || load="streams $TI_STREAMS"; }
  printf '  %-12s %-6s %-5s %s%s %-12s%s %-6s %-11s %s\n' "${n:0:12}" "$r" "$cr" "$SC_COL" "$SC_DOT" "${SC_TXT^^}" "$RST" \
    "$([ "$TI_STATE" = up ] && printf '%.0fms' "$TI_RTT" || echo -)" "$load" "$(ports_summary "$n" 17)"
}
tunnel_card() {
  local n=$1 r cr peer lis par sub='' srv_act srv_up srv_en routing_txt c k x
  r=$(role "$n"); cr=$(cfg "$n" carrier); peer=$(cfg "$n" peer); lis=$(cfg "$n" listen)
  par=$(companion_of "$n")
  tinfo "$n"; state_cell "$r" "$TI_STATE"
  srv_act=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null || echo inactive)
  srv_up=$(uptime_of "$n")
  srv_en=$(systemctl is-enabled "${WAT_PREFIX}@$n" 2>/dev/null | head -1)

  if [ "$r" = Kharej ]; then routing_txt="$(kv allows "$(ports_summary "$n" 26)")"; else routing_txt="$(kv ports "$(ports_summary "$n" 26)")"; fi
  box_top "${par:+reverse side of $par}"

  local boot='not started at boot'; [ "$srv_en" = enabled ] && boot='starts at boot'
  # state lives in the page header; the card keeps the detail that is not repeated there
  [ -n "$TI_WHY" ] && box_row "${SC_COL}${TI_WHY}${RST}"
  if [ "$srv_act" = active ]; then box_row "${GRY}service running${srv_up:+ for $srv_up} · $boot${RST}"
  else box_row "${GRY}service $srv_act · $boot${RST}"; fi
  if is_auto_kharej "$n"; then
    auto_live "$n"; c=$(echo $AN_D ${AN_R:+r:$AN_R}); c=${c// /+}; x=$(cfg "$n" carrier | tr '+' ' ' | wc -w)
    if [ -n "$c" ]; then k="picked by Iran"; else k="$x open"; fi
    row_2col "$(kv carrier "${c:-auto} ${GRY}($k)${RST}")" "$routing_txt"
  elif [ -n "$par" ] && [ "$TI_STATE" = up ] && [ -n "$TI_LIVE" ]; then row_2col "$(kv carrier "$TI_LIVE ${GRY}(picked by Iran)${RST}")" "$routing_txt"
  elif [ -n "$par" ]; then row_2col "$(kv carrier "auto ${GRY}($(wc -w <<<"${cr//+/ }") types open)${RST}")" "$routing_txt"
  else row_2col "$(kv carrier "$cr")" "$routing_txt"; fi

  # Sub-role details
  if [ -n "$par" ]; then
    box_row "$(kv reverse "auto, to Iran $(cfg "$n" peer-icmp)")"
  elif is_auto_kharej "$n"; then
    if [ -f "$CONF/$n-r.yml" ]; then sub="reverse side: $n-r (Iran $(cfg "$n-r" peer-icmp))"
    elif systemctl is-active -q "${WAT_PREFIX}-autowatch-$n.service" 2>/dev/null; then sub="waiting for Iran to connect"
    else sub="Iran's IP not known: $SELF auto-ip $n IRAN_IP"; fi
    [ -f "$CONF/$n-r.yml" ] || [ -n "$AN_D$AN_R" ] || box_row "$(kv auto "$sub")"
    if [ -n "$AN_D$AN_R" ]; then
      c=$(cfg "$n" carrier); c=${c//+/ }; x=0; for k in $c; do case " $AN_D " in *" $k "*) ;; *) x=$((x+1)) ;; esac; done
      [ "$x" -gt 0 ] && box_row "$(kv unused "$x types still open ${GRY}(u closes them)${RST}")"
    fi
  elif [ "$cr" = icmp ] && is_reverse "$n"; then
    if [ "$r" = Iran ]; then box_row "$(kv reverse "pinged by ${peer:--}")"; else box_row "$(kv reverse "pings Iran ${peer:--}")"; fi
  elif is_rpool "$cr" && is_reverse "$n"; then
    if [ "$r" = Iran ]; then box_row "$(kv reverse "Kharej connects on ${lis:-:-}")"; else box_row "$(kv reverse "connects to Iran ${peer:--}")"; fi
  elif [ "$r" = Iran ]; then
    box_row "$(kv Kharej "${peer:--}")"
  else
    [ -n "$lis" ] && box_row "$(kv listen "$lis")"
  fi
  if [ "$r" = Iran ] && [ "$(uname -s)" = Linux ] && ! { is_rpool "$cr" && is_reverse "$n"; }; then
    local oip nips; oip=$(cfg "$n" src-ip); nips=$(local_ips | wc -l)
    if [ -n "$oip" ]; then box_row "$(kv source "$oip ${GRY}(src-ip)${RST}")"
    elif [ -n "$(out_ip "${peer%%[:,]*}")" ]; then
      box_row "$(kv source "$(out_ip "${peer%%[:,]*}")$([ "$nips" -gt 1 ] && echo "${GRY} · $nips IPs here, src-ip picks one${RST}")")"
    fi
  fi

  sub=$(cdn_summary "$n"); [ -n "$sub" ] && box_row "$(kv cdn "$sub")"
  if ac_dialer "$n"; then
    local fks=$(cfg "$n" fake-sni) gov=$(cfg "$n" governor) rot=$(cfg "$n" pool-rotate) dl=$(cfg "$n" dns-listen)
    if [ -n "$fks" ] || [ "$gov" = true ] || [ -n "$rot" ] || [ -n "$dl" ]; then
      box_row "$(kv anti-censor "${GRN}on${RST} · $(detect_preset "$n")${fks:+ · fake-sni $fks}${dl:+ · dns $dl}")"
    else
      box_row "$(kv anti-censor off)"
    fi
  elif [ "$(uname -s)" = Linux ] && is_pool_list "$(cfg "$n" carrier)" && is_reverse "$n"; then
    box_row "$(kv anti-censor "${GRY}set on the Kharej side (reverse)${RST}")"
  fi
  local bmode=$(cfg "$n" bond-mode)
  [ -n "$bmode" ] && box_row "$(kv bond "$bmode")"
  if [ -f "$CONF/$n.sla" ]; then
    local min_r=$(grep '^sla_min_rate_kbps=' "$CONF/$n.sla" 2>/dev/null | cut -d= -f2)
    local max_rtt=$(grep '^sla_max_rtt_ms=' "$CONF/$n.sla" 2>/dev/null | cut -d= -f2)
    local max_l=$(grep '^sla_max_loss_pct=' "$CONF/$n.sla" 2>/dev/null | cut -d= -f2)
    box_row "$(kv sla "rate ≥ ${min_r:-0} kbps · rtt ≤ ${max_rtt:-0} ms · loss ≤ ${max_l:-0} %")"
  fi

  # Section 2: Real-time telemetry (when not stopped)
  if [ "$TI_STATE" != stopped ]; then
    box_mid
    local uf; uf=$(jget "$TI_RAW" dgram_flows)
    if [ "$TI_STATE" = up ] || [ "$TI_STATE" = degraded ]; then
      local rt mr; printf -v rt '%.0f' "$TI_RTT"; printf -v mr '%.0f' "$(jget "$TI_RAW" min_rtt_ms)"
      if [ "$rt" = "$mr" ]; then rt="$rt ms"; else rt="$rt ms ${GRY}min $mr${RST}"; fi
      row_2col "$(kv rtt "$rt")" "$(kv streams "$TI_STREAMS")"
      row_2col "$(kv total "↓$(human "$TI_IN")  ↑$(human "$TI_OUT")")" "$(kv sessions "$TI_SESS")"
      if has_dgram "$TI_LIVE"; then row_2col "$(kv loss "$(printf '%.1f' "$(jget "$TI_RAW" loss_pct)") %")" "$([ "${uf:-0}" -gt 0 ] 2>/dev/null && kv 'udp flows' "$uf")"
      elif [ "${uf:-0}" -gt 0 ] 2>/dev/null; then box_row "$(kv 'udp flows' "$uf")"; fi
    else
      if [ -n "$TI_WHY" ]; then :
      elif [ "$r" = Kharej ]; then box_row "${GRY}no link yet, waiting for Iran to connect${RST}"; else box_row "${GRY}no link yet, d runs a diagnosis${RST}"; fi
      [ "${TI_IN%.*}" -gt 0 ] 2>/dev/null && box_row "$(kv total "↓$(human "$TI_IN")  ↑$(human "$TI_OUT")")"
    fi
    # one row per carrier of a bond; an auto side lists only what Iran uses, and nothing when that is one type
    if [ "$TI_CAR_COUNT" -gt 1 ] && { [ "$TI_AUTO" = 0 ] || [ "$TI_LIVE" != "${TI_LIVE//+/}" ]; }; then
      box_mid
      local ci ccol cdot ctxt det
      for ((ci=0; ci<TI_CAR_COUNT; ci++)); do
        det=''
        if [ "${CAR_MUTED[$ci]}" = true ]; then ccol=$GRY; cdot='○'; ctxt=muted
        elif [ "${CAR_ALIVE[$ci]}" = true ]; then
          ccol=$GRN; cdot='●'; ctxt=up
          det="$(printf '%.0f' "${CAR_RTT[$ci]:-0}") ms · $(awk -v sh="${CAR_SHARE[$ci]:-0}" 'BEGIN{printf "%.0f", sh*100}') % of traffic"
          has_dgram "${CAR_NAME[$ci]}" && det+=" · loss $(awk -v l="${CAR_LOSS[$ci]:-0}" 'BEGIN{printf "%.1f", l*100}') %"
        else
          [ "$TI_AUTO" = 1 ] && continue
          ccol=$RED; cdot='○'; ctxt=down
        fi
        box_row "$(printf '%s%s %-5s%s %-6s %s%s%s' "$ccol" "$cdot" "$ctxt" "$RST" "${CAR_NAME[$ci]}" "$GRY" "$det" "$RST")"
      done
    fi
  fi
  box_bot
}
show_token() {
  if [ -f "$CONF/$1.token" ]; then refresh_token "$1"; printf '%s%s%s\n' "$BOLD$YEL" "$(cat "$CONF/$1.token")" "$RST"
  else err "No token stored for '$1' (tokens exist only on Kharej tunnels)."; return 1; fi
  warn "The token contains the key. Share it only over a private channel."
}
edit_ports() { # name
  local n=$1 r old=() it i pub=() before par
  par=$(companion_of "$n"); [ -n "$par" ] && { hint "$n is the reverse side of $par: editing the ports of $par."; n=$par; }
  r=$(role "$n")
  load_maps "$n"; old=("${MAPS[@]+"${MAPS[@]}"}")
  PE_ROLE=$r; PE_TUNNEL=$n; PE_ALLOW=(); PE_OWNED=(); PE_MSG=''
  for it in ${old[@]+"${old[@]}"}; do PE_OWNED+=("$(spec_L "$it")/$(spec_P "$it")"); done
  systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null || PE_OWNED=()
  port_editor || { warn "No changes saved."; return 0; }
  write_ports "$n" || { err "Could not write the config."; return 1; }
  [ "$r" = Kharej ] && refresh_token "$n"
  [ "$r" = Kharej ] && [ -f "$CONF/$n-r.yml" ] && is_auto_kharej "$n" && write_ports "$n-r"
  ok "Saved: $(ports_summary "$n" 60)"
  hint "Applied within 3 seconds, no restart, no dropped users."
  if [ "$r" = Iran ]; then
    before=" ${PE_OWNED[*]-} "
    for ((i=0; i<${#MAPS[@]}; i++)); do
      it="$(spec_L "${MAPS[$i]}")/$(spec_P "${MAPS[$i]}")"
      case "$before" in *" $it "*) ;; *) pub+=("$it") ;; esac
    done
    [ "${#pub[@]}" -gt 0 ] && fw_open "${pub[*]}"
    hint "On Kharej, make sure the target ports are allowed (or its allowed list is empty)."
  else
    warn "The token was updated with the new allowed ports. Iran servers already connected keep working."
  fi
}
change_peer() {
  local n=$1 r cr old v op np
  r=$(role "$n"); cr=$(cfg "$n" carrier); old=$(cfg "$n" peer)
  if is_reverse "$n"; then
    if [ "$r" = Kharej ]; then
      # reverse: this server dials Iran, so its peer is the address that must be repointed here
      if [ "$cr" = icmp ]; then ask_ok "New Iran address (IPv4)" "${old%%:*}" v_ipv4 || return 1
      else ask_ok "New Iran address (host or host:port)" "$old" v_host || return 1; fi
      v=$REPLY_V
      if [ "$cr" != icmp ] && [[ "$v" != *:* ]] && [ "${old##*:}" != "$old" ]; then
        v="$v:${old##*:}"
      fi
      set_value "$n" peer "$v"
      step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n" || return 1
      wait_link "$n" 20 && ok "CONNECTED (RTT ${LINK_RTT} ms)" || warn "Not connected yet."
      [ "$cr" != icmp ] && hint "If the carrier port changed too, set the same listen port on Iran (tunnel page, h)."
      return 0
    fi
    # reverse on Iran: this server is the listener, so only its own port is local
    [ "$cr" = icmp ] && { hint "Reverse ICMP has no port to change: this server only answers ping."; return 0; }
    ask_ok "New carrier listen port on this server (the same port on Kharej)" "${old##*:}" v_port || return 1
    np=$((10#$REPLY_V))
    if listen_blocked "$(rproto "$cr")" "$np" && [ "$np" != "${old##*:}" ]; then
      err "Port $np/$(rproto "$cr") is already in use here by $(listen_conflict_desc "$(rproto "$cr")" "$np")."; return 1
    fi
    set_value "$n" listen "\":$np\""
    case "$old" in *:*) set_value "$n" peer "${old%:*}:$np" ;; esac
    fw_open "$np/$(rproto "$cr")"
    step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n" || return 1
    wait_link "$n" 20 && ok "CONNECTED (RTT ${LINK_RTT} ms)" || warn "Not connected yet."
    hint "On Kharej set the same port as its peer target (tunnel page, h)."
    return 0
  fi
  # normal: Iran dials Kharej
  ask_ok "New Kharej address (host or host:port)" "$old" v_host || return 1
  v=$REPLY_V
  if is_raw_carrier "$cr"; then # raw-IP carriers take a bare host; a typed port would break the raw socket
    case "$v" in *:*) op=${v##*:}; v_port "$op" >/dev/null 2>&1 && { v=${v%:*}; hint "Raw-IP carrier: dropped the port, the peer is a bare address."; } ;; esac
  else
    op=${old##*:}; [ "$op" = "$old" ] && op=''
    if [[ "$v" != *:* ]]; then
      [ -n "$op" ] || { err "This carrier needs host:port (for example example.com:443)."; return 1; }
      v="$v:$op"; hint "No port given: keeping port $op."
    fi
    v_port "${v##*:}" >/dev/null 2>&1 || { err "The Kharej address needs a valid port, like host:443."; return 1; }
    np=$((10#${v##*:}))
    v="${v%:*}:$np"
  fi
  set_value "$n" peer "$v"
  step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n" || return 1
  wait_link "$n" 20 && ok "CONNECTED (RTT ${LINK_RTT} ms)" || warn "Not connected yet."
}
change_key() {
  local n=$1 k t u
  if [ "$(role "$n")" = Kharej ]; then
    warn "Every Iran server on this tunnel disconnects until it gets the new token."
    confirm "Make a new key and token?" n || return 0
    k=$(new_key); ( umask 077; printf '%s\n' "$k" >"$CONF/$n.key" )
    if [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")"; then
      make_token "$T_CARRIER" "$T_PEER" "$k" "$T_PATH" "$T_SNI" "$T_ICMP" "$T_PORTS" "$T_REV" "$T_AUTO" >"$CONF/$n.token"
    fi
    step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
    [ -f "$CONF/$n-r.yml" ] && is_auto_kharej "$n" && step "Restarting ${WAT_PREFIX}@$n-r" systemctl restart "${WAT_PREFIX}@$n-r"
    # H3 (2026-11-04): hidden shaped listeners read key-file only at startup; without a restart they keep accepting the
    # old key (and cannot be reached with the new token). Disabled units are pruned on purpose: leave them closed.
    for u in $(auto_ext_names "$n"); do
      systemctl is-enabled -q "${WAT_PREFIX}@$u" 2>/dev/null || continue
      step "Restarting extended listener ${WAT_PREFIX}@$u" systemctl restart "${WAT_PREFIX}@$u"
    done
    echo; ok "New token. Paste it on each Iran server (tunnel page, t):"; echo
    show_token "$n"
  else
    local f="$CONF/$n.yml" oldrev=0 oldlisten='' oldproto='' keepres='' rport=''
    ask_ok "Token from Kharej" "" v_token || return 1
    t=$REPLY_V; read_token "$t"
    if [ "$T_CARRIER" = auto ]; then # auto token: the type is chosen by testing, so test now and apply the winner
      local oldkey oldauto=0
      [ -f "$CONF/$n.auto" ] && oldauto=1
      oldkey=$(cat "$CONF/$n.key" 2>/dev/null || true)
      ( umask 077; printf '%s\n' "$T_KEY" >"$CONF/$n.key" )
      ( umask 077; printf '%s\n' "$t" >"$CONF/$n.auto" ); chmod 600 "$CONF/$n.auto"
      ok "Token accepted: Kharej ${T_PEER%%[:,]*}. The running tunnel stays up while the types are tested."
      if [ "$NONINTERACTIVE" = 1 ]; then
        hint "Now pick the type that works: $SELF auto-test $n"
        return 0
      fi
      AT_APPLIED=0
      auto_test_cmd "$n" || true
      if [ "$AT_APPLIED" = 1 ]; then
        wait_link "$n" 10 && ok "Connected to the new Kharej." || warn "Switched, not connected yet. Press d to diagnose."
        return 0
      fi
      # nothing was chosen: put the old key back, or the next restart would use a key the old Kharej rejects
      [ -n "$oldkey" ] && ( umask 077; printf '%s\n' "$oldkey" >"$CONF/$n.key" )
      [ "$oldauto" = 1 ] || rm -f "$CONF/$n.auto"
      hint "Nothing changed: '$n' still uses its old Kharej."
      return 0
    fi
    v_carrier_list "$T_CARRIER" || return 1 # D7: a shaped carrier cannot be a bond leg (engine refuses it)
    if is_shaped_list "$T_CARRIER"; then # F19: the far end must run 3.3.0 too; fix the peer form before writing it
      [ "$T_REV" = 1 ] && { err "F19 shaped carriers do not support reverse."; return 1; }
      shaped_supported_here "$T_CARRIER" || return 1
      if is_shaped_carrier "$T_CARRIER"; then
        T_PEER=$(shaped_peer_for_client "$T_CARRIER" "$T_PEER")
        case "$T_PEER" in *:*) v_port "${T_PEER##*:}" || return 1 ;; esac
      fi
      shaped_warn "$T_CARRIER"
    fi
    [ "$T_REV" = 1 ] && is_rpool "$T_CARRIER" && { v_port "${T_PEER##*:}" || return 1; }
    is_reverse "$n" && oldrev=1
    if [ "$oldrev" = 1 ]; then
      oldlisten=$(cfg "$n" listen); oldlisten=${oldlisten##*:}
      is_rpool "$(cfg "$n" carrier)" && oldproto=$(rproto "$(cfg "$n" carrier)")
    fi
    if is_pool_list "$T_CARRIER" && [ "$T_REV" != 1 ]; then keepres=1; fi
    ( umask 077; printf '%s\n' "$T_KEY" >"$CONF/$n.key" )
    rm -f "$CONF/$n.auto" # a fixed token replaces the auto plan; a stale one would let heal retest and switch it back
    # the token decides how the pair connects; drop every stale field instead of leaving a mismatch
    sed -i -E '/^(carrier|peer|path|udp-dns|sni|host|icmp-type|reverse|listen|peer-[a-z0-9]+|listen-[a-z0-9]+):/d' "$f"
    [ "$keepres" = 1 ] || sed -i -E '/^(fake-(sni|mode|ttl)|pool-rotate(-bytes)?|fp|ech|ech-cache|tls-frag):/d' "$f"
    set_value "$n" carrier "$T_CARRIER"
    set_value "$n" peer "$T_PEER"
    if [ "$T_CARRIER" = udp ] && [ "$T_PATH" = dns ]; then set_value "$n" udp-dns true
    elif [ -n "$T_PATH" ]; then set_value "$n" path "$T_PATH"; fi
    if [ -n "$T_SNI" ]; then set_value "$n" sni "$T_SNI"; set_value "$n" host "$T_SNI"; fi
    [ -n "$T_ICMP" ] && [ "$T_ICMP" != echo ] && set_value "$n" icmp-type "$T_ICMP"
    if [ "$T_REV" = 1 ]; then
      set_value "$n" reverse true
      is_rpool "$T_CARRIER" && { rport=${T_PEER##*:}; set_value "$n" listen "\":$((10#${rport}))\""; }
    fi
    step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n" || return 1
    [ -n "$rport" ] && fw_open "$rport/$(rproto "$T_CARRIER")"
    [ "$oldrev" = 1 ] && [ -n "$oldlisten" ] && [ "$oldlisten" != "$rport" ] && fw_close "$oldlisten/$oldproto"
    [ "$T_CARRIER" = icmp ] && [ "$T_REV" = 1 ] && kreply_offer
    [ "$oldrev" = 1 ] && { [ "$T_REV" != 1 ] || [ "$T_CARRIER" != icmp ]; } && { kreply_users_left || kreply_restore; }
    wait_link "$n" 20 && ok "CONNECTED (RTT ${LINK_RTT} ms)" || warn "Not connected yet."
    # the new Kharej may allow a different set of targets: name the published rows it will refuse
    local missing='' it
    allow_to_array "$T_PORTS"
    load_maps "$n"
    for it in ${MAPS[@]+"${MAPS[@]}"}; do
      allowed_has "$(spec_T "$it")" "$(spec_P "$it")" || missing="$missing $(spec_T "$it")/$(spec_P "$it")"
    done
    [ -n "$missing" ] && warn "Kharej does not allow:${missing//\/tcp/} — those ports will be refused until you list them on Kharej (tunnel page, p)."
  fi
}
delete_tunnel() {
  local n=$1 f s p
  warn "This stops '$n' and deletes its config, key and token."
  if [ "$NONINTERACTIVE" = 1 ]; then REPLY_V=$n # --yes is the confirmation
  else ask "Type $n to delete it (Enter cancels)" ""; fi
  [ "$REPLY_V" = "$n" ] || { warn "Not deleted."; return 1; }
  state_dir_relative_warn "$n" # M8: the service resolves a relative state-dir from /; say so before resolving it
  if [ -f "$CONF/$n-r.yml" ] && is_auto_kharej "$n"; then # the auto reverse companion goes with its parent
    systemctl disable --now "${WAT_PREFIX}@$n-r" >/dev/null 2>&1
    while IFS= read -r f; do rm -f "$f"; done < <(state_files "$n-r")
    rm -f "$CONF/$n-r".yml "$CONF/$n-r".ech
    ok "Reverse side '$n-r' deleted."
  fi
  for f in $(auto_ext_names "$n"); do # B3: the hidden extended listeners belong to this tunnel too
    systemctl disable --now "${WAT_PREFIX}@$f" >/dev/null 2>&1
    p=$(cfg "$f" listen); p=${p##*:}
    [ -n "$p" ] && is_shaped_udp "$(cfg "$f" carrier)" && fw_close "$p/udp" # F17: the child's UDP rule goes with it
    while IFS= read -r s; do rm -f "$s"; done < <(state_files "$f") # F08: a child keeps its own state files
    rm -f "$CONF/$f".yml "$CONF/$f".autoext
  done
  systemctl stop "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  systemctl reset-failed "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  # H8: stop the unit BEFORE removing its state files. The engine saves quota/totals on SIGTERM (and every state-save
  # seconds), so a rm first is undone by the shutdown save and a re-created tunnel starts with the old usage.
  systemctl disable --now "${WAT_PREFIX}@$n" >/dev/null 2>&1
  while IFS= read -r f; do rm -f "$f"; done < <(state_files "$n")
  bond_retest_disable "$n" # the bond-retest timer belongs to this tunnel
  rm -f "$CONF/$n".yml "$CONF/$n".ech "$CONF/$n".key "$CONF/$n".token "$CONF/$n".auto "$RUN/$n.down" "$RUN/$n.cycles" "$RUN/$n.retest" \
        "$CONF/$n".bondretest "$CONF/$n".bondretest.tmp "$CONF/$n".bondfail "$CONF/$n".bondfail.tmp "$CONF/$n".keepopen \
        "$RUN/$n.autoprune" "$RUN/$n.autoprune.done"
  ok "Tunnel '$n' deleted."
  kreply_users_left || kreply_restore
  return 0
}
reset_traffic() { # name : zero the lifetime traffic counters (the engine keeps them across restarts)
  local n=$1 f was=0
  state_dir_relative_warn "$n" # M8: same resolver rule as delete_tunnel
  f=$(state_file "$n" totals) # F8: honour state-dir:, else the file next to the config
  systemctl is-active -q "${WAT_PREFIX}@$n" && was=1
  [ "$was" = 1 ] && systemctl stop "${WAT_PREFIX}@$n" >/dev/null 2>&1
  rm -f "$f" "$f.host" "$f.tmp"
  [ "$was" = 1 ] && systemctl start "${WAT_PREFIX}@$n" >/dev/null 2>&1
  ok "Traffic counters of '$n' start from zero."
}
# Toggle reverse ICMP on one side. Kharej keeps Iran's IP as its peer and puts the flag in the token.
set_direction() { # name
  local n=$1 r ip cr pp pr
  r=$(role "$n"); cr=$(cfg "$n" carrier); pr=$(rproto "$cr")
  reverse_hint "$cr"
  if is_rpool "$cr"; then
    if is_reverse "$n"; then
      confirm "Switch '$n' back to the normal direction (Iran connects to Kharej)?" n || return 1
      if [ "$r" = Kharej ]; then
        pp=$(cfg "$n" peer); pp=${pp##*:}
        v_port "$pp" >/dev/null 2>&1 || { err "Cannot read the carrier port from peer."; return 1; }
        set_value "$n" listen "\":$pp\""
        unset_value "$n" peer; unset_value "$n" sni; unset_value "$n" host
        fw_open "$pp/$pr"
      else
        unset_value "$n" listen
      fi
      unset_value "$n" reverse
    else
      confirm "Switch '$n' to reverse (Kharej connects out to Iran)?" n || return 1
      if [ "$r" = Kharej ]; then
        pp=$(cfg "$n" listen); pp=${pp##*:}
        v_port "$pp" >/dev/null 2>&1 || { err "Cannot read the carrier port from listen."; return 1; }
        ask_ok "Iran server IPv4 address" "" v_ipv4 || return 1; ip=$REPLY_V
        set_value "$n" peer "$ip:$pp"
        [ "$cr" = udp ] || unset_value "$n" listen # reverse udp keeps it: the source port of the punches
        if [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")" && [ -n "$T_SNI" ]; then
          set_value "$n" sni "$T_SNI"; set_value "$n" host "$T_SNI"
        fi
      else
        pp=$(cfg "$n" peer); pp=${pp##*:}
        v_port "$pp" >/dev/null 2>&1 && [ "$pp" != "$(cfg "$n" peer)" ] || { err "The peer has no carrier port, so reverse cannot be set up."; return 1; }
        pp=$((10#$pp))
        if listen_blocked "$pr" "$pp"; then err "Port $pp/$pr is already in use here by $(listen_conflict_desc "$pr" "$pp")."; return 1; fi
        set_value "$n" listen "\":$pp\""
        fw_open "$pp/$pr"
      fi
      set_value "$n" reverse true
      local ofm; ofm=$(cfg "$n" fake-mode)
      case "$ofm" in sum|seqsum)
        set_value "$n" fake-mode rst; warn "fake-mode $ofm changed to rst: checksum markers are refused on a reverse tunnel." ;;
      esac
    fi
  elif is_reverse "$n"; then
    confirm "Switch '$n' back to the normal direction (Iran sends the pings)?" n || return 1
    unset_value "$n" reverse
    [ "$r" = Kharej ] && unset_value "$n" peer
  else
    confirm "Switch '$n' to reverse (Kharej sends the pings)?" n || return 1
    if [ "$r" = Kharej ]; then
      ask_ok "Iran server IPv4 address" "" v_ipv4 || return 1; ip=$REPLY_V
      set_value "$n" peer "$ip"
    fi
    set_value "$n" reverse true
  fi
  if [ "$cr" = icmp ]; then
    if kreply_wanted "$n"; then kreply_offer; else kreply_users_left || kreply_restore; fi
  fi
  if [ "$r" = Kharej ] && [ -f "$CONF/$n.token" ] && read_token "$(cat "$CONF/$n.token")"; then
    T_REV=''; is_reverse "$n" && T_REV=1
    make_token "$T_CARRIER" "$T_PEER" "$T_KEY" "$T_PATH" "$T_SNI" "$T_ICMP" "$T_PORTS" "$T_REV" "$T_AUTO" >"$CONF/$n.token"
  fi
  warn "Change it on the $([ "$r" = Kharej ] && echo Iran || echo Kharej) server too (Advanced, d), or the link stays down."
  return 0
}
