    printf '  testing %s ...\n' "$lbl"
  elif [ "$IS_TTY" = 1 ]; then
    if [ "${AT_TOTAL:-0}" -gt 0 ]; then printf '  [%d/%d] Testing %s ...' "$AT_IDX" "$AT_TOTAL" "$lbl"
    else printf '  testing %s ...' "$lbl"; fi
  fi
  return 0
}
at_idle() { if [ "$ANIM" = 1 ]; then spin_stop; elif [ "$IS_TTY" = 1 ]; then printf '\r\e[K'; fi; return 0; }
at_print() {
