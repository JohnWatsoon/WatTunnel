  [ "$(wc -w <<<"$AT_JR")" -ge 2 ] && s="${s:+$s  ·  }Reverse: $AT_JR"
  [ -n "$s" ] && hint "$s (cannot mix)"
  ask "Join rows (e.g. 1+3, Enter = cancel)" ""
  [ -n "$REPLY_V" ] || return 1
  at_rows "$REPLY_V"
