# ---- boxes ----
BOXW=74
box_top() { # [title]
  if [ -z "${1:-}" ]; then printf '  %s╭%s╮%s\n' "$GRY" "$(rep ─ "$BOXW")" "$RST"; return 0; fi
  printf '  %s╭─ %s%s%s %s╮%s\n' "$GRY" "$RST" "$1" "$GRY" "$(rep ─ $((BOXW-${#1}-3)))" "$RST"
}
box_mid() { printf '  %s├%s┤%s\n' "$GRY" "$(rep ─ "$BOXW")" "$RST"; }
box_row() { # a row never pushes the right border out: a longer one is cut to the box (and loses its colors)
  local t=$1 pad; vlen "$t"
  if [ "$VLEN" -gt $((BOXW-2)) ]; then t=$(strip_ansi "$t"); t="${t:0:$((BOXW-3))}…"; VLEN=$((BOXW-2)); fi
  pad=$((BOXW-2-VLEN)); printf '  %s│%s %s%*s %s│%s\n' "$GRY" "$RST" "$t" "$pad" '' "$GRY" "$RST"
}
row_2col() {
  local left=$1 right=$2 w_left=36 pad
  vlen "$left"
  pad=$((w_left - VLEN))
  [ "$pad" -lt 0 ] && pad=0
  box_row "${left}$(rep ' ' "$pad")  ${right}"
}
