at_rows() { # "1 3 4", "1,3,4" or "1+3+4" (rows of the table) -> AT_SEL ; rc 1 with a message when a row is unusable
  local norm=${1//[,+;]/ } r i c seen=' ' cars=' ' has_r=0 has_d=0
