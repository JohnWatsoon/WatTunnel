          "$GRN" "$RST" "$(at_lbl "${AV_LABEL[$i]}" 24)" "$BOLD" "${AR_DOWN[$i]:-0}" "$RST" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}" "$(tbar "$pk" "$AT_PEAK" 10)"
      else
