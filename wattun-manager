# ---- spinner / progress ----
SPIN_FR=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
spin_start() { # label : animate a spinner on the current line until spin_stop (foreground work continues)
  [ "$ANIM" = 1 ] || return 0
  cur_hide
  (
    local i=0 t0=$SECONDS
    while :; do
      printf '\r\e[K  %s%s%s %s %s(%ds)%s' "$CYN" "${SPIN_FR[$i]}" "$RST" "$1" "$GRY" $((SECONDS-t0)) "$RST"
      i=$(( (i+1) % 10 )); sleep 0.1
    done
  ) &
  SPIN_PID=$!
}
spin_stop() { kill_spin; [ "$ANIM" = 1 ] && { printf '\r\e[K'; cur_show; }; return 0; }
step() { # label cmd... : run silently under a spinner, print a done/failed line
  local label=$1 rc; shift
  [ -n "$LOGF" ] || LOGF=$(mktemp /tmp/wattun-manager.XXXXXX)
  : >"$LOGF"
  spin_start "$label"
  "$@" >>"$LOGF" 2>&1; rc=$?
  spin_stop
  if [ "$rc" -eq 0 ]; then ok "$label"; else err "$label"; tail -n 3 "$LOGF" 2>/dev/null | sed "s/^/      $GRY/; s/\$/$RST/"; fi
  return "$rc"
}
bar() { # cur max width -> [████░░░░]
  local c=$1 m=$2 w=${3:-20} f
  [ "$m" -gt 0 ] || m=1; [ "$c" -gt "$m" ] && c=$m
  f=$(( c * w / m ))
  printf '%s%s%s' "$(rep █ "$f")" "$GRY" "$(rep ░ $((w-f)))$RST"
}

celebrate() { ok "$1"; }

# ---- input ----
# shellcheck disable=SC2120
key_read() { # [timeout] -> KEY ; rc 0 key, 2 timeout ; EOF exits
  local rc k2 c i; KEY=''
  [ "$NONINTERACTIVE" = 1 ] && { KEY=enter; return 0; }
  while :; do
    if [ -n "${1:-}" ]; then IFS= read -rsn1 -t "$1" KEY; rc=$?; else IFS= read -rsn1 KEY; rc=$?; fi
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -gt 128 ] && { KEY=''; return 2; }
      eof_exit
    fi
    if [ "$KEY" = $'\e' ]; then
      # ESC followed by more bytes is an escape sequence (arrows, Home, F-keys): swallowed and read again,
      # except arrows on a page that navigates a deck (KEY_NAV=1). A lone ESC stays "esc".
      if IFS= read -rsn1 -t 0.05 k2; then
        c=''
        if [ "$k2" = '[' ] || [ "$k2" = O ]; then
          for ((i=0; i<8; i++)); do
            IFS= read -rsn1 -t 0.05 c || break
            case "$c" in [A-Za-z~@]) break ;; esac
          done
          if [ "$KEY_NAV" = 1 ]; then
            case "$c" in
              A) KEY=up; return 0 ;;
              B) KEY=down; return 0 ;;
              C) KEY=right; return 0 ;;
              D) KEY=left; return 0 ;;
            esac
          fi
        fi
        KEY=''; continue
      fi
      KEY=esc
    fi
    break
  done
  [ -z "$KEY" ] && KEY=enter
  return 0
}
ask() { # prompt [default] -> REPLY_V (free text). Enter keeps the default.
  local d=${2:-} v
  if [ "$NONINTERACTIVE" = 1 ]; then REPLY_V=$d; return 0; fi
  printf '  %s?%s %s%s %s›%s ' "$CYN" "$RST" "$1" "${d:+ ${GRY}[$d]${RST}}" "$GRY" "$RST"
  IFS= read -r v || eof_exit
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  REPLY_V=${v:-$d}
}
ask_ok() { # prompt default validator : up to 3 tries, validator prints its own error
  local t
  if [ "$NONINTERACTIVE" = 1 ]; then # the preset/default is the only answer: validate once and say what is wrong
    ask "$1" "$2"; "$3" "$REPLY_V" && return 0
    err "'$1': '$REPLY_V' is not accepted (set it with the matching command-line flag)"; return 1
  fi
  for t in 1 2 3; do
    ask "$1" "$2"
    if "$3" "$REPLY_V"; then return 0; fi
  done
  err "Too many invalid answers, going back."; return 1
}
confirm() { # prompt [y|n default]
  local def=${2:-y} t lab='Y/n'
  [ "$def" = y ] || def=n # anything but y is "no"
  [ "$def" = n ] && lab='y/N'
  if [ "$NONINTERACTIVE" = 1 ]; then
    echo "  ? $1 -> $([ "$def" = y ] && echo yes || echo no)" # the answer actually used
    [ "$def" = y ]; return
  fi
  for t in 1 2 3; do
    printf '  %s?%s %s %s[%s]%s ' "$CYN" "$RST" "$1" "$GRY" "$lab" "$RST"
    key_read
    case "$KEY" in
      y|Y) echo yes; return 0 ;;
      n|N) echo no; return 1 ;;
      enter) echo; [ "$def" = y ]; return ;;
      esc) echo; return 1 ;;
    esac
    echo
  done
  return 1
}
pause() { printf '\n  %sPress any key to go back...%s' "$GRY" "$RST"; key_read; echo; }
PMSG=''
flash() { PMSG=$*; } # shown after the next prompt caret

run_flow() { # fn args... : run in a subshell; Ctrl+C cancels just this flow
  local rc
  IN_FLOW=1
  ( trap 'kill_spin; cur_show; exit 130' INT; trap 'kill_spin; cur_show; at_cleanup' EXIT; "$@" )
  rc=$?
  IN_FLOW=0
  [ "$rc" -eq 130 ] && { echo; warn "Cancelled."; [ "$IS_TTY" = 1 ] && sleep 0.8; }
  return "$rc"
}

# ======================================================================================
#  Pure helpers: config, tokens, port specs
# ======================================================================================
tunnels() { # every *visible* tunnel: the hidden per-shape auto listeners are left out of lists/pickers (B3)
  local f b; for f in "$CONF"/*.yml; do [ -e "$f" ] || continue; b=${f##*/}; b=${b%.yml}; is_auto_ext "$b" && continue; echo "$b"; done
}
listed_tunnels() { # what a status list shows: an auto reverse side the cleanup stopped is not a tunnel of its own
  local n; for n in $(tunnels); do
    [ -n "$(companion_of "$n")" ] && ! systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null && continue
    echo "$n"
  done
}
tunnels_all() { # every config, hidden extended listeners included (delete/uninstall/heal/prune)
  local f b; for f in "$CONF"/*.yml; do [ -e "$f" ] || continue; b=${f##*/}; echo "${b%.yml}"; done
}
cfg()     { sed -n "s/^$2:[[:space:]]*//p" "$CONF/$1.yml" 2>/dev/null | head -1 | tr -d "\"'"; }
role()    { [ "$(cfg "$1" mode)" = server ] && echo Kharej || echo Iran; }
stats()   { local m; m=$(cfg "$1" metrics); [ -n "$m" ] && curl -fs --noproxy '*' --max-time 2 "http://$m/stats"; }
ms()      { printf "%.1f" "${1:-0}"; }
jget()    { grep -o "\"$2\": *[^,}]*" <<<"$1" | head -1 | sed 's/.*: *//; s/"//g'; }
jget_flat() { # json flat-key legacy-key: the flat aggregate first, fall back for older binaries
  local v; v=$(jget "$1" "$2"); [ -n "$v" ] || v=$(jget "$1" "$3"); printf '%s' "$v"
}
human()   { awk -v b="${1:-0}" 'BEGIN{s="B KB MB GB TB";split(s,u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}printf "%.1f %s",b,u[i]}'; }
ipv4_ok() { # is $1 a dotted IPv4 with every octet 0-255 ?
  local a b c d
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}; c=${BASH_REMATCH[3]}; d=${BASH_REMATCH[4]}
  [ "$((10#$a))" -le 255 ] && [ "$((10#$b))" -le 255 ] && [ "$((10#$c))" -le 255 ] && [ "$((10#$d))" -le 255 ]
}
ip_is_private() { # RFC1918, CGNAT 100.64/10, loopback, link-local
  local a b
  ipv4_ok "$1" || return 1
  a=${1%%.*}; b=${1#*.}; b=${b%%.*}; a=$((10#$a)); b=$((10#$b))
  case "$a" in 10|127) return 0 ;; esac
  [ "$a" = 172 ] && [ "$b" -ge 16 ] && [ "$b" -le 31 ] && return 0
  [ "$a" = 192 ] && [ "$b" = 168 ] && return 0
  [ "$a" = 169 ] && [ "$b" = 254 ] && return 0
  [ "$a" = 100 ] && [ "$b" -ge 64 ] && [ "$b" -le 127 ] && return 0
  return 1
}
public_ip() { # prints a valid IPv4 or nothing. A public address on an interface comes first (no third-party
  # lookup); NAT'd servers (the public IP is nowhere on the box) fall back to ipify/ifconfig.me, then to hostname -I
  local ip u
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\) .*/\1/p')
  if ipv4_ok "$ip" && ! ip_is_private "$ip"; then echo "$ip"; return 0; fi
  for u in https://api.ipify.org https://ifconfig.me; do
    ip=$(curl -fs4 --max-time 5 "$u" 2>/dev/null | tr -d '[:space:]')
    ipv4_ok "$ip" && { echo "$ip"; return 0; }
  done
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  ipv4_ok "$ip" && echo "$ip"
  return 0
}
new_key() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | head -c 40; }
rand_path() { echo "/api/$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"; } # a fresh URL path per tunnel: every install used /wat, a fixed string a filter can match (3.0.1)
uptime_of() { # name -> "3d 4h" / "2h 14m" / "5m", empty when unknown
  local t s; t=$(systemctl show "${WAT_PREFIX}@$1" -p ActiveEnterTimestamp --value 2>/dev/null)
  s=$(date -d "$t" +%s 2>/dev/null) || return 0; s=$(( $(date +%s) - s )); [ "$s" -ge 0 ] || return 0
  if [ "$s" -ge 86400 ]; then echo "$((s/86400))d $((s%86400/3600))h"
  elif [ "$s" -ge 3600 ]; then echo "$((s/3600))h $((s%3600/60))m"
  else echo "$((s/60))m"; fi
}
has_dgram() { local c; for c in ${1//+/ }; do is_pool "$c" || return 0; done; return 1; } # icmp/udp/gre/ipip in the list: the only carriers whose loss_pct is wire loss

# ---- engine state files (F8, 3.3.0): -state-dir moves the quota/totals pair, the names keep the config basename ----
# Mirrors cmd/wattun/state.go statePaths: <state-dir>/<config basename>.quota.json / .totals.json when the tunnel sets
# state-dir:, else next to the config (the 2.5.0-3.2.x location, so existing tunnels keep working). The manager only
# ever deletes these files (reset-traffic, delete, uninstall): live byte totals come from /stats, never from disk.
state_base_path() { # name state-dir -> the "<config basename>" the engine prefixes (pure; empty dir = next to the config)
  local n=$1 d=${2:-}
  if [ -n "$d" ]; then
    # the engine resolves a relative -state-dir from its working directory, which systemd sets to /; mirror that so a
    # hand-edited relative value does not make the manager delete files somewhere else
    case "$d" in /*) ;; *) d="/$d" ;; esac
    d=${d%/}
    printf '%s/%s.yml' "$d" "$n"
  else printf '%s/%s.yml' "$CONF" "$n"; fi
}
state_dir_of() { # name -> the tunnel's state-dir value (empty = engine default: next to the config)
  local d; d=$(cfg "$1" state-dir)
  printf '%s' "${d%/}"
}
state_dir_is_relative() { # name -> 0 when a hand-edited state-dir: is relative (engine CWD = / under the unit)
  local d; d=$(state_dir_of "$1")
  [ -n "$d" ] && [ "${d#/}" = "$d" ]
}
state_dir_relative_warn() { # name : M8 — say it out loud instead of silently assuming the unit's CWD (/)
  state_dir_is_relative "$1" || return 0
  warn "state-dir of '$1' is relative ($(cfg "$1" state-dir)); the service resolves it from / (the manager does the same)."
  hint "Use an absolute path (the shipped unit supports /run/wattun) so the manager and the service agree."
  return 0
}
state_base() { state_base_path "$1" "$(state_dir_of "$1")"; }
state_file() { # name totals|quota -> resolved path, exactly where the engine reads/writes it
  case "${2:-}" in totals|quota) ;; *) return 1 ;; esac
  printf '%s.%s.json' "$(state_base "$1")" "$2"
}
state_files() { # name -> every state file the engine can leave for it (delete/reset cleanup), one per line
  local b; b=$(state_base "$1")
  printf '%s\n' "$b.totals.json" "$b.totals.json.host" "$b.totals.json.tmp" "$b.quota.json" "$b.quota.json.tmp"
}

free_metrics_port() { # first free port from WAT_METRICS_BASE (default 19750, sandbox 19850); never 19700-19709 or 18990-18999
  local p=${WAT_METRICS_BASE:-} lim
  [[ "$p" =~ ^[0-9]{4,5}$ ]] || { p=19750; [ "$SANDBOX" = 1 ] && p=19850; }
  lim=$((p + 650)); [ "$lim" -le 65535 ] || lim=65535 # F25: the range follows the base; 650 ports at the default
  while [ "$p" -lt "$lim" ]; do
    if { [ "$p" -ge 19700 ] && [ "$p" -le 19709 ]; } || { [ "$p" -ge 18990 ] && [ "$p" -le 18999 ]; }; then p=$((p+1)); continue; fi
    port_busy "$p" tcp || grep -qhE "^metrics:.*:$p\"?[[:space:]]*\$" "$CONF"/*.yml 2>/dev/null || break
    p=$((p+1))
  done
  # F25: fail closed instead of returning a busy/out-of-range port. Callers then write no metrics: line.
  # shortcut: only 650 metrics ports exist, so write no metrics listener after that; widen the range if a real host hits it.
  if [ "$p" -ge "$lim" ]; then
    printf '  ! No free metrics port below %s; this tunnel gets no /stats listener (auto-heal/prune cannot read it).\n' "$lim" >&2
    return 1
  fi
  echo "$p"
}
valid_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] && [ ! -e "$CONF/$1.yml" ]; }
suggest_name() { # kharej|iran -> kharej, kharej-2, kharej-3 ...
  local base=$1 n=1 c=$1
  while [ -e "$CONF/$c.yml" ] && [ "$n" -lt 99 ]; do n=$((n+1)); c="$base-$n"; done
  echo "$c"
}

# ---- port busy / ownership ----
port_busy() { # port [tcp|udp|any] : is something listening on it on this server?
  local pr=${2:-any} f fl=-Hltnu hex files=()
  if command -v ss >/dev/null 2>&1; then
    case "$pr" in tcp) fl=-Hltn ;; udp) fl=-Hlun ;; esac
    ss "$fl" "( sport = :$1 )" 2>/dev/null | grep -q .; return
  fi
  printf -v hex '%04X' "$1"   # no ss on this system: read /proc/net directly
  case "$pr" in tcp) files=(tcp tcp6) ;; udp) files=(udp udp6) ;; *) files=(tcp tcp6 udp udp6) ;; esac
  for f in "${files[@]}"; do
    awk -v h=":$hex" -v u="${f:0:3}" 'NR>1 && substr($2, length($2)-4) == h && (u=="udp" || $4=="0A") {found=1} END{exit !found}' "/proc/net/$f" 2>/dev/null && return 0
  done
  return 1
}
port_user() { # port proto -> process name and PID or empty
  local f=-Hltnp; [ "${2:-tcp}" = udp ] && f=-Hlunp
  local line u pid
  line=$(ss "$f" "( sport = :$1 )" 2>/dev/null | grep -o 'users:(("[^"]*",pid=[0-9]*' | head -1)
  if [ -n "$line" ]; then
    u=$(echo "$line" | cut -d'"' -f2)
    pid=$(echo "$line" | grep -o 'pid=[0-9]*' | cut -d= -f2)
    if [ -n "$pid" ] && [ -n "$u" ]; then echo "$u (PID $pid)"; return; fi
    [ -n "$u" ] && { echo "$u"; return; }
  fi
  ss "$f" "( sport = :$1 )" 2>/dev/null | grep -o 'users:(("[^"]*"' | head -1 | cut -d'"' -f2
}

# ---- port specs. Canonical form: LISTEN:TARGET/proto (proto = tcp|udp) ----
NS_OUT=(); NS_ERR=''
norm_spec() { # "8443->443/udp" "443" "53/both" -> NS_OUT=(canonical...) ; rc 1 + NS_ERR on bad input
  NS_OUT=(); NS_ERR=''
  local s=$1 body proto=tcp L T
  s=${s//->/:}; s=${s//→/:}; s=${s//=>/:}; s=${s//=/:}; s=${s//[[:space:]]/}
  [ -n "$s" ] || { NS_ERR='empty entry'; return 1; }
  body=$s
  if [[ $s == */* ]]; then body=${s%%/*}; proto=${s#*/}; fi
  proto=${proto,,}
  case $proto in
    tcp|udp|both) ;;
    tcp+udp|udp+tcp|tcpudp|udptcp) proto=both ;;
    *) NS_ERR="unknown protocol '$proto' (use tcp, udp or both)"; return 1 ;;
  esac
  if [[ $body == *:*:* ]]; then NS_ERR="'$1' has too many ':'"; return 1; fi
  if [[ $body == *:* ]]; then L=${body%%:*}; T=${body##*:}; else L=$body; T=$body; fi
  if ! [[ $L =~ ^[0-9]{1,5}$ && $T =~ ^[0-9]{1,5}$ ]]; then NS_ERR="'$1' is not a port"; return 1; fi
  L=$((10#$L)); T=$((10#$T))
  if [ "$L" -lt 1 ] || [ "$L" -gt 65535 ] || [ "$T" -lt 1 ] || [ "$T" -gt 65535 ]; then NS_ERR="'$1': ports must be 1-65535"; return 1; fi
  case $proto in both) NS_OUT=("$L:$T/tcp" "$L:$T/udp") ;; *) NS_OUT=("$L:$T/$proto") ;; esac
}
spec_L() { local x=${1%%/*}; echo "${x%%:*}"; }
spec_T() { local x=${1%%/*}; echo "${x##*:}"; }
spec_P() { echo "${1##*/}"; }
spec_yaml() { # canonical -> YAML list item text (L:T only when they differ)
  local L T P out
  L=$(spec_L "$1"); T=$(spec_T "$1"); P=$(spec_P "$1")
  if [ "$L" = "$T" ]; then out=$L; else out="$L:$T"; fi
  [ "$P" = udp ] && out="$out/udp"
  echo "$out"
}
spec_human() { # canonical -> "443" / "8443→443" / "53/udp"
  local L T P out
  L=$(spec_L "$1"); T=$(spec_T "$1"); P=$(spec_P "$1")
  if [ "$L" = "$T" ]; then out=$L; else out="$L→$T"; fi
  [ "$P" = udp ] && out="$out/udp"
  echo "$out"
}
maps_yaml_block() { # prints the ports: block for the array MAPS (nothing when empty)
  local i
  [ "${#MAPS[@]}" -gt 0 ] || return 0
  echo "ports:"
  for ((i=0; i<${#MAPS[@]}; i++)); do echo "  - $(spec_yaml "${MAPS[$i]}")"; done
}
maps_allow_str() { # MAPS -> "443,53/udp" (target ports only, as embedded in the token)
  local i out='' t p
  for ((i=0; i<${#MAPS[@]}; i++)); do
    t=$(spec_T "${MAPS[$i]}"); p=$(spec_P "${MAPS[$i]}")
    [ "$p" = udp ] && t="$t/udp"
    case ",$out," in *",$t,"*) continue ;; esac
    out="${out:+$out,}$t"
  done
  echo "$out"
}
allow_to_array() { # "443,53/udp" -> PE_ALLOW=(443:443/tcp 53:53/udp)
  local it; PE_ALLOW=()
  for it in ${1//,/ }; do norm_spec "$it" && PE_ALLOW+=("${NS_OUT[@]}"); done
  return 0
}
allowed_has() { # target proto : 0 if allowed or the allow list is unknown/empty
  local i
  [ "${#PE_ALLOW[@]}" -gt 0 ] || return 0
  for ((i=0; i<${#PE_ALLOW[@]}; i++)); do
    [ "$(spec_T "${PE_ALLOW[$i]}")" = "$1" ] && [ "$(spec_P "${PE_ALLOW[$i]}")" = "$2" ] && return 0
  done
  return 1
}
yml_ports_raw() { # name -> one raw ports: item per line
  sed -n '/^ports:/,/^[^ #\t-]/{/^[[:space:]]*-[[:space:]]/{s/^[[:space:]]*-[[:space:]]*//;s/[[:space:]]*#.*//;s/["'"'"']//g;p}}' "$CONF/$1.yml" 2>/dev/null
}
yml_maps() { # name -> canonical items, one per line
  local it
  while IFS= read -r it; do [ -n "$it" ] && norm_spec "$it" && printf '%s\n' "${NS_OUT[@]}"; done < <(yml_ports_raw "$1")
}
load_maps() { # name -> MAPS
  MAPS=()
  local it
  while IFS= read -r it; do [ -n "$it" ] && MAPS+=("$it"); done < <(yml_maps "$1")
}
cfg_ports() { # legacy one-line list: "443 8443→443 53/udp"
  local it out=''
  while IFS= read -r it; do [ -n "$it" ] && out="$out $(spec_human "$it")"; done < <(yml_maps "$1")
  echo "${out# }"
}
write_ports() { # name : replace the ports: block of NAME.yml with the array MAPS
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  awk '
    /^ports:/ {skip=1; next}
    skip && /^[[:space:]]+(-|#)/ {next}
    skip && /^[[:space:]]*$/ {next}
    {skip=0; print}' "$f" >"$tmp"
  maps_yaml_block >>"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
set_value() { # name key value : set or add a top-level key
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  grep -v "^$2:" "$f" | awk -v k="$2" -v v="$3" '/^(metrics|ports):/ && !d {print k ": " v; d=1} {print} END{if(!d) print k ": " v}' >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
unset_value() { # same tmp+mv pattern as set_value: the 3 s hot-reloader must never see an interleaved rewrite
  local f="$CONF/$1.yml" tmp
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  grep -v "^$2:" "$f" >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
set_port_limit() { # name port rate quota
  local f="$CONF/$1.yml" lp=$2 lr=$3 lq=$4 tmp
  [ -f "$f" ] || return 1
  tmp=$(mktemp "$CONF/.tmp.XXXXXX") || return 1
  awk -v lp="$lp" -v lr="$lr" -v lq="$lq" '
    BEGIN { in_lim=0; wrote=0 }
    /^limits:/ { in_lim=1; print; next }
    in_lim && /^[a-zA-Z0-9_-]+:/ {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        print s
        wrote = 1
      }
      in_lim = 0
      print
      next
    }
    in_lim && $1 == "-" && $2 ~ ("^" lp "([[:space:]]|$)") {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        print s
        wrote = 1
      }
      next
    }
    { print }
    END {
      if (!wrote && ((lr != "" && lr != "0") || (lq != "" && lq != "0"))) {
        if (!in_lim) print "limits:"
        s = "  - " lp
        if (lr != "" && lr != "0") s = s " rate=" lr
        if (lq != "" && lq != "0") s = s " quota=" lq
        print s
      }
    }
  ' "$f" >"$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}

# Connection token: wat1:BASE64("carrier|peer|key|path|sni|icmp-type|allowed-ports[|reverse]")
# Field 7 (allowed ports on Kharej, comma list, empty = any) was added in 1.9.0; 6-field tokens still parse.
# Field 8 ("1" = reverse ICMP, wattun >= 2.0.0) is written only when set, so every other token stays 7 fields.
# Field 9 (auto plan) is written only for carrier "auto" tokens; field 8 stays empty there. Format:
#   d=udp:4443,tcp:4443,...;r=tcp:24431,...   d = Kharej listen ports (direct), r = ports Iran listens on during the
#   reverse test. Only ; , : = are used, never '|'. 7/8-field tokens still parse.
make_token() {
  local f; f=$(printf '%s|%s|%s|%s|%s|%s|%s' "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}")
  if [ -n "${9:-}" ]; then f="$f|${8:-}|$9"; elif [ "${8:-}" = 1 ]; then f="$f|1"; fi
  printf 'wat1:%s' "$(printf '%s' "$f" | base64 -w0)"
}
T_CARRIER=''; T_PEER=''; T_KEY=''; T_PATH=''; T_SNI=''; T_ICMP=''; T_PORTS=''; T_REV=''; T_AUTO=''
read_token() { # token -> T_CARRIER T_PEER T_KEY T_PATH T_SNI T_ICMP T_PORTS T_REV T_AUTO
  local raw
  T_CARRIER=''; T_PEER=''; T_KEY=''; T_PATH=''; T_SNI=''; T_ICMP=''; T_PORTS=''; T_REV=''; T_AUTO=''
  [[ "$1" == wat1:* ]] || return 1
  raw=$(printf '%s' "${1#wat1:}" | base64 -d 2>/dev/null) || return 1
  IFS='|' read -r T_CARRIER T_PEER T_KEY T_PATH T_SNI T_ICMP T_PORTS T_REV T_AUTO <<<"$raw"
  [ -n "$T_CARRIER" ] && [ -n "$T_PEER" ] && [ -n "$T_KEY" ]
}
is_reverse() { [ "$(cfg "$1" reverse)" = true ]; }

# The server that RECEIVES the tunnel's ICMP requests (Iran in reverse, Kharej in normal mode, echo/timestamp types):
# Linux answers every one with its own full-size copy, which doubles that server's ICMP upload (and, on Kharej, the
# ICMP volume the route sees, which has a ~30 MB/s reroute trigger). Rate-limiting the kernel's echo and timestamp
# replies (icmp_ratemask bits 0 and 14, 10 per second per sender) drops those copies and keeps ordinary pings
# answered. The tunnel's replies are raw-socket sends and are not limited. Measured on the real path: without it
# OutEchoReps = 2 x InEchos. The old values are kept and restored when the last such tunnel is gone (Kharej: 3.0.0).
KREPLY_CONF=/etc/sysctl.d/90-$WAT_PREFIX-reverse.conf
kreply_on() { [ -f "$KREPLY_CONF" ]; }
kreply_apply() {
  local mask lim
  mask=$(sysctl -n net.ipv4.icmp_ratemask 2>/dev/null) && lim=$(sysctl -n net.ipv4.icmp_ratelimit 2>/dev/null) || return 1
  [ -f "$CONF/.kreply.orig" ] || printf 'net.ipv4.icmp_ratemask = %s\nnet.ipv4.icmp_ratelimit = %s\n' "$mask" "$lim" >"$CONF/.kreply.orig"
  {
    echo "# wattun-manager: this server receives ICMP tunnel requests. The kernel's ping replies are rate-limited so it"
    echo "# stops sending a copy of every tunnel packet. Removed when no such tunnel is left."
    echo "net.ipv4.icmp_ratemask = $((mask | 1 | 16384))"
    echo "net.ipv4.icmp_ratelimit = 100"
  } >"$KREPLY_CONF"
  sysctl -q -p "$KREPLY_CONF" >/dev/null
}
kreply_restore() {
  [ -f "$KREPLY_CONF" ] || return 0
  rm -f "$KREPLY_CONF"
  [ -f "$CONF/.kreply.orig" ] && sysctl -q -p "$CONF/.kreply.orig" >/dev/null && rm -f "$CONF/.kreply.orig"
  ok "Restored the kernel's normal ping replies (no ICMP tunnel that needs it is left)."
}
kreply_wanted() { # name : this tunnel receives ICMP requests that the kernel would answer too
  [ "$(cfg "$1" carrier)" = icmp ] || return 1
  case "$(cfg "$1" icmp-type)" in ''|echo|timestamp) ;; *) return 1 ;; esac # info/mask: Linux does not answer
  if [ "$(role "$1")" = Iran ]; then is_reverse "$1"; else ! is_reverse "$1"; fi
}
kreply_users_left() {
  local n
  for n in $(tunnels); do kreply_wanted "$n" && return 0; done
  return 1
}
kreply_needed() { ! kreply_on && [ "$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null)" != 1 ]; }
kreply_offer() {
  kreply_needed || return 0
  hint "Linux here also answers every tunnel packet with a full-size copy, doubling this server's ICMP upload."
  [ "$SANDBOX" = 1 ] && warn "Sandbox: this changes GLOBAL kernel settings (net.ipv4.icmp_ratemask |= 16385, icmp_ratelimit = 100) via $KREPLY_CONF; original values saved in $CONF/.kreply.orig."
  step "Limiting the kernel's ping replies (normal pings keep working)" kreply_apply \
    && hint "Undo: remove $KREPLY_CONF and run: sysctl --system (it is also undone when the last reverse Iran tunnel is deleted)."
  return 0
}
refresh_token() { # name : keep NAME.token in step with the allowed ports in NAME.yml
  local f="$CONF/$1.token" allow
  [ -f "$f" ] && read_token "$(cat "$f")" || return 0
  load_maps "$1"; allow=$(maps_allow_str)
  [ -f "$CONF/$1-r.yml" ] && is_auto_kharej "$1" && write_ports "$1-r" # the auto reverse companion allows the same ports
  [ "$allow" = "$T_PORTS" ] && return 0
  make_token "$T_CARRIER" "$T_PEER" "$T_KEY" "$T_PATH" "$T_SNI" "$T_ICMP" "$allow" "$T_REV" "$T_AUTO" >"$f"
}

# ---- cross-tunnel conflict checks ----
tunnel_using_public() { # port proto [exclude] -> name of another Iran tunnel publishing it
  local n it
  for n in $(tunnels); do
    [ "$n" = "${3:-}" ] && continue
    [ "$(role "$n")" = Iran ] || continue
    while IFS= read -r it; do
      [ -n "$it" ] && [ "$(spec_L "$it")" = "$1" ] && [ "$(spec_P "$it")" = "$2" ] && { echo "$n"; return 0; }
    done < <(yml_maps "$n")
  done
  return 1
}
tunnel_using_listen() { # port [exclude] -> name of a tunnel (Kharej, or Iran in reverse) listening on it
  local n
  for n in $(tunnels); do
    [ "$n" = "${2:-}" ] && continue
    [[ "$(cfg "$n" listen)" == *:"$1" ]] && { echo "$n"; return 0; }
  done
  return 1
}
listen_blocked() { # proto port
  port_busy "$2" "$1" || tunnel_using_listen "$2" >/dev/null
}
listen_conflict_desc() { # proto port -> explanation string
  local proto=${1:-tcp} port=$2
  local tun u
  tun=$(tunnel_using_listen "$port")
  if [ -n "$tun" ]; then echo "tunnel '$tun'"; return; fi
  u=$(port_user "$port" "$proto")
  if [ -n "$u" ]; then echo "$u"; return; fi
  echo "another process or tunnel"
}
default_listen() { # carrier -> a free listen port; F19 UDP shapes keep their conventional port while it is free
  local base proto=tcp c sp
  sp=$(shaped_udp_port "$1")
  if [ -n "$sp" ] && ! listen_blocked udp "$sp"; then echo "$sp"; return; fi # F10: a busy conventional port falls back below
  case "$1" in ws|h2c) base=8080 ;; wss|tls|grpc|h2) base=443 ;; *) base=4443 ;; esac
  is_udp_carrier "$1" && proto=udp
  for c in "$base" 8443 2053 2083 2087 2096 $((base+1)) $((base+2)) $((base+3)); do
    listen_blocked "$proto" "$c" || { echo "$c"; return; }
  done
  echo "$base"
}

# ---- validators (print their own error, rc 1 when bad) ----
# Engine limits, kept next to the validators: a bigger value is refused or silently clamped by the engine
# (maxSessions in cmd/wattun/tunnel.go, poolMaxConns in wat/carrier_tcp.go, MinPayload/MaxPayloadHi and
# poolMaxMTU in wat/session.go + wat/carrier_tcp.go), so the manager refuses it with the real limit instead.
ENG_MAX_SESSIONS=16   # maxSessions: -sessions 1..16 (a client of one pool carrier only)
ENG_MAX_CONNS=64      # poolMaxConns: -conns is clamped to 64 per pool
ENG_MTU_MIN=256       # MinPayload: the smallest datagram the engine accepts
ENG_MTU_MAX=1400      # MaxPayloadHi: icmp/udp/gre/ipip (and any bond with one) cap -mtu here
ENG_MTU_MAX_POOL=16384 # poolMaxMTU: a tcp/tls/ws/wss/h2/h2c/grpc carrier frames up to this
# A5 (2026-11-04): stable-but-rare engine keys that stay file-only on purpose (no UI: they are set once by an expert,
# or matter only to one debugging scenario). Listed in one place, shown in the Advanced page's help line, and checked by
# test-manager's coverage test, so a new engine flag cannot silently lack a manager path.
#   debug/ping-every/udp-idle/tcp-cc/slack-ms/hedge/lanes/mem-budget/plain: diagnostics and hand-tuned internals
#   port-offset: the "second slot" of a one-server handover, set by the installer docs
#   tls-cert/tls-key: a custom certificate pair for the tls carrier (self-signed is the default)
#   header: extra request headers for the ws/wss/h2/h2c/grpc carriers (repeatable; flag.Func, no UI row)
#   keep-slow/tls-small-ch/hdr-mask/tcp-mimic/tls-pin/fake-ip/fake-split: anti-censor/diagnostic file-only keys
CFG_FILE_ONLY='debug ping-every udp-idle tcp-cc slack-ms hedge lanes mem-budget plain port-offset tls-cert tls-key header keep-slow tls-small-ch hdr-mask tcp-mimic tls-pin fake-ip fake-split'
# The server's target-port allowlist (-allow-min/-allow-max/-allow-ports/-allow-file) is reachable through the wizard's
# ports:/allowed-ports editor instead of separate rows: same data, one code path. The coverage test excludes these four.
CFG_PORTS_UI='allow-min allow-max allow-ports allow-file'
mtu_max_for() { # carrier list -> largest mtu the engine will not clamp for it (a bond merges to its smallest leg)
  local c hi leg
  [ -n "$1" ] || { echo "$ENG_MTU_MAX"; return 0; }
  hi=$ENG_MTU_MAX_POOL
  for c in ${1//+/ }; do
    case "$c" in tcp|tls|ws|wss|h2|h2c|grpc) leg=$ENG_MTU_MAX_POOL ;; *) leg=$ENG_MTU_MAX ;; esac
    leg=$(shaped_raw_mtu "$c" "$leg") # F19 raw shapes: 1400 minus their IP protocol header (M1/M15)
    leg=$(shaped_udp_mtu "$c" "$leg") # F19 UDP shapes carry a fixed header: their ceiling is below 1400
    [ "$leg" -lt "$hi" ] && hi=$leg
  done
  echo "$hi"
}
sessions_carrier_ok() { # carrier list -> 0 when the engine accepts -sessions > 1 (one udp/pool carrier, not a bond)
  case "${1:-}" in *+*) return 1 ;; esac
  case "${1:-}" in udp|tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac
  return 1
}
v_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$1))" -ge 1 ] && [ "$((10#$1))" -le 65535 ] && return 0; err "Enter a port between 1 and 65535."; return 1; }
v_name() {
  [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || { err "Use 1-32 letters, digits, - or _."; return 1; }
  [ ! -e "$CONF/$1.yml" ] || { err "A tunnel named '$1' already exists."; return 1; }
}
v_host() { [[ "$1" =~ ^[A-Za-z0-9._:-]{1,253}$ ]] && return 0; err "Enter an IP address or a domain name."; return 1; }
v_ipv4() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && return 0; err "Enter the server's IPv4 address, such as 198.51.100.20."; return 1; }
is_pool() { case "$1" in tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac; return 1; }
is_pool_list() { local c; for c in ${1//+/ }; do is_pool "$c" && return 0; done; return 1; }
has_ech_list() { local c; for c in ${1//+/ }; do case "$c" in tls|wss|h2|grpc) return 0 ;; esac; done; return 1; }
undisguised_legs() { local c out=''; for c in ${1//+/ }; do is_pool "$c" || out="${out:+$out }$c"; done; echo "$out"; }
carrier_ok() { # single carrier name, including the F19 shaped tier (3.3.0)
  case "$1" in
    icmp|udp|tcp|tls|ws|wss|h2|h2c|grpc|gre|ipip) return 0 ;;
    sit|6to4|xfrm-ipsec|etherip|l2tpv3) return 0 ;;
    fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) return 0 ;;
  esac
  return 1
}
# B2 (2026-11-04): the oldest engine that can run a carrier at all. Auto itself needs 2.1.0; gre/ipip arrived in 3.2.0;
# the 13 shaped carriers are 3.3.0-only on both ends. Used by the Kharej plan writer and the Iran variant builder, so an
# old engine never receives a carrier it cannot start or test.
carrier_min_ver() {
  case "$1" in
    gre|ipip) echo 3.2.0 ;;
    sit|6to4|xfrm-ipsec|etherip|l2tpv3|fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) echo 3.3.0 ;;
    *) echo 2.1.0 ;;
  esac
}
carrier_ok_here() { [ -n "$(bin_ver_ok "$(carrier_min_ver "$1")")" ]; }
# F19 (3.3.0): wattun-internal wire shapes. Raw tier: bare-IP peer on a raw socket like icmp/gre, IP protocols
# 41/41/50/97/115, no -listen and no -reverse, one session, Linux + root/CAP_NET_RAW. UDP tier: the udp carrier with a
# fixed per-protocol header and conventional port (peer/listen, explicit port wins), no -reverse, one session. Both
# ends must run 3.3.0 with the same name; they do NOT talk to the real protocol. Kept in sync with cmd/wattun/main.go
# and wat/udpshape.go (port table).
SHAPED_RAW='sit 6to4 xfrm-ipsec etherip l2tpv3'
SHAPED_UDP='fou-gre gue-ipip vxlan geneve dnscrypt-udp ntp-direct openvpn-dco srtp-direct'
is_shaped_raw() { case " $SHAPED_RAW " in *" $1 "*) return 0 ;; esac; return 1; }
is_shaped_udp() { case " $SHAPED_UDP " in *" $1 "*) return 0 ;; esac; return 1; }
is_shaped_carrier() { is_shaped_raw "$1" || is_shaped_udp "$1"; }
is_shaped_list() { local c; for c in ${1//+/ }; do is_shaped_carrier "$c" && return 0; done; return 1; }
is_raw_carrier() { case "$1" in icmp|gre|ipip) return 0 ;; esac; is_shaped_raw "$1"; }
is_udp_carrier() { [ "$1" = udp ] || is_shaped_udp "$1"; }
carrier_has_listen() { ! is_raw_carrier "$1"; }
carrier_write_listen() { # carrier list -> 0 when the config needs a global listen: key (single raw shape: no listen)
  local c
  case "$1" in
    *+*) for c in ${1//+/ }; do case "$c" in udp|tcp|tls|ws|wss|h2|h2c|grpc) return 0 ;; esac; done; return 1 ;;
    *) carrier_has_listen "$1" ;;
  esac
}
shaped_udp_port() { # F19 UDP-shaped carrier -> its conventional UDP port (the engine's withDefaultPort default)
  case "$1" in
    fou-gre) echo 5555 ;; gue-ipip) echo 6080 ;; vxlan) echo 4789 ;; geneve) echo 6081 ;;
    dnscrypt-udp) echo 443 ;; ntp-direct) echo 123 ;; openvpn-dco) echo 1194 ;; srtp-direct) echo 5004 ;;
  esac
}
shaped_udp_mtu() { # carrier [default] -> the shape's datagram ceiling (wat/udpshape.go: 1400 minus its header/padding)
  local m
  case "$1" in
    dnscrypt-udp) m=1326 ;; ntp-direct) m=1352 ;; openvpn-dco) m=1396 ;; srtp-direct) m=1388 ;;
    fou-gre|gue-ipip|vxlan|geneve) m=1392 ;; *) echo "${2:-$ENG_MTU_MAX}"; return 0 ;;
  esac
  echo "$m"
}
shaped_raw_mtu() { # M1/M15: raw tier = 1400 minus the shape's fixed header (engine wat/mtuclamp_test.go pins these)
  local m
  case "$1" in
    sit|6to4) m=1360 ;; xfrm-ipsec) m=1392 ;; etherip) m=1384 ;; l2tpv3) m=1396 ;;
    *) echo "${2:-$ENG_MTU_MAX}"; return 0 ;;
  esac
  echo "$m"
}
shaped_real_name() { # F19 carrier -> the real protocol name the UI must say it is NOT
  case "$1" in
    sit) echo '6in4' ;; 6to4) echo '6to4' ;; xfrm-ipsec) echo 'IPsec/ESP' ;; etherip) echo 'EtherIP' ;;
    l2tpv3) echo 'L2TPv3' ;; fou-gre) echo 'FOu/GRE-in-UDP' ;; gue-ipip) echo 'GUE' ;; vxlan) echo 'VXLAN' ;;
    geneve) echo 'Geneve' ;; dnscrypt-udp) echo 'DNSCrypt' ;; ntp-direct) echo 'NTP' ;;
    openvpn-dco) echo 'OpenVPN DCO' ;; srtp-direct) echo 'SRTP' ;;
  esac
}
shaped_raw_proto() { # raw tier -> the IP protocol number it imitates
  case "$1" in sit|6to4) echo 41 ;; xfrm-ipsec) echo 50 ;; etherip) echo 97 ;; l2tpv3) echo 115 ;; esac
}
v_carrier_list() { # "icmp+udp" etc: every leg a known carrier, no duplicates; "auto" only alone
  local v=${1:-} c seen=''
  [ -n "$v" ] || { err "Choose a carrier."; return 1; }
  if [ "$v" = auto ]; then return 0; fi
  case "$v" in *++*|+*|*+) err "Carrier list '$v' has an empty leg."; return 1 ;; esac
  # D7: the engine refuses shaped carriers in a bond in 3.3.0 (untested, per-protocol port defaults collide)
  case "$v" in *+*) is_shaped_list "$v" && { err "F19 shaped carriers are single-carrier only in 3.3.0; the engine refuses them in a '+'-bond ('$v')."; return 1; } ;; esac
  for c in ${v//+/ }; do
    carrier_ok "$c" || { err "Unknown carrier '$c' (use icmp, udp, tcp, tls, ws, wss, h2, h2c, grpc, gre, ipip, sit, 6to4, xfrm-ipsec, etherip, l2tpv3, fou-gre, gue-ipip, vxlan, geneve, dnscrypt-udp, ntp-direct, openvpn-dco, srtp-direct; join several with + to bond)."; return 1; }
    case " $seen " in *" $c "*) err "Carrier '$c' appears twice in '$v'."; return 1 ;; esac
    seen="$seen $c"
  done
  return 0
}
shaped_supported_here() { # carrier list -> 0 when this host can run it, else prints why
  local c raw=0 shaped=0
  for c in ${1//+/ }; do
    is_shaped_carrier "$c" || continue
    shaped=1
    is_shaped_raw "$c" && raw=1
  done
  [ "$shaped" = 1 ] || return 0
  if [ "$raw" = 1 ] && [ "$(uname -s)" != Linux ]; then
    err "The raw-tier shaped carriers (sit, 6to4, xfrm-ipsec, etherip, l2tpv3) need Linux + root/CAP_NET_RAW on both ends (raw sockets); this server is not Linux."
    return 1
  fi
  if [ "$(bin_ver_ok 3.3.0)" != 1 ]; then
    err "F19 shaped carriers need wattun 3.3.0 or newer on BOTH ends; this server has ${VER:-an unknown version}. Run: $SELF update"
    return 1
  fi
  return 0
}
shaped_warn() { # carrier list : the wattun-internal warning (plus raw-tier and bond caveats) for the UI
  local c real='' raw=0 udp=0 bond=0 any=0 rawprotos='' udpports=''
  case "$1" in *+*) bond=1 ;; esac
  for c in ${1//+/ }; do
    is_shaped_carrier "$c" || continue
    any=1
    real="$real${real:+, }$(shaped_real_name "$c")"
    if is_shaped_raw "$c"; then raw=1; rawprotos="$rawprotos $(shaped_raw_proto "$c")"; else udp=1; udpports="$udpports${udpports:+, }$(shaped_udp_port "$c")"; fi
  done
  [ "$any" = 1 ] || return 0
  warn "F19 $([ "$bond" = 1 ] && echo 'leg(s)' || echo carrier) '$1': wattun-internal shape between two 3.3.0 peers, NOT real $real."
  hint "Both ends must run wattun 3.3.0+ and pick the SAME carrier name; it does not talk to the real $real protocol."
  [ "$raw" = 1 ] && hint "Raw tier: IP protocol ${rawprotos# } on a raw socket, Linux + root/CAP_NET_RAW on both ends, no listen port, no reverse, one session. Allow that protocol in the cloud firewalls."
  [ "$udp" = 1 ] && hint "UDP tier: Kharej listens on $udpports/udp unless you give a port (an explicit port wins, peer host:port). Open it in the Kharej cloud firewall."
  [ "$bond" = 1 ] && warn "3.3.0 refuses F19 shaped carriers in a '+'-bond; use a single shaped carrier instead."
  return 0
}
shaped_peer_for_client() { # carrier peer -> the peer form the engine wants (raw tier: bare host; UDP tier: host:port)
  local c=$1 p=$2 last
  if is_shaped_raw "$c"; then
    case "$p" in *:*) last=${p##*:}; v_port "$last" >/dev/null 2>&1 && p=${p%:*} ;; esac
    printf '%s' "$p"; return 0
  fi
  case "$p" in
    *:*) printf '%s' "$p" ;; # an explicit port wins (withDefaultPort)
    *) printf '%s:%s' "$p" "$(shaped_udp_port "$c")" ;;
  esac
}
# D7 (3.3.0): shaped carriers are single-carrier — the engine refuses them in a '+'-bond, so the manager has no
# per-leg listen-/peer- YAML writer any more (shaped_bond_yaml was removed with the 3.3.0 audit fix).
# Which address a connection to HOST leaves from, and the global IPv4 addresses this server holds (3.0.0). A server with
# two addresses sends the tunnel from the one the route picks, which can be the address the users connect to.
out_ip() { ip -4 route get "$1" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1; }
local_ips() { ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/,"",$4); print $4}'; }
# carriers whose reverse mode means: Iran listens on the carrier port and Kharej connects (tcp family) or punches (udp) to it
is_rpool() { is_pool "$1" || [ "$1" = udp ]; }
rproto() { # transport of the carrier port, for firewall and busy-port checks
  case "$1" in udp|fou-gre|gue-ipip|vxlan|geneve|dnscrypt-udp|ntp-direct|openvpn-dco|srtp-direct) echo udp ;; *) echo tcp ;; esac
}
rev_capable() { [ "$1" = icmp ] || is_rpool "$1"; }
reverse_hint() { # [carrier]
  if [ "${1:-}" = udp ]; then
    hint "Reverse: Kharej sends first and Iran only answers. For filters that punish flows Iran starts."
    hint "Set it on both sides (wattun 3.0.0+)."
  elif is_pool "${1:-}"; then
    hint "Reverse: Kharej connects to Iran. For when Iran cannot reach Kharej's port, but Kharej can reach Iran."
    hint "Set it on both sides."
  else
    hint "Reverse: Kharej pings Iran. For a one-way block where Iran cannot ping Kharej."
    hint "Set it on both sides (wattun 2.0.0+)."
  fi
}
v_icmp() { case "$1" in echo|timestamp) return 0 ;; esac; err "Use echo or timestamp (Linux does not answer info/mask)."; return 1; }
v_mbps_adv() { case "$1" in -|0|default) return 0 ;; esac; v_mbps "$1"; }
v_mbps() { [ -z "$1" ] && return 0; [[ "$1" =~ ^[0-9]{1,4}$ ]] && [ "$1" -ge 1 ] && return 0; err "Enter a number of MB/s (1-9999)."; return 1; }
v_sessions() { # [count] [carrier] [reverse=1] : engine max 16, and >1 only one udp/pool carrier in forward mode
  local v=$1 car=${2:-} rev=${3:-0}
  [ -z "$v" ] && return 0
  case "$v" in -|0|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$v))" -ge 1 ] && [ "$((10#$v))" -le "$ENG_MAX_SESSIONS" ] || {
    err "Enter sessions count 1-$ENG_MAX_SESSIONS (or 0/default to unset)."; return 1; }
  [ "$((10#$v))" -gt 1 ] || return 0
  if [ "$rev" = 1 ]; then err "sessions > 1 does not work with reverse (the server dials one pool)."; return 1; fi
  if [ -n "$car" ] && ! sessions_carrier_ok "$car"; then
    err "sessions > 1 needs one udp/tcp/tls/ws/wss/h2/h2c/grpc carrier, not '$car' (bonds, icmp/gre/ipip and the F19 shapes run one session)."
    return 1
  fi
  return 0
}
v_conns() { [ -z "$1" ] && return 0; case "$1" in -|0|default) return 0 ;; esac; [[ "$1" =~ ^[0-9]{1,3}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le "$ENG_MAX_CONNS" ] && return 0; err "Enter conns count 1-$ENG_MAX_CONNS (the engine caps a pool at $ENG_MAX_CONNS; or 0/default to unset)."; return 1; }
v_mtu() { # [mtu] [carrier] : engine bound 256..1400, up to 16384 with a pool carrier (a bond uses its smallest leg)
  local hi=$ENG_MTU_MAX_POOL
  [ -n "${2:-}" ] && hi=$(mtu_max_for "$2")
  [ -z "$1" ] && return 0
  case "$1" in -|0|default) return 0 ;; esac
  [[ "$1" =~ ^[0-9]{3,5}$ ]] && [ "$((10#$1))" -ge "$ENG_MTU_MIN" ] && [ "$((10#$1))" -le "$hi" ] && return 0
  if [ -n "${2:-}" ]; then err "Enter MTU $ENG_MTU_MIN-$hi for carrier '$2' (or 0/default to unset)."
  else err "Enter MTU $ENG_MTU_MIN-$ENG_MTU_MAX_POOL (or 0/default to unset); without a pool carrier the engine caps it at $ENG_MTU_MAX."; fi
  return 1
}
v_num() { [[ "$1" =~ ^[0-9]+$ ]] && return 0; err "Enter a valid positive number."; return 1; }
v_bind() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && return 0; err "Enter an IPv4 address such as 0.0.0.0 or 10.0.0.5."; return 1; }
v_fec() { case "$1" in off|auto) return 0 ;; esac; err "Use off or auto."; return 1; }
# A3: stable engine knobs as first-class rows. -win-max is an Int clamped by the engine to 4..64 MB (0 = auto-tuned
# from host RAM, 3.0.3); -loss-ceiling is a bool opt-in (3.0.0). A value the engine would clamp must not be written.
v_win_max() { # MB, 4..64; empty/-/0/default = unset (engine auto)
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|0|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$v))" -ge 4 ] && [ "$((10#$v))" -le 64 ] && return 0
  err "Enter the per-stream window cap in MB (4-64), or 0/- for the engine's auto value."
  return 1
}
v_loss_ceiling() { # on/off (also true/false/1/0); off is the engine default
  case "${1:-}" in off|false|0|default|'') return 0 ;; on|true|1) return 0 ;; esac
  err "Use on or off."
  return 1
}
# A2: the wizard's FEC prompt keeps off|auto and adds `a` = auto plus open the loss-band rows after creation. Parsed by a
# pure helper so the three answers and the old-engine fallback are table-testable. On an engine older than 3.3.0 the
# band keys do not exist (unknown key stops startup), so `a` falls back to plain auto with the update hint.
REPLY_FEC_BAND=0; REPLY_FEC_OLD=0
fec_choice() { # raw answer -> REPLY_V (off|auto), REPLY_FEC_BAND (1 = open the band rows), REPLY_FEC_OLD (1 = asked on old engine)
  local v=${1:-}
  REPLY_FEC_BAND=0; REPLY_FEC_OLD=0
  case "$v" in
    ''|off|default) REPLY_V=off ;;
    auto) REPLY_V=auto ;;
    a|A)
      if [ -n "$(bin_ver_ok 3.3.0)" ]; then REPLY_V=auto; REPLY_FEC_BAND=1
      else REPLY_V=auto; REPLY_FEC_OLD=1; fi ;;
    *) err "Use off, auto or a."; return 1 ;;
  esac
  return 0
}
ask_fec() { # [default] : wizard FEC prompt; interactive answer a also opens the band rows
  local def=${1:-off}
  if [ "$NONINTERACTIVE" = 1 ]; then fec_choice "$def" || return 1; return 0; fi
  hint "auto sends parity only while loss is above 2 %; a here lets you tune the band."
  ask "FEC: off, auto, or a (auto + open the loss-band rows)" "$def"
  fec_choice "$REPLY_V" || return 1
  [ "$REPLY_FEC_OLD" = 1 ] && hint "The FEC loss band needs wattun 3.3.0 on this server (run: $SELF update); using auto with engine defaults."
  return 0
}
# -fec-on-loss/-fec-off-loss (F11, 3.3.0): percentages. The engine (cmd/wattun/fecgate.go) requires 0 < on <= 50 and
# 0 <= off < on; an invalid band stops the tunnel at startup, so the same check runs here before the key is written.
v_fec_on() { # value [current-off] : 0 < value <= 50 and above the off threshold
  local v=${1:-} off=${2:-0.5}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}(\.[0-9]+)?$ ]] || { err "Enter a loss percentage above 0 and at most 50 (for example 2 or 0.5)."; return 1; }
  awk -v v="$v" -v o="$off" 'BEGIN{exit !(v > 0 && v <= 50 && v > o)}' \
    || { err "fec-on-loss must be above 0, at most 50 and above fec-off-loss ($off)."; return 1; }
  return 0
}
v_fec_off() { # value [current-on] : 0 <= value < on threshold
  local v=${1:-} on=${2:-2}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}(\.[0-9]+)?$ ]] || { err "Enter 0 or a loss percentage (for example 0.5 or 2)."; return 1; }
  awk -v v="$v" -v n="$on" 'BEGIN{exit !(v >= 0 && v < n)}' \
    || { err "fec-off-loss must be 0 or more and below fec-on-loss ($on)."; return 1; }
  return 0
}
# -state-dir/-state-save (F8, 3.3.0): the engine needs an existing-or-creatable directory (it creates 0700 and probes
# writability at startup) and a whole number of seconds >= 0.
v_state_dir() { # absolute directory, or empty/-/default for the engine default (next to the config)
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|default|0) return 0 ;; esac
  [[ "$v" =~ ^/[A-Za-z0-9._/-]*$ ]] || { err "Enter an absolute directory such as /run/wattun (no spaces), or - for the default next to the config."; return 1; }
  case "/${v#/}/" in */../*) err "The state directory cannot contain '..'."; return 1 ;; esac
  [ "${#v}" -le 200 ] || { err "That path is too long (200 characters at most)."; return 1; }
  case "$v" in # H1: the shipped unit only makes /run/wattun writable (RuntimeDirectory + ReadWritePaths)
    /run/wattun|/run/wattun/*|/etc/wattun|/etc/wattun/*) ;;
    *) warn "The shipped systemd unit only guarantees writes under /run/wattun; add '$v' to its ReadWritePaths or the engine stops at startup." ;;
  esac
  [ -e "$v" ] && [ ! -d "$v" ] && { err "$v exists and is not a directory."; return 1; }
  [ -d "$v" ] && [ ! -w "$v" ] && { err "$v is not writable; wattun would fail at startup (the shipped unit only makes /run/wattun writable via RuntimeDirectory)."; return 1; }
  return 0
}
v_state_save() { # whole seconds 0..2592000 (0 = only on shutdown); mirrors stateSaveInterval's cap
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,7}$ ]] && [ "$((10#$v))" -le 2592000 ] && return 0
  err "Enter the save interval in whole seconds, at most 2592000 (30 days; 0 = only on shutdown)."
  return 1
}
# -shape-data / -noise / -noise-bps / -noise-window (F13, 3.3.0): every one is validated at startup in
# cmd/wattun/noise.go, so a typo stops the tunnel instead of silently disabling shaping. These mirror those rules.
v_shape_data() { # percent 0..25; 0/empty = off (engine hard cap 25)
  local v=${1:-}
  [ -z "$v" ] && return 0
  case "$v" in -|default|0|0.0) return 0 ;; esac
  [[ "$v" =~ ^[0-9]{1,2}(\.[0-9]+)?$ ]] || { err "Enter the padding budget in percent (0 = off, up to 25)."; return 1; }
  awk -v v="$v" 'BEGIN{exit !(v > 0 && v <= 25)}' || { err "shape-data must be 0 (off) or up to 25 percent, got $v."; return 1; }
  return 0
}
v_noise_mode() { case "${1:-}" in ''|off|low|med|custom) return 0 ;; esac; err "Use off, low, med or custom."; return 1; }
v_noise_bps() { # bytes/second, only with noise custom: 64..1000000 (noiseBudget)
  local v=${1:-}
  [ -n "$v" ] || { err "noise custom needs a byte budget (64..1000000 B/s)."; return 1; }
  [[ "$v" =~ ^[0-9]{1,7}$ ]] && [ "$((10#$v))" -ge 64 ] && [ "$((10#$v))" -le 1000000 ] && return 0
  err "Enter the filler budget in bytes/second (64..1000000)."
  return 1
}
v_noise_window() { # "HH:MM-HH:MM" local clock, start != end, may wrap past midnight; empty/- = all day
  local v=${1:-} a b am bm
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  [[ "$v" =~ ^([0-9]|[01][0-9]|2[0-3]):[0-5][0-9]-([0-9]|[01][0-9]|2[0-3]):[0-5][0-9]$ ]] \
    || { err 'Enter a local-clock window such as 02:00-06:00 (HH:MM-HH:MM), or - for all day.'; return 1; }
  a=${v%%-*}; b=${v#*-}
  am=$(( 10#${a%%:*} * 60 + 10#${a##*:} )); bm=$(( 10#${b%%:*} * 60 + 10#${b##*:} ))
  [ "$am" != "$bm" ] || { err "The noise window cannot start and end at the same time; leave it empty for all day."; return 1; }
  return 0
}
# -allow-clients / -allow-clients-file (W10, 3.3.0): server-side admission allowlist, checked before a session is
# admitted (cmd/wattun/clientallow.go). Bare addresses are kept as /32 or /128; entries are masked like the engine does.
ipv6_ok() { # pragmatic syntax check; netip.ParseAddr in the engine is the authority
  local a=${1:-} zone='' g last
  [ -n "$a" ] || return 1
  case "$a" in *%*) zone=${a##*%}; a=${a%%%*}; [ -n "$zone" ] && [[ "$zone" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1 ;; esac
  [ "${#a}" -le 45 ] && [[ "$a" == *:* ]] && [[ "$a" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
  case "$a" in *:::*) return 1 ;; esac
  case "${a/::/}" in *::*) return 1 ;; esac # at most one "::"
  case "$a" in :*) [[ "$a" == ::* ]] || return 1 ;; esac
  case "$a" in *:) [[ "$a" == *:: ]] || return 1 ;; esac
  g=$(printf '%s\n' "$a" | awk '
    BEGIN { FS = "::" }
    { dbl = ($0 ~ /::/) ? 1 : 0; g = 0; bad = 0
      for (p = 1; p <= NF; p++) {
        if ($p == "") continue
        m = split($p, u, /:+/)
        for (i = 1; i <= m; i++) {
          if (u[i] == "") { bad = 1; break }
          if (u[i] ~ /\./) { if (p != NF || i != m) bad = 1; else g += 2 }
          else if (u[i] ~ /^[0-9A-Fa-f]{1,4}$/) g += 1
          else bad = 1
        }
        if (bad) break
      }
      if (bad) { print -1; exit }
      if (dbl ? (g > 7) : (g != 8)) { print -1; exit }
      print g }') || return 1
  [ "${g:--1}" -ge 0 ] 2>/dev/null || return 1
  case "$a" in *.*) last=${a##*:}; [ -z "$last" ] || ipv4_ok "$last" || return 1 ;; esac
  return 0
}
ip_or_cidr_ok() { # one allowlist entry: bare IPv4/IPv6 address or CIDR prefix
  local a=${1:-} addr pfx
  [ -n "$a" ] || return 1
  case "$a" in */*) addr=${a%%/*}; pfx=${a#*/} ;; *) addr=$a; pfx='' ;; esac
  if ipv4_ok "$addr"; then
    [ -z "$pfx" ] && return 0
    [[ "$pfx" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$pfx))" -le 32 ] && return 0
    return 1
  fi
  if ipv6_ok "$addr"; then
    [ -z "$pfx" ] && return 0
    [[ "$pfx" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$pfx))" -le 128 ] || return 1
    # M3: the engine normalizes a mapped prefix to IPv4 and refuses mapped bits < /96; reject it here instead.
    case "$addr" in ::ffff:*|::FFFF:*) [ "$((10#$pfx))" -lt 96 ] && return 1 ;; esac
    return 0
  fi
  return 1
}
v_allow_clients() { # comma/space separated addresses or prefixes; empty/- = admit every source
  local v=${1:-} e
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  for e in ${v//,/ }; do
    ip_or_cidr_ok "$e" || { err "'$e' is not an IPv4/IPv6 address or CIDR prefix."; return 1; }
  done
  return 0
}
# M4: the service unit has ProtectSystem=strict/ProtectHome=yes and ReadWritePaths=/etc/wattun, so a list file
# anywhere else (e.g. /root) passes a root-shell check but fatals at startup. Require the path under /etc/wattun (under
# $CONF in a sandbox, whose configs live in the test dir). A CDN carrier/sni tunnel is refused by the engine anyway.
allow_clients_dir() { [ "$SANDBOX" = 1 ] && { printf '%s' "$CONF"; return 0; }; printf '/etc/wattun'; }
allow_clients_cdn_risk() { # carrier-list [sni] -> 0 when -allow-clients cannot be used (engine refuses the combination)
  local c
  case "${2:-}" in ''|-) ;; *) return 0 ;; esac
  for c in ${1//+/ }; do case "$c" in ws|wss|h2|h2c|grpc) return 0 ;; esac; done
  return 1
}
v_allow_clients_file() { # path under the state dir; the engine reads it once at startup and refuses it if empty
  local v=${1:-} e dir
  [ -z "$v" ] && return 0
  case "$v" in -|default) return 0 ;; esac
  dir=$(allow_clients_dir)
  [[ "$v" =~ ^/[A-Za-z0-9._/-]*$ ]] || { err "Enter an absolute path to the list file (no spaces), or - for the inline list."; return 1; }
  case "$v" in
    "$dir"/*) ;;
    *) err "Put the allowlist file under $dir/ (the shipped unit can only read that path); got $v."; return 1 ;;
  esac
  [ -f "$v" ] || { err "$v does not exist (the engine reads the file at startup)."; return 1; }
  [ -r "$v" ] || { err "$v is not readable."; return 1; }
  local found=0
  # the engine splits on comma, space, tab, CR and newline (clientallow.go isClientSeparator); default IFS covers all
  # but the comma
  for e in $(tr ',' ' ' <"$v"); do
    [ -n "$e" ] || continue
    found=1
    ip_or_cidr_ok "$e" || { err "$v: '$e' is not an IPv4/IPv6 address or CIDR prefix."; return 1; }
  done
  [ "$found" = 1 ] || { err "$v has no entries; the engine refuses an empty allowlist."; return 1; }
  return 0
}
# H6: one list, AC_ALLMODES, is the single source for the validator, the unattended --fake-mode parser, the picker,
# the matrix and the usage text. It must match wat/desync.go's accepted modes (13 since 2.9.0/3.0.0); the old second
# list in the manager made the unattended path reject 5 documented modes the engine accepts.
AC_ALLMODES='rst synrst paws seq seqsum sum ttl split hlen0 fakeip ff all auto'
fake_mode_ok() { case " $AC_ALLMODES " in *" $1 "*) return 0 ;; esac; return 1; }
v_fake_mode() { fake_mode_ok "${1:-}" && return 0; err "Use one of: $AC_ALLMODES."; return 1; }
fake_mode_desc() { # mode -> one-line picker description (version notes; unknown modes get a generic line)
  case "$1" in
    auto) echo 'tests the route at start, up to 18 s (3.0.0+)' ;;
    seqsum) echo 'seq + bad checksum, SNI-allowlist filters (2.8.0+)' ;;
    sum) echo 'bad checksum, stateful NATs (2.7.1+)' ;;
    seq) echo 'out-of-window sequence (2.7.0+)' ;;
    ttl) echo 'short TTL (2.7.0+)' ;;
    rst) echo 'bad-checksum RST, recommended (2.9.0+)' ;;
    synrst) echo 'when rst is filtered (2.10.5+)' ;;
    paws) echo 'stale timestamp, filters that check checksums (3.0.2+)' ;;
