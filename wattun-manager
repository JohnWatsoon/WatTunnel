         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" conns; else set_value "$n" conns "$REPLY_V"; fi; changed=1 ;;
      u) echo; ask_ok "MTU $ENG_MTU_MIN-$(mtu_max_for "$cr") for carrier '$cr' (- or 0 or default = unset)" "$(cfg "$n" mtu)" v_mtu_adv || continue
         case "$REPLY_V" in -|0|default) REPLY_V='' ;; esac
         if [ -z "$REPLY_V" ]; then unset_value "$n" mtu; else set_value "$n" mtu "$REPLY_V"; fi; changed=1 ;;
      k) ac_dialer "$n" || continue; anticensor_menu "$n" ;;
      f) echo; ask_ok "FEC: off or auto" "$(cfg "$n" fec | sed 's/^$/off/')" v_fec || continue
         if [ "$REPLY_V" = off ]; then unset_value "$n" fec; else set_value "$n" fec "$REPLY_V"; fi; changed=1 ;;
      o) [ "$fec_auto" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "FEC auto sends parity only while measured loss is above this; the tuple needs 0 < on <= 50."
         ask_ok "FEC on-loss percent (above fec-off-loss $FEC_OFF_CUR)" "$(cfg "$n" fec-on-loss)" v_fec_on_adv || continue
         case "$REPLY_V" in
           ''|-|default)
             # unsetting falls back to the engine default 2 %, which must still be above the configured off threshold
             awk -v o="$FEC_OFF_CUR" 'BEGIN{exit !(2 > o)}' \
               || { err "fec-off-loss is $FEC_OFF_CUR %, so the engine default 2 % would not be above it; lower fec-off-loss first."; continue; }
             unset_value "$n" fec-on-loss ;;
           *) set_value "$n" fec-on-loss "$REPLY_V" ;;
         esac; changed=1 ;;
      x) [ "$fec_auto" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "FEC auto stops sending parity below this; it must be 0 or more and below fec-on-loss."
         ask_ok "FEC off-loss percent (below fec-on-loss $FEC_ON_CUR)" "$(cfg "$n" fec-off-loss)" v_fec_off_adv || continue
         case "$REPLY_V" in
           ''|-|default)
             awk -v n="$FEC_ON_CUR" 'BEGIN{exit !(0.5 < n)}' \
               || { err "fec-on-loss is $FEC_ON_CUR %, so the engine default 0.5 % would not be below it; raise fec-on-loss first."; continue; }
             unset_value "$n" fec-off-loss ;;
           *) set_value "$n" fec-off-loss "$REPLY_V" ;;
         esac; changed=1 ;;
      t) adv_33 || { sleep 1; continue; }
         echo
         hint "Wattun keeps quota usage and lifetime totals next to the config. The shipped unit makes /run/wattun a"
         hint "writable tmpfs (RuntimeDirectory), so that is the supported place; the files are then lost on reboot."
         hint "Any other absolute path works only if the unit can write it (ReadWritePaths); the engine stops at startup."
         [ "$SANDBOX" = 1 ] && hint "Sandbox $WAT_PREFIX: these are test configs, the installed unit's sandbox does not apply."
         ask_ok "State directory (absolute; /run/wattun is the supported tmpfs, 0 or - = next to the config)" "$(cfg "$n" state-dir)" v_state_dir || continue
         case "$REPLY_V" in
           ''|-|default|0) unset_value "$n" state-dir; ok "State files stay next to the config." ;; # F11: 0 = default, never a /0 dir
           *) set_value "$n" state-dir "${REPLY_V%/}"; ok "State files will live in ${REPLY_V%/} (created 0700 by wattun)." ;;
         esac
         hint "On restart the engine reads that directory; counters start from zero if they lived elsewhere."
         changed=1 ;;
      v) adv_33 || { sleep 1; continue; }
         echo; hint "How often quota usage and lifetime totals are written to disk; 0 = only on shutdown."
         ask_ok "State save interval in seconds (0 = shutdown only; max 2592000 = 30 days)" "$(cfg "$n" state-save)" v_state_save || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" state-save; ok "Engine default: every 30 s." ;;
           *) set_value "$n" state-save "$REPLY_V"; ok "Saved: every $REPLY_V s$([ "$REPLY_V" = 0 ] && echo ' (shutdown only)')." ;;
         esac; changed=1 ;;
      p) adv_33 || { sleep 1; continue; }
         echo
         hint "shape-data pads stream packets to randomized realistic sizes, spending at most this percent of the"
         hint "stream bytes sent. It costs bandwidth (and any traffic quota) and is opt-in: 0 = off, at most 25."
         ask_ok "shape-data percent (0 = off, up to 25)" "$(cfg "$n" shape-data)" v_shape_data || continue
         case "$REPLY_V" in
           ''|-|default|0|0.0) unset_value "$n" shape-data; ok "shape-data off." ;;
           *) set_value "$n" shape-data "$REPLY_V"; ok "shape-data: up to $REPLY_V % padding." ;;
         esac; changed=1 ;;
      n) adv_33 || { sleep 1; continue; }
         echo
         hint "Noise is filler sent only while the session is idle. It is PER SESSION: -sessions N multiplies it on the"
         hint "dialing side, and Kharej runs one per connected client. Counts on the host bill and in the session totals"
         hint "(not in per-port quotas/limits): low ~11 MB/day/session, med ~88 MB/day/session; custom uses noise-bps."
         ask "noise: off, low, med or custom" "$(cfg "$n" noise | sed 's/^$/off/')"
         v_noise_mode "$REPLY_V" || continue
         nm=$REPLY_V
         case "$nm" in
           ''|off) unset_value "$n" noise; unset_value "$n" noise-bps; ok "Idle noise off." ;;
           low|med) set_value "$n" noise "$nm"; unset_value "$n" noise-bps; ok "Idle noise: $nm." ;;
           custom)
             cb=$(cfg "$n" noise-bps); case "$cb" in ''|*[!0-9]*) cb=1024 ;; esac
             [ "$cb" -ge 64 ] && [ "$cb" -le 1000000 ] || cb=1024
             echo; hint "Custom noise needs a byte budget; noise-window can limit when it may flow."
             ask_ok "Noise filler bytes/second (64..1000000)" "$cb" v_noise_bps || continue
             set_value "$n" noise-bps "$REPLY_V"; set_value "$n" noise custom # budget first: custom without one is refused
             ok "Idle noise: custom at $REPLY_V B/s." ;;
         esac; changed=1 ;;
      g) [ "$noise_m" = custom ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "Only used with noise custom; low/med have fixed budgets. Per session (see n)."
         ask_ok "Noise filler bytes/second (64..1000000)" "$(cfg "$n" noise-bps)" v_noise_bps || continue
         set_value "$n" noise-bps "$REPLY_V"; ok "Idle noise: custom at $REPLY_V B/s."; changed=1 ;;
      w) [ "$noisw" = 1 ] || continue; adv_33 || { sleep 1; continue; }
         echo; hint "Local clock on this server: filler may be sent only inside this window; it may wrap past midnight."
         ask_ok "Noise window HH:MM-HH:MM (empty = all day)" "$(cfg "$n" noise-window)" v_noise_window || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" noise-window; ok "Noise may flow all day." ;;
           *) set_value "$n" noise-window "$REPLY_V"; ok "Noise window: $REPLY_V." ;;
         esac; changed=1 ;;
      j) [ "$r" = Kharej ] || continue; adv_33 || { sleep 1; continue; }
         allow_clients_cdn_risk "$cr" "$(cfg "$n" sni)" && { err "The engine refuses -allow-clients with a CDN carrier or sni: the source is the CDN edge, so it would lock everyone out."; sleep 1; continue; }
         echo
         hint "Admission allowlist: checked before a session is admitted, so established sessions stay up. Needs a restart."
         hint "It restricts holders of the key/token to these source addresses; it is not a firewall against strangers."
         hint "Reverse mode ignores the list. Comma/space separated IPv4/IPv6 addresses or CIDR prefixes."
         ask_ok "Allowed client addresses/prefixes (- = any source)" "$(cfg "$n" allow-clients)" v_allow_clients || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" allow-clients; ok "Every source is admitted (no allowlist)." ;;
           *) set_value "$n" allow-clients "$REPLY_V"
              [ -n "$(cfg "$n" allow-clients-file)" ] && warn "allow-clients-file is set and replaces this list until you clear it."
              ok "Allowed clients: $REPLY_V" ;;
         esac; changed=1 ;;
      l) [ "$r" = Kharej ] || continue; adv_33 || { sleep 1; continue; }
         allow_clients_cdn_risk "$cr" "$(cfg "$n" sni)" && { err "The engine refuses -allow-clients-file with a CDN carrier or sni: the source is the CDN edge."; sleep 1; continue; }
         echo
         hint "A file with the admission allowlist: one address/prefix per line (comma or space also works). The engine"
         hint "reads it once at startup and it replaces the inline list; an empty file stops the tunnel."
         hint "The shipped unit can only read it under $(allow_clients_dir)/; reverse mode ignores the list."
         ask_ok "Allowlist file (under $(allow_clients_dir)/; - = none)" "$(cfg "$n" allow-clients-file)" v_allow_clients_file || continue
         case "$REPLY_V" in
           ''|-|default) unset_value "$n" allow-clients-file; ok "The inline allow-clients list is used." ;;
           *) set_value "$n" allow-clients-file "$REPLY_V"; ok "Allowlist file: $REPLY_V (read at restart)." ;;
         esac; changed=1 ;;
      a) [ "$r" = Iran ] || continue; echo; ask_ok "Bind address" "$(cfg "$n" bind | sed 's/^$/0.0.0.0/')" v_bind || continue
         if [ "$REPLY_V" = 0.0.0.0 ]; then unset_value "$n" bind; else set_value "$n" bind "$REPLY_V"; fi; changed=1 ;;
      i) [ "$cr" = icmp ] || continue; echo; hint "Must match the other side."; ask_ok "ICMP type" "$(cfg "$n" icmp-type | sed 's/^$/echo/')" v_icmp || continue
         if [ "$REPLY_V" = echo ]; then unset_value "$n" icmp-type; else set_value "$n" icmp-type "$REPLY_V"; fi; changed=1 ;;
      y) case "$cr" in icmp|udp) ;; *) continue ;; esac
         echo; hint "Batching sends and reads many packets per system call (less CPU per MB). Needs wattun 3.0.0."
         ask "Batching: on, off or default" "$(cfg "$n" batch | sed 's/^$/default/')"
         case "$REPLY_V" in
           on|off) [ "$(bin_ver_ok 3.0.0)" = 1 ] || { err "batch needs wattun 3.0.0 or newer (run: $SELF update)."; sleep 1; continue; }
              set_value "$n" batch "$REPLY_V"; changed=1 ;;
           default|-|'') unset_value "$n" batch; changed=1 ;;
           *) err "Use on, off or default."; sleep 1 ;;
         esac ;;
      e) [ "$wm_ok" = 1 ] || { err "win-max needs wattun 3.0.3 or newer (run: $SELF update)."; sleep 1; continue; }
         echo; hint "Caps the per-stream receive window; windows are receiver-driven, so this bounds what the PEER"
         hint "buffers per stream. 4-64 MB; 0 or - keeps the engine's auto value (host-RAM based)."
         ask_ok "Stream window cap in MB (4-64; 0/- = auto)" "$(cfg "$n" win-max | sed 's/^$/0/')" v_win_max || continue
         case "$REPLY_V" in ''|-|0|default) unset_value "$n" win-max; ok "win-max: engine auto value." ;;
           *) set_value "$n" win-max "$REPLY_V"; ok "win-max: $REPLY_V MB per stream." ;;
         esac; changed=1 ;;
      r) [ "$lc_ok" = 1 ] || { err "loss-ceiling needs wattun 3.0.0 or newer (run: $SELF update)."; sleep 1; continue; }
         echo; hint "Also cut the rate when loss jumps far above its learned baseline (delay-based CC stays the"
         hint "default rule). Opt-in; useful on routes that cut flows rather than merely congest."
         ask "Loss ceiling: on or off" "$([ "$(cfg "$n" loss-ceiling)" = true ] && echo on || echo off)"
         v_loss_ceiling "$REPLY_V" || { sleep 1; continue; }
         case "$REPLY_V" in on|true|1) set_value "$n" loss-ceiling true; ok "loss-ceiling on." ;;
           *) unset_value "$n" loss-ceiling; ok "loss-ceiling off (delay-only CC)." ;;
         esac; changed=1 ;;
      d) rev_capable "$cr" || continue; echo
         # applied at once, so the direction never sits in the file without running
         set_direction "$n" && step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
         pause ;;
      b|0|q|enter|esc) break ;;
      *) : ;;
    esac
  done
  # Every setting here needs a restart; apply it automatically (an unapplied change only logs "restart needed").
  if [ "$changed" = 1 ]; then
    step "Restarting ${WAT_PREFIX}@$n to apply" systemctl restart "${WAT_PREFIX}@$n"
  fi
  return 0
}

# ======================================================================================
#  Automated Anti-Censorship Testing & Verification
# ======================================================================================
anticensor_test() {
  local n=$1 r cr peer s alive=false srtt pkts_in pkts_out fprof ech_st gov_st
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n"); cr=$(cfg "$n" carrier); peer=$(cfg "$n" peer)
  ac_dialer "$n" || { err "'$n' does not dial the carrier (anti-censorship verification runs on the dialing end)."; return 1; }
  echo
  say "  ${BOLD}Anti-censor test${RST}  ${GRY}$n · $r · $cr${RST}"
  echo

  if ! systemctl is-active -q "${WAT_PREFIX}@$n" 2>/dev/null; then
    warn "$n is stopped. Starting it."
    systemctl start "${WAT_PREFIX}@$n" 2>/dev/null
    sleep 1
  fi

  # Active profile report
  local fks=$(cfg "$n" fake-sni) fkm=$(cfg "$n" fake-mode) fkt=$(cfg "$n" fake-ttl)
  local rot=$(cfg "$n" pool-rotate) rbytes=$(cfg "$n" pool-rotate-bytes)
  local ech=$(cfg "$n" ech) gov=$(cfg "$n" governor)
  local dl=$(cfg "$n" dns-listen) sip=$(cfg "$n" src-ip)

  if [ -n "$fks" ]; then
    say "  $(kv 'fake sni' "$fks · ${fkm:-seq}${fkt:+ · ttl $fkt}")"
  else
    say "  $(kv 'fake sni' "${GRY}off${RST}")"
  fi
  [ -n "$rot" ] && say "  $(kv rotate "$rot${rbytes:+ / $rbytes}")"
  [ -n "$ech" ] && say "  $(kv ech "$ech")"
  [ "$gov" = true ] && say "  $(kv governor on)"
  [ -n "$dl" ] && say "  $(kv 'dns relay' "$dl")"
  [ -n "$sip" ] && say "  $(kv 'source ip' "$sip")"
  echo

  spin_start "Waiting for the link"
  local wait_sec=${ANTICENSOR_TEST_WAIT:-6}
  for ((i=0; i<wait_sec; i++)); do
    s=$(stats "$n" 2>/dev/null)
    if [ "$(jget "$s" alive)" = true ]; then
      alive=true; break
    fi
    sleep 1
  done
  spin_stop

  if [ "$alive" = true ]; then
    srtt=$(jget_flat "$s" rtt_ms srtt_ms)
    pkts_in=$(jget "$s" pkts_in)
    pkts_out=$(jget "$s" pkts_out)
    fprof=$(jget "$s" filter_profile)
    ech_st=$(jget "$s" ech)

    ok "Connected: the filter lets it through"
    say "  $(kv rtt "$(ms "$srtt") ms")"
    say "  $(kv packets "${pkts_in:-0} in · ${pkts_out:-0} out")"
    [ -n "$fprof" ] && say "  $(kv filter "$fprof")"
    [ -n "$ech_st" ] && say "  $(kv ech "$ech_st")"

    # Forwarded port check
    load_maps "$n"
    if [ "${#MAPS[@]}" -gt 0 ]; then
      local first_map="${MAPS[0]}"
      local lport=$(spec_L "$first_map")
      local proto=$(spec_P "$first_map")
      if [ -n "$lport" ] && [[ "$lport" =~ ^[0-9]+$ ]]; then
        if [ "$proto" = tcp ]; then
          if timeout 2 bash -c "</dev/tcp/127.0.0.1/$lport" 2>/dev/null; then
            ok "Port $lport/$proto answers"
          fi
        elif port_busy "$lport" "$proto"; then
          ok "Port $lport/$proto is open"
        fi
      fi
    fi
    return 0
  else
    err "Not connected within ${wait_sec} s"
    if [ -n "$fks" ]; then
      hint "This provider may block $fks or mode ${fkm:-seq}. Try in order:"
      hint "  $SELF blackout $n blackout"
      hint "  mode rst or synrst: tunnel page, o, k"
      hint "  another SNI: irancell.ir, tci.ir, divar.ir"
    else
      hint "Fake SNI is off. If this provider allows only listed SNIs: $SELF blackout $n mci"
    fi
    [ "$cr" = icmp ] && hint "ICMP may be filtered or rerouted. Turn the governor on."
    return 1
  fi
}

# ======================================================================================
#  Interactive Anti-Censorship Menu Hub
# ======================================================================================
AC_KEYS="fake-sni fake-mode fake-ttl fake-ip fake-split fp tls-small-ch ech ech-cache tls-frag pool-rotate pool-rotate-bytes governor dns-listen src-ip conns loss-ceiling keep-slow"
anticensor_menu() {
  local n=$1 cr r
  cr=$(cfg "$n" carrier); r=$(role "$n")
  [ "$(uname -s)" = Linux ] || return 0
  if ! ac_dialer "$n"; then # the listening end has nothing to configure
    page "Anti-censor" "$n · $cr"
    say "  The $([ "$r" = Iran ] && echo Kharej || echo Iran) server dials this $(is_reverse "$n" && echo reverse || echo normal) tunnel, so anti-censor is set there."
    hint "To change who dials: Advanced, d, on both servers."
    menu_line h 'what spoofing and shaping mean'
    key_read
    [ "$KEY" = h ] && spoofhelp_page "$n"
    return 0
  fi
  local changed=0 k v
  while :; do
    page "Anti-censor" "$n · $cr"
    local fs fm ft pr pb ech gov dl sip
    fs=$(cfg "$n" fake-sni)
    fm=$(cfg "$n" fake-mode); [ -n "$fm" ] || fm=seq
    ft=$(cfg "$n" fake-ttl)
    pr=$(cfg "$n" pool-rotate)
    pb=$(cfg "$n" pool-rotate-bytes)
    ech=$(cfg "$n" ech)
    gov=$(cfg "$n" governor)
    dl=$(cfg "$n" dns-listen)
    sip=$(cfg "$n" src-ip)

    if [ -n "$fs" ] || [ "$gov" = true ] || [ -n "$pr" ]; then set_row 1 anti-censor "${GRN}on${RST} · $(detect_preset "$n")"
    else set_row 1 anti-censor "off ${GRY}(plain tunnel, full speed)${RST}"; fi
    set_row r direction "$(is_reverse "$n" && echo "reverse ${GRY}(Kharej dials Iran)${RST}" || echo "normal ${GRY}(Iran dials Kharej)${RST}")"
    echo
    if is_pool_list "$cr"; then
      set_row 2 'fake sni' "$fs" '' off
      [ -n "$fs" ] && set_row 3 'desync mode' "$fm"
      [ -n "$fs" ] && [ "$fm" = ttl ] && set_row 4 'fake ttl' "$ft" '' auto
      set_row 5 'rotate every' "$pr" '' off
      set_row 6 'rotate after' "$pb" '' off
    elif [ "$cr" = icmp ]; then
      set_row 2 governor "$([ "$gov" = true ] && echo on)" '' off
    fi
    has_ech_list "$cr" && set_row 7 ech "$ech" '' off
    set_row 8 'dns forwarder' "$dl" '' off
    set_row 9 'source ip' "$sip" '' 'default route'
    echo
    menu_line w presets t 'test now' m 'test all modes' h 'what these do'
    menu_line p 'save as profile' e 'edit any key'
    menu_line 0 back
    key_read
    case "$KEY" in
      h|H) spoofhelp_page "$n"; continue ;;
      1) # Toggle: on -> plain tunnel, off -> preset (apply_preset restarts the tunnel itself)
         echo
         if [ -n "$fs" ] || [ "$gov" = true ] || [ -n "$pr" ]; then
           confirm "Turn anti-censor OFF (plain tunnel, open connections drop)?" y && apply_preset "$n" off
         elif pick_preset "cloudflare"; then
           apply_preset "$n" "$REPLY_V"
         fi
         sleep 1 ;;
      w|W) echo
         if pick_preset "cloudflare"; then
           apply_preset "$n" "$REPLY_V"
         fi
         sleep 1 ;;
      r|R) rev_capable "$cr" || continue; echo
         if set_direction "$n"; then
           step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
           hint "Anti-censor now belongs to the dialing end: open this screen on the other server and press 1 there."
           pause; return 0
         fi
         pause ;;
      e|E) echo
         hint "Keys: $AC_KEYS"
         ask "Key to set" ""; k=$REPLY_V
         [ -n "$k" ] || continue
         case " $AC_KEYS " in *" $k "*) ;; *) err "Unknown key '$k'."; sleep 1; continue ;; esac
         ask "Value for $k (- = remove)" "$(cfg "$n" "$k")"; v=$REPLY_V
         if [ -z "$v" ] || [ "$v" = - ]; then unset_value "$n" "$k"; ok "$k removed."; changed=1
         elif [[ "$v" =~ ^[A-Za-z0-9._:/@+-]+$ ]]; then set_value "$n" "$k" "$v"; ok "$k set to $v."; changed=1
         else err "Value may only hold letters, digits and . _ : / @ + -"; fi
         sleep 1 ;;
      2) # Pick SNI (pool) or Toggle Governor (icmp)
         if [ "$cr" = icmp ]; then
           echo
           if [ "$(cfg "$n" governor)" = true ]; then
             unset_value "$n" governor; ok "Volume governor turned OFF."
           else
             set_value "$n" governor true; ok "Volume governor turned ON."
           fi
           changed=1; sleep 1; continue
         fi
         is_pool_list "$cr" || continue
         echo
         if pick_sni_preset "${fs:-mci.ir}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             sed -i -E '/^fake-(sni|mode|ttl):/d' "$CONF/$n.yml"
             ok "Fake-SNI turned OFF."; changed=1
           else
             set_value "$n" fake-sni "$REPLY_V"
             [ -n "$(cfg "$n" fake-mode)" ] || set_value "$n" fake-mode rst
             ok "Fake-SNI set to $REPLY_V"; changed=1
           fi
         fi
         sleep 1 ;;
      3) # Pick Fake Mode
         is_pool_list "$cr" || continue
         [ -n "$(cfg "$n" fake-sni)" ] || { warn "Turn on Fake-SNI first (option 2)."; sleep 1; continue; }
         echo
         if pick_fake_mode "$fm" && ! rev_sum_refused "$n" "$REPLY_V"; then
           set_value "$n" fake-mode "$REPLY_V"
           [ "$REPLY_V" != ttl ] && unset_value "$n" fake-ttl
           ok "Fake mode set to $REPLY_V"; changed=1
         fi
         sleep 1 ;;
      4) # Fake TTL
         is_pool_list "$cr" || continue
         [ "$(cfg "$n" fake-mode)" = ttl ] || { warn "Fake TTL is only used in ttl mode."; sleep 1; continue; }
         echo
         ask "Fake TTL (hop count, empty = auto-calibrate)" "$ft"
         if [ -z "$REPLY_V" ]; then
           unset_value "$n" fake-ttl; ok "Fake TTL set to auto-calibrate."; changed=1
         elif v_fake_ttl "$REPLY_V"; then
           set_value "$n" fake-ttl "$REPLY_V"; ok "Fake TTL set to $REPLY_V."; changed=1
         fi
         sleep 1 ;;
      5) # Pool Rotate (Time)
         is_pool_list "$cr" || continue
         echo
         if pick_pool_rotate "${pr:-30m}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" pool-rotate; ok "Pool rotate by time turned OFF."; changed=1
           else
             set_value "$n" pool-rotate "$REPLY_V"; ok "Pool rotate set to $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      6) # Pool Rotate (Bytes)
         is_pool_list "$cr" || continue
         echo
         if pick_pool_rotate_bytes "${pb:-500MB}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" pool-rotate-bytes; ok "Pool rotate by bytes turned OFF."; changed=1
           else
             set_value "$n" pool-rotate-bytes "$REPLY_V"; ok "Pool rotate bytes set to $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      7) # ECH Mode
         case "$cr" in
           tls|wss|h2|grpc)
             echo
             if pick_ech "${ech:-ladder}"; then
               if [ "$REPLY_V" = off ]; then
                 unset_value "$n" ech; ok "ECH turned OFF."; changed=1
               else
                 set_value "$n" ech "$REPLY_V"; ok "ECH set to $REPLY_V."; changed=1
               fi
             fi
             sleep 1 ;;
         esac ;;
      8) # DNS Forwarder Listener
         echo
         if pick_dns_listen "${dl:-off}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" dns-listen; ok "DNS forwarder listener turned OFF."; changed=1
           else
             set_value "$n" dns-listen "$REPLY_V"; ok "DNS forwarder listening on $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      9) # Carrier Source IP Binding
         echo
         if pick_src_ip "${sip:-off}"; then
           if [ "$REPLY_V" = off ] || [ "$REPLY_V" = 0 ]; then
             unset_value "$n" src-ip; ok "Carrier source IP binding turned OFF."; changed=1
           else
             set_value "$n" src-ip "$REPLY_V"; ok "Carrier bound to source IP $REPLY_V."; changed=1
           fi
         fi
         sleep 1 ;;
      t|T)
         anticensor_test "$n"
         pause ;;
      m|M)
         ac_matrix_cmd "$n"
         pause ;;
      p|P)
         echo
         ask "Profile name to save" ""
         if [ -n "$REPLY_V" ]; then
           profile_cmd save "$REPLY_V" "$n"
           sleep 1
         fi ;;
      b|0|q|enter|esc) break ;;
      *) : ;;
    esac
  done
  if [ "$changed" = 1 ]; then
    hint "Applying changes: restarting '$n'..."
    step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  fi
}

# ---- spoofing vs shaping: what each anti-censor option actually does (matches docs/TECHNICAL.md) ----
# One page, no network calls. The classification is the docs' one: fake-sni is the only true spoof, everything that
# changes our own packet bytes/sizes/timing is shape, FEC/governor are neither, and tunnel-level spoofing is not shipped.
spoofhelp_page() { # [name]
  page "Spoofing & shaping" "${1:-}"
  printf '  %sTwo words separate the anti-censor options.%s\n\n' "$BOLD" "$RST"
  printf '  %sSpoof%s  the censor is shown a second, fake artifact next to the real flow and the peer ignores it.\n' "$CYN" "$RST"
  printf '         %sOnly fake-sni does this. It carries no session data and adds no secrecy.%s\n\n' "$GRY" "$RST"
  printf '  %sShape%s  WatTunnel'"'"'s own packets change their bytes, sizes or timing:\n' "$CYN" "$RST"
  printf '         tcp-mimic, hdr-mask, shape, tls-frag, ech, udp-dns, pool-rotate.\n'
  printf '         shape-data (pad stream packets to random sizes) and noise (idle filler packets).\n'
  printf '         %sBoth are opt-in and spend bandwidth: shape-data a percent of the stream, noise a\n' "$GRY"
  printf '         byte rate inside noise-window. Noise is PER SESSION: -sessions N multiplies it on\n' "$GRY"
  printf '         the dialing side, and Kharej runs one per connected client.%s\n' "$RST"
  printf '         %sThe carriers that wrap the session in a real protocol (tls, wss, h2,\n' "$GRY"
  printf '         grpc, ws, dns-shaped udp, icmp echo) are shaping too.%s\n' "$RST"
  printf '         %sAuto mode can also test the 13 F19 shaped carriers: --extended on Kharej\n' "$GRY"
  printf '         opens one hidden listener per shape; both ends need 3.3.0.%s\n\n' "$RST"
  printf '  %sNot camouflage%s  fec is robustness on a lossy path; governor is ICMP pacing.\n\n' "$CYN" "$RST"
  printf '  %sWhat none of them hide%s\n' "$BOLD" "$RST"
  printf '   %s· the destination and that the flow exists (server address, volume, timing under load)%s\n' "$GRY" "$RST"
  printf '   %s· the icmp carrier'"'"'s echo structure (on such a route it looks like ping by construction)%s\n' "$GRY" "$RST"
  printf '   %s· the forwarded content between users and the Iran server (only Iran <-> Kharej is encrypted)%s\n' "$GRY" "$RST"
  printf '   %s· that the payload behind the envelope is a tunnel, not the DNS/TLS traffic it resembles%s\n\n' "$GRY" "$RST"
  printf '  %sTunnel-level spoofing is NOT shipped.%s\n' "$BOLD$RED" "$RST"
  printf '  %sNo VLESS/Shadowsocks/Trojan/Hysteria/WireGuard mimicry, no faked completed handshake:%s\n' "$GRY" "$RST"
  printf '  %sfake-sni'"'"'s hello is meant to be dropped by the peer and tcp-mimic never finishes TLS.%s\n\n' "$GRY" "$RST"
  printf '  %sHow to choose%s\n' "$BOLD" "$RST"
  printf '   %s· SNI allowlist cuts the flows%s -> fake-sni (rst/synrst where stateful filtering clears them)\n' "$GRY" "$RST"
  printf '   %s· handshake passes, then SNI black-holes%s -> ech on wss/grpc through a Cloudflare domain\n' "$GRY" "$RST"
  printf '   %s· "first bytes are not TLS" or a fixed header%s -> tcp-mimic + hdr-mask (on) or a real-TLS carrier\n' "$GRY" "$RST"
  printf '   %s· UDP cut after a few datagrams, DNS/53 passes%s -> udp-dns on both ends\n' "$GRY" "$RST"
  printf '   %s· connection lifetime or bytes per flow watched%s -> pool-rotate / pool-rotate-bytes\n' "$GRY" "$RST"
  printf '   %s· reroutes on sustained ICMP volume%s -> governor plus a low total max-mbps\n\n' "$GRY" "$RST"
  hint "Full table and caveats: docs/TECHNICAL.md, \"Spoofing and shaping, explained\"."
  pause
}

# ---- resilience profiles: save one tunnel's working fake-sni/pool-rotate combination, re-apply it later ----
prof_names() { local f; for f in "$CONF/profiles"/*.env; do [ -e "$f" ] || continue; basename "$f" .env; done; }
prof_path() { echo "$CONF/profiles/$1.env"; }
v_prof_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || { err "Profile name: 1-32 letters, digits, - or _."; return 1; }; return 0; }
prof_read() { # file -> the KEY=VALUE lines this manager wrote (comments and anything else are ignored)
  local l
  [ -f "$1" ] || return 0
  while IFS= read -r l; do
    case "$l" in FAKESNI=*|FAKEMODE=*|FAKETTL=*|POOLROT=*|POOLBYTES=*|ECH=*|GOVERNOR=*|DNSLISTEN=*|SRCIP=*) echo "$l" ;; esac
  done <"$1"
}
prof_pick_defaults() { # fill the wizard's resilience defaults from a saved profile (interactive only)
  local names pick l k v
  names=$(prof_names)
  [ -n "$names" ] || return 0
  echo
  hint "Saved resilience profiles: $(echo "$names" | tr '\n' ' ')"
  ask "Start from a saved profile (name, empty = skip)" ""; pick=$REPLY_V
  [ -n "$pick" ] || return 0
  [ -f "$(prof_path "$pick")" ] || { err "No profile named '$pick'."; return 0; }
  while IFS= read -r l; do
    k=${l%%=*}; v=${l#*=}
    case "$k" in
      FAKESNI) T_FAKESNI=$v ;; FAKEMODE) T_FAKEMODE=$v ;; FAKETTL) T_FAKETTL=$v ;;
      POOLROT) T_POOLROT=$v ;; POOLBYTES) T_POOLBYTES=$v ;;
      ECH) T_ECH=$v ;; GOVERNOR) T_GOVERNOR=$v ;;
      DNSLISTEN) T_DNSLISTEN=$v ;; SRCIP) T_SRCIP=$v ;;
    esac
  done < <(prof_read "$(prof_path "$pick")")
  hint "Profile '$pick' loaded as the defaults below; press Enter to keep each."
}
prof_only_tunnel() { # the single Iran pool tunnel, when there is exactly one
  local n count=0 pick=''
  for n in $(tunnels); do
    [ "$(role "$n")" = Iran ] && is_pool_list "$(cfg "$n" carrier)" || continue
    count=$((count+1)); pick=$n
  done
  [ "$count" = 1 ] && echo "$pick"
  return 0
}

blackout_cmd() { # name [sni_or_preset] : turn the resilience kit on when a censor starts blocking the tunnel.
  local n=$1 sni=${2:-}
  [ "$(uname -s)" = Linux ] || { err "The resilience kit is a Linux feature (fake-SNI needs CAP_NET_RAW, like the icmp carrier)."; return 1; }
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  ac_dialer "$n" || {
    err "'$n' does not dial the carrier, so anti-censorship runs on its other end (Iran normally, Kharej when reverse)."; return 1; }

  if [ -z "$sni" ] && [ "$NONINTERACTIVE" != 1 ]; then
    echo
    say "  ${BOLD}Blackout Resilience Activation for '$n'${RST}"
    say "  Under an SNI allowlist or blackout, choose an operator preset or allowlisted domain."
    echo
    pick_preset "mci" || return 1; sni=$REPLY_V
  fi
  [ -n "$sni" ] || { err "An allowlisted name or preset is required (blackout $n mci.ir or blackout $n mci)."; return 1; }

  if is_builtin_preset "$sni"; then
    apply_preset "$n" "$sni" || return 1
    if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
      anticensor_test "$n"
    fi
    return 0
  fi

  # Custom SNI domain
  [ "$(role "$n")" = Iran ] && is_pool "$(cfg "$n" carrier)" && ! is_reverse "$n" || {
    err "'$n' is not a direct Iran tunnel on a pool carrier (tcp, tls, ws, wss, h2, h2c, grpc); the kit is client-only and only attaches there."; return 1; }
  v_sni_name "$sni" || return 1
  [ "$(bin_ver_ok 2.7.0)" = 1 ] || { err "fake-sni needs wattun 2.7.0 or newer on this server (run: $SELF update)."; return 1; }
  set_value "$n" fake-sni "$sni"
  set_value "$n" fake-mode rst
  unset_value "$n" fake-ttl
  ok "Resilience kit on: fake-sni $sni (rst mode). pool-rotate stays off; tune later: tunnel page -> o -> k."
  if step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"; then
    ok "Restart applied. Watch whether the link comes back: $SELF test $n"
    if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
      anticensor_test "$n"
    fi
  else
    err "Restart failed: run  systemctl restart ${WAT_PREFIX}@$n"; return 1
  fi
  return 0
}

arm_blackout_cmd() { # name
  local n=$1 r
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n")
  if [ "$r" = Kharej ]; then
    say "  ${BOLD}Arming Kharej '$n' in Fortress Mode for Blackout Resilience${RST}"
    if [ "$(uname -s)" = Linux ]; then
      sysctl -w net.ipv4.icmp_echo_ignore_all=0 >/dev/null 2>&1 || true
      sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || true
      sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || true
      sysctl -w net.core.rmem_max=67108864 >/dev/null 2>&1 || true
      sysctl -w net.core.wmem_max=67108864 >/dev/null 2>&1 || true
    fi
    fw_open 80/tcp >/dev/null 2>&1 || true
    fw_open 443/tcp >/dev/null 2>&1 || true
    fw_open 4443/tcp >/dev/null 2>&1 || true
    fw_open 8443/tcp >/dev/null 2>&1 || true
    fw_open 53/udp >/dev/null 2>&1 || true
    fw_open 4443/udp >/dev/null 2>&1 || true
    set_value "$n" carrier fortress
    [ -n "$(cfg "$n" dns-relay-upstream)" ] || set_value "$n" dns-relay-upstream "1.1.1.1:53"
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1 || true
    ok "Kharej '$n' armed in Fortress Mode (ICMP, TCP:80, TLS:443, WSS:8443, UDP:53)."
    say "  Emergency blackout token for Iran distribution:"
    show_token "$n"
  else
    say "  ${BOLD}Arming Iran '$n' for Autonomous Blackout Failover${RST}"
    set_value "$n" path-probe-max "6s"
    set_value "$n" governor true
    heal_enable >/dev/null 2>&1 || true
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1 || true
    ok "Iran '$n' armed for Autonomous Failover (fast silence detection, auto-heal timer active)."
  fi
  return 0
}

audit_blackout_cmd() { # name
  local n=$1 r pid pass_cnt=0 fail_cnt=0
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  r=$(role "$n")
  echo
  say "  ${BOLD}Blackout Preparedness Audit for '$n' ($r)${RST}"
  echo
  pid=$(systemctl show -p MainPID --value "${WAT_PREFIX}@$n" 2>/dev/null || echo 0)
  if [ -n "$pid" ] && [ "$pid" -gt 0 ] && [ -r "/proc/$pid/status" ]; then
    local cap_eff; cap_eff=$(grep -i CapEff "/proc/$pid/status" 2>/dev/null | awk '{print $2}')
    if [ -n "$cap_eff" ]; then
      ok "Process capabilities active (PID $pid, CapEff $cap_eff)"
      pass_cnt=$((pass_cnt+1))
    else
      warn "Unable to read process capabilities"
      fail_cnt=$((fail_cnt+1))
    fi
  else
    warn "Tunnel process is not currently running"
    fail_cnt=$((fail_cnt+1))
  fi

  if [ "$(uname -s)" = Linux ]; then
    local icmp_ign; icmp_ign=$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null || echo 1)
    if [ "$icmp_ign" = 0 ]; then
      ok "Sysctl: net.ipv4.icmp_echo_ignore_all == 0 (ICMP replies enabled)"
      pass_cnt=$((pass_cnt+1))
    else
      ok "Sysctl: net.ipv4.icmp_echo_ignore_all == 1 (plain ping is off; the ICMP tunnel still receives its packets)"
      pass_cnt=$((pass_cnt+1))
    fi
    local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo cubic)
    if [ "$cc" = bbr ]; then
      ok "Sysctl: congestion control is BBR"
      pass_cnt=$((pass_cnt+1))
    else
      hint "Sysctl: congestion control is $cc (BBR recommended for anti-policing)"
    fi
  fi

  if [ "$r" = Kharej ]; then
    local p53; p53=$(ss -ulnp 2>/dev/null | grep -E ':53\s' || true)
    if [ -n "$p53" ] && [[ "$p53" != *"wattun"* ]]; then
      warn "Port 53/udp bound by another process: $p53"
      fail_cnt=$((fail_cnt+1))
    else
      ok "Port 53/udp available or bound by wattun"
      pass_cnt=$((pass_cnt+1))
    fi
  fi

  local dns_up; dns_up=$(cfg "$n" dns-relay-upstream)
  if [ -n "$dns_up" ]; then
    ok "DNS in-band relay configured ($dns_up)"
    pass_cnt=$((pass_cnt+1))
  else
    hint "DNS in-band relay not configured (default upstreams active)"
  fi

  local st; st=$(systemctl is-active "${WAT_PREFIX}@$n" 2>/dev/null || echo inactive)
  if [ "$st" = active ]; then
    ok "Service ${WAT_PREFIX}@$n is active"
    pass_cnt=$((pass_cnt+1))
  else
    warn "Service ${WAT_PREFIX}@$n is $st"
    fail_cnt=$((fail_cnt+1))
  fi

  echo
  if [ "$fail_cnt" -eq 0 ]; then
    say "  ${GRN}${BOLD}OVERALL STATUS: ARMED & READY FOR BLACKOUT${RST} (${pass_cnt} checks passed)"
  else
    say "  ${YEL}${BOLD}OVERALL STATUS: PARTIALLY ARMED${RST} (${pass_cnt} passed, ${fail_cnt} warnings)"
  fi
  echo
  return 0
}

preset_cmd() { # name [preset]
  local n=$1 p=${2:-}
  [ "$(uname -s)" = Linux ] || { err "Anti-censorship presets are a Linux feature."; return 1; }
  [ -f "$CONF/$n.yml" ] || { err "No tunnel named '$n'."; return 1; }
  ac_dialer "$n" || { err "'$n' does not dial the carrier, so presets run on its other end (Iran normally, Kharej when reverse)."; return 1; }
  if [ -z "$p" ] && [ "$NONINTERACTIVE" != 1 ]; then
    pick_preset "cloudflare" || return 1; p=$REPLY_V
  fi
  [ -n "$p" ] || { err "A preset name is required (preset $n mci). Available: cloudflare, rst-fast, mci, irancell, blackout, conservative"; return 1; }
  v_preset "$p" || return 1
  apply_preset "$n" "$p" || return 1
  if [ -t 0 ] && [ "$NONINTERACTIVE" != 1 ] && [ "${WAT_MANAGER_LIB:-0}" != 1 ]; then
