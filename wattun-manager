        else
          box_row " $(printf '%2d  %-22s %6.1f %6.1f %4.0fms' "$k" "$(at_lbl "${AV_LABEL[$i]}" 22)" "${AR_DOWN[$i]:-0}" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}")${bar_s}"
        fi
      else
        if [ "$k" -eq 1 ]; then
          box_row "${BOLD}${CYN}▸$(printf '%2d  %-18s %6.1f %6.1f %4.0fms ★' "$k" "$(at_lbl "${AV_LABEL[$i]}" 18)" "${AR_DOWN[$i]:-0}" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}")${RST}"
        else
          box_row " $(printf '%2d  %-18s %6.1f %6.1f %4.0fms' "$k" "$(at_lbl "${AV_LABEL[$i]}" 18)" "${AR_DOWN[$i]:-0}" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}")"
        fi
      fi
    done
  fi
  for ((i=0; i<${#AV_LABEL[@]}; i++)); do
    [ "${AR_OK[$i]}" = 1 ] || [ "${AR_WHY[$i]}" = skipped ] || { has_fail=1; break; }
  done
  if [ "$has_fail" = 1 ]; then
    [ "${#AT_RANK[@]}" -gt 0 ] && box_mid
    local maxw=$((BOXW - 30)); [ "$maxw" -lt 12 ] && maxw=12
    for ((i=0; i<${#AV_LABEL[@]}; i++)); do
      [ "${AR_OK[$i]}" = 1 ] || [ "${AR_WHY[$i]}" = skipped ] && continue
      box_row "  ${RED}✘${RST}  $(printf '%-22s' "$(at_lbl "${AV_LABEL[$i]}" 22)") ${GRY}$(at_lbl "${AR_WHY[$i]}" "$maxw")${RST}"
    done
  fi
  box_bot
}
at_to_t() { # AT_SEL (one index, or several = bond) -> T_CARRIER T_PEER T_PATH T_SNI T_REV AT_EXTRA + labels
  local i c cars='' cdn='' l
  AT_EXTRA=''; T_SNI=''; T_REV=''; T_PATH=''
  if [ "${#AT_SEL[@]}" -gt 1 ]; then
    if [ "${AV_KIND[${AT_SEL[0]}]}" = r ]; then
      for i in "${AT_SEL[@]}"; do
        c=${AV_CAR[$i]}; cars="${cars:+$cars+}$c"
        [ -n "${AV_PORT[$i]}" ] && AT_EXTRA+="listen-$c: \":${AV_PORT[$i]}\""$'\n'
      done
      v_carrier_list "$cars" || { err "Cannot join $cars: shaped carriers are single-carrier only."; return 1; }
      AT_EXTRA=${AT_EXTRA%$'\n'}
      T_CARRIER=$cars; T_PEER=$AT_ADDR; T_PATH=$AT_PATH; T_REV=1
      AT_SEL_LABEL="reverse bond $cars"; AT_SEL_KEY=bond/r
      return 0
    fi
    for i in "${AT_SEL[@]}"; do
      c=${AV_CAR[$i]}; cars="${cars:+$cars+}$c"; AT_EXTRA+="peer-$c: ${AV_PEER[$i]}"$'\n'
      # fp / ech / tls-frag are global flags, not per carrier: a bond uses the settings of its first (best) CDN variant
      if [ "${AV_KIND[$i]}" = c ] && [ -z "$cdn" ]; then cdn=$i; T_SNI=${AV_SNI[$i]}; fi
    done
    # B4/D7: a joined list must be a valid bond; the engine refuses a shaped leg in a '+'-bond, so never write one
    v_carrier_list "$cars" || { err "Cannot join $cars: shaped carriers are single-carrier only."; return 1; }
    AT_EXTRA=${AT_EXTRA%$'\n'}
    if [ -n "$cdn" ]; then while IFS= read -r l; do [ -n "$l" ] && AT_EXTRA+=$'\n'"$l"; done < <(at_cdn_lines "$cdn"); fi
    T_CARRIER=$cars; T_PEER=$AT_ADDR; T_PATH=$AT_PATH
    at_hop_line
    AT_SEL_LABEL="bond $cars"; AT_SEL_KEY=bond
    return 0
  fi
  i=${AT_SEL[0]}; c=${AV_CAR[$i]}
  T_CARRIER=$c; T_PEER=${AV_PEER[$i]}
  case "$c" in ws|wss|h2|h2c|grpc|*+*) T_PATH=$AT_PATH ;; esac
  if [ "${AV_KIND[$i]}" = c ]; then T_SNI=${AV_SNI[$i]}; AT_EXTRA=$(at_cdn_lines "$i"); fi
  if av_anti "$i"; then
    T_SNI=${AV_SNI[$i]}; AT_EXTRA=$(at_cdn_lines "$i")
    [ -n "${AV_FS[$i]}" ] && AT_EXTRA+="${AT_EXTRA:+$'\n'}fake-sni: ${AV_FS[$i]}"$'\n'"fake-mode: ${AV_FM[$i]:-seq}"
  fi
  [ "${AV_KIND[$i]}" = r ] && T_REV=1
  if [[ "$c" == *+* ]] && [ "${AV_KIND[$i]}" = r ] && [ -n "${AT_TUNNEL:-}" ]; then
    local rc rp
    for rc in ${c//+/ }; do
      rp=$(cfg "$AT_TUNNEL" "listen-$rc")
      [ -n "$rp" ] && AT_EXTRA+="${AT_EXTRA:+$'\n'}listen-$rc: $rp"
    done
  fi
  at_hop_line
  AT_SEL_LABEL=${AV_LABEL[$i]}; AT_SEL_KEY=$(av_key "$i")
}
AT_JD=''; AT_JR=''
at_joinable_summary() { # fills AT_JD (joinable direct/CDN row numbers) and AT_JR (joinable reverse row numbers)
