    kind=${AV_KIND[$i]}
    if [ "$AT_STOP" = 1 ]; then at_truncate "$i"; break; fi
    if av_anti "$i" && [ -n "$AT_GSKIP" ] && [ "${AV_CAR[$i]}" = "$AT_GSKIP" ]; then
      AR_OK[$i]=0; AR_DOWN[$i]=0; AR_UP[$i]=0; AR_RTT[$i]=0; AR_WHY[$i]=skipped; continue
    fi
    if av_anti "$i" && [ "$last" != anti ] && [ "$AT_QUIET" != 1 ]; then echo; say "  ${BOLD}Anti-censor variants${RST} (direct, with desync / fingerprint / fragmentation)"; last=anti; fi
    if [ "$kind" != "$last" ] && [ "$last" != anti ] && [ "$AT_QUIET" != 1 ]; then
      case "$kind" in
        d) say "  ${BOLD}Direct connections${RST}" ;;
        c) echo; say "  ${BOLD}Through the CDN${RST} ($T_SNI)"; [ "$CS_RAN" = 1 ] && cdn_scan_say ;;
        r) echo; say "  ${BOLD}Reverse${RST} (Kharej connects out to this server)" ;;
      esac
    fi
    av_anti "$i" || last=$kind
    if [ "$kind" = r ] && is_pool "${AV_CAR[$i]}"; then
      pool=(); for ((j=i; j<n; j++)); do [ "${AV_KIND[$j]}" = r ] && is_pool "${AV_CAR[$j]}" && pool+=("$j"); done
      AT_MB=$(at_probe_mb "$best_rate" 1.5 "$AT_SCREEN_CAP_MB")
