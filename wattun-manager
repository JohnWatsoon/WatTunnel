    [ "${AR_OK[$i]:-0}" = 1 ] || continue
    m=$(awk -v a="${AR_DOWN[$i]:-0}" -v b="${AR_UP[$i]:-0}" -v p="$AT_PEAK" 'BEGIN{m=(a>b)?a:b; print (m>p)?m:p}')
