  [ "$AT_QUIET" = 1 ] || hint "Budget: $AT_PLAN (worst case: screening + finalists + tuning; a variant that does not connect sends almost nothing)."
  AT_MB=$AT_SCREEN_MB_START; best_rate=0 # H3: screening starts at 8 MB and grows only if the measured rate says it is short
  AT_KEYS=0; [ "$IS_TTY" = 1 ] && [ "$AT_QUIET" != 1 ] && [ -t 0 ] && AT_KEYS=1
  if [ "$AT_KEYS" = 1 ]; then
    AT_STTY=$(stty -g 2>/dev/null); stty -echo 2>/dev/null # typed s/g/q must not print between polls; at_cleanup restores
    while IFS= read -rsn1 -t 0.01 _; do :; done # drop keys typed before the test
    if [ "$AT_PRESET" = anti ]; then hint "Keys: s = skip this variant   g = skip this carrier's anti-censor variants   q = stop and choose from what was tested"
    else hint "Keys: s = skip this variant   q = stop and choose from what was tested"; fi
    echo
  fi
