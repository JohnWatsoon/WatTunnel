}
auto_current_key() { # name -> carrier/kind of the running config (d direct, c CDN, r reverse) or bond / bond/r
  local c; c=$(cfg "$1" carrier)
  case "$c" in *+*) is_reverse "$1" && echo bond/r || echo bond; return ;; esac
  if is_reverse "$1"; then echo "$c/r"; elif [ -n "$(cfg "$1" sni)" ]; then echo "$c/c"; elif [ -n "$(cfg "$1" udp-hop)" ]; then echo "$c/d/hop"; else echo "$c/d"; fi
}
auto_apply() { # name : write the chosen variant (T_*, AT_EXTRA) into NAME.yml, restart, wait for the link
  local n=$1 f="$CONF/$1.yml" ol l k v rport='' curkey c bak tokbak='' lc lv p
  local -a old_rfw=() new_rfw=()
  # B2: the guard that makes "applying a skipped carrier" impossible even if a caller bypasses the variant builder
  for c in ${T_CARRIER//+/ }; do
    carrier_ok_here "$c" || { err "Carrier '$c' needs wattun $(carrier_min_ver "$c") on this server; not writing it into '$n'."; return 1; }
  done
  bak="$f.bak"
  cp -p "$f" "$bak" || { err "Could not back up $f; not applying."; return 1; } # F16: restore on a failed link check
  tokbak="$CONF/$n.token.bak"
  [ -f "$CONF/$n.token" ] && cp -p "$CONF/$n.token" "$tokbak" # the token is rewritten below; restore it too when the link fails
  AT_APPLIED=1
  curkey=$(auto_current_key "$n")
  if is_reverse "$n"; then
    ol=$(cfg "$n" listen); split_hp "$ol"
    [ -n "$HP_PORT" ] && is_rpool "$(cfg "$n" carrier)" && old_rfw+=("$HP_PORT/$(rproto "$(cfg "$n" carrier)")")
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      lc=${l%%:*}; lc=${lc#listen-}; lv=${l#*:}; lv=${lv//\"/}; lv=${lv//[[:space:]]/}
      split_hp "$lv"
      [ -n "$HP_PORT" ] && old_rfw+=("$HP_PORT/$(rproto "$lc")")
    done < <(grep -E '^listen-[a-z0-9-]+:' "$f" 2>/dev/null)
  fi
  sed -i -E '/^(carrier|peer|path|sni|host|reverse|listen|fp|ech|ech-cache|tls-frag|udp-hop|peer-[a-z0-9-]+|listen-[a-z0-9-]+):/d' "$f"
  # settings the tuning tested: its result replaces them. On a switch to another type all of them go: a value tuned for one
  # type can break another (the engine refuses sessions with icmp, bonds and reverse)
  [ "$curkey" = "$(cut -d/ -f1,2 <<<"${AT_SEL_KEY:-}")" ] || AT_TUNE_KEYS='sessions conns mtu batch loss-ceiling win-max'
  for k in $AT_TUNE_KEYS; do sed -i "/^$k:/d" "$f"; done
  set_value "$n" carrier "$T_CARRIER"
  # a working fake-SNI/pool-rotate combination survives a type switch only while the new carrier set has
  # a pool leg and this side is the dialer (the desync layer attaches to every pool leg of a bond, nowhere
  # else); strip it otherwise, so switching to icmp/udp/reverse never leaves dead keys (or silently re-arms
  # them when the type is switched back later)
  local keepres=''
  if is_pool_list "$T_CARRIER"; then
    if [ "$T_REV" = 1 ]; then
      [ "$(role "$n")" = Kharej ] && keepres=1
    else
      [ "$(role "$n")" = Iran ] && keepres=1
    fi
  fi
  [ "$keepres" = 1 ] || sed -i -E '/^(fake-(sni|mode|ttl)|pool-rotate(-bytes)?):/d' "$f"
  set_value "$n" peer "$T_PEER"
  [ -n "$T_PATH" ] && set_value "$n" path "$T_PATH"
  if is_shaped_carrier "$T_CARRIER"; then # B4: shaped carriers are single-carrier only; raw tier has no listen port
    if [ "$(role "$n")" = Kharej ] && is_shaped_udp "$T_CARRIER"; then
      local sp; sp=$(shaped_udp_port "$T_CARRIER"); split_hp "$T_PEER"; [ -n "$HP_PORT" ] && sp=$HP_PORT
      set_value "$n" listen "\":$sp\""; fw_open "$sp/udp"
    fi
    if [ "$(role "$n")" = Iran ] && [ -n "${T_KEY:-}" ]; then # a reusable token describing the chosen shape
      # F11 (2026-11-22): T_PAIR is make_token's $10 (the pair capability); it sat in $9 (auto plan) here,
      # so a field-10 token was rewritten with its capability as a bogus plan. $9 stays empty on an apply.
      ( umask 077; make_token "$T_CARRIER" "$T_PEER" "$T_KEY" "${T_PATH:-}" "${T_SNI:-}" "${T_ICMP:-}" "${T_PORTS:-}" "" "" "${T_PAIR:-}" >"$CONF/$n.token" )
    fi
  fi
  if [ -n "$T_SNI" ]; then set_value "$n" sni "$T_SNI"; set_value "$n" host "$T_SNI"; fi
  [ "$T_REV" = 1 ] && set_value "$n" reverse true
  if [ "$T_REV" = 1 ] && [[ "$T_CARRIER" != *+* ]] && is_rpool "$T_CARRIER"; then
    split_hp "$T_PEER"; rport=$HP_PORT
    [ -n "$rport" ] && { set_value "$n" listen "\":$rport\""; new_rfw+=("$rport/$(rproto "$T_CARRIER")"); }
  fi
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    k=${l%%: *}; v=${l#*: }; set_value "$n" "$k" "$v"
    if [ "$T_REV" = 1 ] && [[ "$k" == listen-* ]]; then
      lc=${k#listen-}; lv=${v//\"/}; lv=${lv//[[:space:]]/}
      split_hp "$lv"
      [ -n "$HP_PORT" ] && new_rfw+=("$HP_PORT/$(rproto "$lc")")
    fi
  done <<<"$AT_EXTRA"
  l=$(ech_cache_line "$n"); if [ -n "$l" ]; then set_value "$n" ech-cache "${l#*: }"; fi
  step "Restarting ${WAT_PREFIX}@$n" systemctl restart "${WAT_PREFIX}@$n"
  for p in ${new_rfw[@]+"${new_rfw[@]}"}; do fw_open "$p"; done
  for p in ${old_rfw[@]+"${old_rfw[@]}"}; do
    case " ${new_rfw[*]:-} " in *" $p "*) ;; *) fw_close "$p" ;; esac
  done
  if [ "$T_REV" = 1 ] && [[ "+$T_CARRIER+" == *+icmp+* ]]; then
    [ "$AT_QUIET" = 1 ] || kreply_offer
  else kreply_users_left || kreply_restore; fi
  # AT_QUIET=1 applies and restarts without waiting unless AT_VERIFY=1 (auto_retest verifies and rolls back on failure).
  [ "$AT_QUIET" = 1 ] && [ "${AT_VERIFY:-0}" != 1 ] && { rm -f "$bak" "$tokbak"; return 0; }
  if wait_link "$n" 25; then
    ok "CONNECTED — ${AT_SEL_LABEL:-$T_CARRIER} · RTT ${LINK_RTT} ms"; rm -f "$bak" "$tokbak"
  else
    warn "Not connected yet; restoring the previous config."
    if cp -p "$bak" "$f"; then
      [ -f "$tokbak" ] && cp -p "$tokbak" "$CONF/$n.token"
      rm -f "$bak" "$tokbak"
      AT_APPLIED=0 # the variant was rolled back; change_key must not treat its key as applied
      for p in ${new_rfw[@]+"${new_rfw[@]}"}; do
        case " ${old_rfw[*]:-} " in *" $p "*) ;; *) fw_close "$p" ;; esac
      done
      for p in ${old_rfw[@]+"${old_rfw[@]}"}; do fw_open "$p"; done
    else
      warn "Could not restore $f; the backup is kept at $bak (and $tokbak)."
      { [ "$NONINTERACTIVE" = 1 ] || [ "${AT_VERIFY:-0}" = 1 ]; } && return 1
      return 0
    fi
    systemctl restart "${WAT_PREFIX}@$n" >/dev/null 2>&1
    { [ "$NONINTERACTIVE" = 1 ] || [ "${AT_VERIFY:-0}" = 1 ]; } && return 1
  fi
  return 0
}
at_skip_reverse_keys() { # tunnel -> space-padded AT_SKIP of active reverse leg keys (" tls/r wss/r ")
  is_reverse "$1" || return 0
  local c out=' '
  for c in $(tr '+' ' ' <<<"$(cfg "$1" carrier)"); do [ -n "$c" ] && out+="$c/r "; done
  printf '%s' "$out"
}
at_probe_live_tunnel() { # tunnel : measure the running reverse tunnel via its own /speedtest when its port was skipped
  local n=$1 cur m mp s i idx='' save_mb=$AT_MB
  is_reverse "$n" || return 0
  m=$(cfg "$n" metrics); mp=${m##*:}
  [[ "$mp" =~ ^[0-9]+$ ]] || return 0
  s=$(stats "$n" 2>/dev/null) || return 0
  [ "$(jget "$s" alive)" = true ] || return 0
  cur=$(auto_current_key "$n")
  if [ "$cur" = bond/r ]; then
    av_add "reverse bond $(cfg "$n" carrier) (current)" "$(cfg "$n" carrier)" r "$AT_ADDR" '' ''
    idx=$((${#AV_LABEL[@]} - 1))
  else
    for ((i=0; i<${#AV_LABEL[@]}; i++)); do
      [ "$(av_key "$i")" = "$cur" ] && { idx=$i; break; }
    done
  fi
  [ -n "$idx" ] || return 0
  AR_OK[$idx]=0; AR_DOWN[$idx]=0; AR_UP[$idx]=0; AR_RTT[$idx]=0; AR_WHY[$idx]=''
  AT_MB=${AT_LIVE_MB:-8}
  [ "$AT_QUIET" = 1 ] || at_busy "${AV_LABEL[$idx]} (live tunnel)"
  at_measure "$idx" "$mp"
  [ "$AT_QUIET" = 1 ] || { at_idle; at_print "$idx"; }
  AT_MB=$save_mb
  return 0
}
auto_test_cmd() { # name : re-run the test for an existing auto Iran tunnel and offer to switch
  local n=$1 cur i nolink=0
  if [ "$(role "$n")" != Iran ] || [ ! -f "$CONF/$n.auto" ]; then
    err "'$n' is not an auto Iran tunnel (it has no $n.auto). Create it with the token from an auto Kharej tunnel."; return 1
  fi
  if ! { read_token "$(cat "$CONF/$n.auto")" && [ -n "$T_AUTO" ]; }; then err "$CONF/$n.auto is not a valid auto token."; return 1; fi
  AT_TUNNEL=$n
  cur=$(auto_current_key "$n")
  AT_QUIET=0; AT_MB=8; AT_NOTE=""; AT_SKIP=$(at_skip_reverse_keys "$n"); AT_AGAIN="$SELF auto-test $n"
  page "Auto test" "$n"
  hint "Current: $cur ($(cfg "$n" carrier)) · live tunnel untouched"
  at_preset_ask || { warn "Cancelled."; return 0; }
  echo
  auto_test || { err "Could not prepare the test (is $AUTO_RUN writable?)."; return 1; }
  AT_LIVE_MB=8 at_probe_live_tunnel "$n"
  at_rank; auto_refine
  for ((i=0; i<${#AV_LABEL[@]}; i++)); do
    [ "${AR_OK[$i]:-0}" = 1 ] && continue
    [[ "${AR_WHY[$i]:-}" == "no link"* ]] && nolink=$((nolink+1))
  done
  if [ "${#AT_RANK[@]}" -eq 0 ]; then
    echo; at_none
