      lproto=$(rproto "$lc")
      case " ${n_fw[*]:-} " in *" $HP_PORT/$lproto "*) ;; *) n_fw+=("$HP_PORT/$lproto") ;; esac
    fi
  done < <(grep -E '^listen(-[a-z0-9-]+)?:' "$CONF/$n.yml" 2>/dev/null || true)
  if [ -f "$CONF/$n-r.yml" ] && is_auto_kharej "$n"; then # the auto reverse companion goes with its parent
    auto_drop_unit "$n-r"
  fi
  for f in $(auto_ext_names "$n"); do auto_drop_unit "$f"; done # B3/F08/F17: the hidden listeners, their state and UDP rules
  if is_auto_kharej "$n" && [ ! -f "$CONF/$n-r.yml" ]; then # the reverse side's config may be gone already: its state files go too
    while IFS= read -r f; do rm -f "$f"; done < <(state_files "$n-r")
  fi
  systemctl stop "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
  systemctl reset-failed "${WAT_PREFIX}-autowatch-$n.service" >/dev/null 2>&1
