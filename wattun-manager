      r|R) echo; if confirm "Restart all tunnels? Open connections drop." n; then restart_all; sleep 1; fi ;;
      a|A) if [ "$(conf_get anim 1)" = 1 ]; then conf_set anim 0; ANIM=0; else conf_set anim 1; [ "$IS_TTY" = 1 ] && [ "${WAT_NO_ANIM:-0}" != 1 ] && ANIM=1; fi ;;
      b|B) boost_menu ;;
      c|C) { [ "$sd" = kharej ] || [ -z "$sd" ] || pairing_active; } || { warn "Pairing is managed on Kharej."; sleep 1; continue; }
           echo; scepter_menu ;;
      p|P)
        echo
        hint "https://ghproxy.net/ · socks5h://127.0.0.1:1080 · '-' to clear"
        ask "Update proxy / mirror URL" "$up_px"
        if [ "$REPLY_V" = "-" ]; then sed -i '/^update-proxy=/d' "$MCONF" 2>/dev/null || true; ok "Cleared update proxy."
        elif [ -n "$REPLY_V" ]; then conf_set update-proxy "$REPLY_V"; ok "Saved update proxy: $REPLY_V"; fi
        sleep 1 ;;
      w|W) ask_side || true ;;
      0|q|enter|esc) return 0 ;;
      *) : ;;
    esac
  done
