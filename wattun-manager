# 3.3.8: recover NAME.token when an older 3.3.3-3.3.7 finalize (or manual rm) removed it, so show_token, change_key
# and main-menu o work on existing Kharej tunnels without deleting and recreating them.
rebuild_kharej_token() { # name -> rc 0 when NAME.token exists or was rebuilt
  local n=$1 key allow apath sni itype addr='' tf cr rev='' lis lp='' pip rplan dplan
  [ "$(role "$n")" = Kharej ] || return 1
  [ -f "$CONF/$n.token" ] && return 0
  key=$(head -1 "$CONF/$n.key" 2>/dev/null || true); [ -n "$key" ] || return 1
  load_maps "$n"; allow=$(maps_allow_str)
  apath=$(cfg "$n" path); sni=$(cfg "$n" sni); itype=$(cfg "$n" icmp-type)
  for tf in "$CONF"/*.token; do
    [ -e "$tf" ] || continue
    if read_token "$(cat "$tf")" && [ -n "$T_PEER" ]; then split_hp "${T_PEER%%,*}"; addr=$HP_HOST; break; fi # M1: a bond token's first entry carries the host
  done
  [ -n "$addr" ] || addr=$(public_ip)
  [ -n "$addr" ] || addr=$(out_ip 8.8.8.8)
  if [ -z "$addr" ] && [ "$NONINTERACTIVE" != 1 ] && [ -t 0 ]; then
    ask_ok "Public IP or domain of this server" "" v_host && { split_hp "$REPLY_V"; addr=$HP_HOST; }
  fi
  [ -n "$addr" ] || return 1
  cr=$(cfg "$n" carrier); is_reverse "$n" && rev=1
  if head -1 "$CONF/$n.yml" 2>/dev/null | grep -Eq 'Kept by wattun-manager from auto tunnel|auto: every carrier at once'; then
    if [ "$rev" = 1 ]; then
      pip=$(cfg "$n" peer-icmp); [ -n "$pip" ] || { split_hp "$(cfg "$n" peer)"; pip=$HP_HOST; lp=$HP_PORT; }
      [ -n "$pip" ] && ( umask 077; printf '%s\n' "$pip" >"$CONF/$n.iranip" ) 2>/dev/null || true
    else
      lis=$(cfg "$n" listen); split_hp "$lis"; lp=$HP_PORT
    fi
    auto_pick_ports "$([ -n "$sni" ] && echo 1 || echo 0)" || return 1
    dplan=$AUTO_D; rplan=$(auto_pick_rplan "$AUTO_USED_PORTS") || return 1
    if [ -n "$lp" ] && [[ "$cr" != *+* ]]; then
      if [ "$rev" = 1 ]; then rplan=$(sed -E "s/(^|,)$cr:[0-9]+/\1$cr:$lp/" <<<"$rplan")
      elif ! is_shaped_carrier "$cr"; then dplan=$(sed -E "s/(^|,)$cr:[0-9]+/\1$cr:$lp/" <<<"$dplan"); fi
    fi
    ( umask 077
      make_token auto "$addr" "$key" "${apath:-/wat}" "$sni" "" "$allow" "" "d=$dplan;r=$rplan" >"$CONF/$n.token"
      : >"$CONF/$n.repaste" ) # new ports: Iran's saved plan is stale until this token is pasted there (cleared by show_token)
    return 0
  fi
  lis=$(cfg "$n" listen); split_hp "$lis"; lp=$HP_PORT
  if [ -z "$lp" ] && [ "$rev" = 1 ]; then split_hp "$(cfg "$n" peer)"; lp=$HP_PORT; fi
  [ "$(cfg "$n" udp-dns)" = true ] && apath=dns
  ( umask 077; make_token "$cr" "$(join_hp "$addr" "$lp")" "$key" "$apath" "$sni" "$itype" "$allow" "$rev" >"$CONF/$n.token" )
