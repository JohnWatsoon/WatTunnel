    fi
    w=8; [ "$kind" = r ] && [ "${AV_CAR[$i]}" = icmp ] && w=30 # Kharej's companion needs a few seconds to start
    AT_MB=$(at_probe_mb "$best_rate" 1.5 "$AT_SCREEN_CAP_MB") # H3: duration-based size, 8 -> x4 while under 1.5 s
    [ "$AT_QUIET" = 1 ] || at_busy "${AV_LABEL[$i]}"
    at_probe "$i" "$w"
    best_rate=$(at_best_rate "$best_rate" "$i")
    [ "$AT_QUIET" = 1 ] || { at_idle; [ "${AR_WHY[$i]}" = skipped ] && printf '  %s-%s %-28s %sskipped%s\n' "$GRY" "$RST" "${AV_LABEL[$i]}" "$GRY" "$RST" || at_print "$i"; }
    case "$AT_ACT" in group) av_anti "$i" && AT_GSKIP=${AV_CAR[$i]} ;; stop) AT_STOP=1; AR_WHY[$i]=skipped ;; esac
    AT_ACT=''
    if [ "$kind" = c ] && cdn_ok && [ "${AV_KIND[$((i+1))]:-}" != c ]; then cdn_auto_extras; fi
  done
