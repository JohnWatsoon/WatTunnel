}
at_truncate() { # k : keep only the first k variants (the test was stopped before the rest)
  local k=$1
  AV_LABEL=("${AV_LABEL[@]:0:$k}"); AV_CAR=("${AV_CAR[@]:0:$k}"); AV_KIND=("${AV_KIND[@]:0:$k}"); AV_PEER=("${AV_PEER[@]:0:$k}")
  AV_PORT=("${AV_PORT[@]:0:$k}"); AV_SNI=("${AV_SNI[@]:0:$k}"); AV_FP=("${AV_FP[@]:0:$k}"); AV_ECH=("${AV_ECH[@]:0:$k}")
  AV_FRAG=("${AV_FRAG[@]:0:$k}"); AV_FS=("${AV_FS[@]:0:$k}"); AV_FM=("${AV_FM[@]:0:$k}"); AV_X=("${AV_X[@]:0:$k}")
  AR_OK=("${AR_OK[@]:0:$k}"); AR_DOWN=("${AR_DOWN[@]:0:$k}"); AR_UP=("${AR_UP[@]:0:$k}"); AR_RTT=("${AR_RTT[@]:0:$k}"); AR_WHY=("${AR_WHY[@]:0:$k}")
}
at_rank() { # [policy] -> AT_RANK (working variants, best first: policy driven)
  local pol=${1:-${NI_POLICY:-}} i
  if [ -z "$pol" ] && [ -n "${AT_TUNNEL:-}" ] && [ -f "$CONF/$AT_TUNNEL.policy" ]; then
    pol=$(cat "$CONF/$AT_TUNNEL.policy" 2>/dev/null || echo speed)
  fi
  : "${pol:=speed}"
  AT_RANK=()
  case "$pol" in
    latency)
      while read -r _ _ i; do [ -n "$i" ] && AT_RANK+=("$i"); done < <(
        for ((i=0; i<${#AV_LABEL[@]}; i++)); do
          [ "${AR_OK[$i]}" = 1 ] && awk -v d="${AR_DOWN[$i]:-0}" -v u="${AR_UP[$i]:-0}" -v r="${AR_RTT[$i]:-0}" -v i="$i" 'BEGIN{printf "%.3f %.6f %d\n", r, d+u, i}'
        done | sort -k1,1g -k2,2gr)
      ;;
    direct)
      while read -r _ _ _ i; do [ -n "$i" ] && AT_RANK+=("$i"); done < <(
        for ((i=0; i<${#AV_LABEL[@]}; i++)); do
          local dir_p=0
          case "${AV_CAR[$i]}" in tcp|tls|udp|icmp) [ "${AV_KIND[$i]}" = d ] && dir_p=1 ;; esac
          [ "${AR_OK[$i]}" = 1 ] && awk -v dp="$dir_p" -v d="${AR_DOWN[$i]:-0}" -v u="${AR_UP[$i]:-0}" -v r="${AR_RTT[$i]:-0}" -v i="$i" 'BEGIN{printf "%d %.6f %.3f %d\n", dp, d+u, r, i}'
        done | sort -k1,1nr -k2,2gr -k3,3g)
      ;;
    bond|speed|*)
      while read -r _ _ i; do [ -n "$i" ] && AT_RANK+=("$i"); done < <(
        for ((i=0; i<${#AV_LABEL[@]}; i++)); do
          # an anti-censor variant must beat the plain type by 8 % to rank above it (noise, plus its startup cost)
          [ "${AR_OK[$i]}" = 1 ] && awk -v pen="$(av_anti "$i" && echo 0.92 || echo 1)" -v d="${AR_DOWN[$i]:-0}" -v u="${AR_UP[$i]:-0}" -v r="${AR_RTT[$i]:-0}" -v i="$i" 'BEGIN{printf "%.6f %.3f %d\n", (d+u)*pen, r, i}'
        done | sort -k1,1gr -k2,2g)
      ;;
  esac
}
at_table() {
  local i k=0
  echo
  printf '  %s%3s  %-28s %12s %12s %7s%s\n' "$GRY" '#' variant down up rtt "$RST"
  for i in "${AT_RANK[@]}"; do
    k=$((k+1))
    printf '  %s%3s%s  %-28s %7.1f MB/s %7.1f MB/s %4.0f ms\n' "$BOLD$CYN" "$k" "$RST" "${AV_LABEL[$i]}" "${AR_DOWN[$i]:-0}" "${AR_UP[$i]:-0}" "${AR_RTT[$i]:-0}"
  done
  for ((i=0; i<${#AV_LABEL[@]}; i++)); do
    [ "${AR_OK[$i]}" = 1 ] || [ "${AR_WHY[$i]}" = skipped ] || printf '  %s  ✘  %-28s %s%s%s\n' "$RED" "${AV_LABEL[$i]}" "$GRY" "${AR_WHY[$i]}" "$RST"
  done
  hint "${AT_NOTE:-Tested with ${AT_MB} MB each way.} Finished in ${AT_SECS} s.${AT_PLAN:+ Budget: $AT_PLAN.}"
