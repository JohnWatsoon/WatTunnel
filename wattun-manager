at_failed() { # prints the indices of variants that failed the test ; rc 1 when none did
  local i any=1
  for ((i=0; i<${#AV_LABEL[@]}; i++)); do [ "${AR_OK[$i]}" = 1 ] || { echo "$i"; any=0; }; done
