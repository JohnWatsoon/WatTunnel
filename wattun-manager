# Time estimates shown in the Test mode menu (one table so they can be tuned without touching the box rows):
# screening rows x ~20 s a row at the 8-16 MB probe sizes and the ~8 MB/s budget rate, rounded to a range.
#   normal  ~14 rows  -> ~1-3 min    fast    ~14 + 7x6 rows -> ~4-6 min
#   anti    ~200 rows -> ~15-40 min  reverse ~8 rows        -> ~1-2 min
at_preset_ask() { # -> AT_PRESET normal|anti|fast|reverse|extended (--test in unattended runs), T_SNI (CDN domain, d) ; rc 1 = cancelled
  AT_PRESET=${NI_TEST:-normal}
  [ "$NONINTERACTIVE" = 1 ] && return 0
  [ "${UI_W:-0}" -gt 0 ] || ui_init_width
  local t dom_lbl ext ext_n=0 meta
  ext=$(auto_plan_extnames "$(plan_part "${T_AUTO:-}" d)")
  for t in $ext; do ext_n=$((ext_n+1)); done
  meta="Kharej ${T_PEER%%[:,]*} · ${T_PORTS:-any port}"
  [ "$ext_n" -gt 0 ] && meta+=" · +${ext_n} shaped"
  echo
  hint "$meta"
  for t in 1 2 3 4 5 6; do
    dom_lbl="${T_SNI:-none (optional)}"
    echo
    box_top "Test mode"
    box_row "$(key_label Enter)  Standard carriers     ${GRY}Direct, CDN, Reverse        ~1-3 min${RST}"
    box_row "$(key_label f)      Anti-censor fast      ${GRY}rst/synrst x 3 SNIs,       ~4-6 min${RST}"
    box_row "                               ${GRY}best row applied${RST}"
    box_row "$(key_label a)      + Anti-censor         ${GRY}full grid, fake-SNI, fp   ~15-40 min${RST}"
    box_row "$(key_label x)      + Extended            ${GRY}13 shaped carriers         ~4-7 min${RST}"
    box_row "$(key_label r)      Reverse only          ${GRY}just the r= plan carriers ~1-2 min${RST}"
    box_row "$(key_label d)      Cloudflare domain     ${GRY}$dom_lbl${RST}"
    box_row "$(key_label q)      Cancel"
    box_bot
    printf '  %s?%s Choice %s[Enter]%s %s›%s ' "$CYN" "$RST" "$GRY" "$RST" "$GRY" "$RST"
    key_read
    case "$KEY" in
      enter) AT_PRESET=normal; echo; return 0 ;;
      f|F) AT_PRESET=fast; echo; return 0 ;;
      a|A) AT_PRESET=anti; echo; return 0 ;;
      x|X) if [ -z "$(auto_plan_extnames "$(plan_part "$T_AUTO" d)")" ]; then
             echo; warn "This token has no extended carriers: Kharej made it before 3.6.0 or cannot run them. Update Kharej, show its token (t) and paste it here."; continue
           fi
           AT_PRESET=extended; echo; return 0 ;;
      r|R) AT_PRESET=reverse; echo; return 0 ;;
      d|D) echo; hint "Domain proxied to Kharej via Cloudflare (orange cloud, SSL Full)."
           ask_ok "Cloudflare domain" "$T_SNI" v_domain_opt || continue; T_SNI=$REPLY_V
           if [ -n "$T_SNI" ] && [ -n "${T_AUTO:-}" ]; then
             local _d _c _p _cf_any=0 _noncf=''
             _d=$(plan_part "$T_AUTO" d)
             for _c in $AUTO_VAR_CDN; do
               _p=$(plan_port "$_d" "$_c"); [ -n "$_p" ] || continue
               if cf_port_ok "$_c" "$_p"; then _cf_any=1; else _noncf+="${_noncf:+, }$_c:$_p"; fi
             done
             if [ "$_cf_any" = 0 ] && [ -n "$_noncf" ]; then
               warn "Token CDN ports ($_noncf) are not Cloudflare orange-cloud ports (443/2053/2083/2087/2096/8443)."
             fi
           fi ;;
      q|Q|esc) echo; return 1 ;;
      *) echo ;;
    esac
  done
  return 1
}
auto_iran_front() { # token : test everything, ranked table, choose. Leaves T_* ready for the normal flow
  AUTO_TOKEN=$1
  [ -n "$T_AUTO" ] || { err "This auto token has no test plan. Make a new token on Kharej (wattun 2.1.0 or newer)."; return 1; }
  at_preset_ask || { warn "Cancelled."; return 1; }
