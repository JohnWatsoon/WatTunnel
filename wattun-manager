TI_STATE=stopped; TI_RTT=0; TI_STREAMS=0; TI_SESS=0; TI_IN=0; TI_OUT=0; TI_RATE=0; TI_RAW=''
TI_CAR_COUNT=0; TI_CAR_ALIVE=0; TI_CAR_MUTED=0
CAR_COUNT=0; CAR_NAME=(); CAR_ALIVE=(); CAR_RTT=(); CAR_LOSS=(); CAR_SHARE=(); CAR_MUTED=()
parse_carriers() { # json
  local json=$1 carr_block item
  CAR_COUNT=0; CAR_NAME=(); CAR_ALIVE=(); CAR_RTT=(); CAR_LOSS=(); CAR_SHARE=(); CAR_MUTED=()
  carr_block=$(grep -o '"carriers": *\[[^]]*\]' <<<"$json" | head -1)
  [ -n "$carr_block" ] || return 0
  while read -r item; do
    [ -n "$item" ] || continue
    local nm al rtt ls sh mu
    nm=$(grep -o '"name": *"[^"]*"' <<<"$item" | head -1 | cut -d'"' -f4)
    al=$(grep -o '"alive": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    rtt=$(grep -o '"srtt_ms": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    ls=$(grep -o '"loss": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    sh=$(grep -o '"share": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    mu=$(grep -o '"muted": *[^,}]*' <<<"$item" | head -1 | sed 's/.*: *//; s/"//g')
    CAR_NAME+=("${nm:-unknown}")
    CAR_ALIVE+=("${al:-false}")
    CAR_RTT+=("${rtt:-0}")
    CAR_LOSS+=("${ls:-0}")
    CAR_SHARE+=("${sh:-0}")
    CAR_MUTED+=("${mu:-false}")
    CAR_COUNT=$((CAR_COUNT+1))
  done < <(grep -o '{[^{}]*}' <<<"$carr_block")
}
tinfo() { # name -> TI_*  (state: up | degraded | down | standby | unknown | stopped), TI_WHY says why when it is not obvious
  local par other='' s='' on=0 miss=0
  TI_STATE=stopped; TI_RTT=0; TI_STREAMS=0; TI_SESS=0; TI_IN=0; TI_OUT=0; TI_RATE=0; TI_RAW=''; TI_WHY=''
  TI_CAR_COUNT=0; TI_CAR_ALIVE=0; TI_CAR_MUTED=0; TI_LIVE=$(cfg "$1" carrier); TI_AUTO=0
  par=$(companion_of "$1")
  if [ -n "$par" ]; then TI_AUTO=1; other=$par # all types open, Iran uses one: the dead rest is normal
  elif is_auto_kharej "$1"; then TI_AUTO=1; fi
  [ -z "$par" ] && [ "$(companion_of "$1-r")" = "$1" ] && other=$1-r
  systemctl is-active -q "${WAT_PREFIX}@$1" 2>/dev/null && on=1
  # an auto Kharej is one tunnel on two units: Iran's link may be on either, and only that one reports it.
  # A busy host can miss the 2 s stats limit, so try twice: no answer is not "no link".
  if [ -n "$other" ] && systemctl is-active -q "${WAT_PREFIX}@$other" 2>/dev/null; then
    s=$(stats "$other") || s=$(stats "$other") || miss=1
  fi
  if [ "$on" = 1 ]; then
    TI_RAW=$(stats "$1") || TI_RAW=$(stats "$1") || TI_RAW=''
    if [ -z "$TI_RAW" ]; then TI_STATE=unknown; TI_WHY='stats did not answer, status not known'; return 0; fi
  elif [ -z "$par" ] && [ -n "$s" ]; then TI_RAW=$s
  elif [ -z "$par" ] && [ "$miss" = 1 ]; then TI_STATE=unknown; TI_WHY="$other stats did not answer, status not known"; return 0
  else return 0; fi
  if [ "$on" = 1 ] && [ "$(jget "$TI_RAW" alive)" = true ]; then TI_STATE=up
  elif [ "$miss" = 1 ]; then TI_STATE=unknown; TI_WHY="$other stats did not answer, status not known"
  elif [ "$(jget "$s" alive)" != true ]; then TI_STATE=down
  elif [ -n "$par" ]; then TI_STATE=standby; TI_WHY="not in use, Iran is connected through $par"
  else TI_STATE=up; TI_RAW=$s; TI_WHY="Iran is connected through $other"; fi
  TI_RTT=$(jget_flat "$TI_RAW" rtt_ms srtt_ms); TI_STREAMS=$(jget_flat "$TI_RAW" streams_total streams); TI_SESS=$(jget "$TI_RAW" sessions)
  TI_IN=$(jget "$TI_RAW" bytes_in_total); TI_OUT=$(jget "$TI_RAW" bytes_out_total); TI_RATE=$(jget "$TI_RAW" rate_bps)
  [ -n "$TI_IN" ] || { TI_IN=$(jget "$TI_RAW" bytes_in); TI_OUT=$(jget "$TI_RAW" bytes_out); } # before 2.4.19: since the last restart
  awk -v r="${TI_RTT:-0}" 'BEGIN{exit !(r < 0.5)}' && TI_RTT=$(jget "$TI_RAW" min_rtt_ms) # a server between samples reports srtt 0
  : "${TI_RTT:=0}" "${TI_STREAMS:=0}" "${TI_SESS:=0}" "${TI_IN:=0}" "${TI_OUT:=0}" "${TI_RATE:=0}"
  parse_carriers "$TI_RAW"
  TI_CAR_COUNT=$CAR_COUNT
  if [ "$CAR_COUNT" -gt 0 ]; then
    local j; TI_LIVE=''
    for ((j=0; j<CAR_COUNT; j++)); do [ "${CAR_ALIVE[$j]}" = true ] && TI_LIVE+="${TI_LIVE:++}${CAR_NAME[$j]}"; done
  fi
  if [ "$TI_STATE" = up ] && [ "$CAR_COUNT" -gt 0 ] && [ "$TI_AUTO" = 0 ]; then
    local i unmuted_live=0 unmuted_total=0
    for ((i=0; i<CAR_COUNT; i++)); do
      if [ "${CAR_MUTED[$i]}" = true ]; then
        TI_CAR_MUTED=$((TI_CAR_MUTED+1))
      else
        unmuted_total=$((unmuted_total+1))
        [ "${CAR_ALIVE[$i]}" = true ] && unmuted_live=$((unmuted_live+1))
      fi
    done
    TI_CAR_ALIVE=$unmuted_live
    if [ "$unmuted_total" -gt 1 ] && [ "$unmuted_live" -lt "$unmuted_total" ]; then
      TI_STATE=degraded; TI_WHY="$((unmuted_total - unmuted_live)) of $unmuted_total carriers down"
    fi
  fi
}
SC_COL=''; SC_TXT=''; SC_DOT='●'
state_cell() { # role state
  case "$2" in
    up) SC_COL=$GRN; SC_DOT='●'; SC_TXT=up ;;
    degraded) SC_COL=$YEL; SC_DOT='◐'; SC_TXT=partial ;;
    standby) SC_COL=$GRY; SC_DOT='◌'; SC_TXT=standby ;;
    unknown) SC_COL=$YEL; SC_DOT='◐'; SC_TXT=unknown ;;
    down) SC_COL=$RED; SC_DOT='○'; if [ "$1" = Kharej ]; then SC_TXT=waiting; else SC_TXT=down; fi ;;
    *) SC_COL=$GRY; SC_DOT='◌'; SC_TXT=stopped ;;
  esac
}
ports_summary() { # name [maxlen] -> "443 · 8443→443 · 53/udp"
  local n=$1 max=${2:-50} out='' piece it cnt=0 total=0
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    total=$((total+1))
    piece=$(spec_human "$it")
    [ "$(role "$n")" = Kharej ] && { piece=$(spec_T "$it"); [ "$(spec_P "$it")" = udp ] && piece="$piece/udp"; }
    if [ $(( ${#out} + ${#piece} + 5 )) -gt "$max" ]; then continue; fi
    out="${out:+$out · }$piece"; cnt=$((cnt+1))
  done < <(yml_maps "$n")
  if [ "$total" -eq 0 ]; then [ "$(role "$n")" = Kharej ] && echo "any port" || echo "no ports yet"; return; fi
  [ "$cnt" -lt "$total" ] && out="$out +$((total-cnt))"
  echo "$out"
}

