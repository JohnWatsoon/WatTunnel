step_diagram() { # [1|2 highlight]
  local hl=${1:-0} c1=$BOLD c2=$BOLD cols
  cols=$(term_cols)
  [ "$hl" = 1 ] && c2=$GRY; [ "$hl" = 2 ] && c1=$GRY
  if [ "$hl" = 2 ]; then
    printf '  %s✔ [1] Kharej%s %s(outside)%s  %s─── wat1: token ───►%s  %s[2] Iran%s %s(inside)%s\n' \
      "$GRN" "$RST" "$GRY" "$RST" "$CYN" "$RST" "$CYN$BOLD" "$RST" "$GRY" "$RST"
    return 0
  fi
  if [ "$cols" -lt 68 ]; then
    printf '  %s[1] Kharej%s %s(outside)  ─── wat1: token ───►%s\n' "$c1" "$RST" "$GRY" "$RST"
    printf '  %s[2] Iran%s %s(inside, users connect here)%s\n' "$c2" "$RST" "$GRY" "$RST"
  else
    printf '  %s[1] Kharej%s %s(outside)%s  %s─── wat1: token ───►%s  %s[2] Iran%s %s(inside)%s\n' \
      "$c1" "$RST" "$GRY" "$RST" "$GRY" "$RST" "$c2" "$RST" "$GRY" "$RST"
    printf '      %sruns service                              users connect here%s\n' "$GRY" "$RST"
  fi
}
conn_diagram() { # carrier canonical... : Users ──► Iran :8443 ═══[ icmp · 42 ms ]═══► Kharej ──► 127.0.0.1:443
  local cr=$1 it n=0 L T P sfx br cols line_len; shift
  cols=$(term_cols)
  br="$cr"
  [ "${T_REV:-0}" = 1 ] && br+=" · rev"
  [ -n "${LINK_RTT:-}" ] && br+=" · ${LINK_RTT} ms"
  for it in "$@"; do
    n=$((n+1)); [ "$n" -gt 4 ] && continue
    L=$(spec_L "$it"); T=$(spec_T "$it"); P=$(spec_P "$it"); sfx=''; [ "$P" = udp ] && sfx=/udp
    line_len=$(( 38 + ${#L} + ${#sfx} + ${#br} + ${#T} + ${#sfx} ))
    if [ "$cols" -ge 78 ] && [ "$line_len" -le $((cols - 2)) ]; then
      printf '  Users %s──►%s Iran :%s%s %s═══[ %s ]═══►%s Kharej %s──►%s 127.0.0.1:%s%s\n' \
        "$GRY" "$RST" "$L" "$sfx" "$CYN" "$br" "$RST" "$GRY" "$RST" "$T" "$sfx"
    else
      printf '  Users %s──►%s Iran :%s%s\n' "$GRY" "$RST" "$L" "$sfx"
      printf '    %s═══[ %s ]═══►%s Kharej %s──►%s 127.0.0.1:%s%s\n' \
        "$CYN" "$br" "$RST" "$GRY" "$RST" "$T" "$sfx"
    fi
  done
  [ "$n" -gt 4 ] && hint "  … and $((n-4)) more"
  return 0
}

