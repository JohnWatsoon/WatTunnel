    if [ "$kind" != "$last" ] && [ "$last" != anti ] && [ "$AT_QUIET" != 1 ]; then
      case "$kind" in
        d) sec_hdr "Direct" ;;
        c) sec_hdr "CDN" "$T_SNI"; [ "$CS_RAN" = 1 ] && cdn_scan_say ;;
        r) sec_hdr "Reverse" ;;
      esac
    fi
    av_anti "$i" || last=$kind
    if [ "$kind" = r ] && is_pool "${AV_CAR[$i]}"; then
      pool=(); for ((j=i; j<n; j++)); do [ "${AV_KIND[$j]}" = r ] && is_pool "${AV_CAR[$j]}" && pool+=("$j"); done
      AT_IDX=$((i+1))
      AT_MB=$(at_probe_mb "$best_rate" 1.5 "$AT_SCREEN_CAP_MB")
      at_pool_batch "${pool[@]}"
      best_rate=$(at_best_rate "$best_rate" "${pool[@]}")
      break
    fi
    AT_IDX=$((i+1))
    w=8; [ "$kind" = r ] && [ "${AV_CAR[$i]}" = icmp ] && w=30 # Kharej's companion needs a few seconds to start
    AT_MB=$(at_probe_mb "$best_rate" 1.5 "$AT_SCREEN_CAP_MB") # H3: duration-based size, 8 -> x4 while under 1.5 s
    [ "$AT_QUIET" = 1 ] || at_busy "${AV_LABEL[$i]}"
    at_probe "$i" "$w"
    [ "${AR_OK[$i]}" = 1 ] && AT_MOVED_MB=$((AT_MOVED_MB + 2 * AT_MB))
    best_rate=$(at_best_rate "$best_rate" "$i")
    [ "$AT_QUIET" = 1 ] || { at_idle; [ "${AR_WHY[$i]}" = skipped ] && printf '  %s-%s %-24s %sskipped%s\n' "$GRY" "$RST" "$(at_lbl "${AV_LABEL[$i]}" 24)" "$GRY" "$RST" || at_print "$i"; }
    case "$AT_ACT" in group) av_anti "$i" && AT_GSKIP=${AV_CAR[$i]} ;; stop) AT_STOP=1; AR_WHY[$i]=skipped ;; esac
    AT_ACT=''
    if [ "$kind" = c ] && cdn_ok && [ "${AV_KIND[$((i+1))]:-}" != c ]; then cdn_auto_extras; fi
  done
