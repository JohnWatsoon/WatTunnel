if [ "${WAT_FORCE_COLOR:-0}" = 1 ] || { [ "$IS_TTY" = 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; }; then USE_COLOR=1; fi
[ "$NONINTERACTIVE" = 1 ] && USE_COLOR=0
NCOL=8
if [ "$USE_COLOR" = 1 ]; then
