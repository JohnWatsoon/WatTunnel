          bar_s=''; [ "$cols" -ge 72 ] && bar_s="  $(bar "$AT_IDX" "$AT_TOTAL" 14)"
          printf '\r\e[K  %s%s%s %s%-24s%s%s' "$CYN" "${SPIN_FR[$i]}" "$RST" "$tag" "$(at_lbl "$lbl" 24)" "$ts" "$bar_s"
          i=$(( (i + 1) % 10 )); sleep 0.1
